    private async Task PersistAgentSessionAsync()
    {
        if (!Guid.TryParse(_quoteSessionId, out var sessionId) || sessionId == Guid.Empty)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync(
                "malievChatbot.writeSharedSession",
                MakeStudioSessionStorageKey,
                sessionId.ToString("D"),
                _authStatus.CustomerId?.ToString("D"),
                SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en",
                IsSignedIn);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
        }
    }

    private void ApplyCustomerQuoteDefaults(QuotePartViewModel part)
    {
        var toleranceId = NormalizeQuoteDefaultTolerance(part.ProcessId, _defaultToleranceId);
        if (!string.IsNullOrWhiteSpace(toleranceId))
        {
            var tolerance = _reference?.Tolerances.FirstOrDefault(candidate =>
                string.Equals(candidate.Id, toleranceId, StringComparison.OrdinalIgnoreCase)
                && string.Equals(candidate.ProcessId, part.ProcessId, StringComparison.OrdinalIgnoreCase));
            part.ToleranceId = tolerance?.Id;
            part.ToleranceCode = tolerance?.Code;
        }

        part.InspectionLevel = NormalizeQuoteDefaultInspection(_defaultInspectionCode);
    }

    private string NormalizeQuoteDefaultProcess(string? processId)
    {
        return _reference?.Processes.FirstOrDefault(candidate => string.Equals(candidate.Id, processId, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _reference?.Processes.FirstOrDefault()?.Id
            ?? "fdm";
    }

    private string? NormalizeQuoteDefaultTolerance(string processId, string? toleranceId)
    {
        var tolerances = (_reference?.Tolerances ?? []).Where(candidate => string.Equals(candidate.ProcessId, processId, StringComparison.OrdinalIgnoreCase)).ToArray();
        return tolerances.FirstOrDefault(candidate => string.Equals(candidate.Id, toleranceId, StringComparison.OrdinalIgnoreCase))?.Id
            ?? tolerances.FirstOrDefault()?.Id;
    }

    private string NormalizeQuoteDefaultInspection(string? inspectionCode)
    {
        return _reference?.InspectionLevels.FirstOrDefault(candidate => string.Equals(candidate.Code, inspectionCode, StringComparison.OrdinalIgnoreCase))?.Code
            ?? _reference?.InspectionLevels.FirstOrDefault()?.Code
            ?? "STANDARD";
    }

    private string NormalizeQuoteDefaultLeadTime(string? leadTimeCode)
    {
        return _reference?.LeadTimes.FirstOrDefault(candidate => string.Equals(candidate.Code, leadTimeCode, StringComparison.OrdinalIgnoreCase))?.Code
            ?? _reference?.LeadTimes.FirstOrDefault(candidate => string.Equals(candidate.Code, "STANDARD", StringComparison.OrdinalIgnoreCase))?.Code
            ?? _reference?.LeadTimes.FirstOrDefault()?.Code
            ?? "STANDARD";
    }

    private IEnumerable<MaterialOptionDto> MaterialsFor(string processId)
    {
        return (_reference?.Materials ?? []).Where(x => x.ProcessId == processId);
    }

    private decimal PartTotal(QuotePartViewModel part)
    {
        return _estimate?.Lines.FirstOrDefault(line => line.PartId == part.PartId)?.LineTotal ?? 0m;
    }

    private string ProcessName(string processId)
    {
        return _reference?.Processes.FirstOrDefault(process => process.Id == processId)?.Name ?? processId;
    }

    private string MaterialName(string materialId)
    {
        return _reference?.Materials.FirstOrDefault(material => material.Id == materialId)?.Name ?? materialId;
    }

    private static string ProcessIcon(string processId) => processId switch
    {
        "cnc" => Icons.Material.Outlined.PrecisionManufacturing,
        "sla" => Icons.Material.Outlined.Science,
        _ => Icons.Material.Outlined.ViewInAr
    };

    private static string MaterialSwatch(string materialId) => materialId switch
    {
        "pla-black" => "linear-gradient(135deg, #222 0%, #555 100%)",
        "petg-clear" => "linear-gradient(135deg, #d9eef2 0%, #ffffff 100%)",
        "aluminum-6061" => "linear-gradient(135deg, #b9c2c5 0%, #f4f6f7 48%, #8d989d 100%)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };

    private static string StatusClass(QuotePartViewModel part) => part.Status switch
    {
        "Analyzed" => "ok",
        "Upload failed" => "error",
        "Uploading" => "warn",
        _ => "muted"
    };

    private static string LeadTimeBadge(LeadTimeOptionDto leadTime) => leadTime.PriceMultiplier switch
    {
        < 1m => $"-{Math.Round((1m - leadTime.PriceMultiplier) * 100m)}%",
        > 1m => $"+{Math.Round((leadTime.PriceMultiplier - 1m) * 100m)}%",
        _ => "base"
    };

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ClearRetainedBrowserUploadFilesAsync("dispose");
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterDropzone", PageDropzoneId);
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterPasteTarget", PageDropzoneId);
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
        if (_notificationConnection is not null)
        {
            await _notificationConnection.DisposeAsync();
        }
    }

    private sealed record CapturedFile(string ClientFileId, IBrowserFile File);

    private sealed record UploadCandidate(string ClientFileId, string FileName, string ContentType, long FileSizeBytes);

    public sealed class DroppedBrowserFile
    {
        public string ClientFileId { get; set; } = string.Empty;

        public string FileName { get; set; } = string.Empty;

        public string ContentType { get; set; } = "application/octet-stream";

        public long FileSizeBytes { get; set; }
    }

