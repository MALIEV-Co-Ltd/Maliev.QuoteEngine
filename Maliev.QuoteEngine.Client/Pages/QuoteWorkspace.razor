    private async Task<bool> TryApplyLocalViewerUrlAsync(QuotePartViewModel part)
    {
        var viewerExtension = await ResolveBrowserFileViewerExtensionAsync(part);
        if (viewerExtension is null || string.IsNullOrWhiteSpace(part.ClientFileId))
        {
            return false;
        }

        try
        {
            var objectUrl = await Js.InvokeAsync<string?>(
                "quoteEngineUploads.getObjectUrl",
                part.ClientFileId);
            if (string.IsNullOrWhiteSpace(objectUrl))
            {
                return false;
            }

            part.GlbUrl = objectUrl;
            part.ViewerStoragePath ??= part.StoragePath;
            part.ViewerFileExtension = viewerExtension;
            return true;
        }
        catch (JSException)
        {
            return false;
        }
    }

    private bool CanUseBrowserFileViewer(QuotePartViewModel part)
        => ResolveBrowserFileViewerExtension(part, _runtimeBrowserViewerExtensions ?? DefaultBrowserViewerExtensions) is not null;

