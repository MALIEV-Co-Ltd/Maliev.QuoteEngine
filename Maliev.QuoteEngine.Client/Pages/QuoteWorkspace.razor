@page "/quotes/new"
@inject QuoteEngineApiClient Api
@inject IJSRuntime Js

<PageTitle>New manufacturing quote - MALIEV</PageTitle>

<div class="qe-pn-root">
    <div id="@UploadContainerId">
        <InputFile id="@UploadInputId" OnChange="HandleFilesAsync" multiple />
    </div>

    <div class="qe-pn-body">
        <aside class="qe-plp-root">
            <div class="qe-plp-page-header">
                <input type="text" value="@_title" @oninput="e => _title = e.Value?.ToString() ?? string.Empty" class="qe-plp-title-input" title="Project title" />
                <button type="button" class="qe-icon-btn" title="Duplicate project" disabled="@(!_parts.Any())">
                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                </button>
            </div>

            <div class="qe-plp-upload-section">
                <button type="button" class="qe-dropzone qe-dropzone--compact" @onclick="OpenFilePickerAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Medium" />
                    <span>Drop CAD files to quote</span>
                    <small>STL, STEP, STP, OBJ, 3MF, IGES</small>
                </button>
            </div>

            <div class="qe-plp-headers">
                <span>Parts</span>
                <span>@_parts.Count part(s)</span>
            </div>

            <div class="qe-plp-list">
                @foreach (var part in _parts)
                {
                    var index = _parts.IndexOf(part);
                    var total = _estimate?.Lines.FirstOrDefault(line => line.PartId == part.PartId)?.LineTotal;
                    <button type="button" class="qe-plp-part @(index == _selectedPartIndex ? "qe-plp-part--selected" : "")" @onclick="@(() => SelectPart(index))">
                        <span class="qe-plp-thumb">
                            @if (part.Status == "Uploading")
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            }
                            else
                            {
                                <img src="/images/generated/sample-part.svg" alt="" />
                            }
                        </span>
                        <span class="qe-plp-info">
                            <strong>@part.FileName</strong>
                            <small>@part.VolumeCc.ToString("0.##") cc · @part.SurfaceAreaCm2.ToString("0.##") cm²</small>
                            <span class="qe-plp-meta">
                                <span>@ProcessName(part.ProcessId)</span>
                                <span>x @part.Quantity</span>
                            </span>
                        </span>
                        @if (total.HasValue)
                        {
                            <span class="qe-plp-price">@total.Value.ToString("N2") THB</span>
                        }
                    </button>
                }
            </div>

            <div class="qe-plp-footer">
                <span>Total parts</span>
                <strong>@_parts.Sum(part => part.Quantity) pcs</strong>
            </div>
        </aside>

        <main class="qe-pn-center">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="qe-error-alert">@_error</MudAlert>
            }

            @if (SelectedPart is null)
            {
                <section class="qe-empty-state">
                    <button type="button" class="qe-dropzone qe-dropzone--hero" @onclick="OpenFilePickerAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Large" />
                        <span>Drop files here or click to upload</span>
                        <small>STL, STEP, STP, OBJ, 3MF, IGES · max 10 GB per file</small>
                    </button>
                </section>
            }
            else
            {
                <div class="qe-pn-detail-row">
                    <section class="qe-pdc-root">
                        <header class="qe-pdc-header">
                            <div class="qe-pdc-header-left">
                                <div class="qe-pdc-header-name-row">
                                    <strong title="@SelectedPart.FileName">@Path.GetFileNameWithoutExtension(SelectedPart.FileName)</strong>
                                    <span class="qe-status-pill qe-status--@StatusClass(SelectedPart)">@SelectedPart.Status.ToUpperInvariant()</span>
                                </div>
                                <div class="qe-pdc-header-subline">
                                    Uploaded just now · @SelectedPart.FileName · @SelectedPart.VolumeCc.ToString("0.##") cc
                                </div>
                            </div>
                            <div class="qe-pdc-tabs">
                                <button type="button" class="qe-pdc-tab qe-pdc-tab--active">
                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                    3D Model
                                </button>
                                <button type="button" class="qe-pdc-tab">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                                    Drawing
                                </button>
                                <button type="button" class="qe-pdc-tab">
                                    <MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" />
                                    DFM
                                    <span>@SelectedPart.Findings.Count</span>
                                </button>
                            </div>
                        </header>

                        <div class="qe-pdc-container">
                            <div class="qe-pdc-viewer-wrap qe-pdc-polkadot">
                                <div class="qe-pdc-thumb-area">
                                    <img src="/images/generated/sample-part.svg" alt="Preview for @SelectedPart.FileName" />
                                    <div class="qe-viewer-caption">
                                        <strong>Prototype viewer</strong>
                                        <span>Babylon GLB viewer slot</span>
                                    </div>
                                </div>
                                <aside class="qe-dfm-panel">
                                    <div class="qe-dfm-panel-title">
                                        <MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" />
                                        DFM checks
                                    </div>
                                    @foreach (var finding in SelectedPart.Findings)
                                    {
                                        <div class="qe-dfm-issue qe-dfm-issue--@finding.Severity.ToLowerInvariant()">
                                            <strong>@finding.Severity</strong>
                                            <span>@finding.Message</span>
                                        </div>
                                    }
                                </aside>
                            </div>
                        </div>

                        <footer class="qe-pdc-footer">
                            <span class="qe-chip qe-chip--process">@ProcessName(SelectedPart.ProcessId)</span>
                            <span class="qe-chip">@MaterialName(SelectedPart.MaterialId)</span>
                            <span class="qe-footer-sep"></span>
                            <span>@SelectedPart.Quantity pcs</span>
                            <strong>@PartTotal(SelectedPart).ToString("N2") THB</strong>
                        </footer>
                    </section>

                    <aside class="qe-pcs-sidebar">
                        <header class="qe-pcs-header">
                            <span>Configure</span>
                            <strong title="@SelectedPart.FileName">@SelectedPart.FileName</strong>
                        </header>
                        <div class="qe-pcs-scroll">
                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Manufacturing Process</span>
                                </div>
                                <div class="qe-pcs-process-grid">
                                    @foreach (var process in _reference?.Processes ?? [])
                                    {
                                        var active = SelectedPart.ProcessId == process.Id;
                                        <button type="button" class="qe-pcs-process-card @(active ? "qe-pcs-process-card--active" : "")" @onclick="@(() => SelectProcess(SelectedPart, process))">
                                            <MudIcon Icon="@ProcessIcon(process.Id)" Size="Size.Small" />
                                            <strong>@process.Name</strong>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                                            }
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Material</span>
                                    <small>@MaterialsFor(SelectedPart.ProcessId).Count() options</small>
                                </div>
                                <div class="qe-pcs-cards">
                                    @foreach (var material in MaterialsFor(SelectedPart.ProcessId))
                                    {
                                        var active = SelectedPart.MaterialId == material.Id;
                                        <button type="button" class="qe-pcs-mat-card @(active ? "qe-pcs-mat-card--active" : "")" @onclick="@(() => SelectMaterial(SelectedPart, material))">
                                            <span class="qe-mat-swatch" style="background:@MaterialSwatch(material.Id)"></span>
                                            <span>
                                                <strong>@material.Name</strong>
                                                <small>@material.Grade · @material.Finish</small>
                                            </span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                                            }
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Quantity and review</span>
                                </div>
                                <div class="qe-pcs-qty-row">
                                    <label>
                                        Quantity
                                        <input type="number" min="1" @bind="SelectedPart.Quantity" @bind:after="ClearEstimate" />
                                    </label>
                                    <label class="qe-check-btn @(SelectedPart.DfmAcknowledged ? "checked" : "")">
                                        <input type="checkbox" @bind="SelectedPart.DfmAcknowledged" />
                                        DFM reviewed
                                    </label>
                                </div>
                            </section>
                        </div>
                    </aside>
                </div>
            }
        </main>
    </div>

    <footer class="qe-qsb-root">
        <div class="qe-qsb-zone qe-qsb-customer">
            <span class="qe-zone-label">Bill To</span>
            <strong>Customer account</strong>
            <small>Signed-in customer profile boundary</small>
        </div>
        <div class="qe-qsb-divider"></div>
        <div class="qe-qsb-zone qe-qsb-lead">
            <span class="qe-zone-label">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                Lead Time
            </span>
            <div class="qe-qsb-lead-options">
                @foreach (var leadTime in _reference?.LeadTimes ?? [])
                {
                    var active = _leadTimeCode == leadTime.Code;
                    <button type="button" class="qe-qsb-lead-btn @(active ? "qe-qsb-lead-btn--active" : "")" @onclick="@(() => SelectLeadTime(leadTime.Code))">
                        <span>
                            <strong>@leadTime.Name</strong>
                            <small>@leadTime.BusinessDays business days</small>
                        </span>
                        <em>@LeadTimeBadge(leadTime)</em>
                    </button>
                }
            </div>
        </div>
        <div class="qe-qsb-divider"></div>
        <div class="qe-qsb-zone qe-qsb-total">
            <span class="qe-zone-label">Quote Total</span>
            <strong>@(_estimate is null ? "—" : $"{_estimate.Total:N2} {_estimate.Currency}")</strong>
            <div class="qe-qsb-actions">
                <button type="button" class="qe-secondary-btn" disabled="@(!_parts.Any())" @onclick="CalculateAsync">Estimate</button>
                <button type="button" class="qe-secondary-btn" disabled="@(_estimate is null)" @onclick="SubmitQuoteAsync">PDF</button>
                <button type="button" class="qe-primary-btn" disabled="@(_estimate is null)" @onclick="SubmitQuoteAsync">
                    Quote
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </button>
            </div>
            @if (_formalQuote is not null)
            {
                <div class="qe-qsb-result">
                    <span>@_formalQuote.QuoteNumber</span>
                    <button type="button" @onclick="CreateOrderAsync">Create order</button>
                </div>
            }
            @if (_order is not null)
            {
                <div class="qe-qsb-result">
                    <span>@_order.OrderNumber</span>
                    <strong>@_order.Status</strong>
                </div>
            }
        </div>
    </footer>
</div>

@code {
    private const string UploadContainerId = "quote-upload-container";
    private const string UploadInputId = "quote-cad-files";
    private readonly string _quoteSessionId = Guid.NewGuid().ToString("N");
    private readonly List<QuotePartViewModel> _parts = [];
    private QuoteReferenceDataResponse? _reference;
    private QuoteEstimateResponse? _estimate;
    private GenerateFormalQuoteResponse? _formalQuote;
    private CreateManufacturingOrderResponse? _order;
    private string _leadTimeCode = "STANDARD";
    private string _title = "Untitled quote";
    private int _selectedPartIndex;
    private string? _error;

    private QuotePartViewModel? SelectedPart => _parts.Count == 0 ? null : _parts[Math.Min(_selectedPartIndex, _parts.Count - 1)];

    protected override async Task OnInitializedAsync()
    {
        _reference = await Api.GetReferenceDataAsync();
    }

    private async Task OpenFilePickerAsync()
    {
        await Js.InvokeVoidAsync("quoteEngineUploads.openFilePicker", UploadInputId);
    }

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        _estimate = null;
        _formalQuote = null;
        _order = null;

        var selectedFiles = args.GetMultipleFiles(12).ToArray();
        var capturedFiles = selectedFiles
            .Select(file => new CapturedFile(Guid.NewGuid().ToString("N"), file))
            .ToArray();

        await Js.InvokeVoidAsync(
            "quoteEngineUploads.captureFiles",
            UploadInputId,
            capturedFiles.Select(file => new
            {
                clientFileId = file.ClientFileId,
                fileName = file.File.Name,
                fileSizeBytes = file.File.Size
            }));

        foreach (var capturedFile in capturedFiles)
        {
            var file = capturedFile.File;
            var part = new QuotePartViewModel { FileName = file.Name, Status = "Uploading" };
            _parts.Add(part);
            _selectedPartIndex = _parts.Count - 1;
            try
            {
                var initiation = await Api.InitiateUploadAsync(_quoteSessionId, file);
                await Js.InvokeVoidAsync(
                    "quoteEngineUploads.uploadFile",
                    capturedFile.ClientFileId,
                    initiation.ProxyUploadUrl,
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);

                var upload = await Api.CompleteUploadAsync(initiation.UploadId);
                var status = await Api.GetAnalysisStatusAsync(upload.UploadId);
                part.PartId = Guid.NewGuid();
                part.FileId = upload.FileId;
                part.UploadId = upload.UploadId;
                part.Status = status.Status;
                part.VolumeCc = status.VolumeCc;
                part.SurfaceAreaCm2 = status.SurfaceAreaCm2;
                part.Findings = status.Findings;
            }
            catch (Exception ex)
            {
                part.Status = "Upload failed";
                _error = ex.Message;
            }
        }
    }

    private void SelectPart(int index)
    {
        _selectedPartIndex = Math.Clamp(index, 0, Math.Max(_parts.Count - 1, 0));
    }

    private void SelectProcess(QuotePartViewModel part, ProcessOptionDto process)
    {
        part.ProcessId = process.Id;
        var firstMaterial = MaterialsFor(process.Id).FirstOrDefault();
        if (firstMaterial is not null)
        {
            part.MaterialId = firstMaterial.Id;
        }

        ClearEstimate();
    }

    private void SelectMaterial(QuotePartViewModel part, MaterialOptionDto material)
    {
        part.MaterialId = material.Id;
        ClearEstimate();
    }

    private void SelectLeadTime(string code)
    {
        _leadTimeCode = code;
        ClearEstimate();
    }

    private void ClearEstimate()
    {
        _estimate = null;
        _formalQuote = null;
        _order = null;
    }

    private async Task CalculateAsync()
    {
        _estimate = await Api.EstimateAsync(new QuoteEstimateRequest
        {
            QuoteSessionId = _quoteSessionId,
            LeadTimeCode = _leadTimeCode,
            Parts = _parts.Select(x => x.ToDraft()).ToList()
        });
    }

    private async Task SubmitQuoteAsync()
    {
        var draft = await Api.CreateDraftProjectAsync(new CreateDraftProjectRequest(_quoteSessionId, _parts.Select(x => x.ToDraft()).ToArray(), "Customer quote engine prototype"));
        _formalQuote = await Api.GenerateFormalQuoteAsync(new GenerateFormalQuoteRequest(draft.ProjectId, _quoteSessionId, _parts.Select(x => x.ToDraft()).ToArray(), "Formal quote requested by customer."));
    }

    private async Task CreateOrderAsync()
    {
        if (_formalQuote is null)
        {
            return;
        }

        _order = await Api.CreateOrderAsync(new CreateManufacturingOrderRequest(_formalQuote.QuoteId, string.Empty, "Customer accepted quote."));
    }

    private IEnumerable<MaterialOptionDto> MaterialsFor(string processId)
    {
        return (_reference?.Materials ?? []).Where(x => x.ProcessId == processId);
    }

    private decimal PartTotal(QuotePartViewModel part)
    {
        return _estimate?.Lines.FirstOrDefault(line => line.PartId == part.PartId)?.LineTotal ?? 0m;
    }

    private string ProcessName(string processId)
    {
        return _reference?.Processes.FirstOrDefault(process => process.Id == processId)?.Name ?? processId;
    }

    private string MaterialName(string materialId)
    {
        return _reference?.Materials.FirstOrDefault(material => material.Id == materialId)?.Name ?? materialId;
    }

    private static string ProcessIcon(string processId) => processId switch
    {
        "cnc" => Icons.Material.Outlined.PrecisionManufacturing,
        "sla" => Icons.Material.Outlined.Science,
        _ => Icons.Material.Outlined.ViewInAr
    };

    private static string MaterialSwatch(string materialId) => materialId switch
    {
        "pla-black" => "linear-gradient(135deg, #222 0%, #555 100%)",
        "petg-clear" => "linear-gradient(135deg, #d9eef2 0%, #ffffff 100%)",
        "aluminum-6061" => "linear-gradient(135deg, #b9c2c5 0%, #f4f6f7 48%, #8d989d 100%)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };

    private static string StatusClass(QuotePartViewModel part) => part.Status switch
    {
        "Analyzed" => "ok",
        "Upload failed" => "error",
        "Uploading" => "warn",
        _ => "muted"
    };

    private static string LeadTimeBadge(LeadTimeOptionDto leadTime) => leadTime.PriceMultiplier switch
    {
        < 1m => $"-{Math.Round((1m - leadTime.PriceMultiplier) * 100m)}%",
        > 1m => $"+{Math.Round((leadTime.PriceMultiplier - 1m) * 100m)}%",
        _ => "base"
    };

    private sealed record CapturedFile(string ClientFileId, IBrowserFile File);

    private sealed class QuotePartViewModel
    {
        public Guid PartId { get; set; } = Guid.NewGuid();
        public Guid FileId { get; set; }
        public string UploadId { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string ProcessId { get; set; } = "fdm";
        public string MaterialId { get; set; } = "pla-black";
        public int Quantity { get; set; } = 1;
        public decimal VolumeCc { get; set; }
        public decimal SurfaceAreaCm2 { get; set; }
        public bool DfmAcknowledged { get; set; }
        public string Status { get; set; } = "Waiting";
        public IReadOnlyList<DfmFindingDto> Findings { get; set; } = [];

        public QuotePartDraftDto ToDraft() => new()
        {
            PartId = PartId,
            FileId = FileId,
            UploadId = UploadId,
            FileName = FileName,
            ProcessId = ProcessId,
            MaterialId = MaterialId,
            Quantity = Quantity,
            VolumeCc = Math.Max(VolumeCc, 1m),
            SurfaceAreaCm2 = SurfaceAreaCm2,
            DfmAcknowledged = DfmAcknowledged
        };
    }
}
