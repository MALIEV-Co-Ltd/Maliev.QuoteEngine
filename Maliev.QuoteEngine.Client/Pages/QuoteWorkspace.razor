    private async Task InitiatePaymentAsync()
    {
        if (_paymentBusy || _order is null || _estimate is null)
        {
            return;
        }

        if (!IsSignedIn)
        {
            Navigation.NavigateTo($"/auth/sign-in?returnUrl={Uri.EscapeDataString(CheckoutReturnUrl)}");
            return;
        }

        _paymentBusy = true;
        _error = null;

        try
        {
            _payment = await Api.InitiatePaymentAsync(new InitiatePaymentRequest
            {
                OrderId = _order.OrderId,
                OrderNumber = _order.OrderNumber,
                Amount = _estimate.Total,
                Currency = _estimate.Currency,
                BillingAddressId = BillingAddressId,
                ShippingAddressId = ShippingAddressId,
                BillingCompanyName = BillingCompanyName,
                BillingVatNumber = BillingVatNumber,
                AcceptedTerms = _acceptedCheckoutTerms
            });

            if (!string.IsNullOrWhiteSpace(_payment.PaymentUrl))
            {
                Navigation.NavigateTo(_payment.PaymentUrl, forceLoad: true);
            }
            else
            {
                _error = Text("Payment checkout is not available for this order yet.", "ยังไม่สามารถเปิดหน้าชำระเงินสำหรับคำสั่งซื้อนี้ได้");
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (HttpRequestException)
        {
            _error = Text("Payment checkout failed. Please try again.", "เปิดหน้าชำระเงินไม่สำเร็จ กรุณาลองใหม่");
        }
        catch (InvalidOperationException)
        {
            _error = Text("Payment checkout failed. Please try again.", "เปิดหน้าชำระเงินไม่สำเร็จ กรุณาลองใหม่");
        }
        catch (JsonException)
        {
            _error = Text("Payment checkout failed. Please try again.", "เปิดหน้าชำระเงินไม่สำเร็จ กรุณาลองใหม่");
        }
        finally
        {
            _paymentBusy = false;
        }
    }

