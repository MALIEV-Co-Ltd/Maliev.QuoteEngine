    private async Task DuplicateProjectAsync()
    {
        if (!IsSignedIn || IsDemoMode)
        {
            Navigation.NavigateTo("/auth/sign-in?returnUrl=/quote/new");
            return;
        }

        if (_parts.Count == 0)
        {
            return;
        }

        if (!_draftProjectId.HasValue)
        {
            var draft = await Api.CreateDraftProjectAsync(new CreateDraftProjectRequest(
                _quoteSessionId,
                _parts.Select(x => x.ToDraft()).ToArray(),
                "Customer quote engine duplicate source.",
                _title));
            _draftProjectId = draft.ProjectId;
        }

        var duplicate = await Api.DuplicateProjectAsync(_draftProjectId.Value, new DuplicateDraftProjectRequest($"{_title} copy"));
        await ApplyDuplicatedProjectAsync(duplicate);
        await CalculateAsync();
    }

