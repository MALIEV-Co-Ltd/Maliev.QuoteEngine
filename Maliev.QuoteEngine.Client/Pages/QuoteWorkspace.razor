@page "/"
@page "/quotes"
@page "/quotes/new"
@page "/quote/new"
@page "/projects/new"
@page "/demo"
@using System.Net.Http
@using System.Text.Json
@using Maliev.QuoteEngine.Shared.Account
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject QuoteEngineApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject PreferenceService PreferenceState

<PageTitle>@Text("New manufacturing quote - MALIEV", "ขอราคาการผลิตใหม่ - MALIEV")</PageTitle>

<div id="@PageDropzoneId" class="@WorkspaceRootClass">
    <div id="@UploadContainerId">
        <InputFile id="@UploadInputId" OnChange="HandleFilesAsync" multiple accept="@QuoteUploadConstraints.SupportedAttachmentAccept" disabled="@(!_routeStateInitialized || IsDemoMode)" />
    </div>

    <div class="qe-page-drop-overlay" aria-hidden="true">
        <div class="qe-page-drop-overlay-inner">
            <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Large" />
            <strong>@Text("Drop files anywhere to start", "วางไฟล์ที่ใดก็ได้เพื่อเริ่ม")</strong>
            <span>@Text("CAD, drawings, photos, and sketches will be attached to this project.", "แนบ CAD แบบ รูปถ่าย และสเก็ตช์เข้ากับโปรเจกต์นี้")</span>
        </div>
    </div>

    <div class="qe-pn-body">
        @if (IsWorkspaceReady)
        {
            <QePartsListPanel @bind-Title="_title"
                              Parts="@_parts"
                              SelectedPartIndex="@_selectedPartIndex"
                              ReferenceData="@_reference"
                              Estimate="@_estimate"
                              DropzoneId="@CompactDropzoneId"
                              UploadLabel="@UploadCompactLabel"
                              UploadHint="@UploadCompactHint"
                              OnSelectPart="@SelectPart"
                              OnDuplicateProject="DuplicateProjectAsync"
                              OnRemovePart="@RemovePart" />
            <div class="qe-pn-parts-drawer @(_isPartsDrawerOpen ? "qe-pn-parts-drawer--open" : "")">
                <QePartsListPanel @bind-Title="_title"
                                  Parts="@_parts"
                                  SelectedPartIndex="@_selectedPartIndex"
                                  ReferenceData="@_reference"
                                  Estimate="@_estimate"
                                  DropzoneId="@MobileDropzoneId"
                                  UploadLabel="@UploadCompactLabel"
                                  UploadHint="@UploadCompactHint"
                                  IsDrawer="true"
                                  OnSelectPart="@SelectPart"
                                  OnDuplicateProject="DuplicateProjectAsync"
                                  OnRemovePart="@RemovePart" />
            </div>
            @if (_isPartsDrawerOpen)
            {
                <button type="button" class="qe-pn-parts-drawer-backdrop" @onclick="ClosePartsDrawer" aria-label="Close parts drawer"></button>
            }
        }

        <main class="qe-pn-center">
            @if (IsWorkspaceReady)
            {
                <div class="qe-pn-mobile-toolbar">
                    <button type="button" class="qe-mobile-tool-btn" @onclick="TogglePartsDrawer">
                        <MudIcon Icon="@Icons.Material.Outlined.List" Size="Size.Small" />
                        @Text("Parts", "ชิ้นงาน")
                    </button>
                    <div class="qe-mobile-mode-switch" role="tablist" aria-label="@Text("Workspace mode", "โหมดพื้นที่ทำงาน")">
                        <button type="button"
                                class="@(_centerMode == "bulk" ? "" : "active")"
                                @onclick="@(() => SetCenterMode("model"))">@Text("Config", "ตั้งค่า")</button>
                        <button type="button"
                                class="@(_centerMode == "bulk" ? "active" : "")"
                                @onclick="@(() => SetCenterMode("bulk"))">@Text("Table", "ตาราง")</button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="qe-error-alert">@_error</MudAlert>
            }
            @if (_liveNotifications.Count > 0)
            {
                <div class="qe-live-notifications" role="status" aria-live="polite">
                    @foreach (var notification in _liveNotifications.Take(3))
                    {
                        <span>@notification</span>
                    }
                </div>
            }

            @if (SelectedPart is null)
            {
                <QuoteAgentLaunchShell SessionId="@AgentSessionId"
                                       IsSignedIn="@IsSignedIn"
                                       IsDemoMode="@IsDemoMode"
                                       ShowLaunchAccountCard="@ShowLaunchAccountCard"
                                       Culture="@Culture"
                                       OnUploadRequested="OpenFilePickerAsync" />
            }
            else
            {
                var _sp = SelectedPart!;
                <div class="qe-pn-detail-row">
                    <QePartDetailCard Part="@_sp"
                                      Parts="@_parts"
                                      ReferenceData="@_reference"
                                      Estimate="@_estimate"
                                      CenterMode="@_centerMode"
                                      CenterModeChanged="@SetCenterMode"
                                      OnPartChanged="@OnPartConfigurationChanged"
                                      OnSelectPart="@SelectPartFromTable"
                                      OnAddFilesRequested="@OpenFilePickerAsync"
                                      OnRequestFreshViewerUrl="@RequestFreshViewerUrlAsync"
                                      CanAttachDocuments="@(!IsDemoMode)"
                                      IsDarkMode="@IsDarkMode" />

                    <QePartConfigSidebar Part="@_sp"
                                         ReferenceData="@_reference"
                                         OnPartChanged="@OnPartConfigurationChanged" />
                </div>
            }
        </main>
    </div>

    @if (IsWorkspaceReady)
    {
        <QeQuoteSummaryBar Parts="@_parts"
                           ReferenceData="@_reference"
                           Estimate="@_estimate"
                           FormalQuote="@_formalQuote"
                           Order="@_order"
                           Payment="@_payment"
                           LeadTimeCode="@_leadTimeCode"
                           CanRequestFormalQuote="@CanRequestFormalQuote"
                           CanApproveQuote="@CanApproveQuote"
                           CanCreateOrder="@CanCreateOrder"
                           CanPay="@CanPay"
                           TermsAccepted="@_acceptedCheckoutTerms"
                           PaymentBusy="@_paymentBusy"
                           QuoteButtonLabel="@QuoteButtonLabel"
                           BillingName="@BillingSummaryName"
                           BillingHint="@BillingSummaryHint"
                           OnLeadTimeSelected="@SelectLeadTime"
                           OnCalculateRequested="@CalculateAsync"
                           OnQuoteRequested="@SubmitQuoteAsync"
                           OnApproveQuoteRequested="@ApproveQuoteAsync"
                           OnOrderRequested="@CreateOrderAsync"
                           OnPaymentRequested="@InitiatePaymentAsync"
                           TermsAcceptedChanged="@((accepted) => _acceptedCheckoutTerms = accepted)" />
    }
</div>

@code {
    private const string UploadContainerId = "quote-upload-container";
    private const string UploadInputId = "quote-cad-files";
    private const string PageDropzoneId = "quote-page-dropzone";
    private const string CompactDropzoneId = "quote-compact-dropzone";
    private const string MobileDropzoneId = "quote-mobile-dropzone";
    private const string HeroDropzoneId = "quote-hero-dropzone";
    private const string QuoteDefaultProcessKey = "maliev.quote.default.process";
    private const string QuoteDefaultToleranceKey = "maliev.quote.default.tolerance";
    private const string QuoteDefaultInspectionKey = "maliev.quote.default.inspection";
    private const string QuoteDefaultLeadTimeKey = "maliev.quote.default.leadTime";
    private string _quoteSessionId = Guid.NewGuid().ToString("N");
    private readonly List<QuotePartViewModel> _parts = [];
    private QuoteReferenceDataResponse? _reference;
    private QuoteAuthStatusResponse _authStatus = new(false, null, null);
    private QuoteEstimateResponse? _estimate;
    private GenerateFormalQuoteResponse? _formalQuote;
    private CreateManufacturingOrderResponse? _order;
    private InitiatePaymentResponse? _payment;
    private CustomerProfileResponse? _profile;
    private bool _acceptedCheckoutTerms;
    private bool _paymentBusy;
    private IReadOnlyList<CustomerAddressDto> _addresses = [];
    private Guid? _draftProjectId;
    private HubConnection? _notificationConnection;
    private DotNetObjectReference<QuoteWorkspace>? _dotNetRef;
    private readonly List<string> _liveNotifications = [];
    private readonly HashSet<string> _registeredDropzoneIds = [];
    private static readonly HashSet<string> DefaultBrowserViewerExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".3mf",
        ".glb",
        ".gltf",
        ".obj",
        ".stl"
    };
    private HashSet<string>? _runtimeBrowserViewerExtensions;
    private Task<HashSet<string>?>? _runtimeBrowserViewerExtensionsTask;
    private string _leadTimeCode = "STANDARD";
    private string _defaultProcessId = "fdm";
    private string? _defaultToleranceId;
    private string _defaultInspectionCode = "STANDARD";
    private string _defaultLeadTimeCode = "STANDARD";
    private string _title = "Untitled quote";
    private int _selectedPartIndex;
    private string _centerMode = "model";
    private bool _isPartsDrawerOpen;
    private bool _routeStateInitialized;
    private string? _lastWorkspacePath;
    private string? _lastHandoff;
    private string? _error;

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    [CascadingParameter(Name = "OpenAssistant")]
    private Func<Task>? OpenAssistant { get; set; }

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private bool IsDemoMode => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/demo", StringComparison.OrdinalIgnoreCase);
    private bool IsSignedIn => _authStatus.IsSignedIn;
    private bool IsWorkspaceReady => _parts.Count > 0;
    private string WorkspaceRootClass => IsWorkspaceReady ? "qe-pn-root is-workspace-ready" : "qe-pn-root is-launch-screen";
    private bool CanRequestFormalQuote => _estimate is not null && IsSignedIn && !IsDemoMode && AllDfmIssuesAcknowledged;
    private bool CanApproveQuote => _formalQuote is not null && IsSignedIn && !IsDemoMode && !_formalQuote.Status.Contains("Approved", StringComparison.OrdinalIgnoreCase);
    private bool CanCreateOrder => _formalQuote is not null && IsSignedIn && !IsDemoMode && AllDfmIssuesAcknowledged;
    private bool AllDfmIssuesAcknowledged => _parts.All(part => part.DfmAcknowledged || !HasDfmIssues(part));
    private Guid? BillingAddressId => SelectAddressId("Billing");
    private Guid? ShippingAddressId => SelectAddressId("Shipping");
    private bool CanPay => _order is not null &&
        _estimate is not null &&
        IsSignedIn &&
        !IsDemoMode &&
        BillingAddressId.HasValue &&
        ShippingAddressId.HasValue;
    private bool ShowLaunchAccountCard => !IsSignedIn && !IsDemoMode;
    private string EmptyStateGridClass => "qe-empty-state-grid qe-empty-state-grid--solo";
    private Guid AgentSessionId => Guid.TryParse(_quoteSessionId, out var parsed) ? parsed : Guid.Empty;
    [SupplyParameterFromQuery(Name = "handoff")]
    public string? Handoff { get; set; }

    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    private string UploadCompactLabel => IsDemoMode ? Text("Demo sample only", "ไฟล์ตัวอย่างเท่านั้น") : Text("Drop quote files here", "วางไฟล์สำหรับขอราคาที่นี่");
    private string UploadCompactHint => IsDemoMode ? Text("MALIEV-owned sample file", "ไฟล์ตัวอย่างของ MALIEV") : IsSignedIn ? Text("Customer-owned upload storage", "พื้นที่อัปโหลดของลูกค้า") : Text("Saved temporarily", "บันทึกชั่วคราว");
    private string UploadHeroLabel => IsDemoMode ? Text("Demo sample is ready", "ไฟล์ตัวอย่างพร้อมใช้งาน") : Text("Drop files here or click to upload", "ลากไฟล์มาวางหรือคลิกเพื่ออัปโหลด");
    private string UploadHeroHint => IsDemoMode
        ? Text("Demo mode cannot create projects, formal quotes, orders, uploads, or history", "โหมดตัวอย่างไม่สามารถสร้างโปรเจกต์ ใบเสนอราคาทางการ คำสั่งซื้อ การอัปโหลด หรือประวัติได้")
        : $"{QuoteUploadConstraints.SupportedAttachmentExtensionLabel} / {Text("max", "สูงสุด")} {QuoteUploadConstraints.MaxFileSizeMegabytes} MB {Text("per file", "ต่อไฟล์")}";
    private string QuoteButtonLabel => IsDemoMode ? Text("Demo only", "ตัวอย่างเท่านั้น") : IsSignedIn ? Text("Quote", "ขอราคา") : Text("Sign in to quote", "เข้าสู่ระบบเพื่อขอราคา");
    private string BillingSummaryName => IsSignedIn
        ? BillingCompanyName ?? _authStatus.DisplayName ?? Text("Customer account", "บัญชีลูกค้า")
        : Text("Guest checkout", "ขอราคาแบบผู้เยี่ยมชม");
    private string BillingSummaryHint => IsSignedIn ? Text("Private order", "คำสั่งซื้อส่วนตัว") : Text("Sign in to save projects", "เข้าสู่ระบบเพื่อบันทึกโปรเจกต์");
    private string? BillingCompanyName => string.IsNullOrWhiteSpace(_profile?.CompanyName) ? null : _profile.CompanyName;
    private string? BillingVatNumber => string.IsNullOrWhiteSpace(_profile?.VatNumber) ? null : _profile.VatNumber;
    private string CheckoutReturnUrl => _order is null
        ? "/quote/new"
        : $"/orders/{Uri.EscapeDataString(_order.OrderNumber)}";

    private QuotePartViewModel? SelectedPart => _parts.Count == 0 ? null : _parts[Math.Min(_selectedPartIndex, _parts.Count - 1)];

    private QuotePartViewModel? FindPartByStoragePath(string storagePath)
        => _parts.FirstOrDefault(p =>
            string.Equals(p.StoragePath, storagePath, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _reference = await Api.GetReferenceDataAsync();
        _authStatus = await Api.GetAuthStatusAsync();
        if (IsSignedIn)
        {
            _profile = await Api.GetProfileAsync();
            _addresses = await Api.GetAddressesAsync();
        }

        await PreferenceState.InitializeAsync();
        await LoadQuoteDefaultsAsync();

        await SynchronizeRouteStateAsync(force: true);
        _routeStateInitialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_routeStateInitialized)
        {
            await SynchronizeRouteStateAsync(force: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("quoteEngineUploads.registerPasteTarget", PageDropzoneId, _dotNetRef);
        }

        await RegisterActiveDropzoneAsync();
    }

    private async Task RegisterActiveDropzoneAsync()
    {
        if (_dotNetRef is null)
        {
            return;
        }

        var activeDropzoneIds = IsWorkspaceReady
            ? new[] { PageDropzoneId, CompactDropzoneId, MobileDropzoneId }
            : [PageDropzoneId, HeroDropzoneId];

        if (_registeredDropzoneIds.SetEquals(activeDropzoneIds))
        {
            return;
        }

        foreach (var registered in _registeredDropzoneIds.Except(activeDropzoneIds, StringComparer.Ordinal).ToArray())
        {
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterDropzone", registered);
            _registeredDropzoneIds.Remove(registered);
        }

        foreach (var activeDropzoneId in activeDropzoneIds)
        {
            if (_registeredDropzoneIds.Add(activeDropzoneId))
            {
                if (string.Equals(activeDropzoneId, PageDropzoneId, StringComparison.Ordinal))
                {
                    await Js.InvokeVoidAsync("quoteEngineUploads.registerDropzone", activeDropzoneId, UploadInputId, _dotNetRef, new { clickToOpen = false });
                }
                else
                {
                    await Js.InvokeVoidAsync("quoteEngineUploads.registerDropzone", activeDropzoneId, UploadInputId, _dotNetRef);
                }
            }
        }
    }

    private async Task OpenFilePickerAsync()
    {
        if (IsDemoMode)
        {
            return;
        }

        await Js.InvokeVoidAsync("quoteEngineUploads.openFilePicker", UploadInputId);
    }

    private async Task SynchronizeRouteStateAsync(bool force)
    {
        var path = CurrentWorkspacePath();
        var pathChanged = !string.Equals(_lastWorkspacePath, path, StringComparison.OrdinalIgnoreCase);
        var handoffChanged = !string.Equals(_lastHandoff, Handoff, StringComparison.Ordinal);
        var projectChanged = ProjectId != _draftProjectId;

        if (!force && !pathChanged && !handoffChanged && !projectChanged)
        {
            return;
        }

        var isDemoPath = IsDemoPath(path);
        var wasDemoPath = _lastWorkspacePath is not null && IsDemoPath(_lastWorkspacePath);
        if (isDemoPath)
        {
            if (force || pathChanged || !HasDemoWorkspace)
            {
                await ResetWorkspaceStateAsync();
                await LoadDemoProjectAsync();
            }
        }
        else
        {
            if (force || wasDemoPath || HasDemoWorkspace || projectChanged)
            {
                await ResetWorkspaceStateAsync();
            }

            if (ProjectId.HasValue && (force || pathChanged || projectChanged))
            {
                await ResumeProjectAsync(ProjectId.Value);
            }
            else if (!string.IsNullOrWhiteSpace(Handoff) && (force || pathChanged || handoffChanged))
            {
                await ImportHandoffAsync(Handoff);
            }
        }

        _lastWorkspacePath = path;
        _lastHandoff = Handoff;
    }

    private async Task ResumeProjectAsync(Guid projectId)
    {
        try
        {
            var project = await Api.GetProjectDetailAsync(projectId);
            _draftProjectId = project.ProjectId;
            _title = project.Title;
            _parts.Clear();
            foreach (var part in project.Parts)
            {
                _parts.Add(CreatePartViewModel(part));
            }

            _selectedPartIndex = _parts.Count > 0 ? 0 : 0;
            _estimate = null;
            _formalQuote = null;
            _order = null;
            _payment = null;
            _liveNotifications.Insert(0, Text($"Resumed {project.ProjectNumber}.", $"เปิดโปรเจกต์ {project.ProjectNumber} ต่อแล้ว"));
            if (_parts.Count > 0)
            {
                await CalculateAsync();
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = Text("We could not resume this project. Please try again.", "ไม่สามารถเปิดโปรเจกต์นี้ต่อได้ กรุณาลองใหม่");
        }
    }

    private string CurrentWorkspacePath() => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');

    private static bool IsDemoPath(string path) => path.Equals("/demo", StringComparison.OrdinalIgnoreCase);

    private bool HasDemoWorkspace =>
        _parts.Any(part => part.UploadId.StartsWith("demo-upload-", StringComparison.OrdinalIgnoreCase))
        || _title.Contains("sample bracket demo", StringComparison.OrdinalIgnoreCase);

    private async Task ResetWorkspaceStateAsync()
    {
        _quoteSessionId = Guid.NewGuid().ToString("N");
        await ClearRetainedBrowserUploadFilesAsync("workspace-reset");
        _parts.Clear();
        _estimate = null;
        _formalQuote = null;
        _order = null;
        _payment = null;
        _draftProjectId = null;
        _liveNotifications.Clear();
        _leadTimeCode = NormalizeQuoteDefaultLeadTime(_defaultLeadTimeCode);
        _title = "Untitled quote";
        _selectedPartIndex = 0;
        _centerMode = "model";
        _isPartsDrawerOpen = false;
        _error = null;
    }

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        _estimate = null;
        _formalQuote = null;
        _order = null;
        _payment = null;
        _draftProjectId = null;

        var selectedFiles = args.GetMultipleFiles(12).ToArray();
        var capturedFiles = selectedFiles
            .Select(file => new CapturedFile(Guid.NewGuid().ToString("N"), file))
            .ToArray();

        await Js.InvokeVoidAsync(
            "quoteEngineUploads.captureFiles",
            UploadInputId,
            capturedFiles.Select(file => new
            {
                clientFileId = file.ClientFileId,
                fileName = file.File.Name,
                fileSizeBytes = file.File.Size
            }));

        await ProcessUploadCandidatesAsync(capturedFiles.Select(file => new UploadCandidate(
            file.ClientFileId,
            file.File.Name,
            string.IsNullOrWhiteSpace(file.File.ContentType) ? "application/octet-stream" : file.File.ContentType,
            file.File.Size)));
    }

    [JSInvokable]
    public async Task HandleDroppedFilesAsync(DroppedBrowserFile[] files)
    {
        if (IsDemoMode)
        {
            return;
        }

        _error = null;
        _estimate = null;
        _formalQuote = null;
        _order = null;
        _payment = null;
        _draftProjectId = null;

        await ProcessUploadCandidatesAsync(files.Select(file => new UploadCandidate(
            file.ClientFileId,
            file.FileName,
            file.ContentType,
            file.FileSizeBytes)));
    }

    private async Task ProcessUploadCandidatesAsync(IEnumerable<UploadCandidate> candidates)
    {
        foreach (var candidate in candidates)
        {
            if (!ValidateUploadCandidate(candidate))
            {
                continue;
            }

            var part = new QuotePartViewModel
            {
                FileName = candidate.FileName,
                Status = "Uploading",
                ClientFileId = candidate.ClientFileId
            };
            ApplyDefaultRouting(part, candidate.FileName);
            _parts.Add(part);
            _selectedPartIndex = _parts.Count - 1;
            await InvokeAsync(StateHasChanged);
            try
            {
                var initiation = await Api.InitiateUploadAsync(
                    _quoteSessionId,
                    candidate.FileName,
                    candidate.ContentType,
                    candidate.FileSizeBytes);
                part.UploadId = initiation.UploadId;
                await EnsureNotificationConnectionAsync();
                await _notificationConnection!.InvokeAsync("JoinFileGroup", initiation.StoragePath);

                await Js.InvokeVoidAsync(
                    "quoteEngineUploads.uploadFile",
                    candidate.ClientFileId,
                    initiation.ProxyUploadUrl,
                    candidate.ContentType);

                var upload = await Api.CompleteUploadAsync(initiation.UploadId);
                part.PartId = Guid.NewGuid();
                part.FileId = upload.FileId;
                part.UploadId = upload.UploadId;
                part.StoragePath = upload.StoragePath;
                part.Status = "Processing";
                var completedLocally = await TryCompleteBrowserPrimaryViewerLocallyAsync(part);
                if (!completedLocally)
                {
                    var status = await Api.GetAnalysisStatusAsync(upload.UploadId);
                    part.Status = status.Status;
                    part.VolumeCc = status.VolumeCc;
                    part.SurfaceAreaCm2 = status.SurfaceAreaCm2;
                    part.Findings = status.Findings;
                    ApplyAnalysisStatus(part, status);
                    await TryApplyLocalViewerUrlAsync(part);
                }

                if (!ShouldRetainBrowserUploadFile(part))
                    await ScheduleBrowserUploadFileCleanupAsync(candidate.ClientFileId);
                await RegisterCompletedUploadWithAgentAsync(part, candidate);
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                part.Status = "Upload failed";
                _error = ex.Message;
                await ScheduleBrowserUploadFileCleanupAsync(candidate.ClientFileId);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool ValidateUploadCandidate(UploadCandidate candidate)
    {
        if (!QuoteUploadConstraints.IsSupportedAttachmentFileName(candidate.FileName))
        {
            _error = $"{candidate.FileName} is not a supported quote attachment. Upload {QuoteUploadConstraints.SupportedAttachmentExtensionLabel}.";
            return false;
        }

        if (candidate.FileSizeBytes < 1)
        {
            _error = $"{candidate.FileName} is empty.";
            return false;
        }

        if (candidate.FileSizeBytes > QuoteUploadConstraints.MaxFileSizeBytes)
        {
            _error = $"{candidate.FileName} is larger than {QuoteUploadConstraints.MaxFileSizeMegabytes} MB.";
            return false;
        }

        return true;
    }

    private async Task RegisterCompletedUploadWithAgentAsync(QuotePartViewModel part, UploadCandidate candidate)
    {
        if (AgentSessionId == Guid.Empty)
        {
            return;
        }

        try
        {
            var state = await Api.RegisterAgentAttachmentsAsync(
                AgentSessionId,
                new QuoteAgentAttachmentRegisterRequest
                {
                    Message = $"Customer uploaded {candidate.FileName}.",
                    Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en",
                    Attachments =
                    [
                        new QuoteAgentAttachmentDto
                        {
                            FileName = candidate.FileName,
                            ContentType = candidate.ContentType,
                            FileSizeBytes = candidate.FileSizeBytes,
                            Kind = InferAgentAttachmentKind(candidate.FileName, candidate.ContentType),
                            UploadId = part.UploadId,
                            StoragePath = part.StoragePath,
                            Url = part.GlbUrl ?? part.ThumbnailUrl,
                            SatisfiesGeometryGate = QuoteUploadConstraints.IsSupportedCadFileName(candidate.FileName)
                        }
                    ]
                });

            if (state.Artifacts.Count > 0)
            {
                _liveNotifications.Insert(0, Text("Make Studio agent registered the uploaded file.", "เอเจนต์ Make Studio รับไฟล์ที่อัปโหลดแล้ว"));
            }
        }
        catch (Exception ex) when (ex is QuoteEngineApiException or HttpRequestException or InvalidOperationException)
        {
            _liveNotifications.Insert(0, Text("Upload succeeded. Agent context will refresh when you continue chatting.", "อัปโหลดสำเร็จ บริบทเอเจนต์จะอัปเดตเมื่อคุณสนทนาต่อ"));
        }
    }

    private static string InferAgentAttachmentKind(string fileName, string contentType)
    {
        var extension = Path.GetExtension(fileName).TrimStart('.');
        if (QuoteUploadConstraints.IsSupportedCadFileName(fileName))
        {
            return "cad";
        }

        if (QuoteUploadConstraints.SupplementalDocumentExtensions.Any(item =>
            item.Equals(extension, StringComparison.OrdinalIgnoreCase)))
        {
            return "drawing";
        }

        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
            QuoteUploadConstraints.SupplementalImageExtensions.Any(item =>
                item.Equals(extension, StringComparison.OrdinalIgnoreCase)))
        {
            return "photo";
        }

        return "supplemental";
    }

    private async Task ImportHandoffAsync(string encodedHandoff)
    {
        try
        {
            var request = new QuoteUploadHandoffRequest { HandoffToken = encodedHandoff };
            var response = await Api.ImportHandoffAsync(request);
            _quoteSessionId = string.IsNullOrWhiteSpace(response.QuoteSessionId) ? _quoteSessionId : response.QuoteSessionId;
            await ClearRetainedBrowserUploadFilesAsync("handoff-import");
            _parts.Clear();
            foreach (var part in response.Parts)
            {
                _parts.Add(new QuotePartViewModel
                {
                    PartId = part.PartId,
                    FileId = part.FileId,
                    UploadId = part.UploadId,
                    FileName = part.FileName,
                    Status = part.Status,
                    StoragePath = part.StoragePath,
                    GlbUrl = part.ViewerGlbUrl,
                    ViewerStoragePath = part.ViewerStoragePath,
                    ViewerFileExtension = NormalizeViewerFileExtension(part.ViewerFileExtension, part.ViewerStoragePath ?? part.StoragePath),
                    ThumbnailUrl = part.ThumbnailUrl,
                    VolumeCc = part.VolumeCc,
                    SurfaceAreaCm2 = part.SurfaceAreaCm2,
                    Findings = part.Findings
                });
            }

            if (_parts.Count > 0)
            {
                _selectedPartIndex = 0;
                await CalculateAsync();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = Text("We could not import the files from the website upload. Please drop them here again.", "เราไม่สามารถนำเข้าไฟล์จากการอัปโหลดบนเว็บไซต์ได้ กรุณาลากไฟล์มาวางอีกครั้ง");
        }
    }

