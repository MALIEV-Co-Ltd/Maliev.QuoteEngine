@page "/quotes/new"
@page "/projects/new"
@page "/demo"
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject QuoteEngineApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>New manufacturing quote - MALIEV</PageTitle>

<div class="@WorkspaceRootClass">
    <div id="@UploadContainerId">
        <InputFile id="@UploadInputId" OnChange="HandleFilesAsync" multiple accept="@QuoteUploadConstraints.SupportedCadAccept" />
    </div>

    <div class="qe-pn-body">
        @if (IsWorkspaceReady)
        {
            <aside class="qe-plp-root">
                <div class="qe-plp-page-header">
                    <input type="text" value="@_title" @oninput="e => _title = e.Value?.ToString() ?? string.Empty" class="qe-plp-title-input" title="Project title" />
                    <button type="button" class="qe-icon-btn" title="Duplicate project" disabled="@(!_parts.Any())">
                        <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                    </button>
                </div>

                <div class="qe-plp-upload-section">
                    <button id="@CompactDropzoneId" type="button" class="qe-dropzone qe-dropzone--compact">
                        <span class="qe-dropzone-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" />
                        </span>
                        <span>@UploadCompactLabel</span>
                        <small>@UploadCompactHint</small>
                    </button>
                </div>

                <div class="qe-plp-headers">
                    <span>Parts</span>
                    <span>@_parts.Count part(s)</span>
                </div>

                <div class="qe-plp-list">
                    @foreach (var part in _parts)
                    {
                        var index = _parts.IndexOf(part);
                        var total = _estimate?.Lines.FirstOrDefault(line => line.PartId == part.PartId)?.LineTotal;
                        <button type="button" class="qe-plp-part @(index == _selectedPartIndex ? "qe-plp-part--selected" : "")" @onclick="@(() => SelectPart(index))">
                            <span class="qe-plp-thumb">
                                @if (part.Status == "Uploading")
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                }
                                else
                                {
                                    <img src="/images/generated/sample-part.svg" alt="" />
                                }
                            </span>
                            <span class="qe-plp-info">
                                <strong>@part.FileName</strong>
                                <small>@part.VolumeCc.ToString("0.##") cc · @part.SurfaceAreaCm2.ToString("0.##") cm²</small>
                                <span class="qe-plp-meta">
                                    <span>@ProcessName(part.ProcessId)</span>
                                    <span>x @part.Quantity</span>
                                </span>
                            </span>
                            @if (total.HasValue)
                            {
                                <span class="qe-plp-price">@total.Value.ToString("N2") THB</span>
                            }
                        </button>
                    }
                </div>

                <div class="qe-plp-footer">
                    <span>Total parts</span>
                    <strong>@_parts.Sum(part => part.Quantity) pcs</strong>
                </div>
            </aside>
        }

        <main class="qe-pn-center">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="qe-error-alert">@_error</MudAlert>
            }
            @if (_liveNotifications.Count > 0)
            {
                <div class="qe-live-notifications" role="status" aria-live="polite">
                    @foreach (var notification in _liveNotifications.Take(3))
                    {
                        <span>@notification</span>
                    }
                </div>
            }

            @if (SelectedPart is null)
            {
                <section class="qe-empty-state">
                    <div class="qe-empty-state-grid">
                        <button id="@HeroDropzoneId" type="button" class="qe-dropzone qe-dropzone--hero">
                            <span class="qe-dropzone-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" />
                            </span>
                            <span>@UploadHeroLabel</span>
                            <small>@UploadHeroHint</small>
                        </button>
                        @if (!IsDemoMode)
                        {
                            <article class="qe-demo-sample-card">
                                <span class="qe-zone-label">Demo sample</span>
                                <strong class="qe-demo-sample-title">
                                    <span>Try the Quote Engine with a</span>
                                    <img src="/images/logo.svg" alt="MALIEV" />
                                    <span>sample file.</span>
                                </strong>
                                <p>Load a known sample part, review DFM feedback, adjust material and lead time, and test pricing without uploading your own CAD.</p>
                                <button type="button" class="qe-secondary-btn" @onclick="LoadSampleFileAsync">Use sample file</button>
                            </article>
                        }
                    </div>
                </section>
            }
            else
            {
                var _sp = SelectedPart!;
                <div class="qe-pn-detail-row">
                    <section class="qe-pdc-root">
                        <header class="qe-pdc-header">
                            <div class="qe-pdc-header-left">
                                <div class="qe-pdc-header-name-row">
                                    <strong title="@_sp.FileName">@Path.GetFileNameWithoutExtension(_sp.FileName)</strong>
                                    <span class="qe-status-pill qe-status--@StatusClass(_sp)">@_sp.Status.ToUpperInvariant()</span>
                                </div>
                                <div class="qe-pdc-header-subline">
                                    Uploaded just now · @_sp.FileName · @_sp.VolumeCc.ToString("0.##") cc
                                </div>
                            </div>
                            <div class="qe-pdc-tabs">
                                <button type="button" class="qe-pdc-tab qe-pdc-tab--active">
                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                    3D Model
                                </button>
                                <button type="button" class="qe-pdc-tab">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                                    Drawing
                                </button>
                                <button type="button" class="qe-pdc-tab">
                                    <MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" />
                                    DFM
                                    <span>@_sp.Findings.Count</span>
                                </button>
                            </div>
                        </header>

                        @* _sp is non-null: outer @if(SelectedPart is null)/else guarantees it *@
                        <div class="qe-pdc-container">
                            @* 3D viewer — top portion of center pane *@
                            <div class="qe-center-viewer">
                                <QePartViewer GlbUrl="@_sp.GlbUrl"
                                              IsDarkMode="@IsDarkMode"
                                              OnViewerError="@(msg => Console.Error.WriteLine($"Viewer error: {msg}"))" />
                            </div>

                            @* Tab switcher — DFM / Bulk *@
                            <div class="qe-center-tabs">
                                <button class="@(_centerTab == "dfm" ? "qe-tab-active" : "")"
                                        @onclick='() => _centerTab = "dfm"'>DFM Analysis</button>
                                <button class="@(_centerTab == "bulk" ? "qe-tab-active" : "")"
                                        @onclick='() => _centerTab = "bulk"'>All Parts</button>
                            </div>

                            @if (_centerTab == "dfm")
                            {
                                <QeDfmTab IsManifold="@_sp.IsManifold"
                                          NonManifoldReason="@_sp.NonManifoldReason"
                                          FdmReport="@_sp.FdmDfmReport"
                                          SlaReport="@_sp.SlaDfmReport"
                                          CncReport="@_sp.CncDfmReport" />
                            }
                            else
                            {
                                <QeBulkTable Parts="@_parts"
                                             Processes="@(_reference?.Processes ?? [])"
                                             Materials="@(_reference?.Materials ?? [])"
                                             OnPartChanged="@(p => StateHasChanged())"
                                             OnSelectPart="@(p => { _selectedPartIndex = _parts.IndexOf(p); _centerTab = "dfm"; })"
                                             OnAddFilesRequested="@OpenFilePickerAsync" />
                            }
                        </div>
                        <footer class="qe-pdc-footer">
                            <span class="qe-chip qe-chip--process">@ProcessName(_sp.ProcessId)</span>
                            <span class="qe-chip">@MaterialName(_sp.MaterialId)</span>
                            <span class="qe-footer-sep"></span>
                            <span>@_sp.Quantity pcs</span>
                            <strong>@PartTotal(_sp).ToString("N2") THB</strong>
                        </footer>
                    </section>

                    <aside class="qe-pcs-sidebar">
                        <header class="qe-pcs-header">
                            <span>Configure</span>
                            <strong title="@_sp.FileName">@_sp.FileName</strong>
                        </header>
                        <div class="qe-pcs-scroll">
                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Manufacturing Process</span>
                                </div>
                                <div class="qe-pcs-process-grid">
                                    @foreach (var process in _reference?.Processes ?? [])
                                    {
                                        var active = _sp.ProcessId == process.Id;
                                        <button type="button" class="qe-pcs-process-card @(active ? "qe-pcs-process-card--active" : "")" @onclick="@(() => SelectProcess(_sp, process))">
                                            <MudIcon Icon="@ProcessIcon(process.Id)" Size="Size.Small" />
                                            <strong>@process.Name</strong>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                                            }
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Material</span>
                                    <small>@MaterialsFor(_sp.ProcessId).Count() options</small>
                                </div>
                                <div class="qe-pcs-cards">
                                    @foreach (var material in MaterialsFor(_sp.ProcessId))
                                    {
                                        var active = _sp.MaterialId == material.Id;
                                        <button type="button" class="qe-pcs-mat-card @(active ? "qe-pcs-mat-card--active" : "")" @onclick="@(() => SelectMaterial(_sp, material))">
                                            <span class="qe-mat-swatch" style="background:@MaterialSwatch(material.Id)"></span>
                                            <span>
                                                <strong>@material.Name</strong>
                                                <small>@material.Grade · @material.Finish</small>
                                            </span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                                            }
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="qe-pcs-section">
                                <div class="qe-pcs-section-header">
                                    <span>Quantity and review</span>
                                </div>
                                <div class="qe-pcs-qty-row">
                                    <label>
                                        Quantity
                                        <input type="number" min="1" @bind="_sp.Quantity" @bind:after="ClearEstimate" />
                                    </label>
                                    <label class="qe-check-btn @(_sp.DfmAcknowledged ? "checked" : "")">
                                        <input type="checkbox" @bind="_sp.DfmAcknowledged" />
                                        DFM reviewed
                                    </label>
                                </div>
                            </section>
                        </div>
                    </aside>
                </div>
            }
        </main>
    </div>

    @if (IsWorkspaceReady)
    {
        <footer class="qe-qsb-root">
            <div class="qe-qsb-zone qe-qsb-lead">
                <span class="qe-zone-label">
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                    Lead Time
                </span>
                <div class="qe-qsb-lead-options">
                    @foreach (var leadTime in _reference?.LeadTimes ?? [])
                    {
                        var active = _leadTimeCode == leadTime.Code;
                        <button type="button" class="qe-qsb-lead-btn @(active ? "qe-qsb-lead-btn--active" : "")" @onclick="@(() => SelectLeadTime(leadTime.Code))">
                            <span>
                                <strong>@leadTime.Name</strong>
                                <small>@leadTime.BusinessDays business days</small>
                            </span>
                            <em>@LeadTimeBadge(leadTime)</em>
                        </button>
                    }
                </div>
            </div>
            <div class="qe-qsb-divider"></div>
            <div class="qe-qsb-zone qe-qsb-total">
                <span class="qe-zone-label">Quote Total</span>
                <strong>@(_estimate is null ? "—" : $"{_estimate.Total:N2} {_estimate.Currency}")</strong>
                <div class="qe-qsb-actions">
                    <button type="button" class="qe-secondary-btn" disabled="@(!_parts.Any())" @onclick="CalculateAsync">Estimate</button>
                    <button type="button" class="qe-secondary-btn" disabled="@(!CanRequestFormalQuote)" @onclick="SubmitQuoteAsync">PDF</button>
                    <button type="button" class="qe-primary-btn" disabled="@(!CanRequestFormalQuote)" @onclick="SubmitQuoteAsync">
                        @QuoteButtonLabel
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </button>
                </div>
                @if (_formalQuote is not null)
                {
                    <div class="qe-qsb-result">
                        <span>@_formalQuote.QuoteNumber</span>
                        <button type="button" @onclick="CreateOrderAsync">Create order</button>
                    </div>
                }
                @if (_order is not null)
                {
                    <div class="qe-qsb-result">
                        <span>@_order.OrderNumber</span>
                        <strong>@_order.Status</strong>
                    </div>
                }
            </div>
        </footer>
    }
</div>

@code {
    private const string UploadContainerId = "quote-upload-container";
    private const string UploadInputId = "quote-cad-files";
    private const string CompactDropzoneId = "quote-compact-dropzone";
    private const string HeroDropzoneId = "quote-hero-dropzone";
    private string _quoteSessionId = Guid.NewGuid().ToString("N");
    private readonly List<QuotePartViewModel> _parts = [];
    private QuoteReferenceDataResponse? _reference;
    private QuoteAuthStatusResponse _authStatus = new(false, null, null);
    private QuoteEstimateResponse? _estimate;
    private GenerateFormalQuoteResponse? _formalQuote;
    private CreateManufacturingOrderResponse? _order;
    private HubConnection? _notificationConnection;
    private DotNetObjectReference<QuoteWorkspace>? _dotNetRef;
    private readonly List<string> _liveNotifications = [];
    private string? _registeredDropzoneId;
    private string _leadTimeCode = "STANDARD";
    private string _title = "Untitled quote";
    private int _selectedPartIndex;
    private string _centerTab = "dfm";
    private string? _error;
    private bool IsDarkMode => false;  // wire to ThemeService if added later

    private bool IsDemoMode => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/demo", StringComparison.OrdinalIgnoreCase);
    private bool IsSignedIn => _authStatus.IsSignedIn;
    private bool IsWorkspaceReady => _parts.Count > 0;
    private string WorkspaceRootClass => IsWorkspaceReady ? "qe-pn-root is-workspace-ready" : "qe-pn-root is-launch-screen";
    private bool CanRequestFormalQuote => _estimate is not null && IsSignedIn && !IsDemoMode;
    [SupplyParameterFromQuery(Name = "handoff")]
    public string? Handoff { get; set; }

    private string UploadCompactLabel => IsDemoMode ? "Demo sample only" : "Drop CAD files to quote";
    private string UploadCompactHint => IsDemoMode ? "MALIEV-owned sample file" : IsSignedIn ? "Customer-owned upload storage" : "Saved temporarily";
    private string UploadHeroLabel => IsDemoMode ? "Demo sample is ready" : "Drop files here or click to upload";
    private string UploadHeroHint => IsDemoMode
        ? "Demo mode cannot create projects, formal quotes, orders, uploads, or history"
        : $"{QuoteUploadConstraints.SupportedCadExtensionLabel} · max {QuoteUploadConstraints.MaxFileSizeMegabytes} MB per file";
    private string QuoteButtonLabel => IsDemoMode ? "Demo only" : IsSignedIn ? "Quote" : "Sign in to quote";

    private QuotePartViewModel? SelectedPart => _parts.Count == 0 ? null : _parts[Math.Min(_selectedPartIndex, _parts.Count - 1)];

    private QuotePartViewModel? FindPartByStoragePath(string storagePath)
        => _parts.FirstOrDefault(p =>
            string.Equals(p.StoragePath, storagePath, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _reference = await Api.GetReferenceDataAsync();
        _authStatus = await Api.GetAuthStatusAsync();

        if (IsDemoMode)
        {
            await LoadDemoProjectAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Handoff))
        {
            await ImportHandoffAsync(Handoff);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        await RegisterActiveDropzoneAsync();
    }

    private async Task RegisterActiveDropzoneAsync()
    {
        if (_dotNetRef is null)
        {
            return;
        }

        var activeDropzoneId = IsWorkspaceReady ? CompactDropzoneId : HeroDropzoneId;
        if (string.Equals(_registeredDropzoneId, activeDropzoneId, StringComparison.Ordinal))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_registeredDropzoneId))
        {
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterDropzone", _registeredDropzoneId);
        }

        await Js.InvokeVoidAsync("quoteEngineUploads.registerDropzone", activeDropzoneId, UploadInputId, _dotNetRef);
        _registeredDropzoneId = activeDropzoneId;
    }

    private async Task OpenFilePickerAsync()
    {
        if (IsDemoMode)
        {
            return;
        }

        await Js.InvokeVoidAsync("quoteEngineUploads.openFilePicker", UploadInputId);
    }

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        _estimate = null;
        _formalQuote = null;
        _order = null;

        var selectedFiles = args.GetMultipleFiles(12).ToArray();
        var capturedFiles = selectedFiles
            .Select(file => new CapturedFile(Guid.NewGuid().ToString("N"), file))
            .ToArray();

        await Js.InvokeVoidAsync(
            "quoteEngineUploads.captureFiles",
            UploadInputId,
            capturedFiles.Select(file => new
            {
                clientFileId = file.ClientFileId,
                fileName = file.File.Name,
                fileSizeBytes = file.File.Size
            }));

        await ProcessUploadCandidatesAsync(capturedFiles.Select(file => new UploadCandidate(
            file.ClientFileId,
            file.File.Name,
            string.IsNullOrWhiteSpace(file.File.ContentType) ? "application/octet-stream" : file.File.ContentType,
            file.File.Size)));
    }

    [JSInvokable]
    public async Task HandleDroppedFilesAsync(DroppedBrowserFile[] files)
    {
        if (IsDemoMode)
        {
            return;
        }

        _error = null;
        _estimate = null;
        _formalQuote = null;
        _order = null;

        await ProcessUploadCandidatesAsync(files.Select(file => new UploadCandidate(
            file.ClientFileId,
            file.FileName,
            file.ContentType,
            file.FileSizeBytes)));
    }

    private async Task ProcessUploadCandidatesAsync(IEnumerable<UploadCandidate> candidates)
    {
        foreach (var candidate in candidates)
        {
            if (!ValidateUploadCandidate(candidate))
            {
                continue;
            }

            var part = new QuotePartViewModel { FileName = candidate.FileName, Status = "Uploading" };
            ApplyDefaultRouting(part, candidate.FileName);
            _parts.Add(part);
            _selectedPartIndex = _parts.Count - 1;
            try
            {
                var initiation = await Api.InitiateUploadAsync(
                    _quoteSessionId,
                    candidate.FileName,
                    candidate.ContentType,
                    candidate.FileSizeBytes);
                part.UploadId = initiation.UploadId;
                await EnsureNotificationConnectionAsync();
                await _notificationConnection!.InvokeAsync("JoinFileGroup", initiation.StoragePath);

                await Js.InvokeVoidAsync(
                    "quoteEngineUploads.uploadFile",
                    candidate.ClientFileId,
                    initiation.ProxyUploadUrl,
                    candidate.ContentType);

                var upload = await Api.CompleteUploadAsync(initiation.UploadId);
                var status = await Api.GetAnalysisStatusAsync(upload.UploadId);
                part.PartId = Guid.NewGuid();
                part.FileId = upload.FileId;
                part.UploadId = upload.UploadId;
                part.StoragePath = upload.StoragePath;
                part.Status = status.Status;
                part.VolumeCc = status.VolumeCc;
                part.SurfaceAreaCm2 = status.SurfaceAreaCm2;
                part.Findings = status.Findings;
            }
            catch (Exception ex)
            {
                part.Status = "Upload failed";
                _error = ex.Message;
            }
        }
    }

    private bool ValidateUploadCandidate(UploadCandidate candidate)
    {
        if (!QuoteUploadConstraints.IsSupportedCadFileName(candidate.FileName))
        {
            _error = $"{candidate.FileName} is not a supported CAD format. Upload {QuoteUploadConstraints.SupportedCadExtensionLabel}.";
            return false;
        }

        if (candidate.FileSizeBytes < 1)
        {
            _error = $"{candidate.FileName} is empty.";
            return false;
        }

        if (candidate.FileSizeBytes > QuoteUploadConstraints.MaxFileSizeBytes)
        {
            _error = $"{candidate.FileName} is larger than {QuoteUploadConstraints.MaxFileSizeMegabytes} MB.";
            return false;
        }

        return true;
    }

    private async Task ImportHandoffAsync(string encodedHandoff)
    {
        try
        {
            var json = Encoding.UTF8.GetString(DecodeBase64Url(encodedHandoff));
            var request = JsonSerializer.Deserialize<QuoteUploadHandoffRequest>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (request is null || request.Files.Count == 0)
            {
                return;
            }

            _quoteSessionId = string.IsNullOrWhiteSpace(request.QuoteSessionId) ? _quoteSessionId : request.QuoteSessionId;
            var response = await Api.ImportHandoffAsync(request);
            _parts.Clear();
            foreach (var part in response.Parts)
            {
                _parts.Add(new QuotePartViewModel
                {
                    PartId = part.PartId,
                    FileId = part.FileId,
                    UploadId = part.UploadId,
                    FileName = part.FileName,
                    Status = part.Status,
                    VolumeCc = part.VolumeCc,
                    SurfaceAreaCm2 = part.SurfaceAreaCm2,
                    Findings = part.Findings
                });
            }

            if (_parts.Count > 0)
            {
                _selectedPartIndex = 0;
                await CalculateAsync();
            }
        }
        catch (Exception ex) when (ex is FormatException or JsonException or InvalidOperationException)
        {
            _error = "We could not import the files from the website upload. Please drop them here again.";
        }
    }

    private void SelectPart(int index)
    {
        _selectedPartIndex = Math.Clamp(index, 0, Math.Max(_parts.Count - 1, 0));
    }

    private void SelectProcess(QuotePartViewModel part, ProcessOptionDto process)
    {
        part.ProcessId = process.Id;
        var firstMaterial = MaterialsFor(process.Id).FirstOrDefault();
        if (firstMaterial is not null)
        {
            part.MaterialId = firstMaterial.Id;
        }

        ClearEstimate();
    }

    private void SelectMaterial(QuotePartViewModel part, MaterialOptionDto material)
    {
        part.MaterialId = material.Id;
        ClearEstimate();
    }

    private void SelectLeadTime(string code)
    {
        _leadTimeCode = code;
        ClearEstimate();
    }

    private void ClearEstimate()
    {
        _estimate = null;
        _formalQuote = null;
        _order = null;
    }

    private async Task CalculateAsync()
    {
        _estimate = await Api.EstimateAsync(new QuoteEstimateRequest
        {
            QuoteSessionId = _quoteSessionId,
            LeadTimeCode = _leadTimeCode,
            Parts = _parts.Select(x => x.ToDraft()).ToList()
        });
    }

    private async Task SubmitQuoteAsync()
    {
        if (!IsSignedIn || IsDemoMode)
        {
            Navigation.NavigateTo("/auth/sign-in?returnUrl=/projects/new");
            return;
        }

        var draft = await Api.CreateDraftProjectAsync(new CreateDraftProjectRequest(_quoteSessionId, _parts.Select(x => x.ToDraft()).ToArray(), "Customer quote engine prototype"));
        _formalQuote = await Api.GenerateFormalQuoteAsync(new GenerateFormalQuoteRequest(draft.ProjectId, _quoteSessionId, _parts.Select(x => x.ToDraft()).ToArray(), "Formal quote requested by customer."));
    }

    private async Task CreateOrderAsync()
    {
        if (_formalQuote is null)
        {
            return;
        }

        if (!IsSignedIn || IsDemoMode)
        {
            Navigation.NavigateTo("/auth/sign-in?returnUrl=/projects/new");
            return;
        }

        _order = await Api.CreateOrderAsync(new CreateManufacturingOrderRequest(_formalQuote.QuoteId, string.Empty, "Customer accepted quote."));
    }

    private async Task EnsureNotificationConnectionAsync()
    {
        if (_notificationConnection is null)
        {
            _notificationConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/quote-notifications"))
                .WithAutomaticReconnect()
                .Build();

            _notificationConnection.On<QuoteAnalysisStatusResponse>("FileAnalysisCompleted", status =>
            {
                _ = InvokeAsync(() =>
                {
                    var fileName = Path.GetFileName(status.StoragePath);
                    _liveNotifications.Insert(0, $"Analysis complete for {fileName}");

                    var part = _parts.FirstOrDefault(candidate => string.Equals(candidate.UploadId, status.UploadId, StringComparison.OrdinalIgnoreCase));
                    if (part is not null)
                    {
                        part.Status = status.Status;
                        part.VolumeCc = status.VolumeCc;
                        part.SurfaceAreaCm2 = status.SurfaceAreaCm2;
                        part.Findings = status.Findings;
                    }

                    StateHasChanged();
                });
            });

            _notificationConnection.On<QeGlbReadyPayload>("GlbReady", async payload =>
            {
                var part = FindPartByStoragePath(payload.StoragePath);
                if (part is null) return;

                part.GlbUrl = payload.Failed ? null : payload.GlbUrl;
                part.ThumbnailUrl = payload.ThumbnailUrl;
                part.IsManifold = payload.IsManifold;
                part.BodyCount = payload.BodyCount;
                if (payload.Failed)
                    part.Status = "Failed";
                else if (part.Status is "Processing" or "WaitingForUpload")
                    part.Status = "GlbReady";

                await InvokeAsync(StateHasChanged);
            });

            _notificationConnection.On<QeDfmAnalysisReadyPayload>("DfmAnalysisReady", async payload =>
            {
                var part = FindPartByStoragePath(payload.StoragePath);
                if (part is null) return;

                part.FdmDfmReport = payload.FdmReport;
                part.SlaDfmReport = payload.SlaReport;
                part.CncDfmReport = payload.CncReport;
                part.OverlayGlbUrls = payload.OverlayGlbUrls;
                part.IsManifold = payload.IsManifold;
                part.NonManifoldReason = payload.NonManifoldReason;
                part.Status = "DfmAnalysisReady";

                await InvokeAsync(StateHasChanged);
            });
        }

        if (_notificationConnection.State == HubConnectionState.Disconnected)
        {
            await _notificationConnection.StartAsync();
        }
    }

    private async Task LoadDemoProjectAsync()
    {
        var demo = await Api.GetDemoProjectAsync();
        if (demo is null)
        {
            return;
        }

        _title = demo.Title;
        _parts.Clear();
        foreach (var part in demo.Parts)
        {
            _parts.Add(new QuotePartViewModel
            {
                PartId = part.PartId,
                FileId = part.FileId,
                UploadId = part.UploadId,
                FileName = part.FileName,
                ProcessId = part.ProcessId,
                MaterialId = part.MaterialId,
                Quantity = part.Quantity,
                VolumeCc = part.VolumeCc,
                SurfaceAreaCm2 = part.SurfaceAreaCm2,
                DfmAcknowledged = part.DfmAcknowledged,
                Status = "Analyzed",
                Findings =
                [
                    new("Info", "DEMO_SAMPLE", demo.Notice),
                    new("Info", "DFM_SAMPLE", "Sample geometry is suitable for demo pricing.")
                ]
            });
        }

        if (_parts.Count > 0)
        {
            _selectedPartIndex = 0;
            await CalculateAsync();
        }
    }

    private async Task LoadSampleFileAsync()
    {
        _error = null;
        await LoadDemoProjectAsync();
    }

    private void ApplyDefaultRouting(QuotePartViewModel part, string fileName)
    {
        var extension = Path.GetExtension(fileName).TrimStart('.').ToLowerInvariant();
        var process = _reference?.Processes.FirstOrDefault(candidate =>
            candidate.SupportedFileTypes.Any(type => type.Equals(extension, StringComparison.OrdinalIgnoreCase)));
        if (process is null)
        {
            return;
        }

        part.ProcessId = process.Id;
        var material = MaterialsFor(process.Id).FirstOrDefault();
        if (material is not null)
        {
            part.MaterialId = material.Id;
        }
    }

    private IEnumerable<MaterialOptionDto> MaterialsFor(string processId)
    {
        return (_reference?.Materials ?? []).Where(x => x.ProcessId == processId);
    }

    private decimal PartTotal(QuotePartViewModel part)
    {
        return _estimate?.Lines.FirstOrDefault(line => line.PartId == part.PartId)?.LineTotal ?? 0m;
    }

    private string ProcessName(string processId)
    {
        return _reference?.Processes.FirstOrDefault(process => process.Id == processId)?.Name ?? processId;
    }

    private string MaterialName(string materialId)
    {
        return _reference?.Materials.FirstOrDefault(material => material.Id == materialId)?.Name ?? materialId;
    }

    private static string ProcessIcon(string processId) => processId switch
    {
        "cnc" => Icons.Material.Outlined.PrecisionManufacturing,
        "sla" => Icons.Material.Outlined.Science,
        _ => Icons.Material.Outlined.ViewInAr
    };

    private static string MaterialSwatch(string materialId) => materialId switch
    {
        "pla-black" => "linear-gradient(135deg, #222 0%, #555 100%)",
        "petg-clear" => "linear-gradient(135deg, #d9eef2 0%, #ffffff 100%)",
        "aluminum-6061" => "linear-gradient(135deg, #b9c2c5 0%, #f4f6f7 48%, #8d989d 100%)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };

    private static string StatusClass(QuotePartViewModel part) => part.Status switch
    {
        "Analyzed" => "ok",
        "Upload failed" => "error",
        "Uploading" => "warn",
        _ => "muted"
    };

    private static string LeadTimeBadge(LeadTimeOptionDto leadTime) => leadTime.PriceMultiplier switch
    {
        < 1m => $"-{Math.Round((1m - leadTime.PriceMultiplier) * 100m)}%",
        > 1m => $"+{Math.Round((leadTime.PriceMultiplier - 1m) * 100m)}%",
        _ => "base"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterDropzone", CompactDropzoneId);
            await Js.InvokeVoidAsync("quoteEngineUploads.unregisterDropzone", HeroDropzoneId);
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
        if (_notificationConnection is not null)
        {
            await _notificationConnection.DisposeAsync();
        }
    }

    private sealed record CapturedFile(string ClientFileId, IBrowserFile File);

    private sealed record UploadCandidate(string ClientFileId, string FileName, string ContentType, long FileSizeBytes);

    public sealed class DroppedBrowserFile
    {
        public string ClientFileId { get; set; } = string.Empty;

        public string FileName { get; set; } = string.Empty;

        public string ContentType { get; set; } = "application/octet-stream";

        public long FileSizeBytes { get; set; }
    }

    private static byte[] DecodeBase64Url(string value)
    {
        var padded = value.Replace('-', '+').Replace('_', '/');
        padded = padded.PadRight(padded.Length + (4 - padded.Length % 4) % 4, '=');
        return Convert.FromBase64String(padded);
    }
