    private async Task SubmitQuoteAsync()
    {
        if (!IsSignedIn)
        {
            Navigation.NavigateTo("/auth/sign-in?returnUrl=/quote/new");
            return;
        }

        if (!AllDfmIssuesAcknowledged)
        {
            _error = Text("Review and acknowledge DFM issues before requesting a formal quote.", "ตรวจสอบและรับทราบปัญหา DFM ก่อนขอใบเสนอราคาอย่างเป็นทางการ");
            return;
        }

        var draft = await Api.CreateDraftProjectAsync(new CreateDraftProjectRequest(
            _quoteSessionId,
            _parts.Select(x => x.ToDraft()).ToArray(),
            "Customer quote engine prototype",
            _title));
        ApplyDraftProjectIdentity(draft);
        _formalQuote = await Api.GenerateFormalQuoteAsync(new GenerateFormalQuoteRequest(_draftProjectId.GetValueOrDefault(draft.ProjectId), _quoteSessionId, _parts.Select(x => x.ToDraft()).ToArray(), "Formal quote requested by customer."));
        _order = null;
        _payment = null;
    }

    private async Task DuplicateProjectAsync()
    {
        if (!IsSignedIn)
        {
            Navigation.NavigateTo("/auth/sign-in?returnUrl=/quote/new");
            return;
        }

        if (_parts.Count == 0)
        {
            return;
        }

        if (!_draftProjectId.HasValue)
        {
            var draft = await Api.CreateDraftProjectAsync(new CreateDraftProjectRequest(
                _quoteSessionId,
                _parts.Select(x => x.ToDraft()).ToArray(),
                "Customer quote engine duplicate source.",
                _title));
            ApplyDraftProjectIdentity(draft);
        }

        if (!_draftProjectId.HasValue)
        {
            return;
        }

        var duplicate = await Api.DuplicateProjectAsync(_draftProjectId.Value, new DuplicateDraftProjectRequest($"{_title} copy"));
        await ApplyDuplicatedProjectAsync(duplicate);
        await CalculateAsync();
    }

    private async Task ApplyDuplicatedProjectAsync(DuplicateDraftProjectResponse project)
    {
        _draftProjectId = project.ProjectId;
        _title = project.Title;
        _quoteSessionId = Guid.NewGuid().ToString("N");
        await PersistAgentSessionAsync();
        await ClearRetainedBrowserUploadFilesAsync("duplicate-project");
        _parts.Clear();
        foreach (var part in project.Parts)
        {
            _parts.Add(CreatePartViewModel(part));
        }

        _selectedPartIndex = _parts.Count > 0 ? 0 : 0;
        _formalQuote = null;
        _order = null;
        _payment = null;
    }

