@page "/orders/{OrderNumber}"
@using System.Globalization
@using System.Net
@using Maliev.QuoteEngine.Shared.Account
@using Maliev.QuoteEngine.Shared.Quotes
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject QuoteEngineApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Text("Order detail - MALIEV", "รายละเอียดคำสั่งซื้อ - MALIEV")</PageTitle>

@if (_loading)
{
    <div class="empty-state">
        <p>@Text("Loading order detail...", "กำลังโหลดรายละเอียดคำสั่งซื้อ...")</p>
    </div>
}
else if (_order is null)
{
    <div class="empty-state">
        <h1>@Text("Order not found", "ไม่พบคำสั่งซื้อ")</h1>
        <p>@Text("This order is unavailable or does not belong to your account.", "คำสั่งซื้อนี้ไม่พร้อมใช้งานหรือไม่ได้อยู่ในบัญชีของคุณ")</p>
        <a class="primary-button" href="/orders">@Text("Back to orders", "กลับไปที่คำสั่งซื้อ")</a>
    </div>
}
else
{
    <main class="order-detail-shell">
        <header class="order-detail-header">
            <a class="qe-secondary-btn" href="/orders">@Text("Back to orders", "กลับไปที่คำสั่งซื้อ")</a>
            <div>
                <span class="eyebrow">@Text("Manufacturing order", "คำสั่งผลิต")</span>
                <h1>@_order.OrderNumber</h1>
                <p>@_order.Requirements</p>
            </div>
            <strong class="order-status-pill">@_order.CurrentStatus</strong>
        </header>

        <section class="order-progress-card" data-order-section="manufacturing-progress">
            <div class="order-panel-head">
                <span>@Text("Manufacturing progress", "ความคืบหน้าการผลิต")</span>
                <strong>@ManufacturingProgressPercent%</strong>
            </div>
            <div class="order-progress-track" role="progressbar" aria-valuenow="@ManufacturingProgressPercent" aria-valuemin="0" aria-valuemax="100">
                <span style="width:@ManufacturingProgressPercent%"></span>
            </div>
            @if (_order.ManufacturingMilestones.Count > 0)
            {
                <ol class="order-milestone-list">
                    @foreach (var milestone in _order.ManufacturingMilestones)
                    {
                        <li class="order-milestone order-milestone-@milestone.State">
                            <span class="order-milestone-marker"></span>
                            <div>
                                <strong>@milestone.Label</strong>
                                <p>@milestone.Description</p>
                                <small>@MilestoneTimestamp(milestone)</small>
                            </div>
                        </li>
                    }
                </ol>
            }
            <div class="order-progress-meta">
                <span>@Text("Current status", "สถานะปัจจุบัน"): <strong>@_order.CurrentStatus</strong></span>
                <span>@Text("Promised delivery", "กำหนดส่ง"): <strong>@FormatDate(_order.PromisedDeliveryDate)</strong></span>
                <span>@Text("Actual delivery", "ส่งจริง"): <strong>@FormatDate(_order.ActualDeliveryDate)</strong></span>
            </div>
        </section>

        <section class="order-detail-grid">
            <article class="order-detail-card" data-order-section="payment">
                <div class="order-panel-head">
                    <span>@Text("Payment", "การชำระเงิน")</span>
                    <strong>@_order.PaymentStatus</strong>
                </div>
                <dl>
                    <div>
                        <dt>@Text("Quoted amount", "ยอดใบเสนอราคา")</dt>
                        <dd>@FormatMoney(_order.QuotedAmount, _order.QuoteCurrency)</dd>
                    </div>
                    <div>
                        <dt>@Text("Created", "สร้างเมื่อ")</dt>
                        <dd>@FormatDate(_order.CreatedAt)</dd>
                    </div>
                    <div>
                        <dt>@Text("Updated", "อัปเดตเมื่อ")</dt>
                        <dd>@FormatDate(_order.UpdatedAt)</dd>
                    </div>
                </dl>
                <label class="order-payment-consent">
                    <input type="checkbox" @bind="_acceptedCheckoutTerms" />
                    <span>@Text("I accept the checkout terms and consent to MALIEV processing this order.", "ฉันยอมรับเงื่อนไขการชำระเงินและยินยอมให้ MALIEV ดำเนินการคำสั่งซื้อนี้")</span>
                </label>
                <div class="order-detail-actions">
                    <button type="button" class="qe-primary-btn" disabled="@(!CanPay || !_acceptedCheckoutTerms || _paymentBusy)" @onclick="InitiatePaymentAsync">
                        @(_paymentBusy ? Text("Opening payment...", "กำลังเปิดหน้าชำระเงิน...") : Text("Pay this order", "ชำระเงินคำสั่งซื้อนี้"))
                    </button>
                    <a class="qe-secondary-btn" href="@DocumentHref("Receipt")">@Text("Receipts", "ใบเสร็จ")</a>
                    <a class="qe-secondary-btn" href="@DocumentHref("Invoice")">@Text("Invoices", "ใบแจ้งหนี้")</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(_paymentError))
                {
                    <p class="order-payment-error">@_paymentError</p>
                }
            </article>

            <article class="order-detail-card" data-order-section="purchase-order">
                <div class="order-panel-head">
                    <span>@Text("Purchase order", "ใบสั่งซื้อ")</span>
                    <strong>@PoStatusText</strong>
                </div>
                <dl>
                    <div>
                        <dt>@Text("PO number", "เลขที่ PO")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_order.CustomerPoNumber) ? Text("Not uploaded", "ยังไม่ได้อัปโหลด") : _order.CustomerPoNumber)</dd>
                    </div>
                    <div>
                        <dt>@Text("Requirements", "ข้อกำหนด")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_order.Requirements) ? Text("No customer requirements recorded.", "ยังไม่มีข้อกำหนดจากลูกค้า") : _order.Requirements)</dd>
                    </div>
                </dl>
                <div class="order-detail-actions">
                    <a class="qe-secondary-btn" href="@DocumentHref("PurchaseOrder")">@Text("Upload purchase order", "อัปโหลดใบสั่งซื้อ")</a>
                </div>
            </article>

            <article class="order-detail-card" data-order-section="delivery">
                <div class="order-panel-head">
                    <span>@Text("Delivery", "การจัดส่ง")</span>
                    <strong>@DeliveryStatusText</strong>
                </div>
                <div class="order-delivery-list">
                    <div>
                        <span>@Text("Promised delivery", "กำหนดส่ง")</span>
                        <strong>@FormatDate(_order.PromisedDeliveryDate)</strong>
                    </div>
                    <div>
                        <span>@Text("Actual delivery", "ส่งจริง")</span>
                        <strong>@FormatDate(_order.ActualDeliveryDate)</strong>
                    </div>
                    <div>
                        <span>@Text("Tracking", "การติดตาม")</span>
                        <strong>@DeliveryTrackingText</strong>
                    </div>
                </div>
                <div class="order-shipping-quote" data-order-section="shipment-tracking">
                    <div class="order-shipping-form">
                        <label>
                            <span>@Text("Tracking code", "เลขติดตามพัสดุ")</span>
                            <input type="text"
                                   autocomplete="off"
                                   @bind="_trackingCode"
                                   @bind:event="oninput" />
                        </label>
                    </div>
                    <button type="button"
                            class="qe-secondary-btn"
                            disabled="@(_trackingBusy || string.IsNullOrWhiteSpace(_trackingCode))"
                            @onclick="FetchShipmentTrackingAsync">
                        @(_trackingBusy ? Text("Checking tracking...", "กำลังตรวจสอบสถานะ...") : Text("Check shipment status", "ตรวจสอบสถานะพัสดุ"))
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_trackingError))
                    {
                        <p class="order-payment-error">@_trackingError</p>
                    }
                    @if (_trackingStatus is not null)
                    {
                        <div class="order-shipping-rates">
                            <div class="order-shipping-rate is-selected">
                                <span>@TrackingCourierLabel</span>
                                @if (!string.IsNullOrWhiteSpace(_trackingStatus.Provider))
                                {
                                    <small>@Text("Via", "ผ่าน") @_trackingStatus.Provider</small>
                                }
                                <strong>@_trackingStatus.Status</strong>
                                @if (!string.IsNullOrWhiteSpace(_trackingStatus.Description))
                                {
                                    <small>@_trackingStatus.Description</small>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="order-shipping-quote">
                    <div class="order-shipping-form">
                        <label>
                            <span>@Text("Courier", "ขนส่ง")</span>
                            <select @bind="_selectedCourierCode">
                                <option value="">@Text("Any available courier", "ขนส่งที่พร้อมให้บริการ")</option>
                                @foreach (var courier in _couriers)
                                {
                                    <option value="@courier.CourierCode">@CourierLabel(courier)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>@Text("Weight (g)", "น้ำหนัก (กรัม)")</span>
                            <input type="number" min="1" step="1" @bind="_shippingWeightGrams" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>@Text("Length (cm)", "ยาว (ซม.)")</span>
                            <input type="number" min="0.1" step="0.1" @bind="_shippingLengthCm" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>@Text("Width (cm)", "กว้าง (ซม.)")</span>
                            <input type="number" min="0.1" step="0.1" @bind="_shippingWidthCm" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>@Text("Height (cm)", "สูง (ซม.)")</span>
                            <input type="number" min="0.1" step="0.1" @bind="_shippingHeightCm" @bind:event="oninput" />
                        </label>
                    </div>
                    <button type="button" class="qe-secondary-btn" disabled="@(_shippingBusy || ShippingAddress is null)" @onclick="FetchShippingRatesAsync">
                        @(_shippingBusy ? Text("Checking rates...", "กำลังตรวจสอบราคา...") : Text("Get courier rates", "ดูราคาขนส่ง"))
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_shippingError))
                    {
                        <p class="order-payment-error">@_shippingError</p>
                    }
                    @if (_shippingRates.Count > 0)
                    {
                        <div class="order-shipping-rates">
                            @foreach (var rate in _shippingRates)
                            {
                                <button type="button"
                                        class="order-shipping-rate @(ReferenceEquals(rate, _selectedShippingRate) ? "is-selected" : "")"
                                        @onclick="@(() => SelectShippingRate(rate))">
                                    <span>@rate.ProductName</span>
                                    @if (!string.IsNullOrWhiteSpace(rate.Provider))
                                    {
                                        <small>@Text("Via", "ผ่าน") @rate.Provider</small>
                                    }
                                    <strong>@FormatMoney(rate.TotalPrice, rate.CurrencyCode)</strong>
                                    @if (!string.IsNullOrWhiteSpace(rate.EstimatedDeliveryDate))
                                    {
                                        <small>@Text("ETA", "ถึงประมาณ") @rate.EstimatedDeliveryDate</small>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </article>
        </section>

        <section class="order-detail-card" data-order-section="documents">
            <div class="order-panel-head">
                <span>@Text("Order documents", "เอกสารคำสั่งซื้อ")</span>
                <strong>@OrderArtifactCount</strong>
            </div>
            @if (OrderArtifactCount > 0)
            {
                <div class="order-documents-list">
                    @foreach (var file in OrderFiles)
                    {
                        <div class="order-document-row">
                            <span>@file.FileName</span>
                            <strong>@OrderFileKind(file)</strong>
                            <small>@OrderFileMeta(file)</small>
                            <button type="button"
                                    class="qe-secondary-btn"
                                    disabled="@_openingOrderFileIds.Contains(file.FileId)"
                                    @onclick="@(() => OpenOrderFileAsync(file))">
                                @(_openingOrderFileIds.Contains(file.FileId) ? Text("Opening...", "กำลังเปิด...") : Text("Open", "เปิด"))
                            </button>
                        </div>
                    }
                    @foreach (var document in OrderDocuments)
                    {
                        <div class="order-document-row">
                            <span>@document.FileName</span>
                            <strong>@document.Kind</strong>
                            <small>@DocumentMeta(document)</small>
                            <button type="button"
                                    class="qe-secondary-btn"
                                    disabled="@_openingDocumentIds.Contains(document.DocumentId)"
                                    @onclick="@(() => OpenDocumentAsync(document))">
                                @(_openingDocumentIds.Contains(document.DocumentId) ? Text("Opening...", "กำลังเปิด...") : Text("Open", "เปิด"))
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="order-documents-empty">@Text("No purchase order, invoice, or receipt is attached to this order yet.", "ยังไม่มีใบสั่งซื้อ ใบแจ้งหนี้ หรือใบเสร็จที่ผูกกับคำสั่งซื้อนี้")</p>
            }
            <div class="order-detail-actions">
                <a class="qe-secondary-btn" href="@DocumentHref("PurchaseOrder")">@Text("Add PO", "เพิ่ม PO")</a>
                <a class="qe-secondary-btn" href="@DocumentHref("Invoice")">@Text("Add invoice", "เพิ่มใบแจ้งหนี้")</a>
                <a class="qe-secondary-btn" href="@DocumentHref("Receipt")">@Text("Add receipt", "เพิ่มใบเสร็จ")</a>
            </div>
        </section>

        <section class="order-detail-card" data-order-section="timeline">
            <div class="order-panel-head">
                <span>@Text("Status timeline", "ไทม์ไลน์สถานะ")</span>
                <strong>@_order.StatusHistory.Count</strong>
            </div>
            <ol class="order-status-timeline">
                @foreach (var entry in _order.StatusHistory.OrderBy(entry => entry.Timestamp))
                {
                    <li>
                        <span></span>
                        <div>
                            <strong>@entry.Status</strong>
                            <small>@FormatDate(entry.Timestamp)</small>
                            @if (!string.IsNullOrWhiteSpace(entry.CustomerNote))
                            {
                                <p>@entry.CustomerNote</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>
    </main>
}

@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private CustomerOrderDetailDto? _order;
    private bool _loading = true;
    private bool _paymentBusy;
    private bool _acceptedCheckoutTerms;
    private string? _paymentError;
    private CustomerProfileResponse? _profile;
    private IReadOnlyList<CustomerAddressDto> _addresses = [];
    private IReadOnlyList<CustomerDocumentDto> _documents = [];
    private IReadOnlyList<ShippingCourierDto> _couriers = [];
    private List<ShippingRateOptionDto> _shippingRates = [];
    private readonly HashSet<Guid> _openingDocumentIds = [];
    private readonly HashSet<long> _openingOrderFileIds = [];
    private HubConnection? _notificationConnection;
    private string? _joinedOrderNumber;
    private string? _selectedCourierCode;
    private ShippingRateOptionDto? _selectedShippingRate;
    private bool _shippingBusy;
    private string? _shippingError;
    private string _trackingCode = string.Empty;
    private ShippingTrackingDto? _trackingStatus;
    private bool _trackingBusy;
    private string? _trackingError;
    private decimal _shippingWeightGrams = 1000m;
    private decimal _shippingLengthCm = 20m;
    private decimal _shippingWidthCm = 15m;
    private decimal _shippingHeightCm = 10m;

    private int ManufacturingProgressPercent
    {
        get
        {
            if (_order is null)
            {
                return 0;
            }

            var milestonePercent = _order.ManufacturingMilestones
                .Where(milestone =>
                    string.Equals(milestone.State, "complete", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(milestone.State, "current", StringComparison.OrdinalIgnoreCase))
                .Select(milestone => milestone.Percent)
                .DefaultIfEmpty(0)
                .Max();

            if (milestonePercent > 0)
            {
                return Math.Max(milestonePercent, StatusPercent(_order.CurrentStatus));
            }

            return _order.CurrentStatus.ToLowerInvariant() switch
            {
                var status when status.Contains("delivered", StringComparison.Ordinal) => 100,
                var status when status.Contains("shipped", StringComparison.Ordinal) => 90,
                var status when status.Contains("quality", StringComparison.Ordinal) || status.Contains("inspection", StringComparison.Ordinal) => 75,
                var status when status.Contains("manufacturing", StringComparison.Ordinal) || status.Contains("production", StringComparison.Ordinal) => 55,
                var status when status.Contains("paid", StringComparison.Ordinal) => 35,
                var status when status.Contains("accepted", StringComparison.Ordinal) => 25,
                var status when status.Contains("pending", StringComparison.Ordinal) => 15,
                _ => 10
            };
        }
    }

    private string PoStatusText => string.IsNullOrWhiteSpace(_order?.CustomerPoNumber)
        ? Text("Missing", "ยังไม่มี")
        : Text("Received", "ได้รับแล้ว");

    private string DeliveryStatusText => _order switch
    {
        null => Text("Pending", "รอดำเนินการ"),
        { ActualDeliveryDate: not null } => Text("Delivered", "ส่งมอบแล้ว"),
        var order when order.CurrentStatus.Contains("shipped", StringComparison.OrdinalIgnoreCase) => Text("In transit", "อยู่ระหว่างจัดส่ง"),
        var order when order.CurrentStatus.Contains("quality", StringComparison.OrdinalIgnoreCase) ||
                       order.CurrentStatus.Contains("inspection", StringComparison.OrdinalIgnoreCase) => Text("Preparing delivery", "เตรียมจัดส่ง"),
        _ => Text("Scheduled", "วางแผนจัดส่ง")
    };

    private string DeliveryTrackingText => _order switch
    {
        null => Text("Pending", "รอดำเนินการ"),
        _ when _trackingStatus is not null => TrackingStatusSummary,
        { ActualDeliveryDate: not null } => Text("Delivered to customer", "ส่งมอบให้ลูกค้าแล้ว"),
        var order when order.CurrentStatus.Contains("shipped", StringComparison.OrdinalIgnoreCase) => Text("Shipment is on the way.", "พัสดุกำลังอยู่ระหว่างจัดส่ง"),
        var order when order.PromisedDeliveryDate.HasValue => Text("Tracking will appear after shipment handoff.", "ข้อมูลติดตามจะแสดงหลังส่งมอบให้ขนส่ง"),
        _ => Text("Delivery schedule is pending.", "กำลังรอกำหนดการจัดส่ง")
    };

    private string TrackingCourierLabel => _trackingStatus is null
        ? Text("Shipment", "พัสดุ")
        : FirstNonEmpty(_trackingStatus.CourierName, _trackingStatus.CourierCode, _trackingStatus.TrackingCode);

    private string TrackingStatusSummary => _trackingStatus is null
        ? Text("Tracking pending", "รอข้อมูลติดตาม")
        : $"{_trackingStatus.Status} - {TrackingCourierLabel}";

    private Guid? BillingAddressId => SelectAddressId("Billing");
    private Guid? ShippingAddressId => SelectAddressId("Shipping");
    private CustomerAddressDto? ShippingAddress => SelectAddress("Shipping");
    private string? BillingCompanyName => string.IsNullOrWhiteSpace(_profile?.CompanyName) ? null : _profile.CompanyName;
    private string? BillingVatNumber => string.IsNullOrWhiteSpace(_profile?.VatNumber) ? null : _profile.VatNumber;

    private bool CanPay => _order is not null &&
        _order.QuotedAmount is > 0 &&
        BillingAddressId.HasValue &&
        ShippingAddressId.HasValue &&
        !string.Equals(_order.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<CustomerDocumentDto> OrderDocuments => _order is null
        ? []
        : _documents
            .Where(document => string.Equals(document.OrderNumber, _order.OrderNumber, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(document => document.UploadedAt)
            .ToArray();

    private IReadOnlyList<CustomerOrderFileDto> OrderFiles => _order?.OrderFiles
        .OrderByDescending(file => file.UploadedAt)
        .ToArray() ?? [];

    private int OrderArtifactCount => OrderFiles.Count + OrderDocuments.Count;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _paymentError = null;
        _order = string.IsNullOrWhiteSpace(OrderNumber)
            ? null
            : await Api.GetOrderDetailAsync(OrderNumber);
        _loading = false;

        if (_order is not null)
        {
            _profile = await Api.GetProfileAsync();
            _addresses = await Api.GetAddressesAsync();
            _documents = await Api.GetDocumentsAsync();
            _couriers = await Api.GetShippingCouriersAsync();
            await EnsureOrderNotificationConnectionAsync(_order.OrderNumber);
        }
        else
        {
            _profile = null;
            _addresses = [];
            _documents = [];
            _couriers = [];
            _shippingRates = [];
            _trackingStatus = null;
        }
    }

    private async Task FetchShipmentTrackingAsync()
    {
        _trackingError = null;
        _trackingStatus = null;
        var trackingCode = _trackingCode.Trim();
        if (string.IsNullOrWhiteSpace(trackingCode))
        {
            _trackingError = Text("Enter a tracking code before checking shipment status.", "กรอกเลขติดตามพัสดุก่อนตรวจสอบสถานะ");
            return;
        }

        _trackingBusy = true;
        try
        {
            _trackingStatus = await Api.GetShippingTrackingAsync(trackingCode);
            if (_trackingStatus is null)
            {
                _trackingError = Text("No shipment status was found for this tracking code.", "ไม่พบสถานะพัสดุสำหรับเลขติดตามนี้");
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _trackingError = ex.UserMessage;
        }
        catch (HttpRequestException)
        {
            _trackingError = Text("Shipment tracking is temporarily unavailable.", "ยังไม่สามารถตรวจสอบสถานะพัสดุได้ชั่วคราว");
        }
        finally
        {
            _trackingBusy = false;
        }
    }

    private async Task FetchShippingRatesAsync()
    {
        _shippingError = ValidateShippingRateInputs();
        _shippingRates = [];
        _selectedShippingRate = null;
        if (_shippingError is not null)
        {
            return;
        }

        _shippingBusy = true;
        try
        {
            var result = await Api.GetShippingRatesAsync(BuildShippingRateRequest());
            _shippingRates = result.Rates;
            if (_shippingRates.Count == 0)
            {
                _shippingError = Text("No courier rates are available for this destination yet.", "ยังไม่มีราคาขนส่งสำหรับปลายทางนี้");
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _shippingError = ex.UserMessage;
        }
        catch (HttpRequestException)
        {
            _shippingError = Text("Shipping rates are temporarily unavailable.", "ยังไม่สามารถตรวจสอบราคาขนส่งได้ชั่วคราว");
        }
        finally
        {
            _shippingBusy = false;
        }
    }

    private ShippingRateRequestDto BuildShippingRateRequest()
    {
        var address = ShippingAddress ?? throw new InvalidOperationException("Shipping address is required.");
        return new ShippingRateRequestDto
        {
            From = new ShippingAddressDto
            {
                Name = "MALIEV",
                Address = "MALIEV",
                District = "Pathum Wan",
                State = "Pathum Wan",
                Province = "Bangkok",
                Postcode = "10400",
                Tel = "020000000"
            },
            To = new ShippingAddressDto
            {
                Name = FirstNonEmpty(address.RecipientName, _profile?.DisplayName, "Customer"),
                Address = FirstNonEmpty(address.AddressLine1),
                District = FirstNonEmpty(address.District, address.City),
                State = FirstNonEmpty(address.City, address.StateProvince),
                Province = FirstNonEmpty(address.StateProvince),
                Postcode = FirstNonEmpty(address.PostalCode),
                Tel = FirstNonEmpty(address.RecipientPhone, _profile?.Phone),
                Email = _profile?.Email
            },
            Parcel = new ShippingParcelDto
            {
                Name = _order is null ? "MALIEV shipment" : $"MALIEV order {_order.OrderNumber}",
                Weight = _shippingWeightGrams,
                Length = _shippingLengthCm,
                Width = _shippingWidthCm,
                Height = _shippingHeightCm
            },
            CourierCodes = string.IsNullOrWhiteSpace(_selectedCourierCode) ? [] : [_selectedCourierCode]
        };
    }

    private string? ValidateShippingRateInputs()
    {
        var address = ShippingAddress;
        if (address is null)
        {
            return Text("Select a shipping address before checking courier rates.", "เลือกที่อยู่จัดส่งก่อนตรวจสอบราคาขนส่ง");
        }

        if (string.IsNullOrWhiteSpace(address.AddressLine1) ||
            string.IsNullOrWhiteSpace(FirstNonEmpty(address.District, address.City)) ||
            string.IsNullOrWhiteSpace(address.StateProvince) ||
            string.IsNullOrWhiteSpace(address.PostalCode) ||
            string.IsNullOrWhiteSpace(FirstNonEmpty(address.RecipientPhone, _profile?.Phone)))
        {
            return Text("Complete the shipping address and phone number before checking courier rates.", "กรอกที่อยู่จัดส่งและเบอร์โทรให้ครบก่อนตรวจสอบราคาขนส่ง");
        }

        if (_shippingWeightGrams <= 0 || _shippingLengthCm <= 0 || _shippingWidthCm <= 0 || _shippingHeightCm <= 0)
        {
            return Text("Enter positive parcel weight and dimensions before checking courier rates.", "กรอกน้ำหนักและขนาดพัสดุให้มากกว่าศูนย์ก่อนตรวจสอบราคา");
        }

        return null;
    }

    private void SelectShippingRate(ShippingRateOptionDto rate)
    {
        _selectedShippingRate = rate;
        _shippingError = null;
    }

    private async Task InitiatePaymentAsync()
    {
        if (_order is null || _order.QuotedAmount is not > 0)
        {
            return;
        }

        _paymentBusy = true;
        _paymentError = null;
        try
        {
            var payment = await Api.InitiatePaymentAsync(new InitiatePaymentRequest
            {
                OrderId = _order.OrderId,
                OrderNumber = _order.OrderNumber,
                Amount = _order.QuotedAmount.Value,
                Currency = _order.QuoteCurrency ?? "THB",
                BillingAddressId = BillingAddressId,
                ShippingAddressId = ShippingAddressId,
                BillingCompanyName = BillingCompanyName,
                BillingVatNumber = BillingVatNumber,
                AcceptedTerms = _acceptedCheckoutTerms
            });

            if (!string.IsNullOrWhiteSpace(payment.PaymentUrl))
            {
                Navigation.NavigateTo(payment.PaymentUrl, forceLoad: true);
            }
            else
            {
                _paymentError = Text("Payment checkout is not available for this order yet.", "ยังไม่สามารถเปิดหน้าชำระเงินสำหรับคำสั่งซื้อนี้ได้");
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/auth/sign-in?returnUrl={Uri.EscapeDataString($"/orders/{_order.OrderNumber}")}", forceLoad: true);
        }
        catch (Exception)
        {
            _paymentError = Text("Payment checkout failed. Please try again.", "เปิดหน้าชำระเงินไม่สำเร็จ กรุณาลองใหม่");
        }
        finally
        {
            _paymentBusy = false;
        }
    }

    private string FormatMoney(decimal? amount, string? currency)
    {
        return amount is null
            ? Text("Pending", "รอดำเนินการ")
            : $"{amount.Value.ToString("N2", CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture)))} {currency ?? "THB"}";
    }

    private string FormatDate(DateTimeOffset? value)
    {
        return value is null
            ? Text("Pending", "รอดำเนินการ")
            : value.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture)));
    }

    private string DocumentHref(string kind)
    {
        return _order is null
            ? "/documents"
            : $"/documents?kind={Uri.EscapeDataString(kind)}&orderNumber={Uri.EscapeDataString(_order.OrderNumber)}";
    }

    private string DocumentMeta(CustomerDocumentDto document)
    {
        return $"{FormatDate(document.UploadedAt)} · {FormatFileSize(document.FileSizeBytes)}";
    }

    private static string OrderFileKind(CustomerOrderFileDto file)
    {
        return string.IsNullOrWhiteSpace(file.FileCategory)
            ? file.FileRole
            : $"{file.FileRole} · {file.FileCategory}";
    }

    private string OrderFileMeta(CustomerOrderFileDto file)
    {
        return $"{FormatDate(file.UploadedAt)} · {FormatFileSize(file.FileSizeBytes)}";
    }

    private string MilestoneTimestamp(CustomerManufacturingMilestoneDto milestone)
    {
        if (milestone.Timestamp.HasValue)
        {
            return FormatDate(milestone.Timestamp);
        }

        return string.Equals(milestone.State, "current", StringComparison.OrdinalIgnoreCase)
            ? Text("In progress", "กำลังดำเนินการ")
            : Text("Pending", "รอดำเนินการ");
    }

    private async Task OpenDocumentAsync(CustomerDocumentDto document)
    {
        _openingDocumentIds.Add(document.DocumentId);
        try
        {
            var download = await Api.GetDocumentDownloadAsync(document.DocumentId);
            Navigation.NavigateTo(download.DownloadUrl, forceLoad: true);
        }
        finally
        {
            _openingDocumentIds.Remove(document.DocumentId);
        }
    }

    private async Task OpenOrderFileAsync(CustomerOrderFileDto file)
    {
        if (_order is null)
        {
            return;
        }

        _openingOrderFileIds.Add(file.FileId);
        try
        {
            var download = await Api.GetOrderFileDownloadAsync(_order.OrderNumber, file.FileId);
            Navigation.NavigateTo(download.DownloadUrl, forceLoad: true);
        }
        finally
        {
            _openingOrderFileIds.Remove(file.FileId);
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0)
        {
            return "0 KB";
        }

        return bytes >= 1_000_000
            ? $"{bytes / 1_000_000m:N1} MB"
            : $"{Math.Max(1, bytes / 1_000)} KB";
    }

    private async Task EnsureOrderNotificationConnectionAsync(string orderNumber)
    {
        if (_notificationConnection is null)
        {
            _notificationConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/quote-notifications"))
                .WithAutomaticReconnect()
                .Build();

            _notificationConnection.On<QeOrderStatusChangedPayload>("OrderStatusChanged", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyOrderStatusChanged(payload);
                    StateHasChanged();
                });
            });

            _notificationConnection.On<QePaymentCompletedPayload>("PaymentCompleted", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyPaymentCompleted(payload);
                    StateHasChanged();
                });
            });

            _notificationConnection.On<QePaymentPendingPayload>("PaymentPending", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyPaymentPending(payload);
                    StateHasChanged();
                });
            });

            _notificationConnection.On<QePaymentFailedPayload>("PaymentFailed", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyPaymentFailed(payload);
                    StateHasChanged();
                });
            });

            _notificationConnection.On<QePaymentCancelledPayload>("PaymentCancelled", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyPaymentCancelled(payload);
                    StateHasChanged();
                });
            });

            _notificationConnection.On<QePaymentExpiredPayload>("PaymentExpired", payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyPaymentExpired(payload);
                    StateHasChanged();
                });
            });
        }

        if (_notificationConnection.State == HubConnectionState.Disconnected)
        {
            await _notificationConnection.StartAsync();
        }

        if (!string.Equals(_joinedOrderNumber, orderNumber, StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(_joinedOrderNumber))
            {
                await _notificationConnection.InvokeAsync("LeaveOrderGroup", _joinedOrderNumber);
            }

            await _notificationConnection.InvokeAsync("JoinOrderGroup", orderNumber);
            _joinedOrderNumber = orderNumber;
        }
    }

    private void ApplyOrderStatusChanged(QeOrderStatusChangedPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var entry = new OrderStatusEntryDto(payload.NewStatus, payload.Reason, payload.ChangedAt);
        _order = _order with
        {
            CurrentStatus = payload.NewStatus,
            UpdatedAt = payload.ChangedAt,
            StatusHistory = [entry, .. _order.StatusHistory],
            ManufacturingMilestones = BuildRealtimeMilestones(payload.NewStatus, payload.ChangedAt)
        };
    }

    private void ApplyPaymentCompleted(QePaymentCompletedPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _order = _order with
        {
            PaymentStatus = "Paid",
            UpdatedAt = DateTimeOffset.UtcNow,
            ManufacturingMilestones = BuildRealtimeMilestones("Paid", DateTimeOffset.UtcNow)
        };
    }

    private void ApplyPaymentPending(QePaymentPendingPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _paymentError = null;
        _order = _order with
        {
            PaymentStatus = "Pending",
            UpdatedAt = payload.PendingAt
        };
    }

    private void ApplyPaymentFailed(QePaymentFailedPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _paymentError = string.IsNullOrWhiteSpace(payload.ErrorMessage)
            ? Text("Payment was not completed. Please try another payment method.", "การชำระเงินยังไม่เสร็จสมบูรณ์ กรุณาลองวิธีชำระเงินอื่น")
            : Text($"Payment was not completed: {payload.ErrorMessage}", $"การชำระเงินยังไม่เสร็จสมบูรณ์: {payload.ErrorMessage}");

        _order = _order with
        {
            PaymentStatus = "Failed",
            UpdatedAt = payload.FailedAt
        };
    }

    private void ApplyPaymentCancelled(QePaymentCancelledPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _paymentError = string.IsNullOrWhiteSpace(payload.Reason)
            ? Text("Payment was cancelled before completion.", "การชำระเงินถูกยกเลิกก่อนเสร็จสมบูรณ์")
            : Text($"Payment was cancelled: {payload.Reason}", $"การชำระเงินถูกยกเลิก: {payload.Reason}");

        _order = _order with
        {
            PaymentStatus = "Cancelled",
            UpdatedAt = payload.CancelledAt
        };
    }

    private void ApplyPaymentExpired(QePaymentExpiredPayload payload)
    {
        if (_order is null ||
            !string.Equals(_order.OrderNumber, payload.OrderNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _paymentError = string.IsNullOrWhiteSpace(payload.Reason)
            ? Text("Payment checkout expired. Start payment again to continue.", "หน้าชำระเงินหมดอายุ กรุณาเริ่มชำระเงินใหม่อีกครั้ง")
            : Text($"Payment checkout expired: {payload.Reason}", $"หน้าชำระเงินหมดอายุ: {payload.Reason}");

        _order = _order with
        {
            PaymentStatus = "Expired",
            UpdatedAt = payload.ExpiredAt
        };
    }

    private IReadOnlyList<CustomerManufacturingMilestoneDto> BuildRealtimeMilestones(string status, DateTimeOffset changedAt)
    {
        if (_order is null || _order.ManufacturingMilestones.Count == 0)
        {
            return [];
        }

        var statusPercent = StatusPercent(status);
        return _order.ManufacturingMilestones
            .Select(milestone =>
            {
                if (milestone.Percent < statusPercent)
                {
                    return milestone with
                    {
                        State = "complete",
                        Timestamp = milestone.Timestamp ?? changedAt
                    };
                }

                if (milestone.Percent == statusPercent)
                {
                    return milestone with
                    {
                        State = "current",
                        Timestamp = milestone.Timestamp ?? changedAt
                    };
                }

                return milestone with { State = "pending" };
            })
            .ToArray();
    }

    private static int StatusPercent(string status)
    {
        var normalized = status.ToLowerInvariant();
        if (normalized.Contains("delivered", StringComparison.Ordinal))
        {
            return 100;
        }

        if (normalized.Contains("shipped", StringComparison.Ordinal))
        {
            return 90;
        }

        if (normalized.Contains("quality", StringComparison.Ordinal) || normalized.Contains("inspection", StringComparison.Ordinal))
        {
            return 75;
        }

        if (normalized.Contains("manufacturing", StringComparison.Ordinal) || normalized.Contains("production", StringComparison.Ordinal))
        {
            return 55;
        }

        if (normalized.Contains("paid", StringComparison.Ordinal) ||
            normalized.Contains("accepted", StringComparison.Ordinal) ||
            normalized.Contains("quoted", StringComparison.Ordinal) ||
            normalized.Contains("reviewed", StringComparison.Ordinal))
        {
            return 35;
        }

        return normalized.Contains("pending", StringComparison.Ordinal) ? 15 : 10;
    }

    public async ValueTask DisposeAsync()
    {
        if (_notificationConnection is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_joinedOrderNumber) &&
            _notificationConnection.State == HubConnectionState.Connected)
        {
            await _notificationConnection.InvokeAsync("LeaveOrderGroup", _joinedOrderNumber);
        }

        await _notificationConnection.DisposeAsync();
    }

    private Guid? SelectAddressId(string addressType)
    {
        return SelectAddress(addressType)?.Id;
    }

    private CustomerAddressDto? SelectAddress(string addressType)
    {
        return _addresses.FirstOrDefault(address =>
                   address.IsDefault &&
                   string.Equals(address.Type, addressType, StringComparison.OrdinalIgnoreCase))
               ?? _addresses.FirstOrDefault(address =>
                   string.Equals(address.Type, addressType, StringComparison.OrdinalIgnoreCase));
    }

    private string CourierLabel(ShippingCourierDto courier)
    {
        var name = string.IsNullOrWhiteSpace(courier.CourierName) ? courier.CourierCode : courier.CourierName;
        var label = string.IsNullOrWhiteSpace(courier.Note) ? name : $"{name} - {courier.Note}";
        return string.IsNullOrWhiteSpace(courier.Provider) ? label : $"{label} via {courier.Provider.Trim()}";
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }
}
