@page "/orders/{OrderNumber}"
@inject NavigationManager Navigation

@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;

    // Order detail renders inside the Make Studio workspace. Payment providers
    // redirect back here with status query parameters, so the original query
    // string is forwarded to the workspace deep link.
    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;
        var carried = string.IsNullOrEmpty(query) ? string.Empty : "&" + query.TrimStart('?');
        Navigation.NavigateTo($"/quotes?ws=orders&order={Uri.EscapeDataString(OrderNumber)}{carried}", replace: true);
    }
}
