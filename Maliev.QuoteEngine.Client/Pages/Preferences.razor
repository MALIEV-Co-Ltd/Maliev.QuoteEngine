@page "/preferences"
@using Maliev.QuoteEngine.Shared.ReferenceData
@inject QuoteEngineApiClient Api
@inject PreferenceService PreferenceState
@implements IDisposable

<PageTitle>@Text("Preferences - MALIEV Quote Engine", "การตั้งค่า - MALIEV Quote Engine")</PageTitle>

<div class="section-heading">
    <span class="eyebrow">@Text("Account", "บัญชี")</span>
    <h1>@Text("Preferences", "การตั้งค่า")</h1>
    <p>@Text("Display and quoting preferences are applied immediately in the customer quote workspace.", "การตั้งค่าการแสดงผลและการขอราคาจะมีผลทันทีในพื้นที่ทำงานของลูกค้า")</p>
</div>

<section class="preferences-panel">
    <div class="preferences-row">
        <div>
            <span class="eyebrow">@Text("Language", "ภาษา")</span>
            <strong>@Text("Platform language", "ภาษาของแพลตฟอร์ม")</strong>
        </div>
        <div class="preferences-segmented" role="group" aria-label="@Text("Platform language", "ภาษาของแพลตฟอร์ม")">
            <button type="button"
                    class="@LanguageButtonClass(SupportedCultures.DefaultCulture)"
                    @onclick="() => SetCultureAsync(SupportedCultures.DefaultCulture)">
                English
            </button>
            <button type="button"
                    class="@LanguageButtonClass(SupportedCultures.ThaiCulture)"
                    @onclick="() => SetCultureAsync(SupportedCultures.ThaiCulture)">
                ไทย
            </button>
        </div>
    </div>

    <div class="preferences-row">
        <div>
            <span class="eyebrow">@Text("Theme", "ธีม")</span>
            <strong>@Text("Interface appearance", "รูปลักษณ์อินเทอร์เฟซ")</strong>
        </div>
        <div class="preferences-segmented" role="group" aria-label="@Text("Display theme", "ธีมการแสดงผล")">
            <button type="button" class="@ThemeButtonClass(false)" @onclick="() => SetThemeAsync(false)">@Text("Light", "สว่าง")</button>
            <button type="button" class="@ThemeButtonClass(true)" @onclick="() => SetThemeAsync(true)">@Text("Dark", "มืด")</button>
        </div>
    </div>

    <div class="preferences-row">
        <div>
            <span class="eyebrow">@Text("Currency", "สกุลเงิน")</span>
            <strong>@Text("Quote display currency", "สกุลเงินสำหรับแสดงราคา")</strong>
        </div>
        <select class="quote-currency-select preferences-currency-select"
                value="@_selectedCurrency"
                @onchange="HandleCurrencyChanged"
                aria-label="@Text("Quote currency", "สกุลเงินใบเสนอราคา")">
            @foreach (var currency in _currencyOptions)
            {
                <option value="@currency.Code">@CurrencyOptionLabel(currency)</option>
            }
        </select>
    </div>
</section>

@code {
    private static readonly CurrencyOptionDto FallbackCurrency = new("THB", "฿", "Thai Baht", true, true);
    private bool _isDarkMode;
    private List<CurrencyOptionDto> _currencyOptions = [FallbackCurrency];
    private string _selectedCurrency = "THB";
    private string _selectedCulture = SupportedCultures.DefaultCulture;

    protected override async Task OnInitializedAsync()
    {
        PreferenceState.Changed += OnPreferencesChanged;
        await LoadCurrencyOptionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PreferenceState.InitializeAsync();
        _isDarkMode = PreferenceState.IsDarkMode;
        _selectedCulture = PreferenceState.Culture;
        _selectedCurrency = NormalizeCurrency(PreferenceState.Currency);
        StateHasChanged();
    }

    private async Task SetThemeAsync(bool dark)
    {
        await PreferenceState.SetThemeAsync(dark ? PreferenceService.DarkTheme : PreferenceService.LightTheme);
    }

    private async Task SetCultureAsync(string culture)
    {
        await PreferenceState.SetCultureAsync(culture);
    }

    private async Task HandleCurrencyChanged(ChangeEventArgs args)
    {
        _selectedCurrency = NormalizeCurrency(args.Value?.ToString());
        await PreferenceState.SetCurrencyAsync(_selectedCurrency);
    }

    private async Task LoadCurrencyOptionsAsync()
    {
        try
        {
            var currencies = await Api.GetCurrenciesAsync();
            _currencyOptions = currencies
                .Where(currency => currency.IsActive && !string.IsNullOrWhiteSpace(currency.Code))
                .OrderByDescending(currency => currency.IsPrimary)
                .ThenBy(currency => currency.Code, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (_currencyOptions.Count == 0)
            {
                _currencyOptions = [FallbackCurrency];
            }
        }
        catch (HttpRequestException)
        {
            _currencyOptions = [FallbackCurrency];
        }

        _selectedCurrency = NormalizeCurrency(_selectedCurrency);
    }

    private string ThemeButtonClass(bool dark)
    {
        return _isDarkMode == dark ? "preferences-segment is-active" : "preferences-segment";
    }

    private string LanguageButtonClass(string culture)
    {
        return string.Equals(SupportedCultures.Normalize(_selectedCulture), SupportedCultures.Normalize(culture), StringComparison.Ordinal)
            ? "preferences-segment is-active"
            : "preferences-segment";
    }

    private string Text(string en, string th)
    {
        return PreferenceState.Text(en, th);
    }

    private void OnPreferencesChanged()
    {
        _isDarkMode = PreferenceState.IsDarkMode;
        _selectedCulture = PreferenceState.Culture;
        _selectedCurrency = NormalizeCurrency(PreferenceState.Currency);
        _ = InvokeAsync(StateHasChanged);
    }

    private string NormalizeCurrency(string? currency)
    {
        return _currencyOptions.FirstOrDefault(candidate => candidate.Code.Equals(currency, StringComparison.OrdinalIgnoreCase))?.Code
            ?? _currencyOptions.FirstOrDefault(candidate => candidate.IsPrimary)?.Code
            ?? _currencyOptions.FirstOrDefault(candidate => candidate.Code.Equals("THB", StringComparison.OrdinalIgnoreCase))?.Code
            ?? _currencyOptions.FirstOrDefault()?.Code
            ?? "THB";
    }

    private static string CurrencyOptionLabel(CurrencyOptionDto currency)
    {
        return string.IsNullOrWhiteSpace(currency.Name)
            ? currency.Code
            : $"{currency.Code} - {currency.Name}";
    }

    public void Dispose()
    {
        PreferenceState.Changed -= OnPreferencesChanged;
    }
}
