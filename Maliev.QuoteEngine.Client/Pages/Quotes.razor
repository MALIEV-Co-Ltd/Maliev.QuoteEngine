@page "/quotes/{QuoteId:guid}"
@using System.Globalization
@inject QuoteEngineApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Text("Quote detail - MALIEV", "รายละเอียดใบเสนอราคา - MALIEV")</PageTitle>

@if (_loading)
{
    <div class="empty-state">
        <p>@Text("Loading quote detail...", "กำลังโหลดรายละเอียดใบเสนอราคา...")</p>
    </div>
}
else if (_quote is null)
{
    <div class="empty-state">
        <h1>@Text("Quote not found", "ไม่พบใบเสนอราคา")</h1>
        <p>@Text("This quote is unavailable or does not belong to your account.", "ใบเสนอราคานี้ไม่พร้อมใช้งานหรือไม่ได้อยู่ในบัญชีของคุณ")</p>
        <a class="primary-button" href="/quotes/new">@Text("Start another quote", "เริ่มขอราคาใหม่")</a>
    </div>
}
else
{
    <main class="quote-detail-shell">
        <header class="quote-detail-header">
            <a class="qe-secondary-btn" href="/profile">@Text("Back to account", "กลับไปที่บัญชี")</a>
            <div>
                <span class="eyebrow">@Text("Formal quote", "ใบเสนอราคาอย่างเป็นทางการ")</span>
                <h1>@_quote.QuoteNumber</h1>
                <p>@Text("Review quote value, status, and PDF documents before placing or tracking an order.", "ตรวจสอบมูลค่า สถานะ และเอกสาร PDF ก่อนสั่งซื้อหรือติดตามคำสั่งซื้อ")</p>
            </div>
            <strong class="order-status-pill">@_quote.Status</strong>
        </header>

        <section class="quote-detail-card" data-quote-section="summary">
            <div class="order-panel-head">
                <span>@Text("Quote summary", "สรุปใบเสนอราคา")</span>
                <strong>@FormatMoney(_quote.Total, _quote.Currency)</strong>
            </div>
            <dl>
                <div>
                    <dt>@Text("Quote number", "เลขที่ใบเสนอราคา")</dt>
                    <dd>@_quote.QuoteNumber</dd>
                </div>
                <div>
                    <dt>@Text("Status", "สถานะ")</dt>
                    <dd>@_quote.Status</dd>
                </div>
                <div>
                    <dt>@Text("Updated", "อัปเดตเมื่อ")</dt>
                    <dd>@FormatDate(_quote.UpdatedAt)</dd>
                </div>
            </dl>
        </section>

        @if ((_quote.Versions?.Count ?? 0) > 0)
        {
            <section class="quote-detail-card" data-quote-section="versions">
                <div class="order-panel-head">
                    <span>@Text("Quote revision history", "ประวัติการแก้ไขใบเสนอราคา")</span>
                    <strong>@_quote.Versions!.Count</strong>
                </div>
                <div class="quote-history-list">
                    @foreach (var version in _quote.Versions.OrderByDescending(version => version.VersionNumber))
                    {
                        <div class="quote-history-row quote-history-row--version">
                            <div>
                                <strong>@FormatVersionLabel(version)</strong>
                                <small>@FormatDate(version.CreatedAt)</small>
                            </div>
                            <div>
                                <span>@FormatMoney(version.Total, version.Currency)</span>
                                @if (!string.IsNullOrWhiteSpace(version.ChangeSummary))
                                {
                                    <small>@version.ChangeSummary</small>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(version.PdfUrl))
                            {
                                <a class="qe-secondary-btn" href="@version.PdfUrl" target="_blank" rel="noopener">
                                    @Text("Open PDF", "เปิด PDF")
                                </a>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <section class="quote-detail-card" data-quote-section="actions">
            <div class="order-panel-head">
                <span>@Text("Quote actions", "การดำเนินการกับใบเสนอราคา")</span>
                <strong>@_quote.Currency</strong>
            </div>
            <div class="quote-detail-actions">
                @if (!string.IsNullOrWhiteSpace(_quote.PdfUrl))
                {
                    <a class="qe-primary-btn" href="@_quote.PdfUrl" target="_blank" rel="noopener">@Text("Open quote PDF", "เปิด PDF ใบเสนอราคา")</a>
                }
                <a class="qe-secondary-btn" href="/orders">@Text("Track orders", "ติดตามคำสั่งซื้อ")</a>
                <a class="qe-secondary-btn" href="/documents">@Text("Customer documents", "เอกสารลูกค้า")</a>
                <a class="qe-secondary-btn" href="/quotes/new">@Text("Start another quote", "เริ่มขอราคาใหม่")</a>
            </div>
        </section>

        <section class="quote-detail-card quote-conversion-card" data-quote-section="conversion">
            <div class="order-panel-head">
                <span>@Text("Accept and order", "ยอมรับและสั่งซื้อ")</span>
                <strong>@ConversionStatus</strong>
            </div>
            <p>@Text("Approve this formal quote, then create the manufacturing order from the same customer account.", "อนุมัติใบเสนอราคานี้แล้วสร้างคำสั่งผลิตจากบัญชีลูกค้าเดียวกัน")</p>
            <div class="quote-detail-actions">
                <button type="button" class="qe-secondary-btn" disabled="@(!CanApproveQuote || _quoteActionBusy)" @onclick="ApproveQuoteAsync">
                    @Text("Approve quote", "อนุมัติใบเสนอราคา")
                </button>
                <button type="button" class="qe-primary-btn" disabled="@(!CanCreateOrder || _quoteActionBusy)" @onclick="CreateOrderAsync">
                    @Text("Create order", "สร้างคำสั่งซื้อ")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_quoteActionError))
            {
                <p class="quote-action-error">@_quoteActionError</p>
            }
        </section>
    </main>
}

@code {
    [Parameter]
    public Guid QuoteId { get; set; }

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private CustomerQuoteSummaryDto? _quote;
    private bool _loading = true;
    private bool _quoteActionBusy;
    private string? _quoteActionError;
    private bool CanApproveQuote => _quote is not null && !IsApprovedQuote(_quote.Status) && !IsTerminalQuote(_quote.Status);
    private bool CanCreateOrder => _quote is not null && !IsTerminalQuote(_quote.Status);
    private string ConversionStatus => _quote is null
        ? Text("Unavailable", "ไม่พร้อมใช้งาน")
        : IsApprovedQuote(_quote.Status)
            ? Text("Approved", "อนุมัติแล้ว")
            : Text("Ready", "พร้อมดำเนินการ");

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _quoteActionError = null;
        var quotes = await Api.GetQuotesAsync();
        _quote = quotes.FirstOrDefault(quote => quote.QuoteId == QuoteId);
        _loading = false;
    }

    private async Task ApproveQuoteAsync()
    {
        if (_quote is null || !CanApproveQuote)
        {
            return;
        }

        _quoteActionBusy = true;
        _quoteActionError = null;
        try
        {
            var approved = await Api.ApproveQuoteAsync(_quote.QuoteId);
            _quote = _quote with
            {
                Status = approved.Status,
                PdfUrl = string.IsNullOrWhiteSpace(approved.PdfUrl) ? _quote.PdfUrl : approved.PdfUrl,
                UpdatedAt = DateTimeOffset.UtcNow
            };
        }
        catch (Exception)
        {
            _quoteActionError = Text("Quote approval failed. Please try again.", "อนุมัติใบเสนอราคาไม่สำเร็จ กรุณาลองใหม่");
        }
        finally
        {
            _quoteActionBusy = false;
        }
    }

    private async Task CreateOrderAsync()
    {
        if (_quote is null || !CanCreateOrder)
        {
            return;
        }

        _quoteActionBusy = true;
        _quoteActionError = null;
        try
        {
            var currentVersion = ResolveCurrentQuoteVersion();
            var order = await Api.CreateOrderAsync(new CreateManufacturingOrderRequest(_quote.QuoteId, string.Empty, "Customer accepted quote from quote history.")
            {
                QuoteVersionId = currentVersion?.VersionId,
                QuoteVersionNumber = currentVersion?.VersionNumber
            });
            Navigation.NavigateTo($"/orders/{Uri.EscapeDataString(order.OrderNumber)}");
        }
        catch (Exception)
        {
            _quoteActionError = Text("Order creation failed. Please try again.", "สร้างคำสั่งซื้อไม่สำเร็จ กรุณาลองใหม่");
        }
        finally
        {
            _quoteActionBusy = false;
        }
    }

    private string FormatMoney(decimal amount, string currency)
    {
        return $"{amount.ToString("N2", CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture)))} {currency}";
    }

    private string FormatDate(DateTimeOffset value)
    {
        return value.ToLocalTime().ToString("d MMM yyyy", CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture)));
    }

    private string FormatVersionLabel(CustomerQuoteVersionSummaryDto version)
    {
        var label = $"{Text("Version", "เวอร์ชัน")} {version.VersionNumber}";
        return string.IsNullOrWhiteSpace(version.GeneratedByDisplayName)
            ? label
            : $"{label} - {version.GeneratedByDisplayName}";
    }

    private CustomerQuoteVersionSummaryDto? ResolveCurrentQuoteVersion()
    {
        return _quote?.Versions?
            .OrderByDescending(version => version.VersionNumber)
            .FirstOrDefault();
    }

    private static bool IsApprovedQuote(string status)
    {
        return status.Contains("approved", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("accepted", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsTerminalQuote(string status)
    {
        return status.Contains("expired", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("cancelled", StringComparison.OrdinalIgnoreCase);
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }
}
