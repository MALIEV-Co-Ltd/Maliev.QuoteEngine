@page "/"

<PageTitle>MALIEV Quote Engine</PageTitle>

<div class="hero-grid">
    <div class="hero-copy">
        <span class="eyebrow">quote.maliev.com</span>
        <h1>Custom manufacturing orders start here.</h1>
        <p>Upload CAD files, review manufacturability, configure every part, receive a deterministic estimate, and turn approved quotes into tracked manufacturing orders.</p>
        <div class="hero-actions">
            <a class="primary-button" href="/quotes/new">Start a quote</a>
            <a class="text-button" href="/orders">Track orders</a>
        </div>
    </div>
    <div class="hero-media">
        <img src="/images/generated/quote-hero.svg" alt="Manufacturing quote workspace preview" />
    </div>
</div>
