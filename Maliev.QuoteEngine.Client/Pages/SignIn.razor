@page "/auth/sign-in"
@inject QuoteEngineApiClient Api
@inject NavigationManager Navigation

<PageTitle>Sign in - MALIEV Quote Engine</PageTitle>

<div class="auth-panel">
    <span class="eyebrow">Customer account</span>
    <h1>Sign in</h1>
    <button class="primary-button full" @onclick="SignInWithGoogleAsync">Continue with Google</button>
    <div class="auth-divider">or use email</div>
    <label>Email <input type="email" @bind="_email" /></label>
    <label>Password <input type="password" @bind="_password" /></label>
    <button class="secondary-button full" @onclick="SignInAsync">Sign in with email</button>
    <a class="text-button" href="/auth/sign-up">Create account</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _email = "customer@example.com";
    private string _password = string.Empty;

    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith("/", StringComparison.Ordinal)
        ? "/projects/new"
        : ReturnUrl;

    private async Task SignInWithGoogleAsync()
    {
        await Api.ExchangeGoogleAsync();
        Navigation.NavigateTo(SafeReturnUrl);
    }

    private async Task SignInAsync()
    {
        await Api.SignInAsync(new SignInRequest { Email = _email, Password = _password });
        Navigation.NavigateTo(SafeReturnUrl);
    }
}
