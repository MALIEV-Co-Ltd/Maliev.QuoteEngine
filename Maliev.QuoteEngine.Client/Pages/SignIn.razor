@page "/auth/sign-in"
@inject QuoteEngineApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Text("Sign in - MALIEV Quote Engine", "เข้าสู่ระบบ - MALIEV Quote Engine")</PageTitle>

<section class="auth-shell">
    <div class="auth-panel">
        <h1 class="auth-title">
            <span>@Text("Sign in to", "เข้าสู่ระบบ")</span>
            <img class="auth-title-logo" src="/images/logo.svg" width="154" height="35" alt="MALIEV" />
        </h1>
        <p>@Text("Use your customer account for quotes, uploaded CAD files, DFM review, orders, NDAs, and documents.", "ใช้บัญชีลูกค้าของคุณสำหรับใบเสนอราคา ไฟล์ CAD ที่อัปโหลด การตรวจ DFM คำสั่งซื้อ NDA และเอกสาร")</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-error">@_error</div>
        }

        <a class="auth-google" href="@GoogleHref" aria-label="@Text("Continue with Google", "ดำเนินการต่อด้วย Google")">
            <span class="auth-google-icon" aria-hidden="true">
                <svg viewBox="0 0 18 18" focusable="false">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.08-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.87 2.69-6.62z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33C2.44 15.98 5.48 18 9 18z" />
                    <path fill="#FBBC05" d="M3.96 10.71A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.17.28-1.71V4.96H.96A8.96 8.96 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.33z" />
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.33C4.67 5.16 6.66 3.58 9 3.58z" />
                </svg>
            </span>
            <span>@Text("Continue with Google", "ดำเนินการต่อด้วย Google")</span>
        </a>

        <details class="auth-email-panel" open="@EmailPanelOpen">
            <summary>@Text("Use email instead", "ใช้ email แทน")</summary>
            <div class="auth-form">
                <label>
                    @Text("Email", "อีเมล")
                    <input type="email" autocomplete="email" inputmode="email" placeholder="name@company.com" aria-describedby="sign-in-email-requirements" @bind="_email" required />
                    <small id="sign-in-email-requirements" class="auth-field-help">@Text("Use a full email address, for example name@company.com.", "ใช้อีเมลแบบเต็ม เช่น name@company.com")</small>
                </label>
                <label>
                    @Text("Password", "รหัสผ่าน")
                    <input type="password" autocomplete="current-password" minlength="6" aria-describedby="sign-in-password-requirements" @bind="_password" required />
                    <small id="sign-in-password-requirements" class="auth-field-help">@Text("Password must be at least 6 characters.", "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร")</small>
                </label>
                <button type="button" class="primary-button full" @onclick="SignInAsync">@Text("Sign in", "เข้าสู่ระบบ")</button>
            </div>
        </details>

        <div class="auth-links">
            <a href="@SignUpHref">@Text("Create account", "สร้างบัญชี")</a>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith("/", StringComparison.Ordinal)
        ? "/quote/new"
        : ReturnUrl;

    private string SignUpHref => $"/auth/sign-up?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
    private string GoogleHref => $"/auth/google?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
    private bool EmailPanelOpen => !string.IsNullOrWhiteSpace(_error);

    private async Task SignInAsync()
    {
        try
        {
            _error = null;
            await Api.SignInAsync(new SignInRequest { Email = _email, Password = _password });
            Navigation.NavigateTo(SafeReturnUrl);
        }
        catch (Exception)
        {
            _error = Text("Email or password sign-in could not be completed.", "ไม่สามารถเข้าสู่ระบบด้วยอีเมลหรือรหัสผ่านได้");
        }
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }
}
