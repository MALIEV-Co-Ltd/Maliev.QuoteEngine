@page "/auth/sign-in"
@inject QuoteEngineApiClient Api
@inject NavigationManager Navigation

<PageTitle>Sign in - MALIEV Quote Engine</PageTitle>

<div class="auth-panel">
    <span class="eyebrow">Customer account</span>
    <h1>Sign in</h1>
    <label>Email <input type="email" @bind="_email" /></label>
    <label>Password <input type="password" @bind="_password" /></label>
    <button class="primary-button full" @onclick="SignInAsync">Sign in</button>
    <a class="text-button" href="/auth/sign-up">Create account</a>
</div>

@code {
    private string _email = "customer@example.com";
    private string _password = string.Empty;

    private async Task SignInAsync()
    {
        await Api.SignInAsync(new SignInRequest { Email = _email, Password = _password });
        Navigation.NavigateTo("/quotes/new");
    }
}
