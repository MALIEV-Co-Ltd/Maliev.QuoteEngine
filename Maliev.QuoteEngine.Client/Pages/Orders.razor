@page "/orders"
@using System.Globalization
@inject QuoteEngineApiClient Api

<PageTitle>@Text("Orders - MALIEV Quote Engine", "คำสั่งซื้อ - MALIEV Quote Engine")</PageTitle>

<main class="orders-dashboard">
    <div class="section-heading">
        <span class="eyebrow">@Text("Manufacturing orders", "คำสั่งผลิต")</span>
        <h1>@Text("Track custom production", "ติดตามงานผลิตตามสั่ง")</h1>
        <p>@Text("Review active manufacturing, delivery progress, and completed order history.", "ตรวจสอบงานผลิตที่กำลังดำเนินการ ความคืบหน้าการจัดส่ง และประวัติคำสั่งซื้อที่เสร็จสิ้น")</p>
    </div>

    <section class="orders-summary-grid" aria-label="@Text("Order summary", "สรุปคำสั่งซื้อ")">
        <article>
            <span>@Text("Active", "กำลังดำเนินการ")</span>
            <strong>@ActiveOrders.Count</strong>
        </article>
        <article>
            <span>@Text("Completed", "เสร็จสิ้น")</span>
            <strong>@CompletedOrders.Count</strong>
        </article>
        <article>
            <span>@Text("Total", "ทั้งหมด")</span>
            <strong>@_orders.Count</strong>
        </article>
    </section>

    @if (!_orders.Any())
    {
        <div class="empty-state">
            <p>@Text("No manufacturing orders yet.", "ยังไม่มีคำสั่งผลิต")</p>
            <a class="primary-button" href="/quotes/new">@Text("Start a quote", "เริ่มขอราคา")</a>
        </div>
    }
    else
    {
        <section class="orders-section" data-orders-section="active">
            <div class="orders-section-heading">
                <h2>@Text("Active orders", "คำสั่งซื้อที่กำลังดำเนินการ")</h2>
                <span>@ActiveOrders.Count</span>
            </div>
            @if (ActiveOrders.Count == 0)
            {
                <div class="empty-state">
                    <p>@Text("No active manufacturing orders.", "ไม่มีคำสั่งผลิตที่กำลังดำเนินการ")</p>
                </div>
            }
            else
            {
                <div class="data-list">
                    @foreach (var order in ActiveOrders)
                    {
                        <a class="data-row orders-row" href="/orders/@Uri.EscapeDataString(order.OrderNumber)">
                            <span>@order.OrderNumber</span>
                            <strong>@order.Status</strong>
                            <small>@order.TrackingLabel · @FormatDate(order.UpdatedAt)</small>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="orders-section" data-orders-section="completed">
            <div class="orders-section-heading">
                <h2>@Text("Completed history", "ประวัติที่เสร็จสิ้น")</h2>
                <span>@CompletedOrders.Count</span>
            </div>
            @if (CompletedOrders.Count == 0)
            {
                <div class="empty-state">
                    <p>@Text("Completed orders will appear here.", "คำสั่งซื้อที่เสร็จสิ้นจะแสดงที่นี่")</p>
                </div>
            }
            else
            {
                <div class="data-list">
                    @foreach (var order in CompletedOrders)
                    {
                        <a class="data-row orders-row" href="/orders/@Uri.EscapeDataString(order.OrderNumber)">
                            <span>@order.OrderNumber</span>
                            <strong>@order.Status</strong>
                            <small>@order.TrackingLabel · @FormatDate(order.UpdatedAt)</small>
                        </a>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    private IReadOnlyList<CustomerOrderSummaryDto> _orders = [];

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private IReadOnlyList<CustomerOrderSummaryDto> ActiveOrders => _orders
        .Where(order => !IsCompletedOrder(order))
        .OrderByDescending(order => order.UpdatedAt)
        .ToArray();

    private IReadOnlyList<CustomerOrderSummaryDto> CompletedOrders => _orders
        .Where(IsCompletedOrder)
        .OrderByDescending(order => order.UpdatedAt)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _orders = await Api.GetOrdersAsync();
    }

    private static bool IsCompletedOrder(CustomerOrderSummaryDto order)
    {
        return order.Status.Contains("delivered", StringComparison.OrdinalIgnoreCase) ||
            order.Status.Contains("completed", StringComparison.OrdinalIgnoreCase) ||
            order.Status.Contains("cancelled", StringComparison.OrdinalIgnoreCase);
    }

    private string FormatDate(DateTimeOffset value)
    {
        return value.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture)));
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }
}
