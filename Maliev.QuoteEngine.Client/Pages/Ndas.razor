@page "/ndas"
@inject QuoteEngineApiClient Api

<PageTitle>NDAs - MALIEV Quote Engine</PageTitle>

<div class="section-heading">
    <span class="eyebrow">Confidentiality</span>
    <h1>NDAs</h1>
</div>

<div class="data-list">
    @foreach (var nda in _ndas)
    {
        <div class="data-row">
            <span>@nda.Title</span>
            <strong>@nda.Status</strong>
            <small>@NdaDateLine(nda)</small>
        </div>
    }
</div>

@code {
    private IReadOnlyList<CustomerNdaDto> _ndas = [];

    protected override async Task OnInitializedAsync()
    {
        _ndas = await Api.GetNdasAsync();
    }

    private static string NdaDateLine(CustomerNdaDto nda)
    {
        return nda.ExpiresAt.HasValue
            ? $"Expires {nda.ExpiresAt.Value.ToLocalTime():d MMM yyyy}"
            : $"Updated {nda.UpdatedAt.ToLocalTime():d MMM yyyy}";
    }
}
