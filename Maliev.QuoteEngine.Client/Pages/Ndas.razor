@page "/ndas"
@inject QuoteEngineApiClient Api

<PageTitle>@Text("NDAs - MALIEV Quote Engine", "NDA - MALIEV Quote Engine")</PageTitle>

<div class="section-heading">
    <span class="eyebrow">@Text("Confidentiality", "การรักษาความลับ")</span>
    <h1>NDAs</h1>
</div>

<div class="data-list">
    @foreach (var nda in _ndas)
    {
        <div class="data-row">
            <span>@nda.Title</span>
            <strong>@nda.Status</strong>
            <small>@NdaDateLine(nda)</small>
        </div>
    }
</div>

@code {
    private IReadOnlyList<CustomerNdaDto> _ndas = [];

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    protected override async Task OnInitializedAsync()
    {
        _ndas = await Api.GetNdasAsync();
    }

    private string NdaDateLine(CustomerNdaDto nda)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfo(SupportedCultures.Normalize(Culture));
        return nda.ExpiresAt.HasValue
            ? $"{Text("Expires", "หมดอายุ")} {nda.ExpiresAt.Value.ToLocalTime().ToString("d MMM yyyy", culture)}"
            : $"{Text("Updated", "อัปเดต")} {nda.UpdatedAt.ToLocalTime().ToString("d MMM yyyy", culture)}";
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }
}
