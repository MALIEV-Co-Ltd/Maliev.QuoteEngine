@inject PreferenceService Preferences
@implements IDisposable

<div class="appearance-panel">
    <div class="appearance-theme-modes" role="group" aria-label="@Text("Appearance mode", "โหมดรูปลักษณ์")">
        @foreach (var mode in ThemeModeOptions)
        {
            <button type="button"
                    class="@ThemeModeClass(mode.Theme)"
                    @onclick="@(() => SetThemeModeAsync(mode.Theme))">
                <span class="@ThemeModePreviewFrameClass(mode.Theme)" aria-hidden="true">
                    @foreach (var previewTheme in ThemeModePreviewThemes(mode.Theme))
                    {
                        var previewProfile = ThemeProfile(previewTheme);
                        <span class="@StudioPreviewClass(previewTheme)" style="@StudioPreviewStyle(previewProfile)">
                            <span class="appearance-preview-rail">
                                <strong>MALIEV</strong>
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                            <span class="appearance-preview-workspace">
                                <span class="appearance-preview-head">
                                    <span>
                                        <strong>Make Studio</strong>
                                        <span>@ThemeProfileTitle(previewTheme)</span>
                                    </span>
                                    <i></i>
                                </span>
                                <span class="appearance-preview-board">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </span>
                                <span class="appearance-preview-foot">
                                    <span></span>
                                    <strong>@Text("Quote", "ใบเสนอราคา")</strong>
                                </span>
                            </span>
                        </span>
                    }
                </span>
                <strong>@Text(mode.LabelEn, mode.LabelTh)</strong>
                <small>@Text(mode.DescriptionEn, mode.DescriptionTh)</small>
            </button>
        }
    </div>

    @foreach (var themeName in ProfileThemes)
    {
        var profile = ThemeProfile(themeName);
        <section class="appearance-profile-card" data-theme-profile="@themeName">
            <header>
                <strong>@ThemeProfileTitle(themeName)</strong>
                <div>
                    <button type="button"
                            class="appearance-reset-button"
                            @onclick="@(() => ResetThemeProfileAsync(themeName))">
                        @Text("Reset", "รีเซ็ต")
                    </button>
                    <select class="appearance-preset-select"
                            value="make-studio"
                            aria-label="@Text("Theme preset", "พรีเซ็ตธีม")">
                        <option value="make-studio">Make Studio</option>
                    </select>
                </div>
            </header>

            <label class="appearance-profile-row">
                <span>@Text("Accent", "สีเน้น")</span>
                <span class="appearance-color-input">
                    <input type="color"
                           value="@profile.Accent"
                           @oninput="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { Accent = args.Value?.ToString() ?? string.Empty }))" />
                    <span>@profile.Accent</span>
                </span>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("Background", "พื้นหลัง")</span>
                <span class="appearance-color-input">
                    <input type="color"
                           value="@profile.Background"
                           @oninput="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { Background = args.Value?.ToString() ?? string.Empty }))" />
                    <span>@profile.Background</span>
                </span>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("Foreground", "ตัวอักษร")</span>
                <span class="appearance-color-input">
                    <input type="color"
                           value="@profile.Foreground"
                           @oninput="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { Foreground = args.Value?.ToString() ?? string.Empty }))" />
                    <span>@profile.Foreground</span>
                </span>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("UI font", "ฟอนต์ UI")</span>
                <select class="appearance-font-select"
                        value="@profile.UiFont"
                        aria-label="@Text("UI font", "ฟอนต์ UI")"
                        @onchange="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { UiFont = args.Value?.ToString() ?? PreferenceService.DefaultUiFont }))">
                    @foreach (var choice in UiFontChoices)
                    {
                        <option value="@choice.Stack">@FontChoiceLabel(choice)</option>
                    }
                    @if (!IsKnownFont(profile.UiFont, UiFontChoices))
                    {
                        <option value="@profile.UiFont">@Text("Saved Studio font", "ฟอนต์ Studio ที่บันทึกไว้")</option>
                    }
                </select>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("Code font", "ฟอนต์โค้ด")</span>
                <select class="appearance-font-select"
                        value="@profile.CodeFont"
                        aria-label="@Text("Code font", "ฟอนต์โค้ด")"
                        @onchange="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { CodeFont = args.Value?.ToString() ?? PreferenceService.DefaultCodeFont }))">
                    @foreach (var choice in CodeFontChoices)
                    {
                        <option value="@choice.Stack">@FontChoiceLabel(choice)</option>
                    }
                    @if (!IsKnownFont(profile.CodeFont, CodeFontChoices))
                    {
                        <option value="@profile.CodeFont">@Text("Saved Studio font", "ฟอนต์ Studio ที่บันทึกไว้")</option>
                    }
                </select>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("Translucent sidebar", "แถบด้านข้างโปร่งแสง")</span>
                <span class="appearance-toggle">
                    <input type="checkbox"
                           checked="@profile.TranslucentSidebar"
                           @onchange="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { TranslucentSidebar = args.Value is true }))" />
                </span>
            </label>

            <label class="appearance-profile-row">
                <span>@Text("Contrast", "คอนทราสต์")</span>
                <span class="appearance-range">
                    <input type="range"
                           min="0"
                           max="100"
                           value="@profile.Contrast"
                           @oninput="@((ChangeEventArgs args) => UpdateThemeProfileAsync(themeName, current => current with { Contrast = NormalizeContrast(args.Value?.ToString(), current.Contrast) }))" />
                    <output>@profile.Contrast</output>
                </span>
            </label>
        </section>
    }
</div>

@code {
    private static readonly string[] ProfileThemes = [PreferenceService.LightTheme, PreferenceService.DarkTheme];

    private static readonly ThemeModeOption[] ThemeModeOptions =
    [
        new(PreferenceService.SystemTheme, "Auto", "อัตโนมัติ", "System", "ระบบ"),
        new(PreferenceService.LightTheme, "Light", "สว่าง", "Light profile", "โปรไฟล์สว่าง"),
        new(PreferenceService.DarkTheme, "Dark", "มืด", "Dark profile", "โปรไฟล์มืด")
    ];

    private static readonly string[] SystemModePreviewThemes = [PreferenceService.LightTheme, PreferenceService.DarkTheme];
    private static readonly string[] LightModePreviewThemes = [PreferenceService.LightTheme];
    private static readonly string[] DarkModePreviewThemes = [PreferenceService.DarkTheme];

    private static readonly FontChoice[] UiFontChoices =
    [
        new("MALIEV system", "MALIEV system", PreferenceService.DefaultUiFont),
        new("Noto Sans Thai", "Noto Sans Thai", "\"Noto Sans Thai\", \"Noto Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"),
        new("Segoe UI", "Segoe UI", "\"Segoe UI Variable Text\", \"Segoe UI\", \"Noto Sans\", \"Noto Sans Thai\", sans-serif")
    ];

    private static readonly FontChoice[] CodeFontChoices =
    [
        new("MALIEV mono", "MALIEV mono", PreferenceService.DefaultCodeFont),
        new("SF Mono", "SF Mono", "\"SFMono-Regular\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace"),
        new("Consolas", "Consolas", "Consolas, \"Liberation Mono\", Menlo, monospace")
    ];

    private ThemeProfilePreference LightProfile => Preferences.LightThemeProfile;

    private ThemeProfilePreference DarkProfile => Preferences.DarkThemeProfile;

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        await Preferences.InitializeAsync();
    }

    private Task SetThemeModeAsync(string mode)
    {
        return Preferences.SetThemeAsync(mode);
    }

    private Task ResetThemeProfileAsync(string theme)
    {
        return Preferences.ResetThemeProfileAsync(theme);
    }

    private Task UpdateThemeProfileAsync(string theme, Func<ThemeProfilePreference, ThemeProfilePreference> update)
    {
        var current = ThemeProfile(theme);
        return Preferences.SetThemeProfileAsync(theme, update(current));
    }

    private ThemeProfilePreference ThemeProfile(string theme)
    {
        return Preferences.GetThemeProfile(theme);
    }

    private string ThemeModeClass(string theme)
    {
        return Preferences.Theme == theme ? "appearance-mode-option is-active" : "appearance-mode-option";
    }

    private static string ThemeModePreviewFrameClass(string theme)
    {
        return theme == PreferenceService.SystemTheme
            ? "appearance-mode-preview-frame appearance-mode-preview-frame--system"
            : "appearance-mode-preview-frame";
    }

    private static IReadOnlyList<string> ThemeModePreviewThemes(string theme)
    {
        return theme == PreferenceService.SystemTheme
            ? SystemModePreviewThemes
            : theme == PreferenceService.DarkTheme
                ? DarkModePreviewThemes
                : LightModePreviewThemes;
    }

    private string ThemeProfileTitle(string theme)
    {
        return theme == PreferenceService.DarkTheme
            ? Text("Dark theme", "ธีมมืด")
            : Text("Light theme", "ธีมสว่าง");
    }

    private static bool IsKnownFont(string font, IReadOnlyList<FontChoice> choices)
    {
        return choices.Any(choice => string.Equals(choice.Stack, font, StringComparison.Ordinal));
    }

    private string FontChoiceLabel(FontChoice choice)
    {
        return Text(choice.LabelEn, choice.LabelTh);
    }

    private static string StudioPreviewClass(string theme)
    {
        return theme == PreferenceService.DarkTheme
            ? "appearance-preview-card is-dark"
            : "appearance-preview-card is-light";
    }

    private static string StudioPreviewStyle(ThemeProfilePreference profile)
    {
        return $"--appearance-preview-accent: {profile.Accent}; --appearance-preview-bg: {profile.Background}; --appearance-preview-fg: {profile.Foreground}; --appearance-preview-contrast: {profile.Contrast};";
    }

    private static int NormalizeContrast(string? value, int fallback)
    {
        return int.TryParse(value, out var contrast) ? Math.Clamp(contrast, 0, 100) : fallback;
    }

    private string Text(string en, string th)
    {
        return Preferences.Text(en, th);
    }

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
    }

    private sealed record FontChoice(string LabelEn, string LabelTh, string Stack);

    private sealed record ThemeModeOption(
        string Theme,
        string LabelEn,
        string LabelTh,
        string DescriptionEn,
        string DescriptionTh);
}
