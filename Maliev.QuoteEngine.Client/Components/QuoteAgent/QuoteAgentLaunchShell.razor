        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JSException)
        {
            _error = Text(
                "The chat PDF could not be exported right now. Please try again.",
                "ยังไม่สามารถส่งออกแชทเป็น PDF ได้ในตอนนี้ กรุณาลองอีกครั้ง");
