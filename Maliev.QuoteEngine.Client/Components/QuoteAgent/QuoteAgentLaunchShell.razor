    {
        return part.Status is "Uploading" or "WaitingForUpload" ||
            string.IsNullOrWhiteSpace(part.UploadId) &&
            string.IsNullOrWhiteSpace(part.StoragePath) &&
            string.IsNullOrWhiteSpace(part.Url) &&
            !part.Kind.Equals("sketch", StringComparison.OrdinalIgnoreCase);
