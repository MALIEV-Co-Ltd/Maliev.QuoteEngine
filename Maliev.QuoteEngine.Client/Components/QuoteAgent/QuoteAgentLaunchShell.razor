            return;
        }

        _sketchTitle = Text($"{cleaned} annotation", $"โน้ตรูป {cleaned}");
    }

    private async Task AttachSketchAsync()
    {
        if (string.IsNullOrWhiteSpace(_sketchTitle) ||
            _sketchTitle.Equals("Untitled sketch", StringComparison.OrdinalIgnoreCase))
        {
            _sketchTitle = Text("Manufacturing sketch", "สเก็ตช์งานผลิต");
        }

        if (_sketchModule is not null)
        {
            _lastSketchDataUrl = await _sketchModule.InvokeAsync<string>("exportSketchCanvas", SketchCanvasId);
        }

        QueueSketchComposerAttachment(_sketchTitle, _lastSketchDataUrl);
        if (_sketchModule is not null)
        {
            await _sketchModule.InvokeVoidAsync("disposeSketchCanvas", SketchCanvasId);
        }

        _sketchOpen = false;
        await RefreshPendingAttachmentPreviewAsync();
        await FocusComposerAsync();
    }

    private void QueueSketchComposerAttachment(string title, string? previewDataUrl)
    {
        var fileName = BuildSketchFileName(title);
        var attachment = new ComposerAttachmentPreview(
            Guid.NewGuid(),
            fileName,
            "image/png",
            previewDataUrl?.Length ?? 0,
            previewDataUrl,
            "sketch",
            null,
            null,
            previewDataUrl,
            false,
            "Ready");

        _pendingComposerAttachments.Add(attachment);
    }

    private async Task RefreshPendingAttachmentPreviewAsync()
    {
        if (_pendingComposerAttachments.Count == 0)
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
        await FocusComposerAsync();
    }

    private static string BuildSketchFileName(string title)
    {
