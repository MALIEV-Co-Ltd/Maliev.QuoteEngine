    private async Task EnsureAgentNotificationConnectionAsync()
    {
        try
        {
            if (_notificationConnection is null)
            {
                _notificationConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/hubs/quote-notifications"))
                    .WithAutomaticReconnect()
                    .Build();

                _notificationConnection.On<QuoteAgentThinkingStepDto>("QuoteAgentThinkingStep", step =>
                {
                    _ = InvokeAsync(() => ApplyStreamingThinkingStep(step));
                });
            }

            if (_notificationConnection.State == HubConnectionState.Disconnected)
            {
                await _notificationConnection.StartAsync();
            }

            if (_joinedQuoteSessionId != SessionId && _notificationConnection.State == HubConnectionState.Connected)
            {
                if (_joinedQuoteSessionId.HasValue)
                {
                    await _notificationConnection.InvokeAsync("LeaveQuoteSessionGroup", _joinedQuoteSessionId.Value);
                }

                await _notificationConnection.InvokeAsync("JoinQuoteSessionGroup", SessionId);
                _joinedQuoteSessionId = SessionId;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _agentBackendStatusMessage = Text(
                "Live reasoning updates are temporarily unavailable. The final response will still include completed steps.",
                "การอัปเดตขั้นตอนแบบสดยังไม่พร้อมใช้งานชั่วคราว คำตอบสุดท้ายจะยังมีขั้นตอนที่เสร็จแล้ว");
        }
    }

    private void ApplyStreamingThinkingStep(QuoteAgentThinkingStepDto step)
    {
        if (_disposed)
        {
            return;
        }

        var assistantMessage = _messages.LastOrDefault(message =>
            message.Role.Equals("assistant", StringComparison.OrdinalIgnoreCase) &&
            message.IsProcessing);
        if (assistantMessage is null)
        {
            return;
        }

        UpsertThinkingStep(assistantMessage, step);
        RequestScrollToLatestMessage();
        StateHasChanged();
    }

    private static void UpsertThinkingStep(AgentMessageRow assistantMessage, QuoteAgentThinkingStepDto step)
    {
        if (step.StepNumber <= 0)
        {
            step.StepNumber = assistantMessage.ThinkingSteps.Count + 1;
        }

        var index = assistantMessage.ThinkingSteps.FindIndex(existing =>
            existing.StepNumber == step.StepNumber ||
            (!string.IsNullOrWhiteSpace(step.Type) &&
             existing.Type.Equals(step.Type, StringComparison.OrdinalIgnoreCase) &&
             existing.Title.Equals(step.Title, StringComparison.OrdinalIgnoreCase)));
        if (index >= 0)
        {
            assistantMessage.ThinkingSteps[index] = step;
            return;
        }

        assistantMessage.ThinkingSteps.Add(step);
    }

    private async Task ApplyUiDirectivesAsync(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives, bool suppressPanelAutoOpen = false)
    {
        if (directives.Count == 0)
        {
            return;
        }

        _uiFocusDirectives = directives.ToList();
        // Mid-conversation agent directives may still focus a panel (agent-directed
        // workbench focus); upload/attach refreshes pass suppressPanelAutoOpen so the
        // panel never pops open just because files were added.
        if (!suppressPanelAutoOpen)
        {
            OpenDirectivePanel(_uiFocusDirectives);
        }

        SelectDirectiveUploadTarget(_uiFocusDirectives);
        ActivateUiHighlights(_uiFocusDirectives);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenDirectivePanel(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        var panel = directives
            .Select(directive => directive.Panel)
            .FirstOrDefault(item =>
                item.Equals("summary", StringComparison.OrdinalIgnoreCase) ||
                item.Equals("artifacts", StringComparison.OrdinalIgnoreCase) ||
                item.Equals("workbench", StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(panel))
        {
            return;
        }

        if (panel.Equals("summary", StringComparison.OrdinalIgnoreCase))
        {
            _summaryPanelOpen = true;
            _artifactPanelOpen = false;
            return;
        }

        _artifactPanelOpen = true;
        _summaryPanelOpen = false;
    }

    private void SelectDirectiveUploadTarget(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        if (UploadedParts.Count == 0)
        {
            return;
        }

        var partTarget = directives
            .Select(directive => directive.TargetId)
            .FirstOrDefault(target => Guid.TryParse(target, out _));
        if (string.IsNullOrWhiteSpace(partTarget))
        {
            return;
        }

        var index = UploadedParts
            .Select((part, partIndex) => new { part, partIndex })
            .FirstOrDefault(item => item.part.PartId.ToString("D").Equals(partTarget, StringComparison.OrdinalIgnoreCase))
            ?.partIndex ?? -1;
        if (index >= 0 && OnUploadedPartSelected.HasDelegate)
        {
            _ = SelectUploadedPartAsync(index);
        }
    }

    private void ActivateUiHighlights(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        _activeUiHighlightKeys.Clear();
        foreach (var directive in directives)
        {
            if (!string.IsNullOrWhiteSpace(directive.HighlightKey))
            {
                _activeUiHighlightKeys.Add(directive.HighlightKey);
            }
        }

        var focusVersion = ++_uiFocusVersion;
        _ = ClearUiFocusHighlightsLaterAsync(focusVersion);
    }

    private async Task ClearUiFocusHighlightsLaterAsync(int focusVersion)
    {
        await Task.Delay(TimeSpan.FromSeconds(7));
        if (focusVersion != _uiFocusVersion)
        {
            return;
        }

        _activeUiHighlightKeys.Clear();
        _uiFocusDirectives = [];
        await InvokeAsync(StateHasChanged);
    }

