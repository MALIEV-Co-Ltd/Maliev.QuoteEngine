    private sealed class AgentMessageRow(
        string role,
        string content,
        AgentWorkbenchSnapshot? workbench = null,
        IReadOnlyList<ComposerAttachmentPreview>? attachments = null,
        string? sketchPreviewDataUrl = null,
        DateTimeOffset? createdAt = null)
    {
        public Guid Id { get; } = Guid.NewGuid();

        public string Role { get; } = role;

        public string Content { get; set; } = content;

        public string? ReplyToPreview { get; set; }

        public string PendingStreamContent { get; set; } = string.Empty;

        public bool StreamRevealRunning { get; set; }

        public bool IsProcessing { get; set; }

        public bool IsThinking { get; set; }

        public DateTimeOffset? ThinkingStartedAt { get; set; }

        public int ThinkingDurationSeconds { get; set; }

        public List<ReasoningEntry> ReasoningEntries { get; } = [];

        public bool HasReasoning => ReasoningEntries.Count > 0;

        public void AppendReasoningThought(string? text)
        {
            if (string.IsNullOrEmpty(text))
            {
                return;
            }

            if (ReasoningEntries.Count > 0 && !ReasoningEntries[^1].IsTool)
            {
                ReasoningEntries[^1].Text += text;
            }
            else
            {
                ReasoningEntries.Add(new ReasoningEntry { Text = text });
            }
        }

        public void AddReasoningTool(string? text)
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return;
            }

            ReasoningEntries.Add(new ReasoningEntry { IsTool = true, Text = text.Trim() });
        }

        public IReadOnlyList<ComposerAttachmentPreview> Attachments { get; } = attachments ?? [];

        public List<QuoteAgentThinkingStepDto> ThinkingSteps { get; set; } = [];

        public AgentWorkbenchSnapshot? Workbench { get; } = workbench;

        public string? SketchPreviewDataUrl { get; } = sketchPreviewDataUrl;

        public InlineViewerInfo? InlineViewer { get; set; }

        public QuoteAgentCustomerQuestionDto? CustomerQuestion { get; set; }

        public string? CustomerQuestionAnswer { get; set; }

        public DateTimeOffset CreatedAt { get; } = createdAt ?? DateTimeOffset.Now;

        public bool HasExternalAttachments => Attachments.Count > 0 || !string.IsNullOrWhiteSpace(SketchPreviewDataUrl);
    }

