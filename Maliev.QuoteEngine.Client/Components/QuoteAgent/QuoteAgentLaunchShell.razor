    private string? ArtifactPreviewUrl(QuoteAgentArtifactDto artifact)
    {
        var url = !string.IsNullOrWhiteSpace(artifact.Url)
            ? artifact.Url.Trim()
            : ArtifactMetadata(artifact, "storagePath");
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        if (url.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("blob:", StringComparison.OrdinalIgnoreCase) ||
            Uri.TryCreate(url, UriKind.Absolute, out _) ||
            url.StartsWith("/", StringComparison.Ordinal))
        {
            return url;
        }

        return $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/download?path={Uri.EscapeDataString(url)}";
    }

    private string PreviewUrlForUploadedPart(QuotePartViewModel part)
    {
        if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
        {
            return part.ThumbnailUrl;
        }

        if (!string.IsNullOrWhiteSpace(part.GlbUrl))
        {
            return part.GlbUrl;
        }

        return !string.IsNullOrWhiteSpace(part.StoragePath) &&
            IsPreviewableContent(part.ContentType, part.FileName)
                ? $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/download?path={Uri.EscapeDataString(part.StoragePath)}"
                : string.Empty;
    }

    private static bool IsImagePreview(PreviewItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ContentType) &&
            item.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (item.Url.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        var extension = PreviewExtension(item);
        return QuoteUploadConstraints.SupplementalImageExtensions.Any(value =>
            value.Equals(extension, StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsPdfPreview(PreviewItem item)
    {
        return string.Equals(item.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase) ||
            PreviewExtension(item).Equals("pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string? ArtifactMetadata(QuoteAgentArtifactDto artifact, string key)
    {
        return artifact.Metadata.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value.Trim()
            : null;
    }

    private static string? ArtifactContentType(QuoteAgentArtifactDto artifact)
    {
        return ArtifactMetadata(artifact, "contentType");
    }

    private static bool IsPreviewableContent(string? contentType, string fileName)
    {
        return contentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true ||
            string.Equals(contentType, "application/pdf", StringComparison.OrdinalIgnoreCase) ||
            PreviewExtension(fileName).Equals("pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string PreviewExtension(PreviewItem item)
    {
        var extension = PreviewExtension(item.Title);
        return string.IsNullOrWhiteSpace(extension)
            ? PreviewExtension(item.Url)
            : extension;
    }

    private static string PreviewExtension(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var queryIndex = value.IndexOf('?', StringComparison.Ordinal);
        var probe = queryIndex >= 0 ? value[..queryIndex] : value;
        return Path.GetExtension(probe).TrimStart('.');
    }

