    private string ArtifactStatusLabel(QuoteAgentArtifactDto artifact, QuotePartViewModel? dfmPart = null)
    {
        if (dfmPart is not null)
        {
            return DfmChecksStatusLabel(dfmPart);
        }

        if (artifact.ArtifactType.Equals("pricing", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(ArtifactMetadata(artifact, "total")) &&
            !string.IsNullOrWhiteSpace(ArtifactMetadata(artifact, "currency")))
        {
            return $"{ArtifactMetadata(artifact, "total")} {ArtifactMetadata(artifact, "currency")}";
        }

        if (artifact.ArtifactType.Equals("dfm", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(ArtifactMetadata(artifact, "issueCount"), NumberStyles.Integer, CultureInfo.InvariantCulture, out var issueCount))
        {
            return issueCount == 0
                ? Text("No findings recorded", "ยังไม่มีรายการ DFM")
                : Text($"{issueCount} finding(s)", $"{issueCount} รายการ");
        }

        return HumanizeArtifactStatus(artifact.Status);
    }

    private string? ArtifactSummary(QuoteAgentArtifactDto artifact, QuotePartViewModel? dfmPart = null)
    {
        if (dfmPart is not null)
        {
            return DfmChecksSummary(dfmPart);
        }

        var summary = ArtifactMetadata(artifact, "summary");
        if (!string.IsNullOrWhiteSpace(summary))
        {
            return summary;
        }

        return artifact.ArtifactType.ToLowerInvariant() switch
        {
            "dfm" => Text("Manufacturability checks for the selected geometry.", "ผลตรวจความสามารถในการผลิตสำหรับไฟล์ที่เลือก"),
            "pricing" => Text("Pricing waits for a positive validated estimate.", "ราคาจะพร้อมเมื่อมีผลประเมินที่ถูกต้องและมากกว่าศูนย์"),
            "requirements_summary" => Text("Captured project requirements and configuration.", "สรุปข้อกำหนดและการตั้งค่าโปรเจกต์"),
            _ => null
        };
    }

    private IReadOnlyList<ArtifactDetail> ArtifactDetailItems(QuoteAgentArtifactDto artifact, QuotePartViewModel? dfmPart = null)
    {
        var details = new List<ArtifactDetail>
        {
            new(Text("Status", "สถานะ"), ArtifactStatusLabel(artifact, dfmPart))
        };

        AddArtifactDetail(details, Text("Summary", "สรุป"), ArtifactSummary(artifact, dfmPart));
        if (dfmPart is not null)
        {
            var checks = BuildDfmCheckSummaries(dfmPart).ToArray();
            AddArtifactDetail(details, Text("Part", "ชิ้นงาน"), dfmPart.FileName);
            AddArtifactDetail(details, Text("Process", "กระบวนการ"), DfmProcessLabel(dfmPart));
            AddArtifactDetail(details, Text("Geometry checks", "การตรวจเรขาคณิต"), FormatDfmCheckGroup(checks, "geometry"));
            AddArtifactDetail(details, Text("Process checks", "การตรวจกระบวนการ"), FormatDfmCheckGroup(checks, "process"));
            AddArtifactDetail(details, Text("Failed checks", "รายการไม่ผ่าน"), DfmFailedChecksLabel(checks));
            AddArtifactDetail(details, Text("Recorded issues", "ปัญหาที่บันทึก"), DfmIssueCount(dfmPart).ToString(CultureInfo.InvariantCulture));
        }
        else
        {
            AddArtifactDetail(details, Text("Part", "ชิ้นงาน"), ArtifactMetadata(artifact, "partName"));
            AddArtifactDetail(details, Text("DFM findings", "รายการ DFM"), ArtifactMetadata(artifact, "issueCount"));
        }

        if (artifact.ArtifactType.Equals("pricing", StringComparison.OrdinalIgnoreCase))
        {
            AddArtifactDetail(details, Text("Total", "ยอดรวม"), ArtifactStatusLabel(artifact));
        }

        AddArtifactDetail(details, Text("Line items", "รายการราคา"), ArtifactMetadata(artifact, "lineCount"));
        AddArtifactDetail(details, Text("Project parts", "ชิ้นงานในโปรเจกต์"), ArtifactMetadata(artifact, "parts"));

        return details
            .Where(detail => !string.IsNullOrWhiteSpace(detail.Value))
            .GroupBy(detail => detail.Label, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
    }

    private static void AddArtifactDetail(List<ArtifactDetail> details, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            details.Add(new ArtifactDetail(label, value.Trim()));
        }
    }

    private QuotePartViewModel? ResolveDfmArtifactPart(QuoteAgentArtifactDto artifact)
    {
        if (!artifact.ArtifactType.Equals("dfm", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        if (artifact.PartId is { } partId)
        {
            var match = UploadedParts.FirstOrDefault(part => part.PartId == partId);
            if (match is not null)
            {
                return match;
            }
        }

        var partName = ArtifactMetadata(artifact, "partName");
        return string.IsNullOrWhiteSpace(partName)
            ? null
            : UploadedParts.FirstOrDefault(part =>
                part.FileName.Equals(partName, StringComparison.OrdinalIgnoreCase));
    }

    private string DfmChecksStatusLabel(QuotePartViewModel part)
    {
        var checks = BuildDfmCheckSummaries(part).ToArray();
        var resolved = checks.Count(check => check.State != ArtifactCheckState.Pending);
        if (resolved == 0)
        {
            return Text("DFM checks pending", "รอผลตรวจ DFM");
        }

        var failed = checks.Count(check => check.State == ArtifactCheckState.Failed);
        if (failed > 0)
        {
            return Text($"{failed} failed check(s)", $"ไม่ผ่าน {failed} รายการ");
        }

        return Text($"{resolved}/{checks.Length} checks passed", $"ผ่าน {resolved}/{checks.Length} รายการ");
    }

    private string DfmChecksSummary(QuotePartViewModel part)
    {
        var checks = BuildDfmCheckSummaries(part).ToArray();
        var resolved = checks.Count(check => check.State != ArtifactCheckState.Pending);
        if (resolved == 0)
        {
            return Text("Geometry and process DFM checks are waiting for analysis results.", "การตรวจ DFM ด้านเรขาคณิตและกระบวนการกำลังรอผลวิเคราะห์");
        }

        var failed = checks.Count(check => check.State == ArtifactCheckState.Failed);
        var passed = checks.Count(check => check.State == ArtifactCheckState.Passed);
        var pending = checks.Length - resolved;
        if (failed > 0)
        {
            return Text(
                $"{failed} check(s) failed, {passed} passed, {pending} pending for {DfmProcessLabel(part)}.",
                $"ไม่ผ่าน {failed} รายการ ผ่าน {passed} รายการ รอผล {pending} รายการสำหรับ {DfmProcessLabel(part)}");
        }

        return Text(
            $"{passed} check(s) passed for {DfmProcessLabel(part)}.",
            $"ผ่าน {passed} รายการสำหรับ {DfmProcessLabel(part)}");
    }

    private string FormatDfmCheckGroup(IReadOnlyCollection<DfmCheckSummary> checks, string scope)
    {
        var scoped = checks.Where(check => check.Scope.Equals(scope, StringComparison.OrdinalIgnoreCase)).ToArray();
        if (scoped.Length == 0)
        {
            return string.Empty;
        }

        var passed = scoped.Count(check => check.State == ArtifactCheckState.Passed);
        var failed = scoped.Count(check => check.State == ArtifactCheckState.Failed);
        var pending = scoped.Count(check => check.State == ArtifactCheckState.Pending);
        return Text(
            $"{passed} passed, {failed} failed, {pending} pending",
            $"ผ่าน {passed} ไม่ผ่าน {failed} รอผล {pending}");
    }

    private string DfmFailedChecksLabel(IReadOnlyCollection<DfmCheckSummary> checks)
    {
        var failed = checks
            .Where(check => check.State == ArtifactCheckState.Failed)
            .Select(check => check.Label)
            .ToArray();

        return failed.Length == 0
            ? Text("None", "ไม่มี")
            : string.Join(", ", failed);
    }

    private int DfmIssueCount(QuotePartViewModel part) =>
        part.Findings.Count +
        (part.FdmDfmReport?.Issues.Count ?? 0) +
        (part.SlaDfmReport?.Issues.Count ?? 0) +
        (part.CncDfmReport?.Issues.Count ?? 0) +
        (!part.IsManifold && !string.IsNullOrWhiteSpace(part.NonManifoldReason) ? 1 : 0);

    private IReadOnlyList<DfmCheckSummary> BuildDfmCheckSummaries(QuotePartViewModel part)
    {
        var geometryReady = !string.IsNullOrWhiteSpace(part.GlbUrl)
            || part.Status.Equals("GlbReady", StringComparison.OrdinalIgnoreCase)
            || part.Status.Equals("DfmAnalysisReady", StringComparison.OrdinalIgnoreCase);
        var checks = new List<DfmCheckSummary>
        {
            new("geometry", Text("Mesh integrity", "ความสมบูรณ์ของเมช"), !geometryReady ? ArtifactCheckState.Pending : part.IsManifold ? ArtifactCheckState.Passed : ArtifactCheckState.Failed),
            new("geometry", Text("Single body", "บอดี้เดียว"), !geometryReady ? ArtifactCheckState.Pending : part.BodyCount <= 1 ? ArtifactCheckState.Passed : ArtifactCheckState.Failed)
        };

        if (IsSlaDfmProcess(part.ProcessId))
        {
            AddSlaDfmChecks(checks, part.SlaDfmReport);
        }
        else if (IsCncDfmProcess(part.ProcessId))
        {
            AddCncDfmChecks(checks, part.CncDfmReport);
        }
        else
        {
            AddFdmDfmChecks(checks, part.FdmDfmReport);
        }

        return checks;
    }

    private void AddFdmDfmChecks(List<DfmCheckSummary> checks, QeFdmDfmReport? report)
    {
        checks.Add(new("process", Text("Thin walls", "ผนังบาง"), report is null ? ArtifactCheckState.Pending : report.ThinWallCount > 0 ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Overhangs / supports", "ส่วนยื่น / ซัพพอร์ต"), report is null ? ArtifactCheckState.Pending : report.SupportRequired ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Small features", "รายละเอียดขนาดเล็ก"), report is null ? ArtifactCheckState.Pending : report.SmallDetailCount > 0 ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
    }

    private void AddSlaDfmChecks(List<DfmCheckSummary> checks, QeSlaDfmReport? report)
    {
        checks.Add(new("process", Text("Thin walls", "ผนังบาง"), report is null ? ArtifactCheckState.Pending : report.ThinWallCount > 0 ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Resin drainage", "การระบายเรซิน"), report is null ? ArtifactCheckState.Pending : report.ResinTrappingRisk ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Suction risk", "ความเสี่ยงแรงดูด"), report is null ? ArtifactCheckState.Pending : report.SuctionRisk ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Hollow regions", "โพรงภายใน"), report is null ? ArtifactCheckState.Pending : report.HollowRegions ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
    }

    private void AddCncDfmChecks(List<DfmCheckSummary> checks, QeCncDfmReport? report)
    {
        checks.Add(new("process", Text("Internal radii", "รัศมีมุมใน"), report is null ? ArtifactCheckState.Pending : report.SharpCornerCount > 0 ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Undercuts", "อันเดอร์คัต"), report is null ? ArtifactCheckState.Pending : report.HasUndercuts ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("EDM required", "ต้องใช้ EDM"), report is null ? ArtifactCheckState.Pending : report.RequiresEdm ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
        checks.Add(new("process", Text("Surface grinding", "เจียรผิว"), report is null ? ArtifactCheckState.Pending : report.RequiresGrinding ? ArtifactCheckState.Failed : ArtifactCheckState.Passed));
    }

    private string DfmProcessLabel(QuotePartViewModel part) =>
        IsSlaDfmProcess(part.ProcessId)
            ? "SLA"
            : IsCncDfmProcess(part.ProcessId)
                ? "CNC"
                : "FDM";

    private static bool IsSlaDfmProcess(string? processCode)
    {
        if (string.IsNullOrWhiteSpace(processCode))
        {
            return false;
        }

        var normalized = processCode.Trim().Replace("-", "_", StringComparison.Ordinal).ToUpperInvariant();
        return normalized is "SLA" or "DLP" or "SLA_DLP";
    }

    private static bool IsCncDfmProcess(string? processCode)
    {
        if (string.IsNullOrWhiteSpace(processCode))
        {
            return false;
        }

        var normalized = processCode.Trim().Replace("-", "_", StringComparison.Ordinal).ToUpperInvariant();
        return normalized == "CNC" || normalized.StartsWith("CNC_", StringComparison.Ordinal) || normalized is "MILLING" or "TURNING" or "LATHE";
    }

    private string HumanizeArtifactStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return Text("Pending", "รอดำเนินการ");
        }

        var trimmed = status.Trim();
        return trimmed.ToLowerInvariant() switch
        {
            "ready" => Text("Ready", "พร้อม"),
            "needs review" => Text("Needs review", "ต้องตรวจสอบ"),
            "configuration pending" => Text("Configuration pending", "รอการตั้งค่า"),
            _ => trimmed.Replace('_', ' ')
        };
    }

    private static Dictionary<Guid, string> GeneratedViewerArtifactSnapshots(IReadOnlyList<QuoteAgentArtifactDto> artifacts)
    {
        var snapshots = new Dictionary<Guid, string>();
        foreach (var artifact in artifacts.Where(IsGeneratedViewerArtifact))
        {
            snapshots[artifact.ArtifactId] = GeneratedViewerArtifactSignature(artifact);
        }

        return snapshots;
    }

    private static string GeneratedViewerArtifactSignature(QuoteAgentArtifactDto artifact)
    {
        artifact.Metadata.TryGetValue("revision", out var revision);
        artifact.Metadata.TryGetValue("updatedAt", out var updatedAt);
        artifact.Metadata.TryGetValue("cad_commands", out var commandsJson);
        return string.Join(
            '\n',
            revision ?? string.Empty,
            updatedAt ?? string.Empty,
            commandsJson ?? string.Empty);
    }

    private static bool IsGeneratedViewerArtifact(QuoteAgentArtifactDto artifact)
    {
        return artifact.ArtifactType.Equals("viewer", StringComparison.OrdinalIgnoreCase) &&
            artifact.Metadata.TryGetValue("generated", out var generated) &&
            generated.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private static InlineViewerInfo? FindInlinePreview(
        IReadOnlyList<QuoteAgentArtifactDto> artifacts,
        IReadOnlyDictionary<Guid, string>? generatedViewerArtifactsBeforeTurn = null)
    {
        var generated = artifacts.LastOrDefault(a =>
            IsGeneratedViewerArtifact(a) &&
            IsNewOrRevisedGeneratedViewerArtifact(a, generatedViewerArtifactsBeforeTurn));
        if (generated is null)
        {
            return null;
        }

        if (!TryGetGeneratedViewerCommands(generated, out var commandsJson))
        {
            return null;
        }

        return BuildInlineViewerInfo(generated, commandsJson);
    }

    private static bool IsNewOrRevisedGeneratedViewerArtifact(
        QuoteAgentArtifactDto artifact,
        IReadOnlyDictionary<Guid, string>? generatedViewerArtifactsBeforeTurn)
    {
        if (generatedViewerArtifactsBeforeTurn is null)
        {
            return true;
        }

        return !generatedViewerArtifactsBeforeTurn.TryGetValue(artifact.ArtifactId, out var previousSignature) ||
            !string.Equals(previousSignature, GeneratedViewerArtifactSignature(artifact), StringComparison.Ordinal);
    }

    private static InlineViewerInfo BuildInlineViewerInfo(QuoteAgentArtifactDto artifact, string commandsJson)
    {
        return new InlineViewerInfo
        {
            ArtifactId = artifact.ArtifactId,
            CommandsJson = commandsJson,
            FeedbackSentiment = ArtifactMetadata(artifact, "customerSentiment") ?? string.Empty,
            FeedbackComment = ArtifactMetadata(artifact, "customerComment") ?? string.Empty,
            FeedbackStatus = InlineViewerFeedbackStatus(artifact),
            BuildFailed = GeneratedViewerBuildFailed(artifact),
            BuildErrorClass = ArtifactMetadata(artifact, "previewBuildErrorClass")
        };
    }

    private static bool TryGetGeneratedViewerCommands(QuoteAgentArtifactDto artifact, out string commandsJson)
    {
        commandsJson = string.Empty;
        if (!IsGeneratedViewerArtifact(artifact) ||
            !artifact.Metadata.TryGetValue("cad_commands", out var value) ||
            string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        commandsJson = value;
        return true;
    }

    private static string InlineViewerFeedbackStatus(QuoteAgentArtifactDto artifact)
    {
        if (GeneratedViewerBuildFailed(artifact))
        {
            return "3D preview failed to load";
        }

        if (artifact.Status.Equals("customer_approved", StringComparison.OrdinalIgnoreCase))
        {
            return "Design marked usable for this quote";
        }

        if (artifact.Status.Equals("issue_reported", StringComparison.OrdinalIgnoreCase))
        {
            return artifact.Metadata.TryGetValue("feedbackMemoryObserved", out var observed) &&
                observed.Equals("true", StringComparison.OrdinalIgnoreCase)
                    ? "Issue report recorded for future drafts"
                    : "Issue report recorded";
        }

        return artifact.Status.Equals("feedback_recorded", StringComparison.OrdinalIgnoreCase)
            ? "Feedback recorded"
            : string.Empty;
    }

    private static bool GeneratedViewerBuildFailed(QuoteAgentArtifactDto artifact)
    {
        return artifact.Status.Equals("build_failed", StringComparison.OrdinalIgnoreCase) ||
            artifact.Metadata.TryGetValue("previewBuildStatus", out var status) &&
            status.Equals("failed", StringComparison.OrdinalIgnoreCase);
    }

    private static string InlineViewerSentimentClass(InlineViewerInfo viewer, string sentiment)
    {
        return viewer.FeedbackSentiment.Equals(sentiment, StringComparison.OrdinalIgnoreCase)
            ? "qe-inline-viewer-rating-button is-selected"
            : "qe-inline-viewer-rating-button";
    }

    private static string InlineViewerSentimentPressed(InlineViewerInfo viewer, string sentiment)
    {
        return viewer.FeedbackSentiment.Equals(sentiment, StringComparison.OrdinalIgnoreCase) ? "true" : "false";
    }

    private static bool ShouldShowInlineViewerFeedbackForm(InlineViewerInfo viewer)
    {
        return !string.IsNullOrWhiteSpace(viewer.FeedbackSentiment);
    }

    private static void SetInlineViewerSentiment(InlineViewerInfo viewer, string sentiment)
    {
        viewer.FeedbackSentiment = sentiment;
        viewer.FeedbackStatus = string.Empty;
    }

    private static bool CanSubmitInlineViewerFeedback(InlineViewerInfo viewer)
    {
        return !viewer.IsFeedbackSubmitting &&
            viewer.ArtifactId != Guid.Empty &&
            (viewer.FeedbackSentiment.Equals("up", StringComparison.OrdinalIgnoreCase) ||
                viewer.FeedbackSentiment.Equals("down", StringComparison.OrdinalIgnoreCase));
    }

    private async Task SubmitInlineViewerFeedbackAsync(AgentMessageRow message)
    {
        var viewer = message.InlineViewer;
        if (viewer is null || !CanSubmitInlineViewerFeedback(viewer))
        {
            return;
        }

        viewer.IsFeedbackSubmitting = true;
        viewer.FeedbackStatus = Text("Sending feedback…", "กำลังส่งความคิดเห็น...");
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/{viewer.ArtifactId:D}/feedback",
                new QuoteAgentPreviewFeedbackRequest
                {
                    Sentiment = viewer.FeedbackSentiment,
                    Comment = viewer.FeedbackComment.Trim()
                });

            if (!response.IsSuccessStatusCode)
            {
                viewer.FeedbackStatus = Text("Feedback could not be saved.", "ไม่สามารถบันทึกความคิดเห็นได้");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<QuoteAgentPreviewFeedbackResponse>();
            if (result?.State is not null)
            {
                _artifacts = result.State.Artifacts;
                SyncSelectedArtifactWithArtifacts();
                _gates = result.State.Gates;
                _proposedActions = result.State.ProposedActions;
            }

            viewer.FeedbackComment = viewer.FeedbackComment.Trim();
            viewer.FeedbackStatus = viewer.FeedbackSentiment.Equals(ThumbUpSentiment, StringComparison.OrdinalIgnoreCase)
                ? Text("Design marked usable for this quote", "ทำเครื่องหมายว่าแบบนี้ใช้กับใบเสนอราคาได้")
                : result?.MemoryObserved == true
                    ? Text("Issue report recorded for future drafts", "บันทึกรายงานปัญหาสำหรับแบบร่างถัดไปแล้ว")
                    : Text("Issue report recorded", "บันทึกรายงานปัญหาแล้ว");
        }
        catch
        {
            viewer.FeedbackStatus = Text("Feedback could not be saved.", "ไม่สามารถบันทึกความคิดเห็นได้");
        }
        finally
        {
            viewer.IsFeedbackSubmitting = false;
        }
    }

    private async Task HandleInlineViewerBuildOutcomeAsync(InlineViewerInfo? viewer, QeInlinePartViewer.PreviewBuildOutcome outcome)
    {
        if (viewer is null)
        {
            return;
        }

        viewer.BuildFailed = !outcome.Success;
        viewer.BuildErrorClass = outcome.Success ? null : outcome.ErrorClass;
        ApplyPreviewBuildOutcomeToArtifact(viewer.ArtifactId, outcome);
        await InvokeAsync(StateHasChanged);

        await ReportPreviewBuildOutcomeAsync(viewer.ArtifactId, outcome);
    }

    private async Task HandleGeneratedArtifactViewerBuildOutcomeAsync(QuoteAgentArtifactDto? artifact, QeInlinePartViewer.PreviewBuildOutcome outcome)
    {
        if (artifact is null)
        {
            return;
        }

        ApplyPreviewBuildOutcomeToArtifact(artifact.ArtifactId, outcome);
        await InvokeAsync(StateHasChanged);

        await ReportPreviewBuildOutcomeAsync(artifact.ArtifactId, outcome);
    }

    private async Task ReportPreviewBuildOutcomeAsync(Guid artifactId, QeInlinePartViewer.PreviewBuildOutcome outcome)
    {
        if (artifactId == Guid.Empty)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/{artifactId:D}/preview-build",
                new QuoteAgentPreviewBuildRequest
                {
                    Success = outcome.Success,
                    ErrorClass = outcome.Success ? null : outcome.ErrorClass
                });
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<QuoteAgentPreviewBuildResponse>();
            if (result?.State is not null)
            {
                _artifacts = result.State.Artifacts;
                SyncSelectedArtifactWithArtifacts();
                _gates = result.State.Gates;
                _proposedActions = result.State.ProposedActions;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Telemetry reporting must never disrupt the customer's preview experience.
        }
    }

    private void ApplyPreviewBuildOutcomeToArtifact(Guid artifactId, QeInlinePartViewer.PreviewBuildOutcome outcome)
    {
        var artifact = _artifacts.FirstOrDefault(item => item.ArtifactId == artifactId);
        if (artifact is null || !IsGeneratedViewerArtifact(artifact))
        {
            return;
        }

        if (outcome.Success)
        {
            artifact.Metadata["previewBuildStatus"] = "success";
            artifact.Metadata.Remove("previewBuildErrorClass");
            if (artifact.Status.Equals("build_failed", StringComparison.OrdinalIgnoreCase))
            {
                artifact.Status = "ready";
            }
        }
        else
        {
            artifact.Metadata["previewBuildStatus"] = "failed";
            artifact.Metadata["previewBuildErrorClass"] = string.IsNullOrWhiteSpace(outcome.ErrorClass)
                ? "unknown"
                : outcome.ErrorClass.Trim();
            artifact.Status = "build_failed";
        }

        SyncSelectedArtifactWithArtifacts();
    }

    private async Task RequestPreviewRebuildAsync(InlineViewerInfo? viewer)
    {
        if (viewer is not null)
        {
            viewer.BuildFailed = false;
        }

        var prompt = Text(
            "The 3D preview failed to render. Please regenerate it with a corrected, buildable design.",
            "พรีวิว 3D แสดงผลไม่สำเร็จ กรุณาสร้างใหม่ด้วยแบบที่ถูกต้องและสร้างได้");
        _draftMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        if (_composerModule is not null)
        {
            await _composerModule.InvokeVoidAsync("typeComposerText", _composerTextarea, prompt);
            _draftMessage = prompt;
            return;
        }

        _draftMessage = prompt;
        await FocusComposerAsync();
    }

    private PreviewItem? BuildArtifactPreviewItem(QuoteAgentArtifactDto artifact)
    {
        var artifactUrl = ArtifactPreviewUrl(artifact);
        return string.IsNullOrWhiteSpace(artifactUrl)
            ? null
            : new PreviewItem(
                "artifact",
                -1,
                artifact.Title,
                artifact.Status,
                artifactUrl,
                ArtifactKindLabel(artifact),
                ArtifactIcon(artifact.ArtifactType),
                ArtifactContentType(artifact));
    }

    private PreviewItem BuildUploadedPreviewItem(int index, QuotePartViewModel part)
    {
        return new PreviewItem(
            "uploaded",
            index,
            part.FileName,
            UploadedPartStatus(part),
            PreviewUrlForUploadedPart(part),
            SupplementalArtifactLabel(part),
            UploadedPartIcon(part),
            part.ContentType);
    }

    private string? ArtifactPreviewUrl(QuoteAgentArtifactDto artifact)
    {
        var url = !string.IsNullOrWhiteSpace(artifact.Url)
            ? artifact.Url.Trim()
            : ArtifactMetadata(artifact, "storagePath");
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        if (url.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("blob:", StringComparison.OrdinalIgnoreCase) ||
            Uri.TryCreate(url, UriKind.Absolute, out _) ||
            url.StartsWith("/", StringComparison.Ordinal))
        {
            return url;
        }

        return $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/download?path={Uri.EscapeDataString(url)}";
    }

    private string PreviewUrlForUploadedPart(QuotePartViewModel part)
    {
        if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
        {
            return part.ThumbnailUrl;
        }

        if (!string.IsNullOrWhiteSpace(part.GlbUrl))
        {
            return part.GlbUrl;
        }

        return !string.IsNullOrWhiteSpace(part.StoragePath) &&
            IsPreviewableContent(part.ContentType, part.FileName)
                ? $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/download?path={Uri.EscapeDataString(part.StoragePath)}"
                : string.Empty;
    }

    private static bool IsImagePreview(PreviewItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ContentType) &&
            item.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (item.Url.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        var extension = PreviewExtension(item);
        return QuoteUploadConstraints.SupplementalImageExtensions.Any(value =>
            value.Equals(extension, StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsPdfPreview(PreviewItem item)
    {
        return string.Equals(item.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase) ||
            PreviewExtension(item).Equals("pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string? ArtifactMetadata(QuoteAgentArtifactDto artifact, string key)
    {
        return artifact.Metadata.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value.Trim()
            : null;
    }

    private readonly record struct PaymentQrInfo(string ImageUrl, string AmountLabel, string? ExpiresAtIso, string? CountdownLabel);

    // Surfaces the in-chat PromptPay QR from a payment artifact until the payment is confirmed paid.
    private bool TryGetPaymentQr(QuoteAgentArtifactDto artifact, out PaymentQrInfo info)
    {
        info = default;
        if (!artifact.ArtifactType.Equals("payment", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var imageUrl = ArtifactMetadata(artifact, "qrImageUrl");
        if (string.IsNullOrWhiteSpace(imageUrl) ||
            string.Equals(ArtifactMetadata(artifact, "paymentStatus"), "Paid", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var amount = ArtifactMetadata(artifact, "amount");
        var currency = ArtifactMetadata(artifact, "currency");
        var amountLabel = !string.IsNullOrWhiteSpace(amount)
            ? $"{amount} {currency}".Trim()
            : Text("the amount due", "ยอดที่ต้องชำระ");

        string? expiresAtIso = null;
        string? countdownLabel = null;
        if (DateTimeOffset.TryParse(
                ArtifactMetadata(artifact, "qrExpiresAt"),
                CultureInfo.InvariantCulture,
                DateTimeStyles.RoundtripKind,
                out var expiresAt))
        {
            expiresAtIso = expiresAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture);
            var remaining = expiresAt - DateTimeOffset.UtcNow;
            countdownLabel = remaining > TimeSpan.Zero
                ? Text(
                    $"Time left {(int)remaining.TotalMinutes}:{remaining.Seconds:00}",
                    $"เหลือเวลา {(int)remaining.TotalMinutes}:{remaining.Seconds:00}")
                : Text("QR expired — restart payment", "คิวอาร์หมดอายุ — เริ่มชำระใหม่");
        }

        info = new PaymentQrInfo(imageUrl, amountLabel, expiresAtIso, countdownLabel);
        return true;
    }

    private string? _joinedPaymentOrderNumber;

    // Joins the SignalR order group for the active payment artifact so the chat receives the
    // PaymentCompleted webhook notification and can auto-confirm the receipt.
    private async Task EnsurePaymentOrderGroupJoinedAsync()
    {
        if (_notificationConnection is null || _notificationConnection.State != HubConnectionState.Connected)
        {
            return;
        }

        var orderNumber = _artifacts
            .Where(a => a.ArtifactType.Equals("payment", StringComparison.OrdinalIgnoreCase))
            .Select(a => ArtifactMetadata(a, "orderNumber"))
            .FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));

        if (string.IsNullOrWhiteSpace(orderNumber) ||
            string.Equals(orderNumber, _joinedPaymentOrderNumber, StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            if (!string.IsNullOrWhiteSpace(_joinedPaymentOrderNumber))
            {
                await _notificationConnection.InvokeAsync("LeaveOrderGroup", _joinedPaymentOrderNumber);
            }

            await _notificationConnection.InvokeAsync("JoinOrderGroup", orderNumber);
            _joinedPaymentOrderNumber = orderNumber;
        }
        catch (Exception)
        {
            // Non-fatal: the order page also receives the completion, and a reload re-joins.
        }
    }

    // Webhook-driven receipt: when PaymentService confirms payment, the agent auto-posts a receipt
    // in the chat and flips the payment artifact to Paid (which hides the QR).
    private void ApplyChatPaymentCompleted(QePaymentCompletedPayload payload)
    {
        if (payload is null || string.IsNullOrWhiteSpace(payload.OrderNumber))
        {
            return;
        }

        foreach (var artifact in _artifacts.Where(a =>
                     a.ArtifactType.Equals("payment", StringComparison.OrdinalIgnoreCase) &&
                     string.Equals(ArtifactMetadata(a, "orderNumber"), payload.OrderNumber, StringComparison.OrdinalIgnoreCase)))
        {
            artifact.Status = "paid";
            artifact.Metadata["paymentStatus"] = "Paid";
        }

        var amountLabel = payload.Amount > 0m
            ? $"{payload.Amount.ToString("0.##", CultureInfo.InvariantCulture)} {payload.Currency}".Trim()
            : string.Empty;
        _messages.Add(new AgentMessageRow("assistant", Text(
            $"✅ Payment received — receipt {payload.OrderNumber}{(amountLabel.Length > 0 ? $", {amountLabel}" : string.Empty)}. Production tracking continues on your order page.",
            $"✅ ได้รับการชำระเงินแล้ว — ใบเสร็จ {payload.OrderNumber}{(amountLabel.Length > 0 ? $" จำนวน {amountLabel}" : string.Empty)} ติดตามการผลิตต่อได้ที่หน้าคำสั่งซื้อ")));

        StateHasChanged();
    }

