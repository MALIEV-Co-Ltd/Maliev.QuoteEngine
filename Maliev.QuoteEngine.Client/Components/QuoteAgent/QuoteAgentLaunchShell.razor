    private static string HumanizeAgentActivity(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value
            .Replace("quote_", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("_", " ", StringComparison.Ordinal)
            .Replace("-", " ", StringComparison.Ordinal);

        if (!value.Contains('_', StringComparison.Ordinal) &&
            !value.StartsWith("quote-", StringComparison.OrdinalIgnoreCase) &&
            !value.StartsWith("quote ", StringComparison.OrdinalIgnoreCase) &&
            !value.StartsWith("quote_", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        var textInfo = CultureInfo.CurrentCulture.TextInfo;
        return textInfo.ToTitleCase(normalized.Trim().ToLower(CultureInfo.CurrentCulture));
    }

    private static string FormatDuration(long durationMs)
    {
        return durationMs < 1000
            ? FormattableString.Invariant($"{durationMs} ms")
            : FormattableString.Invariant($"{durationMs / 1000.0:0.#} s");
    }

