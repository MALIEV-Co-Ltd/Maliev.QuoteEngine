        var dataUrl = $"data:{image.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("insertSketchImage", SketchCanvasId, dataUrl);
        ApplySketchImageTitle(Path.GetFileNameWithoutExtension(image.Name));
