        }
    }

    private string ConnectorStatus(QuoteAgentConnectorDto connector)
    {
        if (connector.IsConnected)
        {
            return Text("Browse", "เลือกไฟล์");
        }

        if (connector.Status.Equals("available", StringComparison.OrdinalIgnoreCase))
        {
            return Text("Connect", "เชื่อมต่อ");
        }

        return connector.Status.Equals("planned", StringComparison.OrdinalIgnoreCase)
            ? Text("Planned", "วางแผนแล้ว")
            : Text("Future", "อนาคต");
    }

    private string ConnectorRowClass(QuoteAgentConnectorDto connector)
    {
        var classes = new List<string> { "qe-agent-management-row" };
        if (_highlightConnectorId is not null &&
            _highlightConnectorId.Equals(connector.ConnectorId, StringComparison.OrdinalIgnoreCase))
        {
            classes.Add("qe-agent-management-row--highlight");
        }

        if (connector.IsConnected)
        {
            classes.Add("is-connected");
        }

        return string.Join(" ", classes);
    }

    private static bool IsGoogleDriveConnector(QuoteAgentConnectorDto connector)
    {
        return connector.ActionHint.Equals("connect_google_drive", StringComparison.OrdinalIgnoreCase)
               || connector.DisplayName.Contains("Google Drive", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ApplyConnectorAsync(QuoteAgentConnectorDto connector)
    {
        try
        {
            QuoteAgentConnectorHandoffResponse handoff = await Api.GetConnectorHandoffAsync(SessionId, connector.ConnectorId);
            if (!string.IsNullOrWhiteSpace(handoff.HandoffUrl) &&
                handoff.Status.Equals("authentication_required", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo(handoff.HandoffUrl);
                return;
            }

            if (IsGoogleDriveConnector(connector) &&
                handoff.Status.Equals("ready_to_connect", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo(
                    $"/quote/v1/connectors/google-drive/start?returnUrl={Uri.EscapeDataString("/quotes?connect=google-drive")}",
                    forceLoad: true);
                return;
            }

            if (IsGoogleDriveConnector(connector) && connector.IsConnected)
            {
                _error = Text(
                    "Google Drive is connected. Type @drive in the composer to choose files from Drive.",
                    "เชื่อมต่อ Google Drive แล้ว พิมพ์ @drive ในช่องข้อความเพื่อเลือกไฟล์จาก Drive");
                _activeWorkspacePage = WorkspacePage.Chat;
                await FocusComposerAsync();
                return;
            }

            _error = string.IsNullOrWhiteSpace(handoff.Message)
                ? Text($"The {connector.DisplayName} connector is not ready yet.", $"ตัวเชื่อมต่อ {connector.DisplayName} ยังไม่พร้อมใช้งาน")
                : handoff.Message;
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = Text("Connector handoff is temporarily unavailable.", "การส่งต่อไปยังตัวเชื่อมต่อยังไม่พร้อมใช้งานชั่วคราว");
        }
    }

    private IEnumerable<SearchNavItem> BuildSearchResults()
    {
        if (!SearchHasMinimumQuery)
        {
            return [];
        }

        var items = new List<SearchNavItem>();

        if (!_customerSearchUnavailable || _customerSearchResults.Count > 0)
        {
            items.AddRange(_customerSearchResults.Select(SearchNavItem.FromDto));
        }
        else
        {
            items.AddRange(_projects.Select(project => new SearchNavItem(
                "Project",
                "โปรเจกต์",
                project.NameEn,
                project.NameTh,
                project.IsPinned ? "Pinned project" : "Recent project",
                project.IsPinned ? "โปรเจกต์ที่ปักหมุด" : "โปรเจกต์ล่าสุด",
                project.NameEn,
                "resume_project",
                $"/quotes?projectId={project.ProjectId:D}")));
        }

        items.AddRange(_artifacts.Select(artifact => new SearchNavItem(
            "Artifact",
            "ไฟล์งาน",
            artifact.Title,
            artifact.Title,
            $"{artifact.ArtifactType} · {artifact.Status}",
            $"{artifact.ArtifactType} · {artifact.Status}",
            $"{artifact.Title} {artifact.ArtifactType} {artifact.Status}",
            "open_artifact",
            artifact.Url)));

        var query = _searchQuery.Trim();
        if (query.Length == 0 || (!_customerSearchUnavailable && _customerSearchResults.Count > 0))
        {
            return items.Take(6);
        }

        return items
            .Where(item =>
                item.SearchText.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.TitleEn.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.DetailEn.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.TypeEn.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8);
    }

    private void ApplySearchResult(SearchNavItem item)
    {
        _searchOpen = false;
        _focusSearchPending = false;

        if (item.ActionHint.Equals("open_artifact", StringComparison.OrdinalIgnoreCase))
        {
            _artifactPanelOpen = true;
            _summaryPanelOpen = false;
            return;
        }

        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            Navigation.NavigateTo(item.Url);
            return;
        }

        _draftMessage = item.ActionHint.Equals("resume_project", StringComparison.OrdinalIgnoreCase)
            ? Text($"Resume {item.TitleEn}.", $"ทำต่อ {item.TitleTh}")
            : Text($"Open or continue {item.TitleEn}.", $"เปิดหรือทำต่อ {item.TitleTh}");
    }

    private async Task ApplyUseCaseAsync(UseCaseOption useCase)
    {
        var prompt = Text(useCase.PromptEn, useCase.PromptTh);
        _draftMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        if (_composerModule is not null)
        {
            await _composerModule.InvokeVoidAsync("typeComposerText", _composerTextarea, prompt);
            _draftMessage = prompt;
            return;
        }

        _draftMessage = prompt;
        await FocusComposerAsync();
    }

