    public async Task NotifyUploadStartedAsync(QuotePartViewModel part)
    {
        if (string.IsNullOrWhiteSpace(part.FileName))
        {
            return;
        }

        QueueComposerAttachment(part);
        await InvokeAsync(StateHasChanged);
    }

    public async Task NotifyUploadCompletedAsync(QuotePartViewModel part)
    {
        if (string.IsNullOrWhiteSpace(part.FileName))
        {
            return;
