    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }

    private string ProjectName(ProjectNavItem project)
    {
        return Text(project.NameEn, project.NameTh);
    }

    private static string ProjectHref(ProjectNavItem project)
    {
        return $"/quotes?projectId={project.ProjectId:D}";
    }

    private async Task ToggleProjectPinAsync(ProjectNavItem project)
    {
        if (!IsSignedIn)
        {
            _draftMessage = Text("Sign in to pin or unpin projects.", "เข้าสู่ระบบเพื่อปักหมุดหรือเลิกปักหมุดโปรเจกต์");
            return;
        }

        try
        {
            var response = project.IsPinned
                ? await Api.UnpinProjectAsync(project.ProjectId)
                : await Api.PinProjectAsync(project.ProjectId);
            ApplyProjectManagement(response);
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private void ApplyProjectManagement(ProjectManagementResponse response)
    {
        var existing = _projects.FirstOrDefault(project => project.ProjectId == response.ProjectId);
        if (existing is null)
        {
            _projects.Add(ProjectNavItem.FromManagementResponse(response));
            return;
        }

        existing.ProjectNumber = response.ProjectNumber;
        existing.NameEn = response.Title;
        existing.NameTh = response.Title;
        existing.Status = response.Status;
        existing.IsPinned = response.IsPinned;
        existing.IsArchived = response.IsArchived;
    }

    private async Task ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        if (_searchOpen)
        {
            _pluginsOpen = false;
            await RefreshSearchResultsAsync();
        }

        _focusSearchPending = _searchOpen;
    }

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        _searchQuery = args.Value?.ToString() ?? string.Empty;
        if (_searchOpen)
        {
            await RefreshSearchResultsAsync();
        }
    }

    private async Task RefreshSearchResultsAsync()
    {
        if (!IsSignedIn || SessionId == Guid.Empty)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = !IsSignedIn;
            return;
        }

        _searchLoading = true;
        _customerSearchUnavailable = false;
        try
        {
            var response = await Api.SearchCustomerDataAsync(SessionId, _searchQuery, 20);
            _customerSearchResults.Clear();
            _customerSearchResults.AddRange(response.Results);
        }
        catch (QuoteEngineApiException ex)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            if (ex.StatusCode != System.Net.HttpStatusCode.Unauthorized)
            {
                _error = ex.UserMessage;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            _error = ex.Message;
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private async Task TogglePluginsAsync()
    {
        _pluginsOpen = !_pluginsOpen;
        if (_pluginsOpen)
        {
            _searchOpen = false;
            if (!_connectorRegistryLoaded)
            {
                await LoadConnectorRegistryAsync();
            }
        }
    }

    private async Task LoadConnectorRegistryAsync()
    {
        try
        {
            var registry = await Api.GetConnectorRegistryAsync(SessionId);
            _connectors = registry.Connectors;
            _connectorRegistryLoaded = true;
        }
        catch (QuoteEngineApiException ex)
        {
            _connectors = [];
            _connectorRegistryLoaded = false;
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _connectors = [];
            _connectorRegistryLoaded = false;
            _error = ex.Message;
        }
    }

    private string ConnectorStatus(QuoteAgentConnectorDto connector)
    {
        if (connector.IsConnected)
        {
            return Text("Connected", "เชื่อมต่อแล้ว");
        }

        return connector.Status.Equals("planned", StringComparison.OrdinalIgnoreCase)
            ? Text("Planned", "วางแผนแล้ว")
            : Text("Future", "อนาคต");
    }

    private void ApplyConnector(QuoteAgentConnectorDto connector)
    {
        if (connector.RequiresAuthenticationToConnect && !IsSignedIn)
        {
            _draftMessage = Text($"Sign in to connect {connector.DisplayName}.", $"เข้าสู่ระบบเพื่อเชื่อมต่อ {connector.DisplayName}");
            return;
        }

        _draftMessage = connector.ActionHint.Equals("connect_google_drive", StringComparison.OrdinalIgnoreCase)
            ? Text("Help me connect Google Drive when the connector is available.", "ช่วยเชื่อมต่อ Google Drive เมื่อปลั๊กอินพร้อมใช้งาน")
            : Text($"Tell me how the {connector.DisplayName} connector will work.", $"อธิบายว่าตัวเชื่อมต่อ {connector.DisplayName} จะทำงานอย่างไร");
    }

    private IEnumerable<SearchNavItem> BuildSearchResults()
    {
        var items = new List<SearchNavItem>();

        if (!_customerSearchUnavailable || _customerSearchResults.Count > 0)
        {
            items.AddRange(_customerSearchResults.Select(SearchNavItem.FromDto));
        }
        else
        {
            items.AddRange(_projects.Select(project => new SearchNavItem(
                "Project",
                "โปรเจกต์",
                project.NameEn,
                project.NameTh,
                project.IsPinned ? "Pinned project" : "Recent project",
                project.IsPinned ? "โปรเจกต์ที่ปักหมุด" : "โปรเจกต์ล่าสุด",
                project.NameEn,
                "resume_project",
                $"/quotes?projectId={project.ProjectId:D}")));
        }

        items.AddRange(_artifacts.Select(artifact => new SearchNavItem(
            "Artifact",
            "ไฟล์งาน",
            artifact.Title,
            artifact.Title,
            $"{artifact.ArtifactType} · {artifact.Status}",
            $"{artifact.ArtifactType} · {artifact.Status}",
            $"{artifact.Title} {artifact.ArtifactType} {artifact.Status}",
            "open_artifact",
            artifact.Url)));

        var query = _searchQuery.Trim();
        if (query.Length == 0 || (!_customerSearchUnavailable && _customerSearchResults.Count > 0))
        {
            return items.Take(6);
        }

        return items
            .Where(item =>
                item.SearchText.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.TitleEn.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.DetailEn.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.TypeEn.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8);
    }

    private void ApplySearchResult(SearchNavItem item)
    {
        _draftMessage = item.ActionHint.Equals("resume_project", StringComparison.OrdinalIgnoreCase)
            ? Text($"Resume {item.TitleEn}.", $"ทำต่อ {item.TitleTh}")
            : Text($"Open or continue {item.TitleEn}.", $"เปิดหรือทำต่อ {item.TitleTh}");
    }

