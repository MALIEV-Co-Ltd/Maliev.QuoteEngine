    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _composerDotNetRef = DotNetObjectReference.Create(this);
            _composerModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-composer.js");
            await _composerModule.InvokeVoidAsync("initComposer", _composerTextarea, _composerDotNetRef, _dictationButton);
            _dictationUnsupported = !await _composerModule.InvokeAsync<bool>("isSpeechRecognitionSupported");
            await _composerModule.InvokeVoidAsync("focusComposer", _composerTextarea);

            try
            {
                // Drives the live PromptPay QR countdown in JS (avoids a per-second Blazor re-render).
                var countdownModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-payment-countdown.js");
                await countdownModule.InvokeVoidAsync("start");
            }
            catch (Exception)
            {
                // Non-fatal: the QR still shows its initial remaining-time label without the live tick.
            }
        }
        else if (_composerModule is not null)
        {
            var hasHandlers = await _composerModule.InvokeAsync<bool>("isComposerInitialized", _composerTextarea);
            if (!hasHandlers)
            {
                await _composerModule.InvokeVoidAsync("initComposer", _composerTextarea, _composerDotNetRef, _dictationButton);
            }
        }

        if (_scrollToLatestMessageRequested)
        {
            _scrollToLatestMessageRequested = false;
            await ScrollToLatestMessageAsync();
        }

        if (!_sketchInitPending)
        {
            if (_focusSearchPending && _searchOpen)
            {
                _focusSearchPending = false;
                await _searchInput.FocusAsync();
            }

            if (_paletteFocusPending && _commandPaletteOpen)
            {
                _paletteFocusPending = false;
                await _paletteInput.FocusAsync();
            }

            return;
        }

        _sketchInitPending = false;
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("initSketchCanvas", SketchCanvasId, _composerDotNetRef);
        await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);

        if (_focusSearchPending && _searchOpen)
        {
            _focusSearchPending = false;
            await _searchInput.FocusAsync();
        }

        if (_paletteFocusPending && _commandPaletteOpen)
        {
            _paletteFocusPending = false;
            await _paletteInput.FocusAsync();
        }
    }

    private async Task LoadStateAsync(bool forceReloadExistingMessages = false)
    {
        try
        {
            var state = await Api.GetAgentStateAsync(SessionId);
            await ApplyStateAsync(state, suppressPanelAutoOpen: true);
            await LoadMessageHistoryAsync(forceReloadExistingMessages);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = Text("The agent workspace is temporarily unavailable. You can keep typing or attach files while it reconnects.", "พื้นที่ทำงานเอเจนต์ยังไม่พร้อมใช้งานชั่วคราว คุณยังพิมพ์หรือแนบไฟล์ต่อได้ระหว่างเชื่อมต่อใหม่");
        }
    }

    private async Task LoadMessageHistoryAsync(bool forceReloadExistingMessages = false)
    {
        if (SessionId == Guid.Empty || (_messages.Count > 0 && !forceReloadExistingMessages))
        {
            return;
        }

        QuoteAgentMessageHistoryResponse history;
        try
        {
            history = await Api.GetAgentMessageHistoryAsync(SessionId);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or QuoteEngineApiException)
        {
            return;
        }

        if (history.Messages.Count == 0)
        {
            return;
        }

        if (forceReloadExistingMessages)
        {
            _messages.Clear();
        }

        foreach (var message in history.Messages)
        {
            var restored = new AgentMessageRow(message.Role, message.Content, createdAt: message.CreatedAt);
            if (message.Role.Equals("assistant", StringComparison.OrdinalIgnoreCase))
            {
                RestoreThinkingSteps(restored, message.ThinkingSteps);
                restored.InlineViewer = FindInlinePreview(message.Artifacts);
            }

            _messages.Add(restored);
        }

        RequestScrollToLatestMessage();
    }

    private async Task LoadProjectNavigationAsync()
    {
        try
        {
            var projects = await Api.GetProjectNavigationAsync();
            var temporaryProjects = _projects
                .Where(project => !project.IsPersisted)
                .ToList();
            var persistedProjects = projects
                .Select(ProjectNavItem.FromDto)
                .ToList();
            _projects.Clear();
            _projects.AddRange(temporaryProjects.Where(temporary =>
                persistedProjects.All(project => project.ProjectId != temporary.ProjectId)));
            _projects.AddRange(persistedProjects);
            _projectNavigationLoaded = true;
        }
        catch (QuoteEngineApiException ex)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            if (ex.StatusCode != System.Net.HttpStatusCode.Unauthorized)
            {
                _error = ex.UserMessage;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            _error = Text("Project data is temporarily unavailable.", "ข้อมูลโปรเจกต์ยังไม่พร้อมใช้งานชั่วคราว");
        }
    }

