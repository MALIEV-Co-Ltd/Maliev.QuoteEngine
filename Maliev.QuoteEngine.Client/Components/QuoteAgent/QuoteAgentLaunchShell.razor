    private void EnsureLocalProjectFromMessage(string message)
    {
        var title = BuildLocalProjectTitle(message);
        if (string.IsNullOrWhiteSpace(_projectName))
        {
            _projectName = title;
        }

        var existingProject = _projects.FirstOrDefault(project => project.ProjectId == SessionId);
        if (existingProject is not null)
        {
            existingProject.NameEn = _projectName;
            existingProject.NameTh = _projectName;
            existingProject.Status = "draft";
            return;
        }

        _projects.Insert(0, new ProjectNavItem(SessionId, string.Empty, _projectName, _projectName, "draft", false, false));
    }

    private static string BuildLocalProjectTitle(string message)
    {
        var words = Regex.Matches(message, "[\\p{L}\\p{N}]+")
            .Select(match => match.Value)
            .Where(word => word.Length > 1)
            .Take(6)
            .ToArray();

        if (words.Length == 0)
        {
            return "New manufacturing project";
        }

        var title = string.Join(' ', words);
        return title.Length <= 70 ? title : $"{title[..67]}...";
    }

