    private async Task CopyUserMessageAsync(AgentMessageRow message)
    {
        if (!message.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ||
            string.IsNullOrWhiteSpace(message.Content))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", message.Content);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _error = Text(
                "Message could not be copied. Select the text and copy it manually.",
                "ไม่สามารถคัดลอกข้อความได้ โปรดเลือกข้อความแล้วคัดลอกด้วยตนเอง");
            await InvokeAsync(StateHasChanged);
        }
    }

