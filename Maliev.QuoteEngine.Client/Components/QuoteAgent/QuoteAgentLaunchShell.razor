    // Sign-in completes against AuthService via this app's own BFF: Google as a
    // same-tab browser flow, email credentials as a JSON call. The customer
    // never leaves Make Studio and never depends on the Maliev.Web frontend.
    private bool IsAuthDialogSignUp => _authDialogMode.Equals("sign-up", StringComparison.OrdinalIgnoreCase);

    private async Task ContinueWithEmailAsync()
    {
        if (!AuthEmailLooksValid || string.IsNullOrWhiteSpace(_authPassword) || _authSubmitting)
        {
            return;
        }

        _authSubmitting = true;
        _authDialogError = null;
        try
        {
            var language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en";
            var status = IsAuthDialogSignUp
                ? await Api.SignUpWithEmailAsync(_authEmail, _authPassword, _authFullName, language)
                : await Api.SignInWithEmailAsync(_authEmail, _authPassword);
            if (status?.IsSignedIn == true)
            {
                _authDialogOpen = false;
                await MarkAuthWorkspaceHandoffAsync();
                Navigation.NavigateTo(AuthReturnUrl, forceLoad: true);
                return;
            }

            _authDialogError = IsAuthDialogSignUp
                ? Text("This email cannot be registered. It may already have a MALIEV account.", "อีเมลนี้สมัครไม่ได้ อาจมีบัญชี MALIEV อยู่แล้ว")
                : Text("Email or password is incorrect.", "อีเมลหรือรหัสผ่านไม่ถูกต้อง");
        }
        catch (Exception ex) when (ex is HttpRequestException or QuoteEngineApiException or TaskCanceledException)
        {
            _authDialogError = Text("Sign in is temporarily unavailable.", "ยังเข้าสู่ระบบไม่ได้ชั่วคราว");
        }
        finally
        {
            _authSubmitting = false;
        }
    }

