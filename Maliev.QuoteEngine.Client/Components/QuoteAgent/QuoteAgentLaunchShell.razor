        public static SearchNavItem FromDto(QuoteAgentSearchResultDto result)
        {
            var typeEn = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(result.ResourceType.Replace("_", " ", StringComparison.Ordinal));
            return new(
                typeEn,
                ResourceTypeThai(result.ResourceType),
                result.Title,
                result.Title,
                result.Detail,
                result.Detail,
                $"{result.ResourceType} {result.Title} {result.Detail} {string.Join(" ", result.Metadata.Values)}",
                result.ActionHint,
                result.Url);
        }

        private static string ResourceTypeThai(string resourceType)
        {
            return resourceType.ToLowerInvariant() switch
            {
                "project" => "โปรเจกต์",
                "quote" => "ใบเสนอราคา",
                "order" => "ออเดอร์",
                "document" => "เอกสาร",
                "file" => "ไฟล์",
                "part" => "ชิ้นงาน",
                "artifact" => "ไฟล์งาน",
                _ => "ข้อมูล"
            };
        }
    }

