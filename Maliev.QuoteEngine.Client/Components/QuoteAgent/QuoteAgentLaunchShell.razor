    private async Task OpenUploadedPreviewAsync(int uploadedPartIndex)
    {
        if (UploadedParts.Count == 0)
        {
            return;
        }

        var clampedIndex = Math.Clamp(uploadedPartIndex, 0, UploadedParts.Count - 1);
        await SelectUploadedPartAsync(clampedIndex);
        var previewIndex = PreviewItems.ToList().FindIndex(item =>
            item.Source.Equals("uploaded", StringComparison.OrdinalIgnoreCase) &&
            item.SourceIndex == clampedIndex);
        _previewIndex = previewIndex >= 0 ? previewIndex : 0;
        _previewDialogOpen = true;
    }

    private void OpenArtifactPreview(QuoteAgentArtifactDto artifact)
    {
        var previewIndex = PreviewItems.ToList().FindIndex(item =>
            item.Source.Equals("artifact", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(item.Url, artifact.Url, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(item.Title, artifact.Title, StringComparison.OrdinalIgnoreCase));
        _previewIndex = previewIndex >= 0 ? previewIndex : 0;
        _previewDialogOpen = CurrentPreviewItem is not null;
    }

    private void ClosePreviewDialog()
    {
        _previewDialogOpen = false;
    }

    private void MovePreview(int direction)
    {
        var items = PreviewItems;
        if (items.Count == 0)
        {
            _previewDialogOpen = false;
            return;
        }

        _previewIndex = (_previewIndex + direction + items.Count) % items.Count;
    }

    private IReadOnlyList<PreviewItem> BuildPreviewItems()
    {
        var items = new List<PreviewItem>();
        for (var i = 0; i < UploadedParts.Count; i++)
        {
            var part = UploadedParts[i];
            items.Add(new PreviewItem(
                "uploaded",
                i,
                part.FileName,
                UploadedPartStatus(part),
                PreviewUrlForUploadedPart(part),
                SupplementalArtifactLabel(part),
                UploadedPartIcon(part)));
        }

        foreach (var artifact in _artifacts.Where(item => !string.IsNullOrWhiteSpace(item.Url)))
        {
            items.Add(new PreviewItem(
                "artifact",
                -1,
                artifact.Title,
                artifact.Status,
                artifact.Url!,
                ArtifactKindLabel(artifact),
                ArtifactIcon(artifact.ArtifactType)));
        }

        return items;
    }

