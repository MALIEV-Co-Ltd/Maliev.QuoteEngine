    private async Task BeginDictationAsync()
    {
        if (_composerModule is null || _dictating)
        {
            await FocusComposerAsync();
            return;
        }

        _dictating = true;
        _error = null;
        try
        {
            await _composerModule.InvokeVoidAsync("beginDictation", _composerTextarea);
        }
        catch (JSException ex)
        {
            var friendly = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
            _error = Text(
                friendly,
                friendly);
            _dictating = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private async Task EndDictationAsync()
    {
        if (_composerModule is null || !_dictating)
        {
            await FocusComposerAsync();
            return;
        }

        try
        {
            var dictatedText = await _composerModule.InvokeAsync<string>("endDictation", _composerTextarea);
            _draftMessage = dictatedText;
        }
        catch (JSException ex)
        {
            _error = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
        }
        finally
        {
            _dictating = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

