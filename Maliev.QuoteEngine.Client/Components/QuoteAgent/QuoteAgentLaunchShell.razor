    private void NavigateToMalievAccount()
    {
        var authPath = _authDialogMode.Equals("sign-up", StringComparison.OrdinalIgnoreCase)
            ? "/auth/sign-up"
            : "/auth/sign-in";
        Navigation.NavigateTo($"{authPath}?returnUrl={Uri.EscapeDataString(AuthReturnUrl)}", forceLoad: true);
    }

