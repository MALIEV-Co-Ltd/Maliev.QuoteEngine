    private sealed class ThoughtStepBundle
    {
        public required QuoteAgentThinkingStepDto Request { get; init; }
        public QuoteAgentThinkingStepDto? Response { get; init; }
        public int DisplayIndex { get; init; }
        public long? TotalDurationMs { get; init; }
        public bool IsToolPair => Response is not null;
    }

    private static IReadOnlyList<ThoughtStepBundle> BuildBundledThoughtSteps(IReadOnlyList<QuoteAgentThinkingStepDto> orderedSteps)
    {
        if (orderedSteps.Count == 0)
            return [];

        var bundles = new List<ThoughtStepBundle>();

        var index = 1;
        for (var i = 0; i < orderedSteps.Count; i++)
        {
            var current = orderedSteps[i];
            if (!LooksLikeToolRequestStep(current))
            {
                bundles.Add(BuildThoughtStepBundle(current, null, index));
                index++;
                continue;
            }

            var nextToolResultIndex = FindNextToolResultStepIndex(orderedSteps, i + 1, current);
            if (nextToolResultIndex >= 0)
            {
                for (var skipped = i + 1; skipped < nextToolResultIndex; skipped++)
                {
                    bundles.Add(BuildThoughtStepBundle(orderedSteps[skipped], null, index));
                    index++;
                }

                var result = orderedSteps[nextToolResultIndex];
                bundles.Add(BuildThoughtStepBundle(current, result, index));
                i = nextToolResultIndex;
                index++;
                continue;
            }

            bundles.Add(BuildThoughtStepBundle(current, null, index));
            index++;
        }

        return bundles;
    }

    private static int FindNextToolResultStepIndex(
        IReadOnlyList<QuoteAgentThinkingStepDto> orderedSteps,
        int startIndex,
        QuoteAgentThinkingStepDto request)
    {
        const int maxLookahead = 8;
        for (var i = startIndex; i < orderedSteps.Count; i++)
        {
            if (i - startIndex >= maxLookahead)
            {
                return -1;
            }

            var candidate = orderedSteps[i];

            if (LooksLikeToolRequestStep(candidate))
            {
                return -1;
            }

            if (!LooksLikeToolResultStep(candidate))
            {
                continue;
            }

            if (LooksLikeToolPair(request, candidate))
            {
                return i;
            }
        }

        return -1;
    }

    private static ThoughtStepBundle BuildThoughtStepBundle(
        QuoteAgentThinkingStepDto request,
        QuoteAgentThinkingStepDto? response,
        int displayIndex)
    {
        return new ThoughtStepBundle
        {
            Request = request,
            Response = response,
            DisplayIndex = displayIndex,
            TotalDurationMs = request.DurationMs.GetValueOrDefault() + (response?.DurationMs.GetValueOrDefault() ?? 0L)
        };
    }

    private static string? ThinkingStepDisplayTitle(ThoughtStepBundle bundle)
    {
        var requestTitle = ThinkingStepTitle(bundle.Request);
        if (!string.IsNullOrWhiteSpace(requestTitle))
        {
            if (bundle.Response is not null &&
                LooksLikeToolRequestStep(bundle.Request) &&
                LooksLikeToolResultStep(bundle.Response))
            {
                return requestTitle;
            }

            if (bundle.Response is null)
                return requestTitle;

            var responseTitle = ThinkingStepTitle(bundle.Response);
            if (string.Equals(
                    NormalizeThoughtStepType(bundle.Response.Type),
                    NormalizeThoughtStepType(bundle.Request.Type),
                    StringComparison.OrdinalIgnoreCase))
            {
                return string.Equals(responseTitle, requestTitle, StringComparison.OrdinalIgnoreCase)
                    ? requestTitle
                    : responseTitle;
            }
        }

        return ThinkingStepTitle(bundle.Request);
    }

    private IEnumerable<string> ThinkingStepDisplayCompacts(ThoughtStepBundle bundle)
    {
        var requestCompact = ThinkingStepCompact(bundle.Request);
        var responseCompact = bundle.Response is null ? null : ThinkingStepCompact(bundle.Response);

        var normalizedRequest = NormalizeCompactTextForDisplayDedupe(requestCompact);
        var normalizedResponse = NormalizeCompactTextForDisplayDedupe(responseCompact);

        if (!string.IsNullOrWhiteSpace(requestCompact)
            && !string.IsNullOrWhiteSpace(responseCompact)
            && string.Equals(normalizedRequest, normalizedResponse, StringComparison.OrdinalIgnoreCase))
        {
            yield return $"{Text("Tool call", "คำสั่ง")}: {requestCompact}";
            yield break;
        }

        if (!string.IsNullOrWhiteSpace(requestCompact))
            yield return $"{Text("Tool call", "คำสั่ง")}: {requestCompact}";

        if (string.IsNullOrWhiteSpace(responseCompact))
            yield break;

        yield return $"{Text("Result", "ผลลัพธ์")}: {responseCompact}";
    }

    private static string? NormalizeCompactTextForDisplayDedupe(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        return Regex.Replace(text.Trim(), "\\s+", " ");
    }

    private static bool LooksLikeToolRequestStep(QuoteAgentThinkingStepDto step)
    {
        return (step.Detail?.StartsWith("Arguments:", StringComparison.OrdinalIgnoreCase) == true) ||
               (NormalizeThoughtStepType(step.Type).Contains("tool", StringComparison.OrdinalIgnoreCase)) ||
               (NormalizeThoughtStepType(step.Title).Contains("tool", StringComparison.OrdinalIgnoreCase)) ||
               (step.Summary?.Contains("tool", StringComparison.OrdinalIgnoreCase) == true) ||
               ((step.Type?.Contains("quote_", StringComparison.OrdinalIgnoreCase) == true) &&
                !LooksLikeToolResultStep(step));
    }

    private static bool LooksLikeToolResultStep(QuoteAgentThinkingStepDto step)
    {
        return (step.Detail is null || !step.Detail.StartsWith("Arguments:", StringComparison.OrdinalIgnoreCase)) &&
               (step.Title?.StartsWith("Got Result From ", StringComparison.OrdinalIgnoreCase) == true ||
                step.Detail?.Contains("Result", StringComparison.OrdinalIgnoreCase) == true ||
                step.Title?.Contains("result", StringComparison.OrdinalIgnoreCase) == true ||
                step.Type?.Contains("result", StringComparison.OrdinalIgnoreCase) == true ||
                step.Summary?.Contains("result", StringComparison.OrdinalIgnoreCase) == true);
    }

    private static bool LooksLikeToolPair(QuoteAgentThinkingStepDto request, QuoteAgentThinkingStepDto response)
    {
        var requestType = NormalizeToolPairingKey(request.Type);
        var responseType = NormalizeToolPairingKey(response.Type);
        if (!string.IsNullOrWhiteSpace(requestType) && !string.IsNullOrWhiteSpace(responseType) &&
            ToolPairSignaturesMatch(requestType, responseType))
        {
            return true;
        }

        var requestTitle = NormalizeToolPairingKey(request.Title);
        var responseTitle = NormalizeToolPairingKey(response.Title);
        if (!string.IsNullOrWhiteSpace(requestTitle) &&
            !string.IsNullOrWhiteSpace(responseTitle) &&
            ToolPairSignaturesMatch(requestTitle, responseTitle))
        {
            return true;
        }

        var gotResultFromTool = NormalizeToolPairingKey(GetGotResultFromTool(response.Title));
        return !string.IsNullOrWhiteSpace(requestTitle) &&
            !string.IsNullOrWhiteSpace(gotResultFromTool) &&
            ToolPairSignaturesMatch(requestTitle, gotResultFromTool);
    }

    private static string NormalizeToolPairingKey(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return string.Empty;

        var normalized = raw.ToLowerInvariant();
        normalized = normalized.Replace("Got Result From ", string.Empty, StringComparison.OrdinalIgnoreCase);
        normalized = normalized.Replace("quote_", " ", StringComparison.OrdinalIgnoreCase);
        normalized = Regex.Replace(normalized, @"\bquote\b", " ", RegexOptions.IgnoreCase);
        normalized = Regex.Replace(normalized, @"\btool\b", " ", RegexOptions.IgnoreCase);
        normalized = normalized.Replace("tool_call", " ");
        normalized = normalized.Replace("toolresult", " ");
        normalized = normalized.Replace("tool_result", " ");
        normalized = normalized.Replace("call", " ");
        normalized = normalized.Replace("result", " ");
        normalized = normalized.Replace("got", " ");
        normalized = normalized.Replace("_", " ");
        normalized = normalized.Replace("-", " ");
        normalized = Regex.Replace(normalized, "[^a-z0-9]+", " ", RegexOptions.IgnoreCase);

        var tokens = normalized.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(token => token is not ("from" or "the" or "with" or "for" or "to" or "and" or "of" or "a" or "an" or "at"));

        return string.Join(" ", tokens);
    }

    private static bool ToolPairSignaturesMatch(string requestSignature, string responseSignature)
    {
        if (string.IsNullOrWhiteSpace(requestSignature) || string.IsNullOrWhiteSpace(responseSignature))
            return false;

        if (string.Equals(requestSignature, responseSignature, StringComparison.OrdinalIgnoreCase))
            return true;

        if (requestSignature.Contains(responseSignature, StringComparison.OrdinalIgnoreCase) ||
            responseSignature.Contains(requestSignature, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var requestTokens = requestSignature
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(token => token.Length >= 2)
            .ToArray();
        if (requestTokens.Length == 0)
            return false;

        if (requestTokens.Length == 1)
            return requestSignature.Equals(responseSignature, StringComparison.OrdinalIgnoreCase);

        var responseTokens = new HashSet<string>(responseSignature
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(token => token.Length >= 2),
            StringComparer.OrdinalIgnoreCase);
        if (responseTokens.Count == 0)
            return false;

        var overlap = requestTokens.Count(responseTokens.Contains);
        return overlap >= Math.Min(2, requestTokens.Length);
    }

    private static string GetGotResultFromTool(string? resultTitle)
    {
        if (string.IsNullOrWhiteSpace(resultTitle))
            return string.Empty;

        var separator = "Got Result From ";
        var gotResultFromIndex = resultTitle.IndexOf(separator, StringComparison.OrdinalIgnoreCase);
        if (gotResultFromIndex < 0)
            return string.Empty;

        return resultTitle[(gotResultFromIndex + separator.Length)..].Trim();
    }

    private static string NormalizeThoughtStepType(string? raw)
    {
        var normalized = (raw ?? string.Empty).Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(normalized))
            return string.Empty;

        normalized = normalized.Replace("-", "_", StringComparison.OrdinalIgnoreCase);
        if (normalized.StartsWith("quote_", StringComparison.OrdinalIgnoreCase))
            normalized = normalized["quote_".Length..];

        normalized = normalized
            .Replace("tool_call", "")
            .Replace("toolresult", "")
            .Replace("tool_result", "")
            .Replace("_call", "")
            .Replace("_result", "");

        return Regex.Replace(normalized, "_{2,}", "_").Trim('_');
    }

    private static string ThinkingStepTitle(QuoteAgentThinkingStepDto step)
    {
        var title = string.IsNullOrWhiteSpace(step.Title) ? step.Type : step.Title;
        return HumanizeAgentActivity(title);
    }

    private static string? ThinkingStepCompact(QuoteAgentThinkingStepDto step)
    {
        if (!string.IsNullOrWhiteSpace(step.Summary))
            return step.Summary;

        var detail = step.Detail;
        if (string.IsNullOrWhiteSpace(detail))
            return null;

        string? jsonStr = null;
        var isJsonLike = false;
        if (detail.StartsWith("Arguments:", StringComparison.OrdinalIgnoreCase))
        {
            jsonStr = detail["Arguments:".Length..].Trim();
            isJsonLike = true;
        }
        else
        {
            var trimmed = detail.TrimStart();
            if (trimmed.StartsWith('{') || trimmed.StartsWith('['))
            {
                jsonStr = trimmed;
                isJsonLike = true;
            }
        }

        if (jsonStr is not null)
        {
            try
            {
                using var doc = JsonDocument.Parse(NormalizeJsonLiterals(jsonStr));
                return FormatJsonAsInline(doc.RootElement);
            }
            catch (JsonException) { }
        }

        if (isJsonLike)
            return null;

        return HumanizeAgentActivity(detail);
    }

    private static string NormalizeJsonLiterals(string json)
    {
        json = Regex.Replace(json, @"\bTrue\b", "true");
        json = Regex.Replace(json, @"\bFalse\b", "false");
        json = Regex.Replace(json, @"\bNull\b", "null");
        json = Regex.Replace(json, @"\bNone\b", "null");
        return json;
    }

    private static readonly HashSet<string> SkippedJsonKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "sessionId", "customerId", "uploadId", "storagePath", "url", "contentType",
        "fileSizeBytes", "kind", "messageId", "attachments", "artifact_id", "part_id",
        "commandCount", "command_count", "success", "result", "status", "messageId", "statusCode"
    };

    private static string? FormatJsonAsInline(JsonElement element)
    {
        if (element.ValueKind != JsonValueKind.Object)
            return null;

        var values = new List<string>();
        foreach (var prop in element.EnumerateObject())
        {
            if (SkippedJsonKeys.Contains(prop.Name))
                continue;

            var value = FormatJsonValue(prop.Name, prop.Value);
            if (value is not null)
                values.Add(value);
        }

        return values.Count > 0 ? string.Join(" · ", values) : null;
    }

    private static string? FormatJsonValue(string propertyName, JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.Null => null,
            JsonValueKind.True => "Yes",
            JsonValueKind.False => "No",
            JsonValueKind.String => element.GetString(),
            JsonValueKind.Number => element.ToString(),
            JsonValueKind.Array => FormatJsonArrayValue(propertyName, element),
            _ => null
        };
    }

    private static string? FormatJsonArrayValue(string propertyName, JsonElement element)
    {
        if (element.GetArrayLength() == 0)
            return null;

        if (propertyName.Contains("commands", StringComparison.OrdinalIgnoreCase))
            return $"{element.GetArrayLength()} CAD command(s)";

        var items = new List<string>();
        foreach (var item in element.EnumerateArray())
        {
            var val = FormatJsonValue(propertyName, item);
            if (val is not null)
                items.Add(val);
        }

        if (items.Count == 0)
            return null;

        if (items.Count > 3)
            return $"{items.Count} item(s)";

        return string.Join(", ", items);
    }

    private static string HumanizeAgentActivity(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value
            .Replace("quote_", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("_", " ", StringComparison.Ordinal)
            .Replace("-", " ", StringComparison.Ordinal);

        if (!value.Contains('_', StringComparison.Ordinal) &&
            !value.StartsWith("quote-", StringComparison.OrdinalIgnoreCase) &&
            !value.StartsWith("quote ", StringComparison.OrdinalIgnoreCase) &&
            !value.StartsWith("quote_", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        var textInfo = CultureInfo.CurrentCulture.TextInfo;
        return textInfo.ToTitleCase(normalized.Trim().ToLower(CultureInfo.CurrentCulture));
    }

    private static string FormatDuration(long durationMs)
    {
        return durationMs < 1000
            ? FormattableString.Invariant($"{durationMs} ms")
            : FormattableString.Invariant($"{durationMs / 1000.0:0.#} s");
    }

    private static string FormatCompactTokenCount(long tokens)
    {
        var absolute = Math.Abs(tokens);
        if (absolute >= 1_000_000)
            return FormattableString.Invariant($"{tokens / 1_000_000d:0.#}M");
        if (absolute >= 1_000)
            return FormattableString.Invariant($"{tokens / 1_000d:0.#}K");
        return tokens.ToString(CultureInfo.InvariantCulture);
    }

