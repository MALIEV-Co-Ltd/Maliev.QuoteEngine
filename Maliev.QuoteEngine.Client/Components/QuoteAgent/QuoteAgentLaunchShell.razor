    private bool TryGetCanvasFocusPoint(out string style)
    {
        var directive = _uiFocusDirectives.FirstOrDefault(item =>
            item.TargetType.Equals("canvas_location", StringComparison.OrdinalIgnoreCase) ||
            item.TargetType.Equals("viewer", StringComparison.OrdinalIgnoreCase));
        if (directive?.CanvasX is null || directive.CanvasY is null)
        {
            style = string.Empty;
            return false;
        }

        var x = (Math.Clamp(directive.CanvasX.Value, 0.05, 0.95) * 100).ToString("0.##", CultureInfo.InvariantCulture);
        var y = (Math.Clamp(directive.CanvasY.Value, 0.05, 0.95) * 100).ToString("0.##", CultureInfo.InvariantCulture);
        x += "%";
        y += "%";
        style = $"left: {x}; top: {y};";
        return true;
    }

