@namespace Maliev.QuoteEngine.Client.Components.QuoteAgent
@implements IAsyncDisposable
@inject QuoteEngineApiClient Api
@inject PreferenceService Preferences
@inject IJSRuntime Js

<section class="qe-agent-shell" aria-label="@Text("Quote agent workspace", "พื้นที่ผู้ช่วยขอราคา")">
    <aside class="qe-agent-rail" aria-label="@Text("Quote navigation", "เมนูขอราคา")">
        <div class="qe-agent-rail-head">
            <a class="qe-agent-brand" href="/" aria-label="MALIEV">
                <img src="/images/logo.svg" alt="MALIEV" />
            </a>
            <button type="button" class="qe-agent-collapse" title="@Text("Collapse sidebar", "ยุบแถบด้านข้าง")">
                <MudIcon Icon="@Icons.Material.Outlined.MenuOpen" Size="Size.Small" />
            </button>
        </div>

        <nav class="qe-agent-primary-nav" aria-label="@Text("Quote workspace", "พื้นที่ขอราคา")">
            <a class="active" href="/">
                <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                <span>@Text("New project", "โปรเจกต์ใหม่")</span>
            </a>
            <button type="button">
                <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" />
                <span>@Text("Plugins", "ปลั๊กอิน")</span>
            </button>
            <a href="/quotes">
                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" />
                <span>@Text("Projects", "โปรเจกต์")</span>
            </a>
        </nav>

        <div class="qe-agent-rail-scroll">
            @if (PinnedProjects.Any())
            {
                <section class="qe-agent-rail-group" aria-label="@Text("Pinned projects", "โปรเจกต์ที่ปักหมุด")">
                    <header>@Text("Pinned projects", "โปรเจกต์ที่ปักหมุด")</header>
                    @foreach (var project in PinnedProjects)
                    {
                        <div class="qe-agent-project-row">
                            <a href="/quote/new">
                                <span>@ProjectName(project)</span>
                            </a>
                            <button type="button"
                                    class="qe-agent-pin-btn active"
                                    title="@Text("Unpin project", "เลิกปักหมุดโปรเจกต์")"
                                    aria-label="@Text($"Unpin {project.NameEn}", $"เลิกปักหมุด{project.NameTh}")"
                                    aria-pressed="true"
                                    @onclick="@(() => ToggleProjectPin(project))">
                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" />
                            </button>
                        </div>
                    }
                </section>
            }

            <section class="qe-agent-rail-group" aria-label="@Text("Projects", "โปรเจกต์")">
                <header>@Text("Projects", "โปรเจกต์")</header>
                @foreach (var project in _projects)
                {
                    <div class="qe-agent-project-row">
                        <a href="/quote/new">
                            <span>@ProjectName(project)</span>
                        </a>
                        <button type="button"
                                class="@($"qe-agent-pin-btn {(project.IsPinned ? "active" : string.Empty)}")"
                                title="@(project.IsPinned ? Text("Unpin project", "เลิกปักหมุดโปรเจกต์") : Text("Pin project", "ปักหมุดโปรเจกต์"))"
                                aria-label="@(project.IsPinned ? Text($"Unpin {project.NameEn}", $"เลิกปักหมุด{project.NameTh}") : Text($"Pin {project.NameEn}", $"ปักหมุด{project.NameTh}"))"
                                aria-pressed="@project.IsPinned"
                                @onclick="@(() => ToggleProjectPin(project))">
                            <MudIcon Icon="@(project.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)" Size="Size.Small" />
                        </button>
                    </div>
                }
            </section>
        </div>

        <div class="qe-agent-rail-foot">
            @if (IsSignedIn)
            {
                <span class="qe-agent-account-dot" aria-hidden="true">@Text("M", "ม")</span>
                <span>@Text("Signed in", "เข้าสู่ระบบแล้ว")</span>
            }
            else
            {
                <a class="qe-agent-signin-btn" href="/auth/sign-in?returnUrl=/">@Text("Sign in", "เข้าสู่ระบบ")</a>
            }
        </div>
    </aside>

    <main class="@MainClass">
        <div class="qe-agent-topline">
            <div class="qe-agent-status">
                <span aria-hidden="true"></span>
                <input class="qe-agent-project-name"
                       @bind="_projectName"
                       maxlength="120"
                       aria-label="@Text("Project name", "ชื่อโปรเจกต์")" />
            </div>
            <button type="button"
                    class="qe-agent-artifact-toggle"
                    aria-expanded="@_artifactPanelOpen"
                    @onclick="ToggleArtifactPanel">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                <span>@Text("Artifacts", "ไฟล์งาน")</span>
                <b>@_artifacts.Count</b>
            </button>
            <button type="button"
                    class="qe-agent-round-btn"
                    title="@Text("Toggle light or dark mode", "สลับโหมดสว่างหรือมืด")"
                    aria-label="@Text("Toggle light or dark mode", "สลับโหมดสว่างหรือมืด")"
                    @onclick="ToggleThemeAsync">
                <MudIcon Icon="@ThemeIcon" Size="Size.Small" />
            </button>
        </div>

        <div class="qe-agent-thread" aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="qe-agent-prompt">
                    <h1>@Text("What do you want to make today?", "วันนี้ต้องการผลิตอะไร?")</h1>
                </div>
            }
            else
            {
                @foreach (var message in _messages)
                {
                    <article class="@($"qe-agent-message qe-agent-message--{message.Role}")">
                        <div class="qe-agent-bubble">
                            <span>@RoleLabel(message.Role)</span>
                            <p>@message.Content</p>
                        </div>
                    </article>
                }
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="qe-agent-error" role="alert">@_error</div>
        }

        <section class="qe-agent-composer-wrap" aria-label="@Text("Message composer", "กล่องข้อความ")">
            <form class="qe-agent-composer" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
                <button type="button" class="qe-agent-round-btn" title="@Text("Attach files", "แนบไฟล์")" @onclick="RequestUploadAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                </button>
                <textarea @ref="_composerTextarea"
                          @bind="_draftMessage"
                          rows="1"
                          maxlength="4000"
                          placeholder="@Text("Describe your part, paste dimensions, or attach files...", "อธิบายชิ้นงาน วางขนาด หรือแนบไฟล์...")"
                          aria-label="@Text("Message MALIEV Quote Agent", "ข้อความถึงผู้ช่วยขอราคา MALIEV")"></textarea>
                <button type="button" class="qe-agent-round-btn" title="@Text("Attach CAD or drawing", "แนบ CAD หรือแบบ")" @onclick="RequestUploadAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                </button>
                <button type="submit" class="qe-agent-send-btn" title="@Text("Send", "ส่ง")" disabled="@_sending">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" />
                </button>
            </form>
            <div class="qe-agent-quick-actions" aria-label="@Text("Quick quote prompts", "คำสั่งลัดขอราคา")">
                <button type="button" @onclick="RequestUploadAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                    <span>@Text("Upload a 3D file", "อัปโหลดไฟล์ 3D")</span>
                </button>
                <button type="button" @onclick="RequestUploadAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Size="Size.Small" />
                    <span>@Text("Photo of a part", "รูปชิ้นงาน")</span>
                </button>
                <button type="button" @onclick="OpenSketchAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Draw" Size="Size.Small" />
                    <span>@Text("Hand sketch", "สเก็ตช์มือ")</span>
                </button>
            </div>
        </section>

        @if (_sketchOpen)
        {
            <button type="button"
                    class="qe-agent-sketch-backdrop"
                    aria-label="@Text("Close hand sketch", "ปิดสเก็ตช์มือ")"
                    @onclick="CloseSketch"></button>
            <section class="qe-agent-sketch-dialog" role="dialog" aria-modal="true" aria-label="@Text("Hand sketch", "สเก็ตช์มือ")">
                <header>
                    <div>
                        <span>@Text("Hand sketch", "สเก็ตช์มือ")</span>
                        <input class="qe-agent-sketch-title"
                               @bind="_sketchTitle"
                               maxlength="80"
                               aria-label="@Text("Sketch name", "ชื่อสเก็ตช์")" />
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="CloseSketch" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <div class="qe-agent-sketch-paper">
                    <canvas id="@SketchCanvasId"
                            class="qe-agent-sketch-canvas"
                            width="1100"
                            height="720"
                            aria-label="@Text("Draw your part sketch with a mouse or pen", "วาดสเก็ตช์ชิ้นงานด้วยเมาส์หรือปากกา")"></canvas>
                </div>
                <footer>
                    <div class="qe-agent-sketch-tools" aria-label="@Text("Sketch colors", "สีสเก็ตช์")">
                        @foreach (var swatch in SketchColors)
                        {
                            <button type="button"
                                    class="@($"qe-agent-sketch-color {(swatch.Hex == _sketchColor ? "active" : string.Empty)}")"
                                    style="@($"--sketch-color:{swatch.Hex}")"
                                    title="@swatch.Name"
                                    aria-label="@Text($"Use {swatch.Name} ink", $"ใช้สี{swatch.ThaiName}")"
                                    aria-pressed="@(swatch.Hex == _sketchColor)"
                                    @onclick="@(() => SelectSketchColorAsync(swatch.Hex))">
                                <span></span>
                            </button>
                        }
                    </div>
                    <button type="button" class="qe-agent-secondary-btn" @onclick="ClearSketchAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Backspace" Size="Size.Small" />
                        <span>@Text("Clear", "ล้าง")</span>
                    </button>
                    <button type="button" class="qe-agent-primary-btn" @onclick="AttachSketchAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        <span>@Text("Attach sketch", "แนบสเก็ตช์")</span>
                    </button>
                </footer>
            </section>
        }

        @if (_artifactPanelOpen)
        {
            <button type="button"
                    class="qe-agent-artifact-backdrop"
                    aria-label="@Text("Close artifacts", "ปิดไฟล์งาน")"
                    @onclick="ToggleArtifactPanel"></button>
            <aside class="qe-agent-artifact-drawer" role="dialog" aria-modal="true" aria-label="@Text("Quote artifacts", "ไฟล์งานใบเสนอราคา")">
                <header>
                    <div>
                        <span>@Text("Workbench", "พื้นที่งาน")</span>
                        <strong>@Text("Artifacts", "ไฟล์งาน")</strong>
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="ToggleArtifactPanel" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                @if (_artifacts.Count == 0)
                {
                    <p class="qe-agent-muted">@Text("Viewer, DFM reports, estimates, quote PDFs, order records, and payment handoffs will appear here.", "โมเดล รายงาน DFM ราคา ใบเสนอราคา คำสั่งซื้อ และการชำระเงินจะแสดงที่นี่")</p>
                }
                else
                {
                    <div class="qe-agent-artifacts">
                        @foreach (var artifact in _artifacts)
                        {
                            <div class="qe-agent-artifact">
                                <MudIcon Icon="@ArtifactIcon(artifact.ArtifactType)" Size="Size.Small" />
                                <div>
                                    <strong>@artifact.Title</strong>
                                    <small>@artifact.Status</small>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (_proposedActions.Count > 0)
                {
                    <section class="qe-agent-actions">
                        <header>@Text("Confirm actions", "ยืนยันการทำงาน")</header>
                        @foreach (var action in _proposedActions)
                        {
                            <article class="qe-agent-action">
                                <strong>@action.Title</strong>
                                <p>@action.Summary</p>
                                @if (action.RequiresAuthentication && !IsSignedIn)
                                {
                                    <a href="/auth/sign-in?returnUrl=/">@Text("Sign in", "เข้าสู่ระบบ")</a>
                                }
                                else
                                {
                                    <button type="button" @onclick="@(() => ConfirmActionAsync(action))">
                                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                        <span>@Text("Confirm", "ยืนยัน")</span>
                                    </button>
                                }
                            </article>
                        }
                    </section>
                }
            </aside>
        }
    </main>
</section>

@code {
    private readonly List<AgentMessageRow> _messages = [];
    private readonly List<ProjectNavItem> _projects =
    [
        new("milling-fixture-quote", "Milling fixture quote", "ใบเสนอราคาจิ๊กกัด", true),
        new("nylon-sensor-housing", "Nylon sensor housing", "กล่องเซนเซอร์ไนลอน", true),
        new("aluminum-mounting-bracket", "Aluminum mounting bracket", "ขายึดอะลูมิเนียม", false),
        new("injection-mold-insert", "Injection mold insert", "อินเสิร์ตแม่พิมพ์", false),
        new("cnc-housing-revision", "CNC housing revision", "ปรับแบบกล่อง CNC", false)
    ];
    private List<QuoteAgentGateDto> _gates = [];
    private List<QuoteAgentArtifactDto> _artifacts = [];
    private List<QuoteAgentProposedActionDto> _proposedActions = [];
    private Guid _loadedSessionId;
    private string _draftMessage = string.Empty;
    private string? _error;
    private bool _sending;
    private bool _artifactPanelOpen;
    private bool _sketchOpen;
    private bool _sketchInitPending;
    private string _projectName = $"Manufacturing project {DateTimeOffset.Now:yyyy-MM-dd}";
    private string _sketchTitle = "Untitled sketch";
    private string _sketchColor = "#161616";
    private string? _lastSketchDataUrl;
    private ElementReference _composerTextarea;
    private DotNetObjectReference<QuoteAgentLaunchShell>? _composerDotNetRef;
    private IJSObjectReference? _composerModule;
    private IJSObjectReference? _sketchModule;
    private string SketchCanvasId { get; } = $"qe-agent-sketch-{Guid.NewGuid():N}";
    private static readonly SketchColorOption[] SketchColors =
    [
        new("Black", "ดำ", "#161616"),
        new("Red", "แดง", "#dc2626"),
        new("Blue", "น้ำเงิน", "#2563eb"),
        new("Green", "เขียว", "#16a34a"),
        new("Amber", "เหลืองอำพัน", "#d97706"),
        new("White", "ขาว", "#ffffff")
    ];

    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsSignedIn { get; set; }

    [Parameter]
    public bool IsDemoMode { get; set; }

    [Parameter]
    public bool ShowLaunchAccountCard { get; set; }

    [Parameter]
    public string Culture { get; set; } = SupportedCultures.DefaultCulture;

    [Parameter]
    public EventCallback OnUploadRequested { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeIcon => IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string MainClass => _messages.Count == 0 ? "qe-agent-main qe-agent-main--empty" : "qe-agent-main qe-agent-main--chat";
    private IEnumerable<ProjectNavItem> PinnedProjects => _projects.Where(project => project.IsPinned);

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId == Guid.Empty || SessionId == _loadedSessionId)
        {
            return;
        }

        _loadedSessionId = SessionId;
        await LoadStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _composerDotNetRef = DotNetObjectReference.Create(this);
            _composerModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-composer.js");
            await _composerModule.InvokeVoidAsync("initComposer", _composerTextarea, _composerDotNetRef);
        }

        if (!_sketchInitPending)
        {
            return;
        }

        _sketchInitPending = false;
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("initSketchCanvas", SketchCanvasId);
        await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);
    }

    private async Task LoadStateAsync()
    {
        try
        {
            var state = await Api.GetAgentStateAsync(SessionId);
            ApplyState(state);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    [JSInvokable]
    public Task SubmitComposerFromKeyboardAsync()
    {
        return HandleSubmitAsync();
    }

    private async Task HandleSubmitAsync()
    {
        var message = _draftMessage.Trim();
        if (string.IsNullOrWhiteSpace(message) || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        _draftMessage = string.Empty;
        _messages.Add(new AgentMessageRow("user", message));

        try
        {
            var response = await Api.SendAgentMessageAsync(new QuoteAgentMessageRequest
            {
                SessionId = SessionId,
                Message = message,
                Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en"
            });

            _messages.Add(new AgentMessageRow("assistant", response.AssistantText));
            _gates = response.Gates;
            _artifacts = response.Artifacts;
            _proposedActions = response.ProposedActions;
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task ConfirmActionAsync(QuoteAgentProposedActionDto action)
    {
        try
        {
            var result = await Api.ConfirmAgentActionAsync(action.ActionId, new QuoteAgentConfirmActionRequest());
            _messages.Add(new AgentMessageRow("assistant", result.Message));
            if (result.State is not null)
            {
                ApplyState(result.State);
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
    }

    private void ApplyState(QuoteAgentStateResponse state)
    {
        _gates = state.Gates;
        _artifacts = state.Artifacts;
        _proposedActions = state.ProposedActions;
    }

    private void ToggleArtifactPanel()
    {
        _artifactPanelOpen = !_artifactPanelOpen;
    }

    private Task ToggleThemeAsync()
    {
        return Preferences.SetThemeAsync(IsDarkMode ? PreferenceService.LightTheme : PreferenceService.DarkTheme);
    }

    private async Task RequestUploadAsync()
    {
        if (OnUploadRequested.HasDelegate)
        {
            await OnUploadRequested.InvokeAsync();
        }
    }

    private Task OpenSketchAsync()
    {
        _sketchOpen = true;
        _sketchInitPending = true;
        return Task.CompletedTask;
    }

    private void CloseSketch()
    {
        _sketchOpen = false;
    }

    private async Task ClearSketchAsync()
    {
        if (_sketchModule is not null)
        {
            await _sketchModule.InvokeVoidAsync("clearSketchCanvas", SketchCanvasId);
        }
    }

    private async Task SelectSketchColorAsync(string color)
    {
        _sketchColor = color;
        if (_sketchModule is not null)
        {
            await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);
        }
    }

    private async Task AttachSketchAsync()
    {
        if (_sketchModule is not null)
        {
            _lastSketchDataUrl = await _sketchModule.InvokeAsync<string>("exportSketchCanvas", SketchCanvasId);
        }

        _messages.Add(new AgentMessageRow("user", Text($"Attached hand sketch: {_sketchTitle}", $"แนบสเก็ตช์มือ: {_sketchTitle}")));
        _messages.Add(new AgentMessageRow("assistant", Text(
            "I received the sketch. Add dimensions, material, and any critical tolerances, or attach CAD when geometry is ready for DFM and pricing.",
            "ได้รับสเก็ตช์แล้ว โปรดเพิ่มขนาด วัสดุ และค่าความเผื่อที่สำคัญ หรือแนบ CAD เมื่อพร้อมสำหรับ DFM และการคำนวณราคา")));
        _sketchOpen = false;
    }

    private string RoleLabel(string role)
    {
        return role.Equals("user", StringComparison.OrdinalIgnoreCase)
            ? Text("You", "คุณ")
            : "Mali";
    }

    private static string ArtifactIcon(string artifactType)
    {
        return artifactType.ToLowerInvariant() switch
        {
            "pricing" => Icons.Material.Outlined.Calculate,
            "formal_quote" => Icons.Material.Outlined.PictureAsPdf,
            "order" => Icons.Material.Outlined.PrecisionManufacturing,
            "viewer" => Icons.Material.Outlined.ViewInAr,
            _ => Icons.Material.Outlined.Inventory2
        };
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }

    private string ProjectName(ProjectNavItem project)
    {
        return Text(project.NameEn, project.NameTh);
    }

    private static void ToggleProjectPin(ProjectNavItem project)
    {
        project.IsPinned = !project.IsPinned;
    }

    private sealed record AgentMessageRow(string Role, string Content);

    private sealed record SketchColorOption(string Name, string ThaiName, string Hex);

    private sealed class ProjectNavItem(string id, string nameEn, string nameTh, bool isPinned)
    {
        public string Id { get; } = id;

        public string NameEn { get; } = nameEn;

        public string NameTh { get; } = nameTh;

        public bool IsPinned { get; set; } = isPinned;
    }

    public async ValueTask DisposeAsync()
    {
        if (_composerModule is not null)
        {
            await _composerModule.InvokeVoidAsync("disposeComposer", _composerTextarea);
            await _composerModule.DisposeAsync();
        }

        _composerDotNetRef?.Dispose();

        if (_sketchModule is not null)
        {
            await _sketchModule.DisposeAsync();
        }
    }
}
