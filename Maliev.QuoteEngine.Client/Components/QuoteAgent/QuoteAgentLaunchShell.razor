    private async Task ExportChatPdfAsync()
    {
        if (_exportingPdf) return;
        _exportingPdf = true;
        _error = null;
        try
        {
            var language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en";
