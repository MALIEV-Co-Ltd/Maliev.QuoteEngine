    private async Task<string> OpenDriveMentionConnectorAsync()
    {
        _highlightConnectorId = "google-drive";
        if (!_connectorRegistryLoaded)
        {
            await LoadConnectorRegistryAsync();
        }

        var connector = GoogleDriveConnector;
        if (connector is null)
        {
            await OpenPluginsPageAsync();
            return _connectorRegistryRequiresAuthentication
                ? Text(
                    "Sign in to use Google Drive from Make Studio. After sign-in, @drive opens Drive file selection.",
                    "ลงชื่อเข้าใช้เพื่อใช้ Google Drive จาก Make Studio หลังจากลงชื่อเข้าใช้แล้ว @drive จะเปิดการเลือกไฟล์จาก Drive")
                : Text(
                    "Google Drive is not available in this environment yet. Use Plugins after it is configured, or upload files directly.",
                    "Google Drive ยังไม่พร้อมใช้งานในสภาพแวดล้อมนี้ ใช้ Plugins หลังจากตั้งค่าแล้ว หรืออัปโหลดไฟล์โดยตรง");
        }

        if (!connector.IsConfigured)
        {
            await ApplyConnectorAsync(connector);
            return Text(
                "Google Drive is not configured for this environment yet. Upload files directly until it is configured.",
                "ยังไม่ได้ตั้งค่า Google Drive สำหรับสภาพแวดล้อมนี้ กรุณาอัปโหลดไฟล์โดยตรงจนกว่าจะตั้งค่าแล้ว");
        }

        if (connector.IsConnected)
        {
            var selectedCount = await OpenGoogleDrivePickerAsync();
            if (selectedCount > 0)
            {
                return Text(
                    $"Selected {selectedCount:N0} file{(selectedCount == 1 ? string.Empty : "s")} from Google Drive. Review the attachment card in the composer, then send it when ready.",
                    $"เลือกไฟล์จาก Google Drive แล้ว {selectedCount:N0} ไฟล์ ตรวจสอบการ์ดไฟล์แนบในกล่องข้อความ แล้วส่งเมื่อพร้อม");
            }

            return Text(
                "Google Drive selection was canceled. Choose @drive again when you want to attach a Drive file.",
                "ยกเลิกการเลือกไฟล์จาก Google Drive แล้ว ใช้ @drive อีกครั้งเมื่อต้องการแนบไฟล์จาก Drive");
        }

        await ApplyConnectorAsync(connector);
        return Text(
            "I opened the Google Drive connector panel. Continue there to connect Drive from this app instead of using a chat link.",
            "ผมเปิดแผงตัวเชื่อมต่อ Google Drive ให้แล้ว ดำเนินการต่อจากแผงนั้นเพื่อเชื่อมต่อ Drive จากแอปนี้แทนการใช้ลิงก์ในแชท");
    }

    private async Task<int> OpenGoogleDrivePickerAsync()
    {
        if (_drivePickerOpening)
        {
            return 0;
        }

        _drivePickerOpening = true;
        _error = null;
        try
        {
            var config = await Api.GetGoogleDrivePickerConfigAsync();
            var selectedFiles = await Js.InvokeAsync<IReadOnlyList<GoogleDriveSelectedFileDto>>("quoteGoogleDrivePicker.openPicker", config);
            if (selectedFiles.Count == 0)
            {
                return 0;
            }

            var response = await Api.ImportGoogleDriveFilesAsync(new GoogleDriveImportRequest
            {
                QuoteSessionId = SessionId.ToString("N"),
                SessionId = SessionId,
                Files = selectedFiles.Take(config.MaxSelectableFiles).ToList()
            });

            foreach (var attachment in response.Attachments)
            {
                QueueComposerAttachment(ComposerAttachmentPreview.FromAgentAttachment(attachment));
            }

            await RefreshPendingAttachmentPreviewAsync();
            return response.Attachments.Count;
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
            return 0;
        }
        catch (Exception ex) when (ex is JSException or HttpRequestException or InvalidOperationException)
        {
            _error = Text(
                "Google Drive selection is temporarily unavailable. Upload the file directly if this continues.",
                "การเลือกไฟล์จาก Google Drive ยังไม่พร้อมใช้งานชั่วคราว หากยังเกิดขึ้นอีก กรุณาอัปโหลดไฟล์โดยตรง");
            return 0;
        }
        finally
        {
            _drivePickerOpening = false;
            await InvokeAsync(StateHasChanged);
        }
    }

