    }

    private async Task AttachSketchAsync()
    {
        if (_sketchAttaching)
        {
            return;
        }

        _sketchAttaching = true;

        if (string.IsNullOrWhiteSpace(_sketchTitle) ||
            _sketchTitle.Equals("Untitled sketch", StringComparison.OrdinalIgnoreCase))
        {
            _sketchTitle = Text("Manufacturing sketch", "สเก็ตช์งานผลิต");
        }

        string? sketchDataUrl = null;
        if (_sketchModule is not null)
        {
            sketchDataUrl = await _sketchModule.InvokeAsync<string>("exportSketchCanvas", SketchCanvasId);
        }

        try
        {
            if (!string.IsNullOrWhiteSpace(sketchDataUrl))
            {
                var fileName = BuildSketchFileName(_sketchTitle);
                var base64Data = sketchDataUrl[(sketchDataUrl.IndexOf(',') + 1)..];
                var imageBytes = Convert.FromBase64String(base64Data);

                var sketchUploadUrl = Navigation.ToAbsoluteUri($"/quote/v1/agent/sessions/{SessionId}/sketches").ToString();
                using var formContent = new MultipartFormDataContent();
                var pngContent = new ByteArrayContent(imageBytes);
                pngContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/png");
                formContent.Add(pngContent, "file", fileName);
                var uploadResponse = await Http.PostAsync(sketchUploadUrl, formContent);
                uploadResponse.EnsureSuccessStatusCode();
                var result = await uploadResponse.Content.ReadFromJsonAsync<UploadSketchResponse>();

                var attachmentId = Guid.NewGuid();
                var attachment = new ComposerAttachmentPreview(
                    attachmentId,
                    fileName,
                    "image/png",
                    imageBytes.Length,
                    sketchDataUrl,
                    "sketch",
                    result!.UploadId,
                    result.StoragePath,
                    result.Url,
                    false,
                    "Ready");

                var existingSketchIndex = _pendingComposerAttachments.FindIndex(item => item.Matches(attachment));
                if (existingSketchIndex >= 0)
                {
                    _pendingComposerAttachments[existingSketchIndex] = attachment;
                }
                else
                {
                    _pendingComposerAttachments.Add(attachment);
                }
            }
        }
        catch
        {
            _error = Text("Sketch could not be uploaded. Please try again.", "ไม่สามารถอัปโหลดสเก็ตช์ได้ กรุณาลองใหม่อีกครั้ง");
        }
        finally
        {
            _sketchAttaching = false;

            if (_sketchModule is not null)
            {
                await _sketchModule.InvokeVoidAsync("disposeSketchCanvas", SketchCanvasId);
            }

            _sketchOpen = false;
            await RefreshPendingAttachmentPreviewAsync();
            await FocusComposerAsync();
        }
    }

