    private async Task OnThreadScrollAsync(EventArgs _)
    {
        if (_scrollUpdatePending)
        {
            return;
        }

        _scrollUpdatePending = true;
        try
        {
            await Task.Delay(80);
            var scrollInfo = await Js.InvokeAsync<ChatScrollInfo>("malievChatbot.getScrollInfo", _threadElement);
            var isAtBottom = QuoteAgentUiHelpers.IsAtScrollBottom(
                scrollInfo.scrollTop,
                scrollInfo.scrollHeight,
                scrollInfo.clientHeight);
            if (isAtBottom)
            {
                _suppressScrollToBottomButtonUntilBottom = false;
            }

            _showScrollToBottomButton = !_suppressScrollToBottomButtonUntilBottom && !isAtBottom;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _scrollUpdatePending = false;
        }
    }

