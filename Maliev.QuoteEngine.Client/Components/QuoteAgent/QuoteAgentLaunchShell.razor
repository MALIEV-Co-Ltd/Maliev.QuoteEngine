    private string BuildReplyPreview(AgentMessageRow message)
    {
        var text = (message.Content ?? string.Empty).Replace("\r", " ").Replace("\n", " ").Trim();
        return text.Length > 120 ? text[..117] + "…" : text;
    }

    private string ReplyChipLabel(AgentMessageRow message)
    {
        var who = message.Role.Equals("user", StringComparison.OrdinalIgnoreCase)
            ? Text("You", "คุณ")
            : Text("Assistant", "ผู้ช่วย");
        return $"{who}: {BuildReplyPreview(message)}";
    }

    private async Task EditUserMessageAsync(AgentMessageRow message)
    {
        // Editing is restricted to the most recent customer message so edits act as a
        // correction/rollback of the last turn, never an arbitrary earlier message.
        if (!message.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ||
            !ReferenceEquals(message, LastUserMessage))
        {
            return;
        }

        _draftMessage = message.Content;
        _replyTo = null;
        _editingLastUserMessage = message;
        _pendingComposerAttachments.Clear();
        _pendingComposerAttachments.AddRange(message.Attachments.Select(attachment => attachment with { }));

        if (_composerModule is not null)
        {
            try
            {
                await _composerModule.InvokeVoidAsync("setComposerText", _composerTextarea, _draftMessage);
            }
            catch (InvalidOperationException)
            {
                // The composer can be unavailable during teardown or first render.
            }
        }

        await InvokeAsync(StateHasChanged);
        await FocusComposerAsync();
    }

