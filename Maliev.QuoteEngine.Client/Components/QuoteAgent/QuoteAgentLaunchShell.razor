            }
        </section>

        @if (_sketchOpen)
        {
            <button type="button"
                    class="qe-agent-sketch-backdrop"
                    aria-label="@Text("Close hand sketch", "ปิดสเก็ตช์มือ")"
                    @onclick="CloseSketch"></button>
            <section class="qe-agent-sketch-dialog" role="dialog" aria-modal="true" aria-label="@Text("Hand sketch", "สเก็ตช์มือ")">
                <header>
                    <div>
                        <span>@Text("Hand sketch", "สเก็ตช์มือ")</span>
                        <input class="qe-agent-sketch-title"
                               @bind="_sketchTitle"
                               maxlength="80"
                               aria-label="@Text("Sketch name", "ชื่อสเก็ตช์")" />
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="CloseSketch" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <div class="qe-agent-sketch-paper">
                    <canvas id="@SketchCanvasId"
                            class="qe-agent-sketch-canvas"
                            width="1100"
                            height="720"
                            aria-label="@Text("Draw your part sketch with a mouse or pen", "วาดสเก็ตช์ชิ้นงานด้วยเมาส์หรือปากกา")"></canvas>
                </div>
                <footer>
                    <div class="qe-agent-sketch-tools" aria-label="@Text("Sketch colors", "สีสเก็ตช์")">
                        @foreach (var swatch in SketchColors)
                        {
                            <button type="button"
                                    class="@($"qe-agent-sketch-color {(swatch.Hex == _sketchColor ? "active" : string.Empty)}")"
                                    style="@($"--sketch-color:{swatch.Hex}")"
                                    title="@swatch.Name"
                                    aria-label="@Text($"Use {swatch.Name} ink", $"ใช้สี{swatch.ThaiName}")"
                                    aria-pressed="@(swatch.Hex == _sketchColor)"
                                    @onclick="@(() => SelectSketchColorAsync(swatch.Hex))">
                                <span></span>
                            </button>
                        }
                    </div>
                    <button type="button" class="qe-agent-secondary-btn" @onclick="ClearSketchAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Backspace" Size="Size.Small" />
                        <span>@Text("Clear", "ล้าง")</span>
                    </button>
                    <button type="button" class="qe-agent-primary-btn" @onclick="AttachSketchAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        <span>@Text("Attach sketch", "แนบสเก็ตช์")</span>
                    </button>
                </footer>
            </section>
        }

    </main>

    @if (_artifactPanelOpen)
    {
        <aside class="qe-agent-artifact-drawer" aria-label="@Text("Quote artifacts", "ไฟล์งานใบเสนอราคา")">
            <header>
                <div>
                    <span>@Text("Workbench", "พื้นที่งาน")</span>
                    <strong>@Text("Artifacts", "ไฟล์งาน")</strong>
                </div>
                <button type="button" class="qe-agent-round-btn" @onclick="ToggleArtifactPanel" title="@Text("Close", "ปิด")">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                </button>
            </header>
            @if (_artifacts.Count == 0)
            {
                <p class="qe-agent-muted">@Text("Viewer, DFM reports, estimates, quote PDFs, order records, and payment handoffs will appear here.", "โมเดล รายงาน DFM ราคา ใบเสนอราคา คำสั่งซื้อ และการชำระเงินจะแสดงที่นี่")</p>
            }
            else
            {
                <div class="qe-agent-artifacts">
                    @foreach (var artifact in _artifacts)
                    {
                        <div class="qe-agent-artifact">
                            <MudIcon Icon="@ArtifactIcon(artifact.ArtifactType)" Size="Size.Small" />
                            <div>
                                <strong>@artifact.Title</strong>
                                <small>@artifact.Status</small>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_proposedActions.Count > 0)
            {
                <section class="qe-agent-actions">
                    <header>@Text("Confirm actions", "ยืนยันการทำงาน")</header>
                    @foreach (var action in _proposedActions)
                    {
                        <article class="qe-agent-action">
                            <strong>@action.Title</strong>
                            <p>@action.Summary</p>
                            @if (action.RequiresAuthentication && !IsSignedIn)
                            {
                                <a href="/auth/sign-in?returnUrl=/quotes">@Text("Sign in", "เข้าสู่ระบบ")</a>
                            }
                            else
                            {
                                <button type="button" @onclick="@(() => ConfirmActionAsync(action))">
                                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                    <span>@Text("Confirm", "ยืนยัน")</span>
                                </button>
                            }
                        </article>
                    }
                </section>
            }
        </aside>
    }

    @if (_artifactPanelOpen)
    {
        <button type="button"
                class="qe-agent-artifact-backdrop"
                aria-label="@Text("Close artifacts", "ปิดไฟล์งาน")"
                @onclick="ToggleArtifactPanel"></button>
    }
</section>

@code {
    private readonly List<AgentMessageRow> _messages = [];
    private readonly List<ProjectNavItem> _projects = [];
    private readonly List<QuoteAgentSearchResultDto> _customerSearchResults = [];
    private List<QuoteAgentGateDto> _gates = [];
    private List<QuoteAgentArtifactDto> _artifacts = [];
    private List<QuoteAgentProposedActionDto> _proposedActions = [];
    private List<QuoteAgentConnectorDto> _connectors = [];
    private Guid _loadedSessionId;
    private string _draftMessage = string.Empty;
    private string? _error;
    private bool _sending;
    private bool _artifactPanelOpen;
    private bool _railCollapsed;
    private bool _sketchOpen;
    private bool _sketchInitPending;
    private bool _searchOpen;
    private bool _pluginsOpen;
    private bool _focusSearchPending;
    private bool _pinnedProjectsCollapsed;
    private bool _projectsCollapsed;
    private bool _projectNavigationLoaded;
    private bool _connectorRegistryLoaded;
    private bool _searchLoading;
    private bool _customerSearchUnavailable;
    private string _projectName = $"Manufacturing project {DateTimeOffset.Now:yyyy-MM-dd}";
    private string _searchQuery = string.Empty;
    private string _sketchTitle = "Untitled sketch";
    private string _sketchColor = "#161616";
    private string? _lastSketchDataUrl;
    private ElementReference _composerTextarea;
    private ElementReference _searchInput;
    private DotNetObjectReference<QuoteAgentLaunchShell>? _composerDotNetRef;
    private IJSObjectReference? _composerModule;
    private IJSObjectReference? _sketchModule;
    private string SketchCanvasId { get; } = $"qe-agent-sketch-{Guid.NewGuid():N}";
    private static readonly SketchColorOption[] SketchColors =
    [
        new("Black", "ดำ", "#161616"),
        new("Red", "แดง", "#dc2626"),
        new("Blue", "น้ำเงิน", "#2563eb"),
        new("Green", "เขียว", "#16a34a"),
        new("Amber", "เหลืองอำพัน", "#d97706"),
        new("White", "ขาว", "#ffffff")
    ];
    private static readonly UseCaseOption[] SampleUseCases =
    [
        new(
            "Quote a 3D printed enclosure",
            "ขอราคากล่องพิมพ์ 3D",
            "I need 25 black nylon SLS enclosures from a STEP file. Please check wall thickness, threads, DFM risks, and quote a 7 day lead time.",
            "ต้องการกล่องไนลอน SLS สีดำ 25 ชิ้นจากไฟล์ STEP ช่วยตรวจความหนาผนัง เกลียว ความเสี่ยง DFM และเสนอเวลานำส่ง 7 วัน"),
        new(
            "Turn a sketch into requirements",
            "เปลี่ยนสเก็ตช์เป็นข้อกำหนด",
            "I have a hand sketch for an aluminum mounting bracket. Help me identify missing dimensions, material, finish, tolerance, and the best manufacturing process.",
            "มีสเก็ตช์มือของขายึดอะลูมิเนียม ช่วยหาขนาดที่ขาด วัสดุ ผิวสำเร็จ ความเผื่อ และกระบวนการผลิตที่เหมาะสม"),
        new(
            "Compare material and finish options",
            "เปรียบเทียบวัสดุและผิวสำเร็จ",
            "For this CNC part, compare 6061 aluminum clear anodized vs black anodized for 10, 50, and 100 pieces, including lead time and cost drivers.",
            "สำหรับชิ้นงาน CNC นี้ ช่วยเปรียบเทียบอะลูมิเนียม 6061 อโนไดซ์ใสกับอโนไดซ์ดำ สำหรับ 10, 50 และ 100 ชิ้น พร้อมเวลานำส่งและปัจจัยต้นทุน")
    ];

    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsSignedIn { get; set; }

    [Parameter]
    public bool IsDemoMode { get; set; }

    [Parameter]
    public bool ShowLaunchAccountCard { get; set; }

    [Parameter]
    public string Culture { get; set; } = SupportedCultures.DefaultCulture;

    [Parameter]
    public EventCallback OnUploadRequested { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeIcon => IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ShellClass => $"qe-agent-shell{(_railCollapsed ? " qe-agent-shell--rail-collapsed" : string.Empty)}{(_artifactPanelOpen ? " qe-agent-shell--artifacts-open" : string.Empty)}";
    private string MainClass => _messages.Count == 0 ? "qe-agent-main qe-agent-main--empty" : "qe-agent-main qe-agent-main--chat";
    private IEnumerable<ProjectNavItem> PinnedProjects => _projects.Where(project => project.IsPinned && !project.IsArchived);
    private IEnumerable<ProjectNavItem> RegularProjects => _projects.Where(project => !project.IsPinned && !project.IsArchived);
    private IEnumerable<SearchNavItem> SearchResults => BuildSearchResults();

    protected override async Task OnParametersSetAsync()
    {
        if (IsSignedIn)
        {
            if (!_projectNavigationLoaded)
            {
                await LoadProjectNavigationAsync();
            }
        }
        else
        {
            _projects.Clear();
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            _projectNavigationLoaded = false;
        }

        if (SessionId == Guid.Empty || SessionId == _loadedSessionId)
        {
            return;
        }

        _loadedSessionId = SessionId;
        await LoadStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _composerDotNetRef = DotNetObjectReference.Create(this);
            _composerModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-composer.js");
            await _composerModule.InvokeVoidAsync("initComposer", _composerTextarea, _composerDotNetRef);
            await _composerModule.InvokeVoidAsync("focusComposer", _composerTextarea);
        }

        if (!_sketchInitPending)
        {
            if (_focusSearchPending && _searchOpen)
            {
                _focusSearchPending = false;
                await _searchInput.FocusAsync();
            }

            return;
        }

        _sketchInitPending = false;
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("initSketchCanvas", SketchCanvasId);
        await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);

        if (_focusSearchPending && _searchOpen)
        {
            _focusSearchPending = false;
            await _searchInput.FocusAsync();
        }
    }

    private async Task LoadStateAsync()
    {
        try
        {
            var state = await Api.GetAgentStateAsync(SessionId);
            ApplyState(state);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadProjectNavigationAsync()
    {
        try
        {
            var projects = await Api.GetProjectNavigationAsync();
            _projects.Clear();
            _projects.AddRange(projects.Select(ProjectNavItem.FromDto));
            _projectNavigationLoaded = true;
        }
        catch (QuoteEngineApiException ex)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            if (ex.StatusCode != System.Net.HttpStatusCode.Unauthorized)
            {
                _error = ex.UserMessage;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            _error = ex.Message;
        }
    }

    [JSInvokable]
    public Task SubmitComposerFromKeyboardAsync()
    {
        return HandleSubmitAsync();
    }

    private async Task HandleSubmitAsync()
    {
        var message = _draftMessage.Trim();
        if (string.IsNullOrWhiteSpace(message) || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        _draftMessage = string.Empty;
        _messages.Add(new AgentMessageRow("user", message));
        var assistantMessage = new AgentMessageRow("assistant", string.Empty);
        _messages.Add(assistantMessage);

        try
        {
            await foreach (var streamEvent in Api.SendAgentMessageStreamAsync(new QuoteAgentMessageRequest
            {
                SessionId = SessionId,
                Message = message,
                Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en"
            }))
            {
                if (streamEvent.Type.Equals("delta", StringComparison.OrdinalIgnoreCase))
                {
                    assistantMessage.Content += streamEvent.Delta;
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("final", StringComparison.OrdinalIgnoreCase) &&
                         streamEvent.Response is not null)
                {
                    assistantMessage.Content = streamEvent.Response.AssistantText;
                    assistantMessage.ThinkingSteps = streamEvent.Response.ThinkingSteps;
                    _gates = streamEvent.Response.Gates;
                    _artifacts = streamEvent.Response.Artifacts;
                    _proposedActions = streamEvent.Response.ProposedActions;
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("error", StringComparison.OrdinalIgnoreCase))
                {
                    _error = string.IsNullOrWhiteSpace(streamEvent.Error)
                        ? Text("The agent could not complete this response.", "ผู้ช่วยไม่สามารถตอบกลับได้สำเร็จ")
                        : streamEvent.Error;
                    _messages.Remove(assistantMessage);
                }
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
            _messages.Remove(assistantMessage);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _messages.Remove(assistantMessage);
            if (TryBuildLocalDemoTurn(message, out var demoTurn))
            {
                AddLocalDemoTurn(demoTurn);
            }
            else
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task ConfirmActionAsync(QuoteAgentProposedActionDto action)
    {
        try
        {
            var result = await Api.ConfirmAgentActionAsync(action.ActionId, new QuoteAgentConfirmActionRequest());
            _messages.Add(new AgentMessageRow("assistant", result.Message));
            if (result.State is not null)
            {
                ApplyState(result.State);
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
    }

    private void ApplyState(QuoteAgentStateResponse state)
    {
        _gates = state.Gates;
        _artifacts = state.Artifacts;
        _proposedActions = state.ProposedActions;
    }

    private void ToggleArtifactPanel()
    {
        _artifactPanelOpen = !_artifactPanelOpen;
    }

    private void ToggleRail()
    {
        _railCollapsed = !_railCollapsed;
        if (_railCollapsed)
        {
            _searchOpen = false;
            _pluginsOpen = false;
        }
    }

    private void TogglePinnedProjects()
    {
        _pinnedProjectsCollapsed = !_pinnedProjectsCollapsed;
    }

    private void ToggleProjects()
    {
        _projectsCollapsed = !_projectsCollapsed;
    }

    private static string RailGroupClass(bool collapsed)
    {
        return collapsed ? "qe-agent-rail-group is-collapsed" : "qe-agent-rail-group";
    }

    private static string AriaExpanded(bool value)
    {
        return value ? "true" : "false";
    }

    private Task ToggleThemeAsync()
    {
        return Preferences.SetThemeAsync(IsDarkMode ? PreferenceService.LightTheme : PreferenceService.DarkTheme);
    }

    private async Task RequestUploadAsync()
    {
        if (OnUploadRequested.HasDelegate)
        {
            await OnUploadRequested.InvokeAsync();
        }
    }

    private Task OpenSketchAsync()
    {
        _sketchOpen = true;
        _sketchInitPending = true;
        return Task.CompletedTask;
    }

    private void CloseSketch()
    {
        _sketchOpen = false;
    }

    private async Task ClearSketchAsync()
    {
        if (_sketchModule is not null)
        {
            await _sketchModule.InvokeVoidAsync("clearSketchCanvas", SketchCanvasId);
        }
    }

    private async Task SelectSketchColorAsync(string color)
    {
        _sketchColor = color;
        if (_sketchModule is not null)
        {
            await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);
        }
    }

    private async Task AttachSketchAsync()
    {
        if (_sketchModule is not null)
        {
            _lastSketchDataUrl = await _sketchModule.InvokeAsync<string>("exportSketchCanvas", SketchCanvasId);
        }

        _messages.Add(new AgentMessageRow("user", Text($"Attached hand sketch: {_sketchTitle}", $"แนบสเก็ตช์มือ: {_sketchTitle}")));
        AddLocalDemoTurn(BuildSketchDemoTurn());
        _sketchOpen = false;
    }

    private string RoleLabel(string role)
    {
        return role.Equals("user", StringComparison.OrdinalIgnoreCase)
            ? Text("You", "คุณ")
            : "Mali";
    }

    private string ThinkingSummary(IReadOnlyCollection<QuoteAgentThinkingStepDto> steps)
    {
        var totalDuration = steps.Sum(step => step.DurationMs.GetValueOrDefault());
        if (totalDuration > 0)
        {
            return Text($"{steps.Count} steps · {FormatDuration(totalDuration)}", $"{steps.Count} ขั้นตอน · {FormatDuration(totalDuration)}");
        }

        return Text($"{steps.Count} steps", $"{steps.Count} ขั้นตอน");
    }

    private static string FormatDuration(long durationMs)
    {
        return durationMs < 1000
            ? FormattableString.Invariant($"{durationMs} ms")
            : FormattableString.Invariant($"{durationMs / 1000.0:0.#} s");
    }

    private static string ArtifactIcon(string artifactType)
    {
        return artifactType.ToLowerInvariant() switch
        {
            "analysis" => Icons.Material.Outlined.AutoAwesome,
            "dfm" => Icons.Material.Outlined.FactCheck,
            "pricing" => Icons.Material.Outlined.Calculate,
            "formal_quote" => Icons.Material.Outlined.PictureAsPdf,
            "order" => Icons.Material.Outlined.PrecisionManufacturing,
            "viewer" => Icons.Material.Outlined.ViewInAr,
            _ => Icons.Material.Outlined.Inventory2
        };
    }

    private static string StepIcon(string status)
    {
        return status.Equals("pending", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Outlined.RadioButtonUnchecked
            : Icons.Material.Outlined.CheckCircle;
    }

    private static string DfmIcon(string severity)
    {
        return severity.ToLowerInvariant() switch
        {
            "blocker" => Icons.Material.Outlined.ErrorOutline,
            "confirm" => Icons.Material.Outlined.WarningAmber,
            _ => Icons.Material.Outlined.CheckCircle
        };
    }

    private void ApplyWorkbenchPrompt(string prompt)
    {
        _draftMessage = prompt;
    }

    private bool TryBuildLocalDemoTurn(string message, out LocalDemoTurn turn)
    {
        var normalized = message.ToLowerInvariant();
        if (normalized.Contains("bracket", StringComparison.Ordinal) ||
            normalized.Contains("sketch", StringComparison.Ordinal) ||
            normalized.Contains("photo", StringComparison.Ordinal) ||
            normalized.Contains("drawing", StringComparison.Ordinal) ||
            normalized.Contains("price", StringComparison.Ordinal) ||
            normalized.Contains("quote", StringComparison.Ordinal) ||
            normalized.Contains("order", StringComparison.Ordinal) ||
            normalized.Contains("step", StringComparison.Ordinal) ||
            normalized.Contains("stl", StringComparison.Ordinal) ||
            normalized.Contains("cad", StringComparison.Ordinal))
        {
            turn = BuildSketchDemoTurn();
            return true;
        }

        turn = default!;
        return false;
    }

    private void AddLocalDemoTurn(LocalDemoTurn turn)
    {
        _messages.Add(new AgentMessageRow("assistant", Text(turn.TextEn, turn.TextTh), turn.Workbench));
        _artifacts = turn.Artifacts;
        _proposedActions = [];
    }

