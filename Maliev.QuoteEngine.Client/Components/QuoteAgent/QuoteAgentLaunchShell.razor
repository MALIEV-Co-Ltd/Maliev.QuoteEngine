@namespace Maliev.QuoteEngine.Client.Components.QuoteAgent
@inject QuoteEngineApiClient Api

<section class="qe-agent-shell" aria-label="@Text("Quote agent workspace", "พื้นที่ผู้ช่วยขอราคา")">
    <aside class="qe-agent-rail" aria-label="@Text("Quote navigation", "เมนูขอราคา")">
        <div class="qe-agent-rail-mark">
            <strong>MALIEV</strong>
            <span>QuoteEngine</span>
        </div>
        <nav class="qe-agent-rail-nav" aria-label="@Text("Workspace sections", "ส่วนพื้นที่ทำงาน")">
            <a class="active" href="/quote/new">
                <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" Size="Size.Small" />
                <span>@Text("New quote", "ขอราคาใหม่")</span>
            </a>
            <button type="button" @onclick="RequestUploadAsync">
                <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                <span>@Text("Attach files", "แนบไฟล์")</span>
            </button>
            @if (ShowDemoSampleCard)
            {
                <button type="button" @onclick="RequestSampleAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                    <span>@Text("Sample part", "ชิ้นงานตัวอย่าง")</span>
                </button>
            }
        </nav>
        <div class="qe-agent-rail-foot">
            @if (IsSignedIn)
            {
                <span>@Text("Signed in", "เข้าสู่ระบบแล้ว")</span>
            }
            else
            {
                <a href="/auth/sign-in?returnUrl=/quote/new">@Text("Sign in", "เข้าสู่ระบบ")</a>
            }
        </div>
    </aside>

    <div class="qe-agent-main">
        <div class="qe-agent-thread" aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="qe-agent-prompt">
                    <span>@Text("Custom manufacturing", "งานผลิตตามสั่ง")</span>
                    <h1>@Text("What do you want to make today?", "วันนี้ต้องการผลิตอะไร?")</h1>
                    <p>@Text("Send requirements or attach CAD, drawings, photos, or sketches.", "ส่งรายละเอียดหรือแนบ CAD แบบ รูปภาพ หรือสเก็ตช์")</p>
                </div>
            }
            else
            {
                @foreach (var message in _messages)
                {
                    <article class="qe-agent-message @($"qe-agent-message--{message.Role}")">
                        <div class="qe-agent-avatar">@AvatarFor(message.Role)</div>
                        <div class="qe-agent-bubble">
                            <span>@RoleLabel(message.Role)</span>
                            <p>@message.Content</p>
                        </div>
                    </article>
                }
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="qe-agent-error" role="alert">@_error</div>
        }

        <form class="qe-agent-composer" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            <button type="button" class="qe-agent-icon-btn" title="@Text("Attach files", "แนบไฟล์")" @onclick="RequestUploadAsync">
                <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
            </button>
            <textarea @bind="_draftMessage"
                      rows="1"
                      maxlength="4000"
                      placeholder="@Text("Ask about the part, material, tolerance, finish, quantity...", "ถามเรื่องชิ้นงาน วัสดุ พิกัดผิว จำนวน...")"
                      aria-label="@Text("Message Mali", "ข้อความถึงมะลิ")"></textarea>
            <button type="submit" class="qe-agent-send-btn" title="@Text("Send", "ส่ง")" disabled="@_sending">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
            </button>
        </form>
    </div>

    <aside class="qe-agent-workbench" aria-label="@Text("Live quote state", "สถานะขอราคาปัจจุบัน")">
        <section class="qe-agent-panel">
            <header>
                <span>@Text("Gates", "เงื่อนไข")</span>
                <strong>@PassedGateCount/@VisibleGates.Count</strong>
            </header>
            <div class="qe-agent-gates">
                @foreach (var gate in VisibleGates)
                {
                    <div class="@($"qe-agent-gate qe-agent-gate--{gate.Status}")">
                        <MudIcon Icon="@GateIcon(gate.Status)" Size="Size.Small" />
                        <div>
                            <strong>@gate.Label</strong>
                            <small>@gate.Detail</small>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="qe-agent-panel">
            <header>
                <span>@Text("Artifacts", "ไฟล์งาน")</span>
                <strong>@_artifacts.Count</strong>
            </header>
            @if (_artifacts.Count == 0)
            {
                <p class="qe-agent-muted">@Text("Viewer, DFM, pricing, quote, and order artifacts appear here.", "โมเดล DFM ราคา ใบเสนอราคา และคำสั่งซื้อจะแสดงที่นี่")</p>
            }
            else
            {
                <div class="qe-agent-artifacts">
                    @foreach (var artifact in _artifacts)
                    {
                        <div class="qe-agent-artifact">
                            <MudIcon Icon="@ArtifactIcon(artifact.ArtifactType)" Size="Size.Small" />
                            <div>
                                <strong>@artifact.Title</strong>
                                <small>@artifact.Status</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @if (_proposedActions.Count > 0)
        {
            <section class="qe-agent-panel">
                <header>
                    <span>@Text("Confirm", "ยืนยัน")</span>
                    <strong>@_proposedActions.Count</strong>
                </header>
                <div class="qe-agent-actions">
                    @foreach (var action in _proposedActions)
                    {
                        <article class="qe-agent-action">
                            <strong>@action.Title</strong>
                            <p>@action.Summary</p>
                            @if (action.RequiresAuthentication && !IsSignedIn)
                            {
                                <a href="/auth/sign-in?returnUrl=/quote/new">@Text("Sign in", "เข้าสู่ระบบ")</a>
                            }
                            else
                            {
                                <button type="button" @onclick="@(() => ConfirmActionAsync(action))">
                                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                    <span>@Text("Confirm", "ยืนยัน")</span>
                                </button>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </aside>
</section>

@code {
    private readonly List<AgentMessageRow> _messages = [];
    private List<QuoteAgentGateDto> _gates = [];
    private List<QuoteAgentArtifactDto> _artifacts = [];
    private List<QuoteAgentProposedActionDto> _proposedActions = [];
    private Guid _loadedSessionId;
    private string _draftMessage = string.Empty;
    private string? _error;
    private bool _sending;

    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsSignedIn { get; set; }

    [Parameter]
    public bool IsDemoMode { get; set; }

    [Parameter]
    public bool ShowDemoSampleCard { get; set; }

    [Parameter]
    public bool ShowLaunchAccountCard { get; set; }

    [Parameter]
    public string Culture { get; set; } = SupportedCultures.DefaultCulture;

    [Parameter]
    public EventCallback OnUploadRequested { get; set; }

    [Parameter]
    public EventCallback OnSampleRequested { get; set; }

    private IReadOnlyList<QuoteAgentGateDto> VisibleGates => _gates.Count > 0 ? _gates : DefaultGates;

    private int PassedGateCount => VisibleGates.Count(gate => gate.Status.Equals("passed", StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<QuoteAgentGateDto> DefaultGates { get; } =
    [
        new("geometry_required", "Usable 3D/CAD geometry", "blocked", "Upload CAD or 3D geometry."),
        new("analysis_complete", "Analysis complete", "pending", "Geometry and DFM analysis will run after upload."),
        new("dfm_reviewed", "DFM reviewed", "pending", "Review manufacturing issues before order."),
        new("configuration_complete", "Configuration complete", "pending", "Choose process, material, tolerance, quantity, and lead time."),
        new("priced", "Priced", "pending", "Estimate appears after required gates."),
        new("customer_authenticated", "Signed in", "blocked", "Required before formal quote, order, and payment.")
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId == Guid.Empty || SessionId == _loadedSessionId)
        {
            return;
        }

        _loadedSessionId = SessionId;
        await LoadStateAsync();
    }

    private async Task LoadStateAsync()
    {
        try
        {
            var state = await Api.GetAgentStateAsync(SessionId);
            ApplyState(state);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private async Task HandleSubmitAsync()
    {
        var message = _draftMessage.Trim();
        if (string.IsNullOrWhiteSpace(message) || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        _draftMessage = string.Empty;
        _messages.Add(new AgentMessageRow("user", message));

        try
        {
            var response = await Api.SendAgentMessageAsync(new QuoteAgentMessageRequest
            {
                SessionId = SessionId,
                Message = message,
                Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en"
            });

            _messages.Add(new AgentMessageRow("assistant", response.AssistantText));
            _gates = response.Gates;
            _artifacts = response.Artifacts;
            _proposedActions = response.ProposedActions;
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task ConfirmActionAsync(QuoteAgentProposedActionDto action)
    {
        try
        {
            var result = await Api.ConfirmAgentActionAsync(action.ActionId, new QuoteAgentConfirmActionRequest());
            _messages.Add(new AgentMessageRow("assistant", result.Message));
            if (result.State is not null)
            {
                ApplyState(result.State);
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
    }

    private void ApplyState(QuoteAgentStateResponse state)
    {
        _gates = state.Gates;
        _artifacts = state.Artifacts;
        _proposedActions = state.ProposedActions;
    }

    private async Task RequestUploadAsync()
    {
        if (OnUploadRequested.HasDelegate)
        {
            await OnUploadRequested.InvokeAsync();
        }
    }

    private async Task RequestSampleAsync()
    {
        if (OnSampleRequested.HasDelegate)
        {
            await OnSampleRequested.InvokeAsync();
        }
    }

    private static string AvatarFor(string role)
    {
        return role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "U" : "M";
    }

    private string RoleLabel(string role)
    {
        return role.Equals("user", StringComparison.OrdinalIgnoreCase)
            ? Text("You", "คุณ")
            : "Mali";
    }

    private static string GateIcon(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "passed" => Icons.Material.Filled.CheckCircle,
            "blocked" => Icons.Material.Filled.RadioButtonUnchecked,
            _ => Icons.Material.Outlined.Pending
        };
    }

    private static string ArtifactIcon(string artifactType)
    {
        return artifactType.ToLowerInvariant() switch
        {
            "pricing" => Icons.Material.Outlined.Calculate,
            "formal_quote" => Icons.Material.Outlined.PictureAsPdf,
            "order" => Icons.Material.Outlined.PrecisionManufacturing,
            "viewer" => Icons.Material.Outlined.ViewInAr,
            _ => Icons.Material.Outlined.Inventory2
        };
    }

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }

    private sealed record AgentMessageRow(string Role, string Content);
}
