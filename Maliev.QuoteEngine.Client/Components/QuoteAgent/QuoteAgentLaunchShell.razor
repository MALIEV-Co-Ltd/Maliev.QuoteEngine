    private async Task HandleSubmitAsync()
    {
        var message = _draftMessage.Trim();
        var pendingAttachments = BuildPendingMessageAttachments();
        if ((string.IsNullOrWhiteSpace(message) && pendingAttachments.Count == 0) || IsComposerSendDisabled)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            message = BuildAttachmentOnlyMessage(pendingAttachments);
        }

        if (message.Length > QuoteAgentTextLimits.MaxMessageCharacters)
        {
            _error = Text(
                $"Please keep each message under {QuoteAgentTextLimits.MaxMessageCharacters:N0} characters and attach long files instead.",
                $"กรุณาให้แต่ละข้อความไม่เกิน {QuoteAgentTextLimits.MaxMessageCharacters:N0} ตัวอักษร และแนบไฟล์ยาวแทน");
            await FocusComposerAsync();
            return;
        }

        var editLastTurn = _editingLastUserMessage is not null &&
            ReferenceEquals(_editingLastUserMessage, LastUserMessage);
        var removedEditedTurn = editLastTurn ? RemoveLocalLastTurn(_editingLastUserMessage!) : null;

        var replyTo = editLastTurn ? null : _replyTo;
        _replyTo = null;
        _editingLastUserMessage = null;
        _sending = true;
        _error = null;
        _composerMenuOpen = false;
        _draftMessage = string.Empty;
        _customerQuestion = null;
        _pendingComposerAttachments.Clear();
        EnsureLocalProjectFromMessage(message);
        var userMessage = new AgentMessageRow("user", message, attachments: pendingAttachments)
        {
            ReplyToPreview = replyTo is null ? null : ReplyChipLabel(replyTo),
        };
        _messages.Add(userMessage);
        var assistantMessage = new AgentMessageRow("assistant", string.Empty);
        _messages.Add(assistantMessage);
        var generatedViewerArtifactIdsBeforeTurn = GeneratedViewerArtifactIds(_artifacts);
        RequestScrollToLatestMessage();

        try
        {
            await foreach (var streamEvent in Api.SendAgentMessageStreamAsync(new QuoteAgentMessageRequest
            {
                SessionId = SessionId,
                Message = message,
                Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en",
                Attachments = pendingAttachments.Select(attachment => attachment.ToAgentAttachment()).ToList(),
                ReplyToMessageId = replyTo?.Id,
                ReplyToPreview = replyTo is null ? null : BuildReplyPreview(replyTo),
                EditLastTurn = editLastTurn
            }))
            {
                if (!assistantMessage.IsProcessing)
                {
                    assistantMessage.IsProcessing = true;
                    await InvokeAsync(StateHasChanged);
                }

                if (streamEvent.Type.Equals("delta", StringComparison.OrdinalIgnoreCase))
                {
                    QueueAssistantStreamDelta(assistantMessage, streamEvent.Delta);
                }
                else if (streamEvent.Type.Equals("thought", StringComparison.OrdinalIgnoreCase) &&
                         !string.IsNullOrWhiteSpace(streamEvent.Thought))
                {
                    assistantMessage.ModelThoughtContent += streamEvent.Thought;
                    assistantMessage.IsThinking = true;
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("final", StringComparison.OrdinalIgnoreCase) &&
                         streamEvent.Response is not null)
                {
                    await FlushAssistantStreamAsync(assistantMessage);
                    assistantMessage.IsThinking = false;
                    assistantMessage.ThinkingSteps = streamEvent.Response.ThinkingSteps ?? [];
                    _gates = streamEvent.Response.Gates;
                    _artifacts = streamEvent.Response.Artifacts;
                    _proposedActions = streamEvent.Response.ProposedActions;
                    _usageSnapshot = streamEvent.Response.UsageSnapshot;
                    assistantMessage.InlineViewer = FindInlinePreview(
                        streamEvent.Response.Artifacts,
                        generatedViewerArtifactIdsBeforeTurn);
                    ApplyAuthHandoff(streamEvent.Response.AuthHandoff);
                    await ApplyUiDirectivesAsync(streamEvent.Response.UiDirectives, suppressPanelAutoOpen: true);
                    if (!string.IsNullOrWhiteSpace(streamEvent.Response.UiCulture))
                    {
                        await Preferences.SetCultureAsync(streamEvent.Response.UiCulture);
                    }
                    ApplyAgentProjectName(streamEvent.Response.ProjectName);
                    _customerQuestion = streamEvent.Response.CustomerQuestion;
                    RequestScrollToLatestMessage();
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("error", StringComparison.OrdinalIgnoreCase))
                {
                    _error = string.IsNullOrWhiteSpace(streamEvent.Error)
                        ? Text("The agent could not complete this response.", "ผู้ช่วยไม่สามารถตอบกลับได้สำเร็จ")
                        : streamEvent.Error;
                    RestoreEditedLastTurnOnFailure(editLastTurn, userMessage, assistantMessage, removedEditedTurn);
                }
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
            RestoreEditedLastTurnOnFailure(editLastTurn, userMessage, assistantMessage, removedEditedTurn);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            RestoreEditedLastTurnOnFailure(editLastTurn, userMessage, assistantMessage, removedEditedTurn);
            if (editLastTurn)
            {
                RequestScrollToLatestMessage();
            }
            else if (TryBuildLocalDemoTurn(message, out var demoTurn))
            {
                AddLocalDemoTurn(demoTurn);
            }
            else
            {
                _messages.Add(new AgentMessageRow("assistant", BuildAgentConnectionFallbackMessage(message)));
            }
            RequestScrollToLatestMessage();
        }
        finally
        {
            _sending = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private List<AgentMessageRow> RemoveLocalLastTurn(AgentMessageRow lastUserMessage)
    {
        var index = _messages.IndexOf(lastUserMessage);
        if (index < 0)
        {
            return [];
        }

        var removedMessages = _messages.Skip(index).ToList();
        _messages.RemoveRange(index, _messages.Count - index);
        return removedMessages;
    }

    private void RestoreEditedLastTurnOnFailure(
        bool editLastTurn,
        AgentMessageRow userMessage,
        AgentMessageRow assistantMessage,
        IReadOnlyList<AgentMessageRow>? removedEditedTurn)
    {
        _messages.Remove(assistantMessage);
        if (!editLastTurn || removedEditedTurn is null || removedEditedTurn.Count == 0)
        {
            return;
        }

        _messages.Remove(userMessage);
        _messages.AddRange(removedEditedTurn);
    }

    private IReadOnlyList<ComposerAttachmentPreview> BuildPendingMessageAttachments()
    {
        return _pendingComposerAttachments
            .Select(attachment => attachment with { })
            .ToList();
    }

    private void QueueAssistantStreamDelta(AgentMessageRow assistantMessage, string? delta)
    {
        if (string.IsNullOrEmpty(delta))
        {
            return;
        }

        assistantMessage.PendingStreamContent += delta;
        _ = RevealAssistantStreamAsync(assistantMessage);
    }

    private async Task RevealAssistantStreamAsync(AgentMessageRow assistantMessage)
    {
        if (assistantMessage.StreamRevealRunning)
        {
            return;
        }

        assistantMessage.StreamRevealRunning = true;
        try
        {
            while (!_disposed && !string.IsNullOrEmpty(assistantMessage.PendingStreamContent))
            {
                RevealNextAssistantStreamChunk(assistantMessage);
                RequestScrollToLatestMessage();
                await InvokeAsync(StateHasChanged);
                await Task.Delay(AgentStreamRevealInterval);
            }
        }
        finally
        {
            assistantMessage.StreamRevealRunning = false;
        }
    }

    private async Task FlushAssistantStreamAsync(AgentMessageRow assistantMessage)
    {
        if (!string.IsNullOrEmpty(assistantMessage.PendingStreamContent))
        {
            assistantMessage.Content += assistantMessage.PendingStreamContent;
            assistantMessage.PendingStreamContent = string.Empty;
            RequestScrollToLatestMessage();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static void RevealNextAssistantStreamChunk(AgentMessageRow assistantMessage)
    {
        var revealLength = Math.Min(AgentStreamRevealCharacters, assistantMessage.PendingStreamContent.Length);
        assistantMessage.Content += assistantMessage.PendingStreamContent[..revealLength];
        assistantMessage.PendingStreamContent = assistantMessage.PendingStreamContent[revealLength..];
    }

