    private void ClearAnimatedSearchPrompt()
    {
        if (!string.IsNullOrEmpty(_animatedSearchPrompt))
        {
            _animatedSearchPrompt = string.Empty;
        }
    }

    private async Task AnimateSearchPromptAsync(CancellationToken cancellationToken)
    {
        var promptIndex = Random.Shared.Next(SearchPromptExamples.Length);
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                if (!CanAnimateSearchPrompt)
                {
                    await InvokeAsync(() =>
                    {
                        ClearAnimatedSearchPrompt();
                        StateHasChanged();
                    });
                    await Task.Delay(220, cancellationToken);
                    continue;
                }

                var prompt = Text(SearchPromptExamples[promptIndex].TextEn, SearchPromptExamples[promptIndex].TextTh);
                promptIndex = (promptIndex + 1) % SearchPromptExamples.Length;

                for (var length = 1; length <= prompt.Length && !cancellationToken.IsCancellationRequested; length++)
                {
                    if (!CanAnimateSearchPrompt)
                    {
                        break;
                    }

                    var current = prompt[..length];
                    await InvokeAsync(() =>
                    {
                        _animatedSearchPrompt = FormatAnimatedSearchPrompt(current);
                        StateHasChanged();
                    });
                    await Task.Delay(56, cancellationToken);
                }

                await Task.Delay(1000, cancellationToken);

                for (var length = prompt.Length - 1; length >= 0 && !cancellationToken.IsCancellationRequested; length--)
                {
                    if (!CanAnimateSearchPrompt)
                    {
                        break;
                    }

                    var current = prompt[..length];
                    await InvokeAsync(() =>
                    {
                        _animatedSearchPrompt = FormatAnimatedSearchPrompt(current);
                        StateHasChanged();
                    });
                    await Task.Delay(28, cancellationToken);
                }

                await Task.Delay(260, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the component is disposed.
        }
    }

    private static string FormatAnimatedSearchPrompt(string prompt)
    {
        return prompt.Length <= SearchPromptVisibleCharacters
            ? prompt
            : prompt[^SearchPromptVisibleCharacters..];
    }

    private async Task RefreshSearchResultsAsync()
    {
        if (!SearchHasMinimumQuery)
        {
            _searchLoading = false;
            _customerSearchResults.Clear();
            _customerSearchUnavailable = false;
            return;
        }

        if (!IsSignedIn || SessionId == Guid.Empty)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = !IsSignedIn;
            return;
        }

        _searchLoading = true;
        _customerSearchUnavailable = false;
        try
        {
            var response = await Api.SearchCustomerDataAsync(SessionId, _searchQuery, 20);
            _customerSearchResults.Clear();
            _customerSearchResults.AddRange(response.Results);
        }
        catch (QuoteEngineApiException ex)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            if (ex.StatusCode != System.Net.HttpStatusCode.Unauthorized)
            {
                _error = ex.UserMessage;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            _error = Text("Search is temporarily unavailable.", "การค้นหายังไม่พร้อมใช้งานชั่วคราว");
        }
        finally
        {
            _searchLoading = false;
        }
    }

