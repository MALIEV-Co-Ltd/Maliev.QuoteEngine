    private async Task<bool> ApplyLocalGeometryRuntimeResultAsync(LocalGeometryRuntimeResult result)
    {
        var selectedPart = SelectedUploadedPart;

        // Apply the full local DFM result (process findings + metrics + manifold) to the part, matching the
        // workspace flow, then submit it to the agent's authoritative analysis store so the assistant
        // reports the same DFM the customer sees — not a guess or a false "no issues".
        var applied = QeLocalDfmMapper.TryApply(selectedPart, result);
        if (!applied)
        {
            // Full process DFM may not apply yet (e.g. process not chosen); keep the basic metrics.
            if (result.Metrics?.VolumeMm3 is > 0)
            {
                selectedPart.VolumeCc = (decimal)(result.Metrics.VolumeMm3.Value / 1000d);
            }

            if (result.Metrics?.BoundingBoxMm is not null)
            {
                selectedPart.BoundingBox = result.Metrics.BoundingBoxMm;
            }
        }

        await SubmitLocalDfmToAgentAsync(selectedPart, result);
        await InvokeAsync(StateHasChanged);
        return applied;
    }

    private async Task SubmitLocalDfmToAgentAsync(QuotePartViewModel part, LocalGeometryRuntimeResult result)
    {
        if (string.IsNullOrWhiteSpace(part.StoragePath))
        {
            return;
        }

        var isManifold = result.Metrics?.IsManifold ?? part.IsManifold;
        try
        {
            await Api.SubmitAgentLocalDfmAsync(SessionId, new QuoteAgentLocalDfmRequest
            {
                StoragePath = part.StoragePath!,
                UploadId = part.UploadId,
                ProcessCode = result.ProcessCode ?? part.ProcessId,
                IsManifold = isManifold,
                NonManifoldReason = isManifold ? null : part.NonManifoldReason,
                FdmReport = part.FdmDfmReport,
                SlaReport = part.SlaDfmReport,
                CncReport = part.CncDfmReport,
                OverlayGlbUrls = part.OverlayGlbUrls?.ToList() ?? []
            });
        }
        catch (Exception ex) when (ex is HttpRequestException or QuoteEngineApiException or InvalidOperationException)
        {
            // Non-blocking: the workbench still shows local DFM even if the agent sync fails this turn.
        }
    }

