                                        <span>
                                            <strong>@Text("Pinned", "ปักหมุด")</strong>
                                            <small>@Text("Fast access projects", "โปรเจกต์ที่เข้าถึงบ่อย")</small>
                                        </span>
                                        <MudIcon Icon="@(_pinnedProjectsCollapsed ? Icons.Material.Outlined.ChevronRight : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                                    </button>
                                </header>
                                @if (!_pinnedProjectsCollapsed)
                                {
                                    <div class="qe-agent-management-list">
                                        @foreach (var project in PinnedProjects)
                                        {
                                            <article class="qe-agent-management-row">
                                                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" />
                                                <div>
                                                    <strong>@ProjectName(project)</strong>
                                                    <p>@project.Status</p>
                                                </div>
                                                <a href="@ProjectHref(project)">@Text("Open", "เปิด")</a>
                                                @if (CanManageProject(project))
                                                {
                                                    <button type="button"
                                                            title="@Text("Duplicate project", "ทำสำเนาโปรเจกต์")"
                                                            aria-label="@Text($"Duplicate {project.NameEn}", $"ทำสำเนา{project.NameTh}")"
                                                            @onclick="@(() => DuplicateProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Unpin project", "เลิกปักหมุดโปรเจกต์")"
                                                            aria-label="@Text($"Unpin {project.NameEn}", $"เลิกปักหมุด{project.NameTh}")"
                                                            @onclick="@(() => ToggleProjectPinAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Archive project", "เก็บโปรเจกต์")"
                                                            aria-label="@Text($"Archive {project.NameEn}", $"เก็บโปรเจกต์{project.NameTh}")"
                                                            @onclick="@(() => ArchiveProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Mark achieved", "ทำเครื่องหมายว่าสำเร็จ")"
                                                            aria-label="@Text($"Mark {project.NameEn} achieved", $"ทำเครื่องหมาย{project.NameTh}ว่าสำเร็จ")"
                                                            @onclick="@(() => AchieveProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                                    </button>
                                                }
                                            </article>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        <section class="@ProjectManagementSectionClass(_projectsCollapsed)">
                            <header>
                                <button type="button"
                                        class="qe-agent-management-section-toggle"
                                        aria-expanded="@AriaExpanded(!_projectsCollapsed)"
                                        @onclick="ToggleProjects">
                                    <span>
                                        <strong>@Text("All projects", "โปรเจกต์ทั้งหมด")</strong>
                                        <small>@Text("Pinned projects are not duplicated here.", "โปรเจกต์ที่ปักหมุดจะไม่แสดงซ้ำที่นี่")</small>
                                    </span>
                                    <MudIcon Icon="@(_projectsCollapsed ? Icons.Material.Outlined.ChevronRight : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                                </button>
                            </header>
                            @if (!_projectsCollapsed)
                            {
                                @if (ProjectManagementProjects.Any())
                                {
                                    <div class="qe-agent-management-list">
                                        @foreach (var project in ProjectManagementProjects)
                                        {
                                            <article class="qe-agent-management-row">
                                                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" />
                                                <div>
                                                    <strong>@ProjectName(project)</strong>
                                                    <p>@project.Status</p>
                                                </div>
                                                <a href="@ProjectHref(project)">@Text("Open", "เปิด")</a>
                                                @if (CanManageProject(project))
                                                {
                                                    <button type="button"
                                                            title="@Text("Duplicate project", "ทำสำเนาโปรเจกต์")"
                                                            aria-label="@Text($"Duplicate {project.NameEn}", $"ทำสำเนา{project.NameTh}")"
                                                            @onclick="@(() => DuplicateProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Pin project", "ปักหมุดโปรเจกต์")"
                                                            aria-label="@Text($"Pin {project.NameEn}", $"ปักหมุด{project.NameTh}")"
                                                            @onclick="@(() => ToggleProjectPinAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.PushPin" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Archive project", "เก็บโปรเจกต์")"
                                                            aria-label="@Text($"Archive {project.NameEn}", $"เก็บโปรเจกต์{project.NameTh}")"
                                                            @onclick="@(() => ArchiveProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            title="@Text("Mark achieved", "ทำเครื่องหมายว่าสำเร็จ")"
                                                            aria-label="@Text($"Mark {project.NameEn} achieved", $"ทำเครื่องหมาย{project.NameTh}ว่าสำเร็จ")"
                                                            @onclick="@(() => AchieveProjectAsync(project))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                                    </button>
                                                }
                                            </article>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="qe-agent-management-empty">@Text("No unpinned projects.", "ไม่มีโปรเจกต์ที่ไม่ได้ปักหมุด")</p>
                                }
                            }
                        </section>
                    }
                }
                else if (IsWorkspacePage(WorkspacePage.Settings))
                {
                    <header class="qe-agent-management-head">
                        <button type="button"
                                class="qe-agent-management-back"
                                title="@Text("Back to chat", "กลับไปที่แชท")"
                                aria-label="@Text("Back to current chat", "กลับไปที่แชทปัจจุบัน")"
                                @onclick="ReturnToCurrentChatAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                            <span>@Text("Back", "กลับ")</span>
                        </button>
                        <div>
                            <span>@Text("Account", "บัญชี")</span>
                            <h1>@Text("Settings", "ตั้งค่า")</h1>
                            <p>@Text("Manage Studio preferences and account actions.", "จัดการการตั้งค่า Studio และการทำงานของบัญชี")</p>
                        </div>
                    </header>
                    <div class="qe-agent-management-tabs" role="tablist" aria-label="@Text("Settings sections", "หมวดการตั้งค่า")">
                        <button type="button"
                                class="@SettingsTabClass("general")"
                                role="tab"
                                aria-selected="@(_settingsTab == "general")"
                                @onclick='@(() => SetSettingsTab("general"))'>
                            @Text("General", "ทั่วไป")
                        </button>
                        <button type="button"
                                class="@SettingsTabClass("appearance")"
                                role="tab"
                                aria-selected="@(_settingsTab == "appearance")"
                                @onclick='@(() => SetSettingsTab("appearance"))'>
                            @Text("Appearance", "รูปลักษณ์")
                        </button>
                        <button type="button"
                                class="@SettingsTabClass("language")"
                                role="tab"
                                aria-selected="@(_settingsTab == "language")"
                                @onclick='@(() => SetSettingsTab("language"))'>
                            @Text("Language", "ภาษา")
                        </button>
                        <button type="button"
                                class="@SettingsTabClass("profile")"
                                role="tab"
                                aria-selected="@(_settingsTab == "profile")"
                                @onclick='@(() => SetSettingsTab("profile"))'>
                            @Text("Profile", "โปรไฟล์")
                        </button>
                    </div>
                    <section class="qe-agent-management-section">
                        <header>
                            <strong>@SettingsSectionHeading</strong>
                            <small>@SettingsSectionSubheading</small>
                        </header>
                        @if (_settingsTab == "general")
                        {
                            <QeAccountPreferences />
                        }
                        else if (_settingsTab == "profile")
                        {
                            <QeAccountProfile />
                        }
                        else if (_settingsTab == "appearance")
                        {
                            <QeAccountAppearance />
                        }
                        else if (_settingsTab == "language")
                        {
                            <div class="qe-agent-theme-grid">
                                <button type="button" class="@LanguageOptionClass(true, string.Empty)" @onclick="Preferences.SetCultureAutoAsync">
                                    <strong>@Text("Auto-detect", "ตรวจจับอัตโนมัติ")</strong>
                                    <span>@Text("Match browser language", "ตามภาษาเบราว์เซอร์")</span>
                                </button>
                                <button type="button" class="@LanguageOptionClass(false, SupportedCultures.DefaultCulture)" @onclick='@(() => Preferences.SetCultureAsync(SupportedCultures.DefaultCulture))'>
                                    <strong>English</strong>
                                    <span>en-US</span>
                                </button>
                                <button type="button" class="@LanguageOptionClass(false, SupportedCultures.ThaiCulture)" @onclick='@(() => Preferences.SetCultureAsync(SupportedCultures.ThaiCulture))'>
                                    <strong>ไทย</strong>
                                    <span>th-TH</span>
                                </button>
                            </div>
                        }
                    </section>
                }
                else if (IsWorkspacePage(WorkspacePage.Orders))
                {
                    <header class="qe-agent-management-head">
                        <button type="button"
                                class="qe-agent-management-back"
                                title="@(_activeOrderNumber is null ? Text("Back to chat", "กลับไปที่แชท") : Text("Back to orders", "กลับไปที่คำสั่งซื้อ"))"
                                @onclick="OrdersBackAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                            <span>@Text("Back", "กลับ")</span>
                        </button>
                        <div>
                            <span>@Text("Account", "บัญชี")</span>
                            <h1>@(_activeOrderNumber is null ? Text("Orders", "คำสั่งซื้อ") : _activeOrderNumber)</h1>
                            <p>@(_activeOrderNumber is null
                                ? Text("Active manufacturing, delivery progress, and completed order history.", "งานผลิตที่กำลังดำเนินการ ความคืบหน้าการจัดส่ง และประวัติคำสั่งซื้อ")
                                : Text("Order detail, payment, and delivery tracking.", "รายละเอียดคำสั่งซื้อ การชำระเงิน และการติดตามการจัดส่ง"))</p>
                        </div>
                    </header>
                    @if (_activeOrderNumber is null)
                    {
                        <QeAccountOrders />
                    }
                    else
                    {
                        <QeOrderDetail OrderNumber="@_activeOrderNumber" />
                    }
                }
                else if (IsWorkspacePage(WorkspacePage.Documents))
                {
                    <header class="qe-agent-management-head">
                        <button type="button"
                                class="qe-agent-management-back"
                                title="@Text("Back to chat", "กลับไปที่แชท")"
                                @onclick="ReturnToCurrentChatAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                            <span>@Text("Back", "กลับ")</span>
                        </button>
                        <div>
                            <span>@Text("Account", "บัญชี")</span>
                            <h1>@Text("Documents", "เอกสาร")</h1>
                            <p>@Text("Purchase orders, receipts, invoices, and manufacturing documents in one place.", "ใบสั่งซื้อ ใบเสร็จ ใบแจ้งหนี้ และเอกสารการผลิตในที่เดียว")</p>
                        </div>
                    </header>
                    <QeAccountDocuments />
                }
                else if (IsWorkspacePage(WorkspacePage.Ndas))
                {
                    <header class="qe-agent-management-head">
                        <button type="button"
                                class="qe-agent-management-back"
                                title="@Text("Back to chat", "กลับไปที่แชท")"
                                @onclick="ReturnToCurrentChatAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                            <span>@Text("Back", "กลับ")</span>
                        </button>
                        <div>
                            <span>@Text("Confidentiality", "การรักษาความลับ")</span>
                            <h1>NDAs</h1>
                            <p>@Text("Confidentiality coverage for quote files, drawings, and manufacturing documents.", "ความคุ้มครองการรักษาความลับสำหรับไฟล์ใบเสนอราคา แบบ และเอกสารการผลิต")</p>
                        </div>
                    </header>
                    <QeAccountNdas />
                }
            </section>
        }
        else
        {
        <div class="qe-agent-chat-stack">
        <div class="qe-agent-thread-wrap">
        <div class="qe-agent-thread"
             @ref="_threadElement"
             @onscroll="@(async e => await OnThreadScrollAsync(e))"
             aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="qe-agent-prompt">
                    <h1>@Text("What do you want to make today?", "วันนี้ต้องการผลิตอะไร?")</h1>
                </div>
            }
            else
            {
                @foreach (var message in _messages)
                {
                    <article class="@($"qe-agent-message qe-agent-message--{message.Role} {(message.Workbench is not null ? "qe-agent-message--workbench" : string.Empty)}")">
                        <div class="@($"qe-agent-bubble {(message.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "qe-agent-message-stack" : string.Empty)}")">
                            <span>@RoleLabel(message.Role)</span>
                            @if (message.Role.Equals("user", StringComparison.OrdinalIgnoreCase))
                            {
                                @if (!string.IsNullOrWhiteSpace(message.SketchPreviewDataUrl))
                                {
                                    <img class="qe-agent-message-sketch-preview"
                                         src="@message.SketchPreviewDataUrl"
                                         alt="@Text("Attached hand sketch preview", "ตัวอย่างสเก็ตช์มือที่แนบ")" />
                                }
                                @if (message.Attachments.Count > 0)
                                {
                                    <div class="qe-agent-message-attachments" aria-label="@Text("Attached files", "ไฟล์ที่แนบ")">
                                        @foreach (var attachment in message.Attachments)
                                        {
                                            <span class="@MessageAttachmentClass(attachment)"
                                                  title="@attachment.FileName"
                                                  aria-label="@attachment.FileName">
                                                @if (!string.IsNullOrWhiteSpace(attachment.PreviewUrl))
                                                {
                                                    <img src="@attachment.PreviewUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@UploadedPartIcon(attachment)" Size="Size.Small" />
                                                }
                                                <small>@attachment.FileName</small>
                                            </span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(message.ReplyToPreview))
                                {
                                    <div class="qe-agent-reply-quote" aria-label="@Text("Replying to", "ตอบกลับ")">
                                        <MudIcon Icon="@Icons.Material.Outlined.Reply" Size="Size.Small" />
                                        <span>@message.ReplyToPreview</span>
                                    </div>
                                }
                                <p>@message.Content</p>
                                <div class="qe-agent-message-footer" aria-label="@Text("Message actions", "ตัวเลือกข้อความ")">
                                    <time datetime="@FormatMessageTimestamp(message.CreatedAt)">@FormatMessageTime(message.CreatedAt)</time>
                                    <button type="button"
                                            title="@Text("Reply to message", "ตอบกลับข้อความ")"
                                            aria-label="@Text("Reply to message", "ตอบกลับข้อความ")"
                                            @onclick="@(() => BeginReplyAsync(message))">
                                        <MudIcon Icon="@Icons.Material.Outlined.Reply" Size="Size.Small" />
                                    </button>
                                    <button type="button"
                                            title="@Text("Copy message", "คัดลอกข้อความ")"
                                            aria-label="@Text("Copy message", "คัดลอกข้อความ")"
                                            @onclick="@(() => CopyUserMessageAsync(message))">
                                        <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                                    </button>
                                    @if (ReferenceEquals(message, LastUserMessage))
                                    {
                                        <button type="button"
                                                title="@Text("Edit message", "แก้ไขข้อความ")"
                                                aria-label="@Text("Edit message", "แก้ไขข้อความ")"
                                                @onclick="@(() => EditUserMessageAsync(message))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                @if (message.HasReasoning)
                                {
                                    <details class="@ReasoningDetailsClass(message)">
                                        <summary class="qe-agent-reasoning-summary">
                                            <span class="qe-agent-reasoning-caret" aria-hidden="true"></span>
                                            <span class="qe-agent-reasoning-label">@ReasoningSummaryLabel(message)</span>
                                        </summary>
                                        <div class="qe-agent-reasoning-stream">
                                            @foreach (var entry in message.ReasoningEntries)
                                            {
                                                @if (entry.IsTool)
                                                {
                                                    <div class="qe-agent-reasoning-tool">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Bolt" Size="Size.Small" />
                                                        <span>@entry.Text</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="qe-agent-reasoning-thought qe-agent-markdown">
                                                        @QuoteAgentMarkdownRenderer.Render(entry.Text)
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </details>
                                }
                                @if (message.IsProcessing && string.IsNullOrEmpty(message.Content) && !message.HasReasoning)
                                {
                                    <div class="qe-agent-response-loader" aria-label="@Text("Agent is thinking…", "เอเจนต์กำลังคิด…")" aria-live="polite">
                                        <span class="qe-agent-response-dot" aria-hidden="true"></span>
                                        <span class="qe-agent-response-dot" aria-hidden="true"></span>
                                        <span class="qe-agent-response-dot" aria-hidden="true"></span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(message.Content))
                                {
                                    <div class="qe-agent-markdown">
                                        @QuoteAgentMarkdownRenderer.Render(message.Content)
                                    </div>
                                    <div class="qe-agent-message-footer" aria-label="@Text("Message actions", "ตัวเลือกข้อความ")">
                                        <time datetime="@FormatMessageTimestamp(message.CreatedAt)">@FormatMessageTime(message.CreatedAt)</time>
                                        <button type="button"
                                                title="@Text("Reply to message", "ตอบกลับข้อความ")"
                                                aria-label="@Text("Reply to message", "ตอบกลับข้อความ")"
                                                @onclick="@(() => BeginReplyAsync(message))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Reply" Size="Size.Small" />
                                        </button>
                                        <button type="button"
                                                title="@Text("Copy message", "คัดลอกข้อความ")"
                                                aria-label="@Text("Copy message", "คัดลอกข้อความ")"
                                                @onclick="@(() => CopyMessageTextAsync(message))">
                                            <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                                        </button>
                                    </div>
                                }
                                @if (message.InlineViewer is not null)
                                {
                                    <section class="qe-agent-inline-viewer">
                                        <QeInlinePartViewer CommandsJson="@message.InlineViewer.CommandsJson"
                                                            OnBuildOutcome="@(outcome => HandleInlineViewerBuildOutcomeAsync(message.InlineViewer, outcome))" />
                                        @if (message.InlineViewer.BuildFailed)
                                        {
                                            <div class="qe-inline-viewer-rebuild">
                                                <span class="qe-inline-viewer-rebuild-text">@Text("This 3D preview could not be built. Ask the agent to rebuild it with a corrected design.", "ไม่สามารถสร้างพรีวิว 3D นี้ได้ ขอให้ผู้ช่วยสร้างใหม่ด้วยแบบที่แก้ไขแล้ว")</span>
                                                <button type="button"
                                                        class="qe-inline-viewer-rebuild-button"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => RequestPreviewRebuildAsync(message.InlineViewer))">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Autorenew" Size="Size.Small" />
                                                    <span>@Text("Ask agent to rebuild", "ขอให้ผู้ช่วยสร้างใหม่")</span>
                                                </button>
                                            </div>
                                        }
                                        <div class="qe-inline-viewer-feedback" aria-label="@Text("3D preview feedback", "ความคิดเห็นต่อพรีวิว 3D")">
                                            <div class="qe-inline-viewer-rating" role="group" aria-label="@Text("Was this 3D preview useful?", "พรีวิว 3D นี้ใช้ได้หรือไม่")">
                                                <button type="button"
                                                        class="@InlineViewerSentimentClass(message.InlineViewer, ThumbUpSentiment)"
                                                        title="@Text("This design is usable", "แบบนี้ใช้ได้")"
                                                        aria-label="@Text("This design is usable", "แบบนี้ใช้ได้")"
                                                        aria-pressed="@InlineViewerSentimentPressed(message.InlineViewer, ThumbUpSentiment)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => SetInlineViewerSentiment(message.InlineViewer, ThumbUpSentiment))">
                                                    <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                                </button>
                                                <button type="button"
                                                        class="@InlineViewerSentimentClass(message.InlineViewer, ThumbDownSentiment)"
                                                        title="@Text("Report an issue with this design", "แจ้งปัญหาของแบบนี้")"
                                                        aria-label="@Text("Report an issue with this design", "แจ้งปัญหาของแบบนี้")"
                                                        aria-pressed="@InlineViewerSentimentPressed(message.InlineViewer, ThumbDownSentiment)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => SetInlineViewerSentiment(message.InlineViewer, ThumbDownSentiment))">
                                                    <MudIcon Icon="@Icons.Material.Filled.ThumbDown" Size="Size.Small" />
                                                </button>
                                            </div>
                                            @if (ShouldShowInlineViewerFeedbackForm(message.InlineViewer))
                                            {
                                                <textarea class="qe-inline-viewer-comment"
                                                          rows="2"
                                                          maxlength="1200"
                                                          placeholder="@Text("Optional: report what is wrong with the generated asset", "ไม่บังคับ: แจ้งปัญหาของไฟล์ที่สร้าง")"
                                                          @bind="message.InlineViewer.FeedbackComment"
                                                          @bind:event="oninput"></textarea>
                                                <div class="qe-inline-viewer-feedback-actions">
                                                    <button type="button"
                                                            class="qe-inline-viewer-submit"
                                                            disabled="@(!CanSubmitInlineViewerFeedback(message.InlineViewer))"
                                                            @onclick="@(() => SubmitInlineViewerFeedbackAsync(message))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Send" Size="Size.Small" />
                                                        <span>@Text("Send", "ส่ง")</span>
                                                    </button>
                                                    @if (!string.IsNullOrWhiteSpace(message.InlineViewer.FeedbackStatus))
                                                    {
                                                        <span class="qe-inline-viewer-feedback-status">@message.InlineViewer.FeedbackStatus</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }
                                @if (message.CustomerQuestion is not null)
                                {
                                    <section class="qe-agent-question" aria-label="@Text("Question from agent", "คำถามจากผู้ช่วย")">
                                        <div class="qe-agent-question-head">
                                            <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" />
                                            <p class="qe-agent-question-text">@message.CustomerQuestion.Question</p>
                                        </div>
                                        @if (string.IsNullOrEmpty(message.CustomerQuestionAnswer))
                                        {
                                            <div class="qe-agent-question-options" role="group" aria-label="@Text("Answer options", "ตัวเลือกคำตอบ")">
                                                @foreach (var option in message.CustomerQuestion.Options)
                                                {
                                                    <button type="button"
                                                            class="qe-agent-question-option"
                                                            disabled="@_sending"
                                                            @onclick="@(() => SubmitQuestionOptionAsync(option, message))">
                                                        @option
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="qe-agent-question-answered" aria-live="polite">
                                                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" />
                                                <span>@Text("You answered:", "คุณตอบว่า:") <strong>@message.CustomerQuestionAnswer</strong></span>
                                            </div>
                                        }
                                    </section>
                                }
                            }
                            @if (message.Workbench is not null)
                            {
                                <section class="qe-agent-workflow" aria-label="@Text("Quote analysis artifacts", "ไฟล์วิเคราะห์ใบเสนอราคา")">
                                    @if (message.Workbench.AnalysisSteps.Count > 0)
                                    {
                                        <article class="qe-agent-flow-card qe-agent-analysis-card">
                                            <header>
                                                <div>
                                                    <strong>@Text("Analyzing attached files", "กำลังวิเคราะห์ไฟล์ที่แนบ")</strong>
                                                    <small>@message.Workbench.AnalysisSummary</small>
                                                </div>
                                                <b>@message.Workbench.AnalysisProgress</b>
                                            </header>
                                            <div>
                                                @foreach (var step in message.Workbench.AnalysisSteps)
                                                {
                                                    <div class="@($"qe-agent-analysis-step is-{step.Status}")">
                                                        <MudIcon Icon="@StepIcon(step.Status)" Size="Size.Small" />
                                                        <span>@Text(step.LabelEn, step.LabelTh)</span>
                                                        <small>@step.Detail</small>
                                                    </div>
                                                }
                                            </div>
                                        </article>
                                    }

                                    @if (message.Workbench.Requirements.Count > 0)
                                    {
                                        <article class="qe-agent-flow-card qe-agent-requirements-card">
                                            <header>
                                                <div>
                                                    <strong>@Text("What I understood", "สิ่งที่เข้าใจจากข้อมูล")</strong>
                                                    <small>@Text("Extracted from attachments and chat", "ดึงจากไฟล์แนบและบทสนทนา")</small>
                                                </div>
                                                <b>@message.Workbench.ProcessLabel</b>
                                            </header>
                                            <div class="qe-agent-spec-summary">
                                                <div>
                                                    <span>@Text("Part type", "ประเภทชิ้นงาน")</span>
                                                    <strong>@message.Workbench.PartType</strong>
                                                </div>
                                                <div>
                                                    <span>@Text("Material", "วัสดุ")</span>
                                                    <strong>@message.Workbench.Material</strong>
                                                </div>
                                                <div>
                                                    <span>@Text("Quantity", "จำนวน")</span>
                                                    <strong>@message.Workbench.Quantity</strong>
                                                </div>
                                            </div>
                                            <table>
                                                <thead>
                                                    <tr>
                                                        <th>@Text("Feature", "คุณลักษณะ")</th>
                                                        <th>@Text("Value", "ค่า")</th>
                                                        <th>@Text("Source", "แหล่งที่มา")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var requirement in message.Workbench.Requirements)
                                                    {
                                                        <tr>
                                                            <td>@requirement.Feature</td>
                                                            <td>@requirement.Value</td>
                                                            <td><span class="@($"qe-agent-source-pill is-{requirement.SourceKind}")">@requirement.Source</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </article>
                                    }

                                    @if (message.Workbench.DfmIssues.Count > 0)
                                    {
                                        <article class="@($"qe-agent-flow-card qe-agent-dfm-card {UiFocusClass("dfm")}")">
                                            <header>
                                                <div>
                                                    <strong>@Text("Manufacturability (DFM)", "ความสามารถในการผลิต (DFM)")</strong>
                                                    <small>@Text("Action needed before formal order", "ต้องดำเนินการก่อนสั่งผลิตจริง")</small>
                                                </div>
                                                <b>@Text("Action needed", "ต้องตรวจสอบ")</b>
                                            </header>
                                            <div>
                                                @foreach (var issue in message.Workbench.DfmIssues)
                                                {
                                                    <section class="@($"qe-agent-dfm-issue is-{issue.Severity}")">
                                                        <header>
                                                            <MudIcon Icon="@DfmIcon(issue.Severity)" Size="Size.Small" />
                                                            <strong>@issue.Title</strong>
                                                            <span>@issue.Badge</span>
                                                        </header>
                                                        <p>@issue.Detail</p>
                                                        @if (!string.IsNullOrWhiteSpace(issue.Resolution))
                                                        {
                                                            <small>@issue.Resolution</small>
                                                        }
                                                    </section>
                                                }
                                            </div>
                                        </article>
                                    }

                                    @if (message.Workbench.ShowModelPreview)
                                    {
                                        <article class="@($"qe-agent-flow-card qe-agent-model-card {UiFocusClass("viewer", "canvas")}")">
                                            <header>
                                                <div>
                                                    <strong>@Text("3D model preview", "ตัวอย่างโมเดล 3D")</strong>
                                                    <small>@Text("Viewer artifact will use the uploaded CAD/mesh when available", "ไฟล์ viewer จะใช้ CAD/mesh ที่อัปโหลดเมื่อพร้อม")</small>
                                                </div>
                                                <b>STEP / STL</b>
                                            </header>
                                            <div class="qe-agent-model-stage" aria-hidden="true">
                                                <svg viewBox="0 0 520 320" role="img">
                                                    <title>L bracket model preview</title>
                                                    <ellipse cx="260" cy="254" rx="158" ry="32"></ellipse>
                                                    <polygon points="126,184 288,110 382,146 218,226"></polygon>
                                                    <polygon points="288,110 288,36 382,72 382,146"></polygon>
                                                    <polygon points="218,226 382,146 382,171 218,252"></polygon>
                                                    <ellipse cx="208" cy="192" rx="21" ry="12"></ellipse>
                                                    <ellipse cx="284" cy="172" rx="21" ry="12"></ellipse>
                                                    <rect x="313" y="69" width="24" height="56" rx="12"></rect>
                                                    <path d="M126 184 L100 214 M218 252 L190 284 M100 214 L190 284"></path>
                                                    <path d="M394 80 L422 80 M394 146 L422 146 M422 80 L422 146"></path>
                                                    <text x="82" y="218">t 3.0</text>
                                                    <text x="196" y="298">50.0</text>
                                                    <text x="431" y="118">30.0</text>
                                                </svg>
                                            </div>
                                            <div class="qe-agent-model-tools">
                                                <span>Orbit</span>
                                                <span>Pan</span>
                                                <span>Zoom</span>
                                                <span>Dims</span>
                                                <span>Section</span>
                                            </div>
                                        </article>
                                    }

                                    @if (message.Workbench.OptionGroups.Count > 0)
                                    {
                                        <article class="qe-agent-flow-card qe-agent-options-card">
                                            <header>
                                                <div>
                                                    <strong>@Text("Build options", "ตัวเลือกการผลิต")</strong>
                                                    <small>@Text("Change options here or ask in chat", "ปรับที่นี่หรือสั่งผ่านแชท")</small>
                                                </div>
                                                <b>@Text("Editable", "แก้ไขได้")</b>
                                            </header>
                                            @foreach (var group in message.Workbench.OptionGroups)
                                            {
                                                <section>
                                                    <header>@group.Label</header>
                                                    <div class="qe-agent-option-grid">
                                                        @foreach (var option in group.Options)
                                                        {
                                                            <button type="button" class="@(option.Selected ? "selected" : string.Empty)" @onclick="@(() => ApplyWorkbenchPrompt(option.FollowUpPrompt))">
                                                                <span>@option.Label</span>
                                                                <small>@option.Detail</small>
                                                            </button>
                                                        }
                                                    </div>
                                                </section>
                                            }
                                        </article>
                                    }

                                    @if (message.Workbench.PriceLines.Count > 0)
                                    {
                                        <article class="qe-agent-flow-card qe-agent-price-card">
                                            <header>
                                                <div>
                                                    <strong>@Text("Instant quote", "ราคาเบื้องต้นทันที")</strong>
                                                    <small>@message.Workbench.PriceSubtitle</small>
                                                </div>
                                                <b>@Text("Rates live", "ราคา live")</b>
                                            </header>
                                            <div class="qe-agent-price-total">
                                                <strong>@message.Workbench.TotalPrice</strong>
                                                <span>@message.Workbench.UnitPrice</span>
                                            </div>
                                            <div class="qe-agent-quantity-breaks">
                                                @foreach (var quote in message.Workbench.QuantityBreaks)
                                                {
                                                    <button type="button" class="@(quote.Selected ? "selected" : string.Empty)" @onclick="@(() => ApplyWorkbenchPrompt(quote.FollowUpPrompt))">
                                                        <span>@quote.Label</span>
                                                        <strong>@quote.Price</strong>
                                                        <small>@quote.Detail</small>
                                                    </button>
                                                }
                                            </div>
                                            <div class="qe-agent-price-lines">
                                                @foreach (var line in message.Workbench.PriceLines)
                                                {
                                                    <div>
                                                        <span>@line.Label</span>
                                                        <strong>@line.Value</strong>
                                                    </div>
                                                }
                                            </div>
                                        </article>
                                    }

                                    @if (message.Workbench.OrderLines.Count > 0)
                                    {
                                        <article class="qe-agent-flow-card qe-agent-order-card">
                                            <header>
                                                <div>
                                                    <strong>@Text("Order summary", "สรุปคำสั่งซื้อ")</strong>
                                                    <small>@Text("Requires sign in and confirmation before durable actions", "ต้องเข้าสู่ระบบและยืนยันก่อนสร้างข้อมูลถาวร")</small>
                                                </div>
                                                <b>@message.Workbench.TotalPrice</b>
                                            </header>
                                            <div>
                                                @foreach (var line in message.Workbench.OrderLines)
                                                {
                                                    <section>
                                                        <span>@line.Label</span>
                                                        <strong>@line.Value</strong>
                                                    </section>
                                                }
                                            </div>
                                            <footer>
                                                <button type="button" @onclick="@(() => ApplyWorkbenchPrompt("Place this order after I sign in"))">
                                                    @Text("Place order", "สั่งผลิต")
                                                </button>
                                                <button type="button" @onclick="@(() => ApplyWorkbenchPrompt("Save this as a formal quote"))">
                                                    @Text("Save quote", "บันทึกใบเสนอราคา")
                                                </button>
                                            </footer>
                                        </article>
                                    }
                                </section>
                            }
                        </div>
                    </article>
                }
            }
        </div>

        <button type="button"
                class="@($"qe-agent-scroll-to-bottom {(_showScrollToBottomButton ? "is-visible" : string.Empty)}")"
                title="@Text("Scroll to latest message", "เลื่อนไปข้อความล่าสุด")"
                aria-label="@Text("Scroll to latest message", "เลื่อนไปข้อความล่าสุด")"
                aria-hidden="@(!_showScrollToBottomButton)"
                @onclick="ScrollToLatestMessageAsync">
            <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" />
        </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="qe-agent-error" role="alert">@_error</div>
        }

        @if (_proposedActions.Count > 0)
        {
            <section class="qe-agent-chat-actions" aria-label="@Text("Pending confirmation actions", "รายการรอยืนยัน")">
                <header>
                    <div>
                        <span>@Text("Confirmation required", "ต้องยืนยัน")</span>
                        <strong>@Text("Review before MALIEV changes anything durable", "ตรวจสอบก่อนให้ MALIEV เปลี่ยนข้อมูลถาวร")</strong>
                    </div>
                    <button type="button"
                            class="qe-agent-secondary-btn"
                            @onclick="ToggleArtifactPanel">
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                        <span>@Text("Open workbench", "เปิดพื้นที่งาน")</span>
                    </button>
                </header>
                @foreach (var action in _proposedActions)
                {
                    <article class="qe-agent-action">
                        <div>
                            <strong>@action.Title</strong>
                            <p>@action.Summary</p>
                        </div>
                        @if (action.RequiresAuthentication && !IsSignedIn)
                        {
                            <button type="button" @onclick='@(() => OpenAuthDialog("sign-in"))'>@Text("Sign in to continue", "เข้าสู่ระบบเพื่อทำต่อ")</button>
                        }
                        else
                        {
                            <button type="button" @onclick="@(() => ConfirmActionAsync(action))">
                                <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                <span>@Text("Confirm", "ยืนยัน")</span>
                            </button>
                        }
                    </article>
                }
            </section>
        }

        @if (ShowSummaryStrip)
        {
            <div class="qe-agent-summary-strip" role="group" aria-label="@Text("Project quick summary", "สรุปโปรเจกต์อย่างย่อ")">
                <span class="qe-agent-summary-strip-item">
                    <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Small" />
                    <span class="qe-agent-summary-strip-value">@QuoteReadyPartCount.ToString(CultureInfo.InvariantCulture)</span>
                    <span class="qe-agent-summary-strip-label">@Text("parts", "ชิ้นงาน")</span>
                </span>
                <span class="qe-agent-summary-strip-divider" aria-hidden="true"></span>
                <span class="qe-agent-summary-strip-item">
                    <MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" />
                    <span class="qe-agent-summary-strip-value">@SummaryStripTotal</span>
                </span>
                <span class="qe-agent-summary-strip-divider" aria-hidden="true"></span>
                <span class="qe-agent-summary-strip-item">
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                    <span class="qe-agent-summary-strip-value">@SummaryLeadTime</span>
                    <span class="qe-agent-summary-strip-label">@Text("lead time", "เวลานำส่ง")</span>
                </span>
                @if (ShowUsageRing)
                {
                    <span class="qe-agent-summary-strip-divider" aria-hidden="true"></span>
                    <span class="@UsageRingClass" style="@UsageRingStyle" title="@UsageRingTitle" aria-label="@UsageRingTitle">
                        <span class="qe-agent-usage-ring" aria-hidden="true"></span>
                        <span class="qe-agent-summary-strip-value">@UsageRingPercent</span>
                        <span class="qe-agent-summary-strip-label">@Text("usage", "การใช้งาน")</span>
                    </span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_dictationNotice))
        {
            <div class="qe-agent-dictation-notice" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.MicOff" Size="Size.Small" />
                <span class="qe-agent-dictation-notice-text">@_dictationNotice</span>
                <button type="button"
                        class="qe-agent-dictation-notice-dismiss"
                        title="@Text("Dismiss", "ปิด")"
                        aria-label="@Text("Dismiss microphone notice", "ปิดการแจ้งเตือนไมโครโฟน")"
                        @onclick="DismissDictationNotice">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                </button>
            </div>
        }

        <section class="@ComposerWrapClass" aria-label="@Text("Message composer", "กล่องข้อความ")">
            @if (DriveMentionActive)
            {
                <button type="button"
                        class="qe-agent-drive-mention is-active"
                        aria-label="@Text("Open Google Drive connector", "เปิดตัวเชื่อมต่อ Google Drive")"
                        @onclick="ApplyDriveMentionAsync">
                    <span class="qe-agent-drive-mention-token">@DriveMentionToken</span>
                    <span class="qe-agent-drive-mention-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path fill="#1a73e8" d="M8.7 3.5h6.6l6.2 10.8h-6.7L8.7 3.5Z" />
                            <path fill="#fbbc04" d="M2.5 14.3 8.7 3.5l3.3 5.8-2.9 5H2.5Z" />
                            <path fill="#34a853" d="M5.8 20.5 2.5 14.3h12.3l3.5 6.2H5.8Z" />
                        </svg>
                    </span>
                    <strong>Google Drive</strong>
                    <small>@DriveMentionStatus</small>
                </button>
            }
            <form class="@ComposerClass" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
                @if (_replyTo is not null)
                {
                    <div class="qe-agent-composer-reply" role="status" aria-label="@Text("Replying to a message", "กำลังตอบกลับข้อความ")">
                        <MudIcon Icon="@Icons.Material.Outlined.Reply" Size="Size.Small" />
                        <span class="qe-agent-composer-reply-text">@ReplyChipLabel(_replyTo)</span>
                        <button type="button"
                                class="qe-agent-composer-reply-cancel"
                                title="@Text("Cancel reply", "ยกเลิกการตอบกลับ")"
                                aria-label="@Text("Cancel reply", "ยกเลิกการตอบกลับ")"
                                @onclick="CancelReply">
                            <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                        </button>
                    </div>
                }
                @if (_pendingComposerAttachments.Count > 0)
                {
                    <div class="qe-agent-composer-attachments"
                         role="status"
                         aria-live="polite"
                         aria-label="@Text("Attached artifacts", "อาร์ติแฟกต์ที่แนบ")">
                        @for (var i = 0; i < Math.Min(_pendingComposerAttachments.Count, 5); i++)
                        {
                            var index = i;
                            var part = _pendingComposerAttachments[i];
                            <div class="@ComposerAttachmentCardClass(part, i)">
                                <button type="button"
                                        class="qe-agent-composer-attachment-main"
                                        @onclick="@(() => SelectPendingComposerAttachmentAsync(index))">
                                    <span class="qe-agent-composer-attachment-preview">
                                        @if (!string.IsNullOrWhiteSpace(part.PreviewUrl))
                                        {
                                            <img src="@part.PreviewUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@UploadedPartIcon(part)" Size="Size.Small" />
                                        }
                                        @if (IsComposerUploadPending(part))
                                        {
                                            <span class="qe-agent-upload-progress" aria-hidden="true"></span>
                                        }
                                    </span>
                                    <span class="qe-agent-composer-attachment-copy">
                                        <strong>@part.FileName</strong>
                                        <small>@AttachmentStatusLabel(part)</small>
                                    </span>
                                </button>
                                <button type="button"
                                        class="qe-agent-composer-attachment-remove"
                                        title="@Text("Remove attachment", "นำไฟล์แนบออก")"
                                        aria-label="@Text($"Remove {part.FileName}", $"นำ {part.FileName} ออก")"
                                        @onclick="@(() => RemovePendingComposerAttachmentAsync(index))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                                </button>
                            </div>
                        }
                        @if (RemainingComposerAttachmentCount > 0)
                        {
                            <div class="qe-agent-composer-attachment-overflow" aria-label="@ComposerAttachmentOverflowLabel()">
                                <strong>+@RemainingComposerAttachmentCount</strong>
                                <small>@Text("more", "เพิ่ม")</small>
                            </div>
                        }
                    </div>
                }
                @if (!IsDictationActive)
                {
                    <div class="qe-agent-composer-tooltip qe-agent-add-tooltip">
                        @if (!string.IsNullOrWhiteSpace(UploadInputElementId))
                        {
                            <label class="qe-agent-round-btn qe-agent-add-btn"
                                   for="@UploadInputElementId"
                                   role="button"
                                   tabindex="0"
                                   aria-describedby="qe-agent-add-tooltip"
                                   aria-label="@Text("Add files", "เพิ่มไฟล์")">
                                <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                            </label>
                        }
                        else
                        {
                            <button type="button"
                                    class="qe-agent-round-btn qe-agent-add-btn"
                                    aria-describedby="qe-agent-add-tooltip"
                                    aria-label="@Text("Add files", "เพิ่มไฟล์")"
                                    @onclick="RequestUploadAsync">
                                <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                            </button>
                        }
                        <span id="qe-agent-add-tooltip" class="qe-agent-tooltip-panel" role="tooltip">
                            <span class="qe-agent-tooltip-content">
                                <span>@Text("Add files", "เพิ่มไฟล์")</span>
                            </span>
                        </span>
                    </div>
                }
                <textarea @ref="_composerTextarea"
                          @bind="_draftMessage"
                          @bind:event="oninput"
                          rows="1"
                          maxlength="@QuoteAgentTextLimits.MaxMessageCharacters"
                          autofocus
                          lang="@SpeechRecognitionLanguage"
                          data-speech-languages="@SpeechRecognitionLanguages"
                          placeholder="@Text("Describe your part, paste dimensions, attach files, or drag and drop files...", "อธิบายชิ้นงาน วางขนาด แนบไฟล์ หรือลากไฟล์มาวาง...")"
                          aria-label="@Text("Message MALIEV Quote Agent", "ข้อความถึงผู้ช่วยขอราคา MALIEV")"></textarea>
                <div class="qe-agent-dictation-meter" aria-hidden="@(!_dictating)">
                    <span class="qe-agent-dictation-meter-line"></span>
                    <span class="qe-agent-dictation-meter-bars">
                        @for (var index = 0; index < DictationMeterBarCount; index++)
                        {
                            <i></i>
                        }
                    </span>
                    <span class="qe-agent-dictation-time">@_dictationTimeLabel</span>
                </div>
                <div class="qe-agent-composer-tooltip qe-agent-dictation-tooltip">
                    <button type="button"
                            @ref="_dictationButton"
                            class="@($"qe-agent-round-btn qe-agent-dictation-btn {(_dictating ? "active" : string.Empty)} {(_dictationProcessing ? "processing" : string.Empty)}")"
                            aria-describedby="qe-agent-dictation-tooltip"
                            aria-label="@DictationButtonTitle"
                            aria-pressed="@_dictating"
                            disabled="@_dictationUnsupported">
                        @if (_dictationProcessing)
                        {
                            <span class="qe-agent-dictation-spinner" aria-hidden="true"></span>
                        }
                        else if (_dictating)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Stop" Size="Size.Small" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.MicNone" Size="Size.Small" />
                        }
                    </button>
                    <span id="qe-agent-dictation-tooltip" class="qe-agent-tooltip-panel" role="tooltip">
                        <span class="qe-agent-tooltip-content">
                            <span>@DictationButtonTitle</span>
                            @if (!_dictating && !_dictationProcessing && !_dictationUnsupported)
                            {
                                <kbd>Space</kbd>
                            }
                        </span>
                    </span>
                </div>
                <div class="qe-agent-composer-tooltip qe-agent-send-tooltip">
                    <button type="submit"
                            class="qe-agent-send-btn"
                            aria-describedby="qe-agent-send-tooltip"
                            aria-label="@Text("Send message", "ส่งข้อความ")"
                            disabled="@IsComposerSendDisabled">
                        @if (_sending)
                        {
                            <span class="qe-agent-send-spinner" aria-hidden="true"></span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" />
                        }
                        <span class="sr-only">@(_sending ? Text("Processing", "กำลังประมวลผล") : Text("Send", "ส่ง"))</span>
                    </button>
                    <span id="qe-agent-send-tooltip" class="qe-agent-tooltip-panel" role="tooltip">
                        <span class="qe-agent-tooltip-content">
                            <span>@Text("Send message", "ส่งข้อความ")</span>
                            <kbd>Enter</kbd>
                        </span>
                    </span>
                </div>
                @if (!IsDictationActive)
                {
                    <div class="qe-agent-quick-actions-wrapper">
                        <div class="qe-agent-composer-tooltip">
                            <button type="button"
                                    class="qe-agent-quick-actions-btn"
                                    @onclick="ToggleQuickActionsMenu"
                                    aria-describedby="qe-agent-tools-tooltip"
                                    aria-label="@Text("Tools", "เครื่องมือ")"
                                    aria-expanded="@_quickActionsMenuOpen">
                                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                                <span>@Text("Tools", "เครื่องมือ")</span>
                            </button>
                            <span id="qe-agent-tools-tooltip" class="qe-agent-tooltip-panel" role="tooltip">
                                <span class="qe-agent-tooltip-content">
                                    <span>@Text("Tools", "เครื่องมือ")</span>
                                </span>
                            </span>
                        </div>
                        @if (_quickActionsMenuOpen)
                        {
                            <div class="qe-agent-quick-actions-menu" role="menu" aria-label="@Text("Tools", "เครื่องมือ")">
                            <button type="button" role="menuitem" @onclick="RequestUploadFromQuickActionsAsync">
                                <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" />
                                <span>@Text("Upload a 3D file", "อัปโหลดไฟล์ 3D")</span>
                            </button>
                            <button type="button" role="menuitem" @onclick="RequestUploadFromQuickActionsAsync">
                                <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" />
                                <span>@Text("Photo of a part", "รูปชิ้นงาน")</span>
                            </button>
                            <button type="button" role="menuitem" @onclick="OpenSketchFromQuickActionsAsync">
                                <MudIcon Icon="@Icons.Material.Outlined.Draw" />
                                <span>@Text("Hand sketch", "สเก็ตช์มือ")</span>
                            </button>
                            @if (_connectors.Count > 0)
                            {
                                <hr class="qe-agent-quick-actions-separator" />
                                <div class="qe-agent-quick-actions-section-label" role="presentation">@Text("Plugins", "ปลั๊กอิน")</div>
                                @foreach (var connector in _connectors)
                                {
                                    <button type="button" role="menuitem" @onclick="@(() => ApplyConnectorFromPluginsAsync(connector))">
                                        <span class="qe-agent-plugin-menu-icon" aria-hidden="true">
                                            @if (IsGoogleDriveConnector(connector))
                                            {
                                                <svg viewBox="0 0 24 24" focusable="false">
                                                    <path fill="#1a73e8" d="M8.7 3.5h6.6l6.2 10.8h-6.7L8.7 3.5Z" />
                                                    <path fill="#fbbc04" d="M2.5 14.3 8.7 3.5l3.3 5.8-2.9 5H2.5Z" />
                                                    <path fill="#34a853" d="M5.8 20.5 2.5 14.3h12.3l3.5 6.2H5.8Z" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" />
                                            }
                                        </span>
                                        <span class="qe-agent-plugin-menu-text">
                                            <strong>@connector.DisplayName</strong>
                                            <small>@ConnectorToolsDescription(connector)</small>
                                        </span>
                                        <span class="qe-agent-plugin-menu-status">@ConnectorStatus(connector)</span>
                                    </button>
                                }
                            }
                            @if (_messages.Count > 0)
                            {
                                <hr class="qe-agent-quick-actions-separator" />
                                <button type="button" role="menuitem" @onclick="ExportChatPdfAsync" disabled="@_exportingPdf">
                                    <MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf" />
                                    <span>@Text("Export chat as PDF", "ส่งออกแชทเป็น PDF")</span>
                                </button>
                            }
                            </div>
                        }
                    </div>
                }
            </form>
            @if (_messages.Count == 0 && VisibleUseCases.Count > 0)
            {
                <section class="@UseCaseListClass"
                         aria-label="@Text("Quick actions", "การดำเนินการด่วน")">
                    @foreach (var useCase in VisibleUseCases)
                    {
                        <button type="button"
                                class="qe-agent-use-case-card"
                                aria-label="@Text(useCase.TitleEn, useCase.TitleTh)"
                                @onclick="@(() => ApplyUseCaseAsync(useCase))">
                            <span>@Text(useCase.TitleEn, useCase.TitleTh)</span>
                            <small>@Text(useCase.PromptEn, useCase.PromptTh)</small>
                        </button>
                    }
                </section>
            }
        </section>
        </div>
        }

        @if (_sketchOpen)
        {
            <button type="button"
                    class="qe-agent-sketch-backdrop"
                    aria-label="@Text("Close hand sketch", "ปิดสเก็ตช์มือ")"
                    @onclick="CloseSketchAsync"></button>
            <section class="qe-agent-sketch-dialog" role="dialog" aria-modal="true" aria-label="@Text("Hand sketch", "สเก็ตช์มือ")">
                <header>
                    <div>
                        <span>@Text("Hand sketch", "สเก็ตช์มือ")</span>
                        <input class="qe-agent-sketch-title"
                               @bind="_sketchTitle"
                               maxlength="80"
                               aria-label="@Text("Sketch name", "ชื่อสเก็ตช์")" />
                        <small>@Text("Paste an image from the clipboard, insert a file, or draw with a mouse or pen.", "วางรูปภาพจากคลิปบอร์ด เพิ่มไฟล์ หรือวาดด้วยเมาส์หรือปากกา")</small>
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="CloseSketchAsync" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <div class="qe-agent-sketch-paper">
                    <canvas id="@SketchCanvasId"
                            class="qe-agent-sketch-canvas"
                            width="1600"
                            height="1000"
                            aria-label="@Text("Draw your part sketch with a mouse or pen", "วาดสเก็ตช์ชิ้นงานด้วยเมาส์หรือปากกา")"></canvas>
                </div>
                <footer>
                    <div class="qe-agent-sketch-tools" aria-label="@Text("Sketch colors", "สีสเก็ตช์")">
                        @foreach (var swatch in SketchColors)
                        {
                            <button type="button"
                                    class="@($"qe-agent-sketch-color {(swatch.Hex == _sketchColor ? "active" : string.Empty)}")"
                                    style="@($"--sketch-color:{swatch.Hex}")"
                                    title="@swatch.Name"
                                    aria-label="@Text($"Use {swatch.Name} ink", $"ใช้สี{swatch.ThaiName}")"
                                    aria-pressed="@(swatch.Hex == _sketchColor)"
                                    @onclick="@(() => SelectSketchColorAsync(swatch.Hex))">
                                <span></span>
                            </button>
                        }
                    </div>
                    <div class="qe-agent-sketch-actions">
                        <button type="button"
                                class="@($"qe-agent-sketch-tool-btn {(_sketchMode == "eraser" ? "active" : string.Empty)}")"
                                title="@Text("Eraser", "ยางลบ")"
                                aria-label="@Text("Eraser", "ยางลบ")"
                                aria-pressed="@(_sketchMode == "eraser")"
                                @onclick="UseSketchEraserAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoFixOff" Size="Size.Small" />
                        </button>
                        <button type="button"
                                class="qe-agent-sketch-tool-btn"
                                title="@Text("Undo", "เลิกทำ")"
                                aria-label="@Text("Undo", "เลิกทำ")"
                                @onclick="UndoSketchAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.Undo" Size="Size.Small" />
                        </button>
                        <button type="button"
                                class="qe-agent-sketch-tool-btn"
                                title="@Text("Redo", "ทำซ้ำ")"
                                aria-label="@Text("Redo", "ทำซ้ำ")"
                                @onclick="RedoSketchAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.Redo" Size="Size.Small" />
                        </button>
                        <label class="qe-agent-sketch-tool-btn qe-agent-sketch-tool-btn--label" for="@SketchImageInputId" title="@Text("Insert image", "เพิ่มรูปภาพ")" aria-label="@Text("Insert image", "เพิ่มรูปภาพ")">
                            <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" Size="Size.Small" />
                        </label>
                    </div>
                    <InputFile id="@SketchImageInputId"
                               class="qe-agent-hidden-file"
                               OnChange="InsertSketchImageAsync"
                               accept="image/png,image/jpeg,image/webp,image/gif" />
                    <button type="button" class="qe-agent-secondary-btn qe-agent-sketch-trash-btn" @onclick="ClearSketchAsync" title="@Text("Clear sketch", "ล้างสเก็ตช์")">
                        <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" />
                        <span class="sr-only">@Text("Clear sketch", "ล้างสเก็ตช์")</span>
                    </button>
                    <button type="button" class="qe-agent-primary-btn" disabled="@_sketchAttaching" @onclick="AttachSketchAsync">
                        @if (_sketchAttaching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                        <span>@Text("Attach sketch", "แนบสเก็ตช์")</span>
                    </button>
                </footer>
            </section>
        }



    </main>

    @if (_summaryPanelOpen)
    {
        <aside class="@($"qe-agent-summary-drawer {UiFocusClass("summary", "summary:actions")}")" aria-label="@Text("Project summary", "สรุปโปรเจกต์")">
            <header>
                <div>
                    <span>@Text("Project", "โปรเจกต์")</span>
                    <strong>@Text("Summary", "สรุป")</strong>
                </div>
                <button type="button" class="qe-agent-round-btn" @onclick="ToggleSummaryPanel" title="@Text("Close", "ปิด")">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                </button>
            </header>

            <section class="@($"qe-agent-summary-card {UiFocusClass("summary")}")">
                <span>@Text("Current project", "โปรเจกต์ปัจจุบัน")</span>
                <strong>@ProjectSummaryTitle</strong>
                <p>@ProjectSummaryStatus</p>
            </section>

            <section class="qe-agent-summary-grid" aria-label="@Text("Project facts", "ข้อมูลโปรเจกต์")">
                @foreach (var item in ProjectSummaryMetrics)
                {
                    <article>
                        <span>@item.Label</span>
                        <strong>@item.Value</strong>
                    </article>
                }
            </section>

            <section class="@($"qe-agent-summary-section {UiFocusClass("summary:actions")}")">
                <header>@Text("Manufacturing state", "สถานะงานผลิต")</header>
                <div class="qe-agent-summary-list">
                    @foreach (var item in ProjectSummaryDetails)
                    {
                        <div>
                            <span>@item.Label</span>
                            <strong>@item.Value</strong>
                        </div>
                    }
                </div>
            </section>

            <section class="qe-agent-summary-section">
                <header>@Text("Next actions", "ขั้นตอนถัดไป")</header>
                @if (_proposedActions.Count == 0)
                {
                    <p class="qe-agent-muted">@Text("No confirmation actions are waiting.", "ยังไม่มีรายการที่ต้องยืนยัน")</p>
                }
                else
                {
                    <div class="qe-agent-summary-actions">
                        @foreach (var action in _proposedActions.Take(3))
                        {
                            <article>
                                <strong>@action.Title</strong>
                                <p>@action.Summary</p>
                            </article>
                        }
                    </div>
                }
            </section>
        </aside>
    }

    @if (_artifactPanelOpen)
    {
        <aside class="@($"qe-agent-artifact-drawer {UiFocusClass("artifacts", "workbench")}")" aria-label="@Text("Quote artifacts", "ไฟล์งานใบเสนอราคา")">
            <header>
                <div>
                    <span>@Text("Workbench", "พื้นที่งาน")</span>
                    <strong>@Text("Artifacts", "ไฟล์งาน")</strong>
                </div>
                <div class="qe-agent-artifact-header-actions">
                    @if (!string.IsNullOrWhiteSpace(UploadInputElementId))
                    {
                        <label class="qe-agent-round-btn qe-agent-artifact-upload-btn"
                               for="@UploadInputElementId"
                               role="button"
                               tabindex="0"
                               title="@Text("Add files to workbench", "เพิ่มไฟล์เข้าพื้นที่งาน")"
                               aria-label="@Text("Add files to workbench", "เพิ่มไฟล์เข้าพื้นที่งาน")">
                            <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Small" />
                        </label>
                    }
                    else
                    {
                        <button type="button"
                                class="qe-agent-round-btn qe-agent-artifact-upload-btn"
                                title="@Text("Add files to workbench", "เพิ่มไฟล์เข้าพื้นที่งาน")"
                                aria-label="@Text("Add files to workbench", "เพิ่มไฟล์เข้าพื้นที่งาน")"
                                @onclick="RequestUploadAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Size="Size.Small" />
                        </button>
                    }
                    <button type="button" class="qe-agent-round-btn" @onclick="ToggleArtifactPanel" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </div>
            </header>
            @if (ArtifactCount == 0)
            {
                <p class="qe-agent-muted">@Text("Add files with the upload button above, or they will appear here as the assistant works: viewer, DFM reports, estimates, quote PDFs, order records, and payment handoffs.", "เพิ่มไฟล์ด้วยปุ่มอัปโหลดด้านบน หรือไฟล์จะปรากฏที่นี่เมื่อผู้ช่วยทำงาน เช่น โมเดล รายงาน DFM ราคา ใบเสนอราคา คำสั่งซื้อ และการชำระเงิน")</p>
            }
            else
            {
                var selectedGeneratedViewer = SelectedGeneratedViewerArtifact;
                var selectedArtifactPreview = SelectedArtifactPreviewItem;
                if (selectedGeneratedViewer is not null &&
                    TryGetGeneratedViewerCommands(selectedGeneratedViewer, out var selectedGeneratedCommandsJson))
                {
                    <div class="qe-agent-artifact-preview-shell">
                        <section class="@($"qe-agent-artifact-viewer {UiFocusClass("viewer", ArtifactFocusKey(selectedGeneratedViewer))}")" aria-label="@Text("Generated 3D preview", "พรีวิว 3D ที่สร้างขึ้น")">
                            <header>
                                <div>
                                    <span>@Text("Generated 3D preview", "พรีวิว 3D ที่สร้างขึ้น")</span>
                                    <strong>@selectedGeneratedViewer.Title</strong>
                                </div>
                                <small>@selectedGeneratedViewer.Status</small>
                            </header>
                            <div class="qe-agent-artifact-viewer-canvas qe-agent-artifact-generated-viewer">
                                <QeInlinePartViewer CommandsJson="@selectedGeneratedCommandsJson"
                                                    OnBuildOutcome="@(outcome => HandleGeneratedArtifactViewerBuildOutcomeAsync(selectedGeneratedViewer, outcome))" />
                            </div>
                            @if (GeneratedViewerBuildFailed(selectedGeneratedViewer))
                            {
                                <button type="button"
                                        class="qe-inline-viewer-rebuild-button"
                                        @onclick="@(() => RequestPreviewRebuildAsync(BuildInlineViewerInfo(selectedGeneratedViewer, selectedGeneratedCommandsJson)))">
                                    <MudIcon Icon="@Icons.Material.Outlined.AutoFixHigh" Size="Size.Small" />
                                    <span>@Text("Ask agent to rebuild this preview", "ขอให้เอเจนต์สร้างพรีวิวนี้ใหม่")</span>
                                </button>
                            }
                        </section>
                    </div>
                }
                else if (_selectedArtifact is not null)
                {
                    var selectedArtifact = _selectedArtifact;
                    var selectedDfmPart = ResolveDfmArtifactPart(selectedArtifact);
                    <div class="qe-agent-artifact-preview-shell">
                        <section class="@($"qe-agent-artifact-context {UiFocusClass("artifact", selectedArtifactPreview?.Source ?? ArtifactFocusKey(selectedArtifact), ArtifactTypeFocusKey(selectedArtifact.ArtifactType))}")" aria-label="@Text("Selected artifact details", "รายละเอียดไฟล์งานที่เลือก")">
                            <header>
                                <div>
                                    <span>@ArtifactKindLabel(selectedArtifact)</span>
                                    <strong>@selectedArtifact.Title</strong>
                                </div>
                                <div class="qe-agent-artifact-preview-actions">
                                    <small>@ArtifactStatusLabel(selectedArtifact, selectedDfmPart)</small>
                                    @if (selectedArtifactPreview is not null)
                                    {
                                        <a href="@selectedArtifactPreview.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="qe-agent-artifact-link qe-agent-artifact-open-link"
                                           title="@Text("Open in new tab", "เปิดในแท็บใหม่")"
                                           aria-label="@Text("Open selected artifact in a new tab", "เปิดไฟล์งานที่เลือกในแท็บใหม่")">
                                            <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" />
                                        </a>
                                    }
                                </div>
                            </header>
                            <div class="qe-agent-artifact-context-body">
                                @if (TryGetPaymentQr(selectedArtifact, out var paymentQr))
                                {
                                    <div class="qe-agent-payment-qr">
                                        <img class="qe-agent-payment-qr-image" src="@paymentQr.ImageUrl" alt="@Text("PromptPay QR code", "คิวอาร์โค้ดพร้อมเพย์")" />
                                        <p class="qe-agent-payment-qr-caption">@Text($"Scan this PromptPay QR to pay {paymentQr.AmountLabel}", $"สแกนคิวอาร์พร้อมเพย์เพื่อชำระ {paymentQr.AmountLabel}")</p>
                                        @if (!string.IsNullOrWhiteSpace(paymentQr.ExpiresAtIso))
                                        {
                                            <small class="qe-agent-payment-qr-countdown"
                                                   data-qr-expires-at="@paymentQr.ExpiresAtIso"
                                                   data-qr-countdown-prefix="@Text("Time left ", "เหลือเวลา ")"
                                                   data-qr-expired-label="@Text("QR expired — restart payment", "คิวอาร์หมดอายุ — เริ่มชำระใหม่")">@paymentQr.CountdownLabel</small>
                                        }
                                    </div>
                                }
                                else if (selectedDfmPart is not null)
                                {
                                    <div class="qe-agent-artifact-dfm-panel">
                                        <QeDfmTab IsManifold="@selectedDfmPart.IsManifold"
                                                  NonManifoldReason="@selectedDfmPart.NonManifoldReason"
                                                  FdmReport="@selectedDfmPart.FdmDfmReport"
                                                  SlaReport="@selectedDfmPart.SlaDfmReport"
                                                  CncReport="@selectedDfmPart.CncDfmReport"
                                                  GlbUrl="@selectedDfmPart.GlbUrl"
                                                  BodyCount="@selectedDfmPart.BodyCount"
                                                  ProcessId="@selectedDfmPart.ProcessId" />
                                    </div>
                                }
                                else if (selectedArtifactPreview is not null && IsImagePreview(selectedArtifactPreview))
                                {
                                    <img class="qe-agent-artifact-preview-media" src="@selectedArtifactPreview.Url" alt="" loading="lazy" onerror="this.style.display='none'" />
                                }
                                else if (selectedArtifactPreview is not null && IsPdfPreview(selectedArtifactPreview))
                                {
                                    <iframe src="@selectedArtifactPreview.Url"
                                            class="qe-agent-artifact-frame"
                                            title="@selectedArtifactPreview.Title"
                                            loading="lazy"
                                            sandbox="allow-scripts allow-same-origin allow-popups allow-forms"></iframe>
                                }
                                else
                                {
                                    <div class="qe-agent-artifact-preview-fallback">
                                        <MudIcon Icon="@ArtifactIcon(selectedArtifact.ArtifactType)" Size="Size.Large" />
                                    </div>
                                }
                                <dl class="qe-agent-artifact-details">
                                    @foreach (var detail in ArtifactDetailItems(selectedArtifact, selectedDfmPart))
                                    {
                                        <div>
                                            <dt>@detail.Label</dt>
                                            <dd>@detail.Value</dd>
                                        </div>
                                    }
                                </dl>
                            </div>
                        </section>
                    </div>
                }
                else if (UploadedParts.Count > 0)
                {
                    <div class="qe-agent-artifact-preview-shell">
                        @if (CanRenderUploadedPartViewer(SelectedUploadedPart))
                        {
                            <section class="@($"qe-agent-artifact-viewer {UiFocusClass("viewer", PartFocusKey(SelectedUploadedPart.PartId))}")" aria-label="@Text("Selected 3D file viewer", "ตัวแสดงไฟล์ 3D ที่เลือก")">
                                <header>
                                    <div>
                                        <span>@Text("3D viewer", "ตัวแสดง 3D")</span>
                                        <strong>@SelectedUploadedPart.FileName</strong>
                                        @if (QuoteUploadConstraints.IsSupportedCadFileName(SelectedUploadedPart.FileName))
                                        {
                                            <small class="qe-agent-artifact-viewer-metadata">@QuoteAgentUiHelpers.FormatUploadedPartMetadata(SelectedUploadedPart)</small>
                                        }
                                    </div>
                                    <small>@UploadedPartStatus(SelectedUploadedPart)</small>
                                </header>
                                <div class="qe-agent-artifact-viewer-canvas">
                                    <QePartViewer GlbUrl="@SelectedUploadedPart.GlbUrl"
                                                  FileExtension="@ResolveUploadedPartViewerExtension(SelectedUploadedPart)"
                                                  IsDarkMode="@IsDarkMode"
                                                  PartColor="@SelectedUploadedPart.Color"
                                                  ProcessId="@SelectedUploadedPart.ProcessId"
                                                  MaterialId="@SelectedUploadedPart.MaterialId"
                                                  BrowserFileClientId="@SelectedUploadedPart.ClientFileId"
                                                  BrowserFileName="@SelectedUploadedPart.FileName"
                                                  StoragePath="@SelectedUploadedPart.StoragePath"
                                                  FinishCode="@SelectedUploadedPart.FinishCode"
                                                  RoughnessCode="@SelectedUploadedPart.RoughnessCode"
                                                  ViewerSettings="@SelectedUploadedPart.ViewerSettings"
                                                  OnLocalGeometryRuntimeCompleted="ApplyLocalGeometryRuntimeResultAsync" />
                                    @if (TryGetCanvasFocusPoint(out var canvasFocusStyle))
                                    {
                                        <span class="qe-agent-canvas-focus qe-agent-focus-pulse"
                                              style="@canvasFocusStyle"
                                              aria-hidden="true"></span>
                                    }
                                </div>
                            </section>
                        }
                        else
                        {
                            var uploadedPreviewItem = BuildUploadedPreviewItem(SelectedPartIndex, SelectedUploadedPart);
                            <section class="@($"qe-agent-artifact-context {UiFocusClass(PartFocusKey(SelectedUploadedPart.PartId))}")" aria-label="@Text("Supplemental uploaded file", "ไฟล์ประกอบที่อัปโหลด")">
                                <header>
                                    <div>
                                        <span>@SupplementalArtifactLabel(SelectedUploadedPart)</span>
                                        <strong>@SelectedUploadedPart.FileName</strong>
                                    </div>
                                    <div class="qe-agent-artifact-preview-actions">
                                        <small>@UploadedPartStatus(SelectedUploadedPart)</small>
                                        @if (!string.IsNullOrWhiteSpace(uploadedPreviewItem.Url))
                                        {
                                            <a href="@uploadedPreviewItem.Url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="qe-agent-artifact-link qe-agent-artifact-open-link"
                                               title="@Text("Open in new tab", "เปิดในแท็บใหม่")"
                                               aria-label="@Text("Open uploaded file in a new tab", "เปิดไฟล์ที่อัปโหลดในแท็บใหม่")">
                                                <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" />
                                            </a>
                                        }
                                    </div>
                                </header>
                                <div class="qe-agent-artifact-context-body">
                                    @if (!string.IsNullOrWhiteSpace(uploadedPreviewItem.Url) && IsImagePreview(uploadedPreviewItem))
                                    {
                                        <img class="qe-agent-artifact-preview-media" src="@uploadedPreviewItem.Url" alt="" loading="lazy" onerror="this.style.display='none'" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(uploadedPreviewItem.Url) && IsPdfPreview(uploadedPreviewItem))
                                    {
                                        <iframe src="@uploadedPreviewItem.Url"
                                                class="qe-agent-artifact-frame"
                                                title="@uploadedPreviewItem.Title"
                                                loading="lazy"
                                                sandbox="allow-scripts allow-same-origin allow-popups allow-forms"></iframe>
                                    }
                                    else
                                    {
                                        <div class="qe-agent-artifact-preview-fallback">
                                            <MudIcon Icon="@UploadedPartIcon(SelectedUploadedPart)" Size="Size.Large" />
                                        </div>
                                    }
                                    <section class="qe-agent-artifact-analysis-note">
                                        <header>
                                            <span>@Text("Artifact analysis", "การวิเคราะห์ไฟล์")</span>
                                            <button type="button"
                                                    class="qe-agent-artifact-note-edit"
                                                    title="@Text("Edit artifact analysis", "แก้ไขการวิเคราะห์ไฟล์")"
                                                    aria-label="@Text("Edit artifact analysis", "แก้ไขการวิเคราะห์ไฟล์")"
                                                    @onclick="@(() => OpenArtifactNoteDialog(SelectedPartIndex))">
                                                <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                            </button>
                                        </header>
                                        <p>@ArtifactAnalysisNoteText(SelectedUploadedPart)</p>
                                    </section>
                                    <p>@SupplementalArtifactHint(SelectedUploadedPart)</p>
                                </div>
                            </section>
                        }
                    </div>
                }
                @if (UploadedParts.Count > 0)
                {
                    <section class="qe-agent-artifact-section" aria-label="@Text("Uploaded files", "ไฟล์ที่อัปโหลด")">
                        <header>@Text("Uploaded files", "ไฟล์ที่อัปโหลด")</header>
                        <div class="qe-agent-artifacts">
                            @foreach (var (index, part) in UniqueUploadedPartsWithIndex)
                            {
                                <button type="button"
                                        class="@($"qe-agent-artifact qe-agent-artifact--button {(index == SelectedPartIndex ? "active" : string.Empty)} {UiFocusClass(PartFocusKey(part.PartId), UploadedPartFocusKey(part))}")"
                                        @onclick="@(() => SelectUploadedPartAsync(index))"
                                        @ondblclick="@(() => OpenUploadedPreviewAsync(index))">
                                    @if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
                                    {
                                        <img class="qe-agent-artifact-thumb" src="@part.ThumbnailUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@UploadedPartIcon(part)" Size="Size.Small" />
                                    }
                                    <div>
                                        <strong>@part.FileName</strong>
                                        <small>@UploadedPartStatus(part)</small>
                                        @if (QuoteUploadConstraints.IsSupportedCadFileName(part.FileName))
                                        {
                                            <small class="qe-agent-artifact-metadata">@QuoteAgentUiHelpers.FormatUploadedPartMetadata(part)</small>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    </section>
                    @if (MessageSketches.Count > 0)
                    {
                        <section class="qe-agent-artifact-section" aria-label="@Text("Sketches", "สเก็ตช์")">
                            <header>@Text("Sketches", "สเก็ตช์")</header>
                            <div class="qe-agent-artifacts">
                                @foreach (var sketch in MessageSketches)
                                {
                                    <button type="button"
                                            class="qe-agent-artifact qe-agent-artifact--button"
                                            @onclick="@(() => OpenSketchPreview(sketch))">
                                        @if (!string.IsNullOrWhiteSpace(sketch.PreviewUrl))
                                        {
                                            <img class="qe-agent-artifact-thumb" src="@sketch.PreviewUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Draw" Size="Size.Small" />
                                        }
                                        <div>
                                            <strong>@sketch.FileName</strong>
                                            <small>@AttachmentStatusLabel(sketch)</small>
                                        </div>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                }
                <div class="qe-agent-artifacts">
                    @foreach (var artifact in _artifacts.Where(QuoteAgentUiHelpers.IsVisibleArtifact))
                    {
                        var isSelected = _selectedArtifact?.ArtifactId == artifact.ArtifactId;
                        var artifactSummary = ArtifactSummary(artifact);
                        <button type="button"
                                class="@($"qe-agent-artifact qe-agent-artifact--button {(isSelected ? "active" : string.Empty)} {UiFocusClass(ArtifactFocusKey(artifact), ArtifactTypeFocusKey(artifact.ArtifactType))}")"
                                @onclick="@(() => SelectArtifact(artifact))">
                            <MudIcon Icon="@ArtifactIcon(artifact.ArtifactType)" Size="Size.Small" />
                            <div>
                                <strong>@artifact.Title</strong>
                                <small>@ArtifactStatusLabel(artifact)</small>
                                @if (!string.IsNullOrWhiteSpace(artifactSummary))
                                {
                                    <small class="qe-agent-artifact-metadata">@artifactSummary</small>
                                }
                            </div>
                        </button>
                    }
                </div>
            }

            @if (_proposedActions.Count > 0)
            {
                <section class="qe-agent-actions">
                    <header>@Text("Confirm actions", "ยืนยันการทำงาน")</header>
                    @foreach (var action in _proposedActions)
                    {
                        <article class="qe-agent-action">
                            <strong>@action.Title</strong>
                            <p>@action.Summary</p>
                            @if (action.RequiresAuthentication && !IsSignedIn)
                            {
                                <button type="button" @onclick='@(() => OpenAuthDialog("sign-in"))'>@Text("Sign in", "เข้าสู่ระบบ")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="@(() => ConfirmActionAsync(action))">
                                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                    <span>@Text("Confirm", "ยืนยัน")</span>
                                </button>
                            }
                        </article>
                    }
                </section>
            }
            </aside>
    }

    @if (_previewDialogOpen && CurrentPreviewItem is not null)
    {
        var preview = CurrentPreviewItem;
        <div class="qe-agent-preview-modal" role="dialog" aria-modal="true" aria-label="@Text("File preview", "ดูตัวอย่างไฟล์")">
            <button type="button"
                    class="qe-agent-preview-backdrop"
                    aria-label="@Text("Close preview", "ปิดตัวอย่าง")"
                    @onclick="ClosePreviewDialog"></button>
            <section class="qe-agent-preview-dialog">
                <header>
                    <div>
                        <span>@preview.KindLabel</span>
                        <strong>@preview.Title</strong>
                        <small>@preview.Status</small>
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="ClosePreviewDialog" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <button type="button"
                        class="qe-agent-preview-nav qe-agent-preview-nav--prev"
                        @onclick="@(() => MovePreview(-1))"
                        disabled="@(PreviewItems.Count < 2)"
                        aria-label="@Text("Previous file", "ไฟล์ก่อนหน้า")">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Medium" />
                </button>
                <div class="qe-agent-preview-stage">
                    @if (IsImagePreview(preview))
                    {
                        <img src="@preview.Url" alt="@preview.Title" />
                    }
                    else if (IsPdfPreview(preview))
                    {
                        <iframe src="@preview.Url" title="@preview.Title"></iframe>
                    }
                    else
                    {
                        <div class="qe-agent-preview-fallback">
                            <MudIcon Icon="@preview.Icon" Size="Size.Large" />
                            <strong>@preview.Title</strong>
                            <p>@Text("This file is attached to the quote workspace. Preview support for this format will appear here when the artifact is ready.", "ไฟล์นี้แนบอยู่ในพื้นที่เสนอราคา ตัวอย่างสำหรับชนิดไฟล์นี้จะแสดงที่นี่เมื่อไฟล์งานพร้อม")</p>
                        </div>
                    }
                </div>
                <button type="button"
                        class="qe-agent-preview-nav qe-agent-preview-nav--next"
                        @onclick="@(() => MovePreview(1))"
                        disabled="@(PreviewItems.Count < 2)"
                        aria-label="@Text("Next file", "ไฟล์ถัดไป")">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Medium" />
                </button>
            </section>
        </div>
    }

    @if (_artifactNoteDialogOpen && ArtifactNoteDialogPart is not null)
    {
        var notePart = ArtifactNoteDialogPart;
        <div class="qe-agent-preview-modal" role="dialog" aria-modal="true" aria-labelledby="qe-agent-artifact-note-title">
            <button type="button"
                    class="qe-agent-preview-backdrop"
                    aria-label="@Text("Close artifact analysis editor", "ปิดตัวแก้ไขการวิเคราะห์ไฟล์")"
                    @onclick="CloseArtifactNoteDialog"></button>
            <section class="qe-agent-artifact-note-dialog">
                <header>
                    <div>
                        <span>@SupplementalArtifactLabel(notePart)</span>
                        <h2 id="qe-agent-artifact-note-title">@Text("Edit artifact analysis", "แก้ไขการวิเคราะห์ไฟล์")</h2>
                        <small>@notePart.FileName</small>
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="CloseArtifactNoteDialog" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <textarea class="qe-agent-artifact-note-input"
                          value="@_artifactNoteDraft"
                          @oninput="UpdateArtifactNoteDraft"
                          aria-label="@Text("Artifact analysis note", "หมายเหตุการวิเคราะห์ไฟล์")"></textarea>
                <footer>
                    <button type="button" class="qe-agent-artifact-note-secondary" @onclick="CloseArtifactNoteDialog">
                        @Text("Cancel", "ยกเลิก")
                    </button>
                    <button type="button" class="qe-agent-artifact-note-primary" @onclick="SaveArtifactNoteAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        <span>@Text("Save", "บันทึก")</span>
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_artifactPanelOpen || _summaryPanelOpen)
    {
        <button type="button"
                class="qe-agent-artifact-backdrop"
                aria-label="@Text("Close side panel", "ปิดแผงด้านข้าง")"
                @onclick="CloseSidePanels"></button>
    }

    @if (_commandPaletteOpen)
    {
        <div class="qe-agent-palette-modal" role="dialog" aria-modal="true" aria-label="@Text("Command palette", "แผงคำสั่ง")">
            <button type="button"
                    class="qe-agent-palette-backdrop"
                    aria-label="@Text("Close command palette", "ปิดแผงคำสั่ง")"
                    @onclick="CloseCommandPalette"></button>
            <section class="qe-agent-palette">
                <div class="qe-agent-palette-input">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <input @ref="_paletteInput"
                           value="@_paletteQuery"
                           @oninput="OnPaletteInput"
                           @onkeydown="OnPaletteKeyDown"
                           placeholder="@Text("Search projects or run a command", "ค้นหาโปรเจกต์หรือเรียกใช้คำสั่ง")"
                           aria-label="@Text("Search projects or run a command", "ค้นหาโปรเจกต์หรือเรียกใช้คำสั่ง")" />
                    <kbd>Esc</kbd>
                </div>
                <div class="qe-agent-palette-results">
                    @if (PaletteProjects.Any())
                    {
                        <span class="qe-agent-palette-section">@Text("Projects", "โปรเจกต์")</span>
                        @foreach (var project in PaletteProjects)
                        {
                            <a class="qe-agent-palette-row" href="@ProjectHref(project)" @onclick="CloseCommandPalette">
                                <MudIcon Icon="@(project.IsPinned ? Icons.Material.Outlined.PushPin : Icons.Material.Outlined.Folder)" Size="Size.Small" />
                                <span>@ProjectName(project)</span>
                                <small>@project.ProjectNumber</small>
                            </a>
                        }
                    }
                    <span class="qe-agent-palette-section">@Text("Commands", "คำสั่ง")</span>
                    @foreach (var command in PaletteCommands)
                    {
                        <button type="button" class="qe-agent-palette-row" @onclick="@(() => RunPaletteCommandAsync(command))">
                            <MudIcon Icon="@command.Icon" Size="Size.Small" />
                            <span>@Text(command.LabelEn, command.LabelTh)</span>
                        </button>
                    }
                    @if (!PaletteProjects.Any() && !PaletteCommands.Any())
                    {
                        <p class="qe-agent-palette-empty">@Text("No matching projects or commands.", "ไม่พบโปรเจกต์หรือคำสั่งที่ตรงกัน")</p>
                    }
                </div>
            </section>
        </div>
    }

    @if (_authDialogOpen && !IsSignedIn)
    {
        <div class="qe-agent-auth-modal" role="dialog" aria-modal="true" aria-labelledby="qe-agent-auth-title">
            <button type="button"
                    class="qe-agent-auth-modal-backdrop"
                    aria-label="@Text("Close sign in", "ปิดเข้าสู่ระบบ")"
                    @onclick="CloseAuthDialog"></button>
            <section class="qe-agent-auth-dialog">
                <header>
                    <div>
                        <span>@Text("MALIEV account", "บัญชี MALIEV")</span>
                        <h2 id="qe-agent-auth-title">@AuthDialogTitle</h2>
                    </div>
                    <button type="button" class="qe-agent-round-btn" @onclick="CloseAuthDialog" title="@Text("Close", "ปิด")">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>
                <p>@Text("Keep chatting while your project is private. One MALIEV account signs you in across Make Studio and maliev.com.", "แชทต่อได้ขณะโปรเจกต์ยังเป็นส่วนตัว บัญชี MALIEV เดียวใช้เข้าสู่ระบบได้ทั้ง Make Studio และ maliev.com")</p>

                <button type="button" class="qe-agent-auth-google" @onclick="ContinueWithGoogle">
                    <span class="qe-agent-auth-google-mark" aria-hidden="true">
                        <svg viewBox="0 0 18 18" focusable="false" role="img" aria-hidden="true">
                            <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.08-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.87 2.69-6.62z" />
                            <path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33C2.44 15.98 5.48 18 9 18z" />
                            <path fill="#FBBC05" d="M3.96 10.71A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.17.28-1.71V4.96H.96A8.96 8.96 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.33z" />
                            <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.33C4.67 5.16 6.66 3.58 9 3.58z" />
                        </svg>
                    </span>
                    <span>@Text("Continue with Google", "ดำเนินการต่อด้วย Google")</span>
                </button>
                <div class="qe-agent-auth-divider" role="separator">@Text("or", "หรือ")</div>
                <form class="qe-agent-auth-form" @onsubmit="ContinueWithEmailAsync" @onsubmit:preventDefault>
                    @if (IsAuthDialogSignUp)
                    {
                        <label>
                            <span>@Text("Full name", "ชื่อ-นามสกุล")</span>
                            <input type="text"
                                   autocomplete="name"
                                   placeholder="@Text("Your name", "ชื่อของคุณ")"
                                   @bind="_authFullName"
                                   @bind:event="oninput" />
                        </label>
                    }
                    <label>
                        <span>@Text("Email address", "อีเมล")</span>
                        <input type="email"
                               autocomplete="email"
                               inputmode="email"
                               placeholder="name@company.com"
                               @bind="_authEmail"
                               @bind:event="oninput" />
                    </label>
                    <label>
                        <span>@Text("Password", "รหัสผ่าน")</span>
                        <input type="password"
                               autocomplete="@(IsAuthDialogSignUp ? "new-password" : "current-password")"
                               placeholder="@Text("Your password", "รหัสผ่านของคุณ")"
                               @bind="_authPassword"
                               @bind:event="oninput" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(_authDialogError))
                    {
                        <p class="qe-agent-auth-error" role="alert">@_authDialogError</p>
                    }
                    <button type="submit" disabled="@(!AuthEmailLooksValid || string.IsNullOrWhiteSpace(_authPassword) || _authSubmitting)">
                        @(IsAuthDialogSignUp
                            ? Text("Create account", "สร้างบัญชี")
                            : Text("Continue with email", "ดำเนินการต่อด้วยอีเมล"))
                    </button>
                </form>
                <button type="button" class="qe-agent-auth-switch" @onclick="ToggleAuthDialogMode">
                    @AuthDialogSwitchLabel
                </button>
            </section>
        </div>
    }

    @if (_driveConnectorModalOpen)
    {
        <div class="qe-agent-connector-modal" role="dialog" aria-modal="true" aria-labelledby="qe-agent-connector-title">
            <button type="button"
                    class="qe-agent-connector-modal-backdrop"
                    aria-label="@Text("Close", "ปิด")"
                    @onclick="CloseDriveConnectorModal"></button>
            <section class="qe-agent-connector-dialog">
                <header>
