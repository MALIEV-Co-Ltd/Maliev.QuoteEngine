    {
        return rating <= viewer.FeedbackRating
            ? "qe-inline-viewer-rating-button is-selected"
            : "qe-inline-viewer-rating-button";
    }

    private static void SetInlineViewerRating(InlineViewerInfo viewer, int rating)
    {
        viewer.FeedbackRating = Math.Clamp(rating, 1, 5);
        viewer.FeedbackStatus = string.Empty;
    }

    private static bool CanSubmitInlineViewerFeedback(InlineViewerInfo viewer)
    {
        return !viewer.IsFeedbackSubmitting &&
            viewer.ArtifactId != Guid.Empty &&
            viewer.FeedbackRating is >= 1 and <= 5;
    }

    private async Task SubmitInlineViewerFeedbackAsync(AgentMessageRow message)
    {
        var viewer = message.InlineViewer;
        if (viewer is null || !CanSubmitInlineViewerFeedback(viewer))
        {
            return;
        }

        viewer.IsFeedbackSubmitting = true;
        viewer.FeedbackStatus = Text("Sending feedback…", "กำลังส่งความคิดเห็น...");
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"/quote/v1/agent/sessions/{SessionId:D}/artifacts/{viewer.ArtifactId:D}/feedback",
                new QuoteAgentPreviewFeedbackRequest
                {
                    Rating = viewer.FeedbackRating,
                    Comment = viewer.FeedbackComment.Trim()
                });

            if (!response.IsSuccessStatusCode)
            {
                viewer.FeedbackStatus = Text("Feedback could not be saved.", "ไม่สามารถบันทึกความคิดเห็นได้");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<QuoteAgentPreviewFeedbackResponse>();
            if (result?.State is not null)
            {
                _artifacts = result.State.Artifacts;
                _gates = result.State.Gates;
                _proposedActions = result.State.ProposedActions;
            }

            viewer.FeedbackComment = viewer.FeedbackComment.Trim();
            viewer.FeedbackStatus = result?.MemoryObserved == true
                ? Text("Feedback recorded for future drafts", "บันทึกความคิดเห็นสำหรับแบบร่างถัดไปแล้ว")
                : Text("Feedback recorded", "บันทึกความคิดเห็นแล้ว");
        }
        catch
        {
            viewer.FeedbackStatus = Text("Feedback could not be saved.", "ไม่สามารถบันทึกความคิดเห็นได้");
        }
        finally
        {
            viewer.IsFeedbackSubmitting = false;
        }
    }

