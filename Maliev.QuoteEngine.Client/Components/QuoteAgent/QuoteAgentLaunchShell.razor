    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsSignedIn { get; set; }

    [Parameter]
    public bool IsDemoMode { get; set; }

    [Parameter]
    public bool ShowLaunchAccountCard { get; set; }

    [Parameter]
    public IReadOnlyList<QuotePartViewModel> UploadedParts { get; set; } = [];

    [Parameter]
    public int SelectedPartIndex { get; set; }

    [Parameter]
    public string Culture { get; set; } = SupportedCultures.DefaultCulture;

    [Parameter]
    public EventCallback OnUploadRequested { get; set; }

    [Parameter]
    public EventCallback<int> OnUploadedPartSelected { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeIcon => IsDarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode;
    private string ShellClass => $"qe-agent-shell{(_railCollapsed ? " qe-agent-shell--rail-collapsed" : string.Empty)}{(RightPanelOpen ? " qe-agent-shell--artifacts-open" : string.Empty)}";
    private string MainClass => _messages.Count == 0 ? "qe-agent-main qe-agent-main--empty" : "qe-agent-main qe-agent-main--chat";
    private string ComposerClass
    {
        get
        {
            var classes = new List<string> { "qe-agent-composer" };
            if (_sending)
            {
                classes.Add("is-sending");
            }

            if (_pendingComposerAttachments.Count > 0)
            {
                classes.Add("qe-agent-composer--has-attachments");
            }

            return string.Join(" ", classes);
        }
    }

    private bool RightPanelOpen => _artifactPanelOpen || _summaryPanelOpen;
    private int ArtifactCount => _artifacts.Count + UploadedParts.Count;
    private QuotePartViewModel SelectedUploadedPart => UploadedParts[Math.Clamp(SelectedPartIndex, 0, Math.Max(UploadedParts.Count - 1, 0))];
    private IReadOnlyList<PreviewItem> PreviewItems => BuildPreviewItems();
    private PreviewItem? CurrentPreviewItem => PreviewItems.Count == 0
        ? null
        : PreviewItems[Math.Clamp(_previewIndex, 0, PreviewItems.Count - 1)];
    private AgentWorkbenchSnapshot? LatestWorkbench => _messages.LastOrDefault(message => message.Workbench is not null)?.Workbench;
    private string ProjectSummaryTitle => string.IsNullOrWhiteSpace(_projectName)
        ? Text("Untitled project", "โปรเจกต์ยังไม่มีชื่อ")
        : _projectName;
    private string ProjectSummaryStatus => _sending
        ? Text("The agent is analyzing the latest request.", "เอเจนต์กำลังวิเคราะห์คำขอล่าสุด")
        : _error is not null
            ? Text("Agent connection needs attention.", "การเชื่อมต่อเอเจนต์ต้องตรวจสอบ")
            : Text("Ready for the next manufacturing decision.", "พร้อมสำหรับการตัดสินใจผลิตขั้นถัดไป");
    private IReadOnlyList<SummaryMetric> ProjectSummaryMetrics =>
    [
        new(Text("Files", "ไฟล์"), UploadedParts.Count.ToString(CultureInfo.InvariantCulture)),
        new(Text("Artifacts", "ไฟล์งาน"), ArtifactCount.ToString(CultureInfo.InvariantCulture)),
        new(Text("Estimate", "ราคา"), LatestWorkbench?.TotalPrice ?? Text("Not priced", "ยังไม่มีราคา")),
        new(Text("Progress", "ความคืบหน้า"), SummaryProgressLabel)
    ];
    private IReadOnlyList<SummaryMetric> ProjectSummaryDetails =>
    [
        new(Text("Material", "วัสดุ"), LatestWorkbench?.Material ?? Text("Not selected", "ยังไม่ได้เลือก")),
        new(Text("Quantity", "จำนวน"), LatestWorkbench?.Quantity ?? Text("Not selected", "ยังไม่ได้เลือก")),
        new(Text("Lead time", "เวลานำส่ง"), SummaryLeadTime),
        new(Text("DFM", "DFM"), SummaryDfmState)
    ];
    private string SummaryProgressLabel => _gates.Count == 0
        ? Text("Not started", "ยังไม่เริ่ม")
        : FormattableString.Invariant($"{_gates.Count(gate => gate.Status.Equals("passed", StringComparison.OrdinalIgnoreCase))}/{_gates.Count}");
    private string SummaryLeadTime => LatestWorkbench?.OrderLines.FirstOrDefault(line => line.Label.Contains("Lead", StringComparison.OrdinalIgnoreCase))?.Value
        ?? Text("Not selected", "ยังไม่ได้เลือก");
    private string SummaryDfmState => LatestWorkbench?.DfmIssues.Count > 0
        ? Text($"{LatestWorkbench.DfmIssues.Count} item(s) to review", $"ต้องตรวจสอบ {LatestWorkbench.DfmIssues.Count} รายการ")
