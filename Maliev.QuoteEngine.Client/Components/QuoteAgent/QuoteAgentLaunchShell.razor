    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsSignedIn { get; set; }

    [Parameter]
    public bool IsDemoMode { get; set; }

    [Parameter]
    public bool ShowLaunchAccountCard { get; set; }

    [Parameter]
    public IReadOnlyList<QuotePartViewModel> UploadedParts { get; set; } = [];

    [Parameter]
    public int SelectedPartIndex { get; set; }

    [Parameter]
    public string Culture { get; set; } = SupportedCultures.DefaultCulture;

    [Parameter]
    public EventCallback OnUploadRequested { get; set; }

    [Parameter]
    public EventCallback<int> OnUploadedPartSelected { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeIcon => IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ShellClass => $"qe-agent-shell{(_railCollapsed ? " qe-agent-shell--rail-collapsed" : string.Empty)}{(_artifactPanelOpen ? " qe-agent-shell--artifacts-open" : string.Empty)}";
    private string MainClass => _messages.Count == 0 ? "qe-agent-main qe-agent-main--empty" : "qe-agent-main qe-agent-main--chat";
    private int ArtifactCount => _artifacts.Count + UploadedParts.Count;
    private IReadOnlyList<UseCaseOption> VisibleUseCases => _visibleUseCases.Count == 0 ? SampleUseCases.Take(3).ToArray() : _visibleUseCases;
    private string AgentStatusClass => _error is not null
        ? "qe-agent-status is-failed"
        : _sending || _searchLoading
            ? "qe-agent-status is-warning"
            : "qe-agent-status is-connected";
    private string AgentStatusTooltip => _error is not null
        ? Text("Agent connection failed. Try again or refresh Make Studio.", "เชื่อมต่อเอเจนต์ไม่สำเร็จ กรุณาลองใหม่หรือรีเฟรช Make Studio")
        : _sending || _searchLoading
            ? Text("Agent is working or reconnecting.", "เอเจนต์กำลังทำงานหรือเชื่อมต่อใหม่")
            : Text("Agent connected and ready.", "เอเจนต์เชื่อมต่อและพร้อมใช้งาน");
    private IEnumerable<ProjectNavItem> PinnedProjects => _projects.Where(project => project.IsPinned && !project.IsArchived);
    private IEnumerable<ProjectNavItem> RegularProjects => _projects.Where(project => !project.IsPinned && !project.IsArchived);
    private IEnumerable<SearchNavItem> SearchResults => BuildSearchResults();

    protected override void OnInitialized()
    {
        _visibleUseCases = SampleUseCases
            .OrderBy(_ => Random.Shared.Next())
            .Take(3)
            .ToArray();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsSignedIn)
        {
            if (!_projectNavigationLoaded)
            {
                await LoadProjectNavigationAsync();
            }
        }
        else
        {
            _projects.Clear();
            _customerSearchResults.Clear();
            _customerSearchUnavailable = true;
            _projectNavigationLoaded = false;
        }

        if (SessionId == Guid.Empty || SessionId == _loadedSessionId)
        {
            return;
        }

        _loadedSessionId = SessionId;
        await LoadStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _composerDotNetRef = DotNetObjectReference.Create(this);
            _composerModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-composer.js");
            await _composerModule.InvokeVoidAsync("initComposer", _composerTextarea, _composerDotNetRef);
            await _composerModule.InvokeVoidAsync("focusComposer", _composerTextarea);
        }

        if (!_sketchInitPending)
        {
            if (_focusSearchPending && _searchOpen)
            {
                _focusSearchPending = false;
                await _searchInput.FocusAsync();
            }

            return;
        }

        _sketchInitPending = false;
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("initSketchCanvas", SketchCanvasId);
        await _sketchModule.InvokeVoidAsync("setSketchBrushColor", SketchCanvasId, _sketchColor);

        if (_focusSearchPending && _searchOpen)
        {
            _focusSearchPending = false;
            await _searchInput.FocusAsync();
        }
    }

    private async Task LoadStateAsync()
    {
        try
        {
            var state = await Api.GetAgentStateAsync(SessionId);
            ApplyState(state);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadProjectNavigationAsync()
    {
        try
        {
            var projects = await Api.GetProjectNavigationAsync();
            _projects.Clear();
            _projects.AddRange(projects.Select(ProjectNavItem.FromDto));
            _projectNavigationLoaded = true;
        }
        catch (QuoteEngineApiException ex)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            if (ex.StatusCode != System.Net.HttpStatusCode.Unauthorized)
            {
                _error = ex.UserMessage;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _projects.Clear();
            _projectNavigationLoaded = false;
            _error = ex.Message;
        }
    }

    [JSInvokable]
    public Task SubmitComposerFromKeyboardAsync()
    {
        return HandleSubmitAsync();
    }

    private async Task HandleSubmitAsync()
    {
        var message = _draftMessage.Trim();
        if (string.IsNullOrWhiteSpace(message) || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        _composerMenuOpen = false;
        _draftMessage = string.Empty;
        EnsureLocalProjectFromMessage(message);
        _messages.Add(new AgentMessageRow("user", message));
        var assistantMessage = new AgentMessageRow("assistant", string.Empty);
        _messages.Add(assistantMessage);

        try
        {
            await foreach (var streamEvent in Api.SendAgentMessageStreamAsync(new QuoteAgentMessageRequest
            {
                SessionId = SessionId,
                Message = message,
                Language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en"
            }))
            {
                if (streamEvent.Type.Equals("delta", StringComparison.OrdinalIgnoreCase))
                {
                    assistantMessage.Content += streamEvent.Delta;
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("final", StringComparison.OrdinalIgnoreCase) &&
                         streamEvent.Response is not null)
                {
                    assistantMessage.Content = streamEvent.Response.AssistantText;
                    assistantMessage.ThinkingSteps = streamEvent.Response.ThinkingSteps;
                    _gates = streamEvent.Response.Gates;
                    _artifacts = streamEvent.Response.Artifacts;
                    _proposedActions = streamEvent.Response.ProposedActions;
                    await InvokeAsync(StateHasChanged);
                }
                else if (streamEvent.Type.Equals("error", StringComparison.OrdinalIgnoreCase))
                {
                    _error = string.IsNullOrWhiteSpace(streamEvent.Error)
                        ? Text("The agent could not complete this response.", "ผู้ช่วยไม่สามารถตอบกลับได้สำเร็จ")
                        : streamEvent.Error;
                    _messages.Remove(assistantMessage);
                }
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
            _messages.Remove(assistantMessage);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _messages.Remove(assistantMessage);
            if (TryBuildLocalDemoTurn(message, out var demoTurn))
            {
                AddLocalDemoTurn(demoTurn);
            }
            else
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _sending = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

