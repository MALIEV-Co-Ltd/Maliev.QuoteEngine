    private void MovePreview(int direction)
    {
        var items = PreviewItems;
        if (items.Count == 0)
        {
            _previewDialogOpen = false;
            return;
        }

        _previewIndex = (_previewIndex + direction + items.Count) % items.Count;
    }

    private IReadOnlyList<PreviewItem> BuildPreviewItems()
    {
        var items = new List<PreviewItem>();
        for (var i = 0; i < UploadedParts.Count; i++)
        {
            var part = UploadedParts[i];
            items.Add(BuildUploadedPreviewItem(i, part));
        }

        foreach (var artifact in _artifacts.Where(QuoteAgentUiHelpers.IsVisibleArtifact))
        {
            var preview = BuildArtifactPreviewItem(artifact);
            if (preview is null)
            {
                continue;
            }

            items.Add(preview);
        }

        foreach (var sketch in MessageSketches)
        {
            items.Add(new PreviewItem(
                "sketch",
                -1,
                sketch.FileName,
                sketch.Status,
                sketch.PreviewUrl ?? string.Empty,
                Text("Sketch", "สเก็ตช์"),
                Icons.Material.Outlined.Draw,
                sketch.ContentType));
        }

        return items;
    }

