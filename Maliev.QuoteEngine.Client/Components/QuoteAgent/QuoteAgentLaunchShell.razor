    private void ApplySketchImageTitle(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        var cleaned = Regex.Replace(name, "[^\\p{L}\\p{N}\\s_-]+", " ").Trim();
        if (string.IsNullOrWhiteSpace(cleaned))
        {
