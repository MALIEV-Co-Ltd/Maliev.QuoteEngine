        StopDictationTimer();
        await InvokeAsync(StateHasChanged);
        await ApplyDictatedTextAsync(speechText);
    }

    private async Task ApplyDictatedTextAsync(string? speechToClean = null)
    {
        var rawText = speechToClean ?? _draftMessage;
        var fullText = _draftMessage;
        try
        {
            if (!string.IsNullOrWhiteSpace(rawText))
            {
                var language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en";
                var cleaned = (await Api.CleanSpeechAsync(rawText, language) ?? string.Empty).Trim();
                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    fullText = _dictationBefore + cleaned + _dictationAfter;
                }
            }
        }
        catch
        {
            fullText = _dictationBefore + rawText + _dictationAfter;
        }
        finally
        {
            _draftMessage = fullText;
            _dictationProcessing = false;
            if (_composerModule is not null)
            {
                await _composerModule.InvokeVoidAsync("setComposerText", _composerTextarea, fullText);
            }
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private string DictationErrorMessage(string? code)
    {
        return (code ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "not-allowed" or "service-not-allowed" or "notallowederror" or "securityerror" => Text(
                "Microphone access is blocked. Allow microphone permission for this site in your browser, then try dictation again.",
                "ไมโครโฟนถูกบล็อก โปรดอนุญาตให้เว็บไซต์นี้ใช้ไมโครโฟนในเบราว์เซอร์ แล้วลองพูดอีกครั้ง"),
            "audio-capture" or "notfounderror" or "notreadableerror" => Text(
                "No microphone was detected. Connect a microphone, make sure it is not muted, then try again.",
                "ไม่พบไมโครโฟน โปรดเชื่อมต่อไมโครโฟนและตรวจสอบว่าไม่ได้ปิดเสียง แล้วลองอีกครั้ง"),
            "network" => Text(
                "The speech service is unreachable. Check your internet connection, then try dictation again.",
                "เชื่อมต่อบริการแปลงเสียงไม่ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วลองอีกครั้ง"),
            _ => Text(
                "Dictation stopped unexpectedly. Please try again.",
                "การพูดตามคำบอกหยุดทำงานกะทันหัน โปรดลองอีกครั้ง"),
        };
    }

    private void StartDictationTimer()
    {
        StopDictationTimer();
        _dictationTimeLabel = "0:00";
        var startTime = DateTime.UtcNow;
        _dictationTimerCts = new CancellationTokenSource();
        var token = _dictationTimerCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                var elapsed = DateTime.UtcNow - startTime;
                var label = elapsed.TotalMinutes >= 1
                    ? $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}"
                    : $"0:{elapsed.Seconds:D2}";
                _dictationTimeLabel = label;
                await InvokeAsync(StateHasChanged);
                try
                {
                    await Task.Delay(1000, token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        });
    }

    private void StopDictationTimer()
    {
        _dictationTimerCts?.Cancel();
        _dictationTimerCts?.Dispose();
        _dictationTimerCts = null;
        _dictationTimeLabel = string.Empty;
    }

    private async Task BeginDictationAsync()
    {
        if (_composerModule is null || _dictating)
        {
            await FocusComposerAsync();
            return;
        }

        _dictating = true;
        _dictationProcessing = false;
        _quickActionsMenuOpen = false;
        _error = null;
        try
        {
            await _composerModule.InvokeVoidAsync("beginDictation", _composerTextarea, _dictationButton);
        }
        catch (JSException ex)
        {
            var friendly = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
            _error = Text(
                friendly,
                friendly);
            _dictating = false;
            _dictationProcessing = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private async Task EndDictationAsync()
    {
        if (_composerModule is null || !_dictating)
        {
            await FocusComposerAsync();
            return;
        }

        try
        {
            _dictationProcessing = true;
            await InvokeAsync(StateHasChanged);
            var dictatedText = await _composerModule.InvokeAsync<string>("endDictation", _composerTextarea);
            _draftMessage = dictatedText;
        }
        catch (JSException ex)
        {
            _error = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
        }
        finally
        {
            _dictating = false;
            _dictationProcessing = false;
            StopDictationTimer();
            if (_composerModule is not null)
            {
                try { await _composerModule.InvokeVoidAsync("setComposerText", _composerTextarea, _draftMessage); } catch { }
            }
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private async Task ConfirmActionAsync(QuoteAgentProposedActionDto action)
    {
        try
        {
            var previousArtifactCount = _artifacts.Count;
            var result = await Api.ConfirmAgentActionAsync(action.ActionId, new QuoteAgentConfirmActionRequest());
            _messages.Add(new AgentMessageRow("assistant", result.Message));
            if (result.State is not null)
            {
                await ApplyStateAsync(result.State);
                if (result.State.UiDirectives.Count == 0 && result.State.Artifacts.Count > previousArtifactCount)
                {
                    _artifactPanelOpen = true;
                    _summaryPanelOpen = false;
