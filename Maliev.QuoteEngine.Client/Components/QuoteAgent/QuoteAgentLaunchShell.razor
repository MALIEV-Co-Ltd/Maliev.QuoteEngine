        var extension = Path.GetExtension(part.FileName).TrimStart('.');
        if (QuoteUploadConstraints.SupplementalImageExtensions.Any(item =>
                item.Equals(extension, StringComparison.OrdinalIgnoreCase)))
        {
            return Text(
                "I can read this for dimensions, notes, material clues, and manufacturing intent. A CAD/3D file is still required before DFM, 3D viewer, pricing, or order completion.",
                "ฉันอ่านภาพนี้เพื่อดูขนาด หมายเหตุ วัสดุ และความต้องการผลิตได้ แต่ยังต้องมีไฟล์ CAD/3D ก่อนตรวจ DFM แสดง 3D คำนวณราคา หรือสั่งผลิต");
        }

        if (QuoteUploadConstraints.SupplementalDocumentExtensions.Any(item =>
                item.Equals(extension, StringComparison.OrdinalIgnoreCase)))
        {
            return Text(
                "I can use this as drawing context for requirements and tolerances. Geometry-driven DFM, viewer, pricing, and order gates still need a CAD/3D file.",
                "ฉันใช้ไฟล์นี้เป็นข้อมูลแบบสำหรับข้อกำหนดและ tolerance ได้ แต่ DFM แบบใช้เรขาคณิต ตัวแสดง 3D ราคา และขั้นตอนสั่งผลิตยังต้องมีไฟล์ CAD/3D");
        }

        return Text(
            "I will keep this with the project as supporting manufacturing context until usable CAD/3D geometry is available.",
            "ฉันจะเก็บไฟล์นี้ไว้เป็นข้อมูลประกอบการผลิตจนกว่าจะมีไฟล์ CAD/3D ที่ใช้ได้");
