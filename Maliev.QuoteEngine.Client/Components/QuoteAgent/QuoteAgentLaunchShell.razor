    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopReasoningTimer();

        if (_agentHealthCts is not null)
        {
            await _agentHealthCts.CancelAsync();
            _agentHealthCts.Dispose();
        }

        if (_searchPromptAnimationCts is not null)
        {
            await _searchPromptAnimationCts.CancelAsync();
            _searchPromptAnimationCts.Dispose();
        }

        if (_notificationConnection is not null)
        {
            if (_joinedQuoteSessionId.HasValue &&
                _notificationConnection.State == HubConnectionState.Connected)
            {
                await _notificationConnection.InvokeAsync("LeaveQuoteSessionGroup", _joinedQuoteSessionId.Value);
            }

            await _notificationConnection.DisposeAsync();
        }

        if (_composerModule is not null)
        {
            await _composerModule.InvokeVoidAsync("disposeComposer", _composerTextarea);
            await _composerModule.DisposeAsync();
        }

        _composerDotNetRef?.Dispose();

        if (_sketchModule is not null)
        {
            if (_sketchOpen)
            {
                await _sketchModule.InvokeVoidAsync("disposeSketchCanvas", SketchCanvasId);
            }

            await _sketchModule.DisposeAsync();
        }
    }

