        }
    }

    private async Task ContinueWithGoogle()
    {
        var authPath = "/auth/sign-in?returnUrl=%2Fauth%2Fchatbot-complete";
        var opened = await Js.InvokeAsync<bool>("malievChatbot.openSignInPopup", authPath);
        if (!opened)
        {
            NavigateToMalievAccount();
            return;
        }
        await _composerModule!.InvokeVoidAsync("listenForAuthComplete", _composerDotNetRef);
    }

