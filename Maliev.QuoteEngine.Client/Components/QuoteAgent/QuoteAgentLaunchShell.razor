    {
        _dictationNotice = null;
    }

    [JSInvokable]
    public async Task DictationStartedAsync()
    {
        _dictating = true;
        _dictationProcessing = false;
        _quickActionsMenuOpen = false;
        _error = null;
        _dictationNotice = null;
        StartDictationTimer();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task BeginDictationProcessingAsync()
    {
        _dictating = false;
        _dictationProcessing = true;
        _quickActionsMenuOpen = false;
        StopDictationTimer();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CompleteDictationAsync(string? before, string? speech, string? after)
    {
        _dictationBefore = before ?? string.Empty;
        _dictationAfter = after ?? string.Empty;
        var speechText = speech ?? string.Empty;
        _draftMessage = _dictationBefore + speechText + _dictationAfter;
        _dictating = false;
        StopDictationTimer();
        await InvokeAsync(StateHasChanged);
        await ApplyDictatedTextAsync(speechText);
    }

    private async Task ApplyDictatedTextAsync(string? speechToClean = null)
    {
        var rawText = speechToClean ?? _draftMessage;
        var fullText = _draftMessage;
        try
        {
            if (!string.IsNullOrWhiteSpace(rawText))
            {
                var language = SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? "th" : "en";
                var cleaned = (await Api.CleanSpeechAsync(rawText, language) ?? string.Empty).Trim();
                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    fullText = _dictationBefore + cleaned + _dictationAfter;
                }
            }
        }
        catch
        {
            fullText = _dictationBefore + rawText + _dictationAfter;
        }
        finally
        {
            _draftMessage = fullText;
            _dictationProcessing = false;
            if (_composerModule is not null)
            {
                await _composerModule.InvokeVoidAsync("setComposerText", _composerTextarea, fullText);
            }
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private string DictationErrorMessage(string? code)
    {
        return (code ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "not-allowed" or "service-not-allowed" or "notallowederror" or "securityerror" => Text(
                "Microphone access is blocked. Allow microphone permission for this site in your browser, then try dictation again.",
                "ไมโครโฟนถูกบล็อก โปรดอนุญาตให้เว็บไซต์นี้ใช้ไมโครโฟนในเบราว์เซอร์ แล้วลองพูดอีกครั้ง"),
            "audio-capture" or "notfounderror" or "notreadableerror" => Text(
                "No microphone was detected. Connect a microphone, make sure it is not muted, then try again.",
                "ไม่พบไมโครโฟน โปรดเชื่อมต่อไมโครโฟนและตรวจสอบว่าไม่ได้ปิดเสียง แล้วลองอีกครั้ง"),
            "network" => Text(
                "The speech service is unreachable. Check your internet connection, then try dictation again.",
                "เชื่อมต่อบริการแปลงเสียงไม่ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วลองอีกครั้ง"),
            _ => Text(
                "Dictation stopped unexpectedly. Please try again.",
                "การพูดตามคำบอกหยุดทำงานกะทันหัน โปรดลองอีกครั้ง"),
        };
    }

    private void StartDictationTimer()
    {
        StopDictationTimer();
        _dictationTimeLabel = "0:00";
        var startTime = DateTime.UtcNow;
        _dictationTimerCts = new CancellationTokenSource();
        var token = _dictationTimerCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                var elapsed = DateTime.UtcNow - startTime;
                var label = elapsed.TotalMinutes >= 1
                    ? $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}"
                    : $"0:{elapsed.Seconds:D2}";
                _dictationTimeLabel = label;
                await InvokeAsync(StateHasChanged);
                try
                {
                    await Task.Delay(1000, token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        });
    }

    private void StopDictationTimer()
    {
        _dictationTimerCts?.Cancel();
        _dictationTimerCts?.Dispose();
        _dictationTimerCts = null;
        _dictationTimeLabel = string.Empty;
    }

    private async Task BeginDictationAsync()
    {
        if (_composerModule is null || _dictating)
        {
            await FocusComposerAsync();
            return;
        }

        _dictating = true;
        _dictationProcessing = false;
        _quickActionsMenuOpen = false;
        _error = null;
        try
        {
            await _composerModule.InvokeVoidAsync("beginDictation", _composerTextarea, _dictationButton);
        }
        catch (JSException ex)
        {
            var friendly = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
            _error = Text(
                friendly,
                friendly);
            _dictating = false;
            _dictationProcessing = false;
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private async Task EndDictationAsync()
    {
        if (_composerModule is null || !_dictating)
        {
            await FocusComposerAsync();
            return;
        }

        try
        {
            _dictationProcessing = true;
            await InvokeAsync(StateHasChanged);
            var dictatedText = await _composerModule.InvokeAsync<string>("endDictation", _composerTextarea);
            _draftMessage = dictatedText;
        }
        catch (JSException ex)
        {
            _error = Text(
                $"Dictation is not available yet: {ex.Message}",
                $"ยังไม่สามารถใช้การพูดตามคำบอกได้: {ex.Message}");
        }
        finally
        {
            _dictating = false;
            _dictationProcessing = false;
            StopDictationTimer();
            if (_composerModule is not null)
            {
                try { await _composerModule.InvokeVoidAsync("setComposerText", _composerTextarea, _draftMessage); } catch { }
            }
            await InvokeAsync(StateHasChanged);
            await FocusComposerAsync();
        }
    }

    private async Task ConfirmActionAsync(QuoteAgentProposedActionDto action)
    {
        try
        {
            var previousArtifactCount = _artifacts.Count(QuoteAgentUiHelpers.IsVisibleArtifact);
            var result = await Api.ConfirmAgentActionAsync(action.ActionId, new QuoteAgentConfirmActionRequest());
            _messages.Add(new AgentMessageRow("assistant", result.Message));
            if (result.State is not null)
            {
                await ApplyStateAsync(result.State);
                if (result.State.UiDirectives.Count == 0 &&
                    result.State.Artifacts.Count(QuoteAgentUiHelpers.IsVisibleArtifact) > previousArtifactCount)
                {
                    _artifactPanelOpen = true;
                    _summaryPanelOpen = false;
                }
            }
        }
        catch (QuoteEngineApiException ex)
        {
            _error = ex.UserMessage;
        }
    }

    public async Task ApplyAgentStateAsync(QuoteAgentStateResponse state)
    {
        // This entry point is driven by file upload/attach registration. We refresh
        // artifacts and highlights but do NOT auto-open the workbench panel — the
        // customer asked to keep the workbench closed until they choose to open it.
        await ApplyStateAsync(state, suppressPanelAutoOpen: true);
        StateHasChanged();
    }

    private async Task ApplyStateAsync(QuoteAgentStateResponse state, bool suppressPanelAutoOpen = false)
    {
        _gates = state.Gates;
        _artifacts = state.Artifacts;
        SyncSelectedArtifactWithArtifacts();
        _proposedActions = state.ProposedActions;
        _stateWorkbench = BuildRestoredWorkbench(state);
        await ApplyAgentProjectNameAsync(state.ProjectName);
        await ApplyUiDirectivesAsync(state.UiDirectives, suppressPanelAutoOpen);
        if (!suppressPanelAutoOpen && HasVisiblePaymentArtifact())
        {
            _artifactPanelOpen = true;
            _summaryPanelOpen = false;
        }
    }

    private bool HasVisiblePaymentArtifact()
    {
        return _artifacts.Any(artifact =>
            QuoteAgentUiHelpers.IsVisibleArtifact(artifact) &&
            artifact.ArtifactType.Equals("payment", StringComparison.OrdinalIgnoreCase));
    }

    private AgentWorkbenchSnapshot? BuildRestoredWorkbench(QuoteAgentStateResponse state)
    {
        if (state.Parts.Count == 0 && state.Estimate is null && state.Artifacts.Count == 0)
        {
            return null;
        }

        var primaryPart = state.Parts.FirstOrDefault();
        var dfmIssues = state.Parts
            .SelectMany(part => part.Findings.Select(finding => new AgentDfmIssue(
                NormalizeDfmSeverity(finding.Severity),
                string.IsNullOrWhiteSpace(finding.Code) ? "DFM review item" : finding.Code,
                string.IsNullOrWhiteSpace(finding.Severity) ? "REVIEW" : finding.Severity.ToUpperInvariant(),
                finding.Message,
                part.DfmAcknowledged ? Text("Acknowledged", "รับทราบแล้ว") : null)))
            .ToList();

        var requirements = new List<AgentRequirement>();
        if (primaryPart is not null)
        {
            requirements.Add(new AgentRequirement(Text("Part", "ชิ้นงาน"), primaryPart.FileName, "state", "state"));
            requirements.Add(new AgentRequirement(Text("Process", "กระบวนการ"), primaryPart.ProcessId, "state", "state"));
            requirements.Add(new AgentRequirement(Text("Material", "วัสดุ"), primaryPart.MaterialId, "state", "state"));
            requirements.Add(new AgentRequirement(Text("Quantity", "จำนวน"), primaryPart.Quantity.ToString(CultureInfo.InvariantCulture), "state", "state"));
        }

        var priceLines = state.Estimate?.Lines
            .Select(line => new AgentPriceLine(line.FileName, FormatMoney(line.LineTotal, line.Currency)))
            .ToList() ?? [];

        var totalPrice = state.Estimate is null
            ? Text("Not priced", "ยังไม่มีราคา")
            : FormatMoney(state.Estimate.Total, state.Estimate.Currency);

        var unitPrice = state.Estimate?.Lines.Count > 0
            ? FormatMoney(state.Estimate.Lines[0].UnitPrice, state.Estimate.Lines[0].Currency)
            : Text("Unit price pending", "รอราคาต่อหน่วย");

        var orderLines = new List<AgentOrderLine>();
        if (primaryPart is not null)
        {
            orderLines.Add(new AgentOrderLine(Text("Part", "ชิ้นงาน"), primaryPart.FileName));
            orderLines.Add(new AgentOrderLine(Text("Quantity", "จำนวน"), primaryPart.Quantity.ToString(CultureInfo.InvariantCulture)));
        }

        if (state.Estimate is not null)
        {
            orderLines.Add(new AgentOrderLine(Text("Estimate", "ราคา"), totalPrice));
        }

        return new AgentWorkbenchSnapshot(
            BuildRestoredAnalysisSummary(state),
            BuildRestoredAnalysisProgress(state),
            primaryPart?.ProcessId ?? Text("Not selected", "ยังไม่ได้เลือก"),
            primaryPart?.FileName ?? Text("No uploaded part", "ยังไม่มีชิ้นงาน"),
            primaryPart?.MaterialId ?? Text("Not selected", "ยังไม่ได้เลือก"),
            primaryPart?.Quantity.ToString(CultureInfo.InvariantCulture) ?? Text("Not selected", "ยังไม่ได้เลือก"),
            BuildRestoredAnalysisSteps(state),
            requirements,
            dfmIssues,
            state.Parts.Any(part => !string.IsNullOrWhiteSpace(part.ViewerGlbUrl) || !string.IsNullOrWhiteSpace(part.ViewerStoragePath)),
            [],
            totalPrice,
            unitPrice,
            state.Estimate is null ? Text("Estimate pending", "รอการคำนวณราคา") : state.Estimate.Currency,
            [],
            priceLines,
            orderLines);
    }

    private IReadOnlyList<AgentAnalysisStep> BuildRestoredAnalysisSteps(QuoteAgentStateResponse state)
    {
        var steps = new List<AgentAnalysisStep>();
        if (state.Parts.Count > 0)
        {
            steps.Add(new AgentAnalysisStep("complete", Text("Files restored", "กู้คืนไฟล์แล้ว"), Text("กู้คืนไฟล์แล้ว", "กู้คืนไฟล์แล้ว"), Text($"{state.Parts.Count} part(s)", $"{state.Parts.Count} ชิ้นงาน")));
        }

        if (state.Parts.Any(part => part.Findings.Count > 0))
        {
            steps.Add(new AgentAnalysisStep("complete", Text("DFM review restored", "กู้คืนผล DFM แล้ว"), Text("กู้คืนผล DFM แล้ว", "กู้คืนผล DFM แล้ว"), Text($"{state.Parts.Sum(part => part.Findings.Count)} issue(s)", $"{state.Parts.Sum(part => part.Findings.Count)} รายการ")));
        }

        if (state.Estimate is not null)
        {
            steps.Add(new AgentAnalysisStep("complete", Text("Estimate restored", "กู้คืนราคาแล้ว"), Text("กู้คืนราคาแล้ว", "กู้คืนราคาแล้ว"), FormatMoney(state.Estimate.Total, state.Estimate.Currency)));
        }

        return steps;
    }

    private string BuildRestoredAnalysisSummary(QuoteAgentStateResponse state)
    {
        var parts = state.Parts.Count.ToString(CultureInfo.InvariantCulture);
        var artifacts = state.Artifacts.Count.ToString(CultureInfo.InvariantCulture);
        return Text($"{parts} part(s) · {artifacts} artifact(s) restored", $"กู้คืน {parts} ชิ้นงาน · {artifacts} ไฟล์งาน");
    }

    private string BuildRestoredAnalysisProgress(QuoteAgentStateResponse state)
    {
        if (state.Estimate is not null)
        {
            return "100%";
        }

        if (state.Parts.Count > 0)
        {
            return state.Parts.Any(part => part.Findings.Count > 0) ? "75%" : "50%";
        }

        return state.Artifacts.Count > 0 ? "50%" : "0%";
    }

    private static string NormalizeDfmSeverity(string? severity)
    {
        return severity?.Trim().ToLowerInvariant() switch
        {
            "blocker" or "error" or "critical" => "blocker",
            "warning" or "confirm" => "confirm",
            "pass" or "ok" => "pass",
            _ => "confirm"
        };
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount.ToString("0.##", CultureInfo.InvariantCulture)} {currency}";
    }

    private async Task EnsureAgentNotificationConnectionAsync()
    {
        try
        {
            if (_notificationConnection is null)
            {
                _notificationConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/hubs/quote-notifications"))
                    .WithAutomaticReconnect()
                    .Build();

                _notificationConnection.On<QuoteAgentThinkingStepDto>("QuoteAgentThinkingStep", step =>
                {
                    _ = InvokeAsync(() => ApplyStreamingThinkingStep(step));
                });

                _notificationConnection.On<QuoteAgentArtifactDto>("QuoteAgentArtifact", artifact =>
                {
                    _ = InvokeAsync(() => ApplyStreamingArtifact(artifact));
                });

                _notificationConnection.On<QePaymentCompletedPayload>("PaymentCompleted", payload =>
                {
                    _ = InvokeAsync(() => ApplyChatPaymentCompleted(payload));
                });
            }

            if (_notificationConnection.State == HubConnectionState.Disconnected)
            {
                await _notificationConnection.StartAsync();
            }

            if (_joinedQuoteSessionId != SessionId && _notificationConnection.State == HubConnectionState.Connected)
            {
                if (_joinedQuoteSessionId.HasValue)
                {
                    await _notificationConnection.InvokeAsync("LeaveQuoteSessionGroup", _joinedQuoteSessionId.Value);
                }

                await _notificationConnection.InvokeAsync("JoinQuoteSessionGroup", SessionId);
                _joinedQuoteSessionId = SessionId;
            }

            await EnsurePaymentOrderGroupJoinedAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _agentBackendStatusMessage = Text(
                "Live reasoning updates are temporarily unavailable. The final response will still include completed steps.",
                "การอัปเดตขั้นตอนแบบสดยังไม่พร้อมใช้งานชั่วคราว คำตอบสุดท้ายจะยังมีขั้นตอนที่เสร็จแล้ว");
        }
    }

    private void ApplyStreamingArtifact(QuoteAgentArtifactDto artifact)
    {
        if (_disposed)
        {
            return;
        }

        // Upsert the typed artifact event into the workbench list at creation time, so a generated 3D
        // preview appears immediately during the turn instead of only when the whole turn completes.
        var index = _artifacts.FindIndex(existing => existing.ArtifactId == artifact.ArtifactId);
        if (index >= 0)
        {
            _artifacts[index] = artifact;
        }
        else
        {
            _artifacts.Add(artifact);
        }

        SyncSelectedArtifactWithArtifacts();

        if (IsGeneratedViewerArtifact(artifact) &&
            artifact.Metadata.TryGetValue("cad_commands", out var commandsJson) &&
            !string.IsNullOrWhiteSpace(commandsJson))
        {
            var inProgress = _messages.LastOrDefault(message =>
                message.Role.Equals("assistant", StringComparison.OrdinalIgnoreCase) &&
                message.IsProcessing);
            if (inProgress is not null)
            {
                inProgress.InlineViewer = BuildInlineViewerInfo(artifact, commandsJson);
            }
        }

        RequestScrollToLatestMessage();
        StateHasChanged();
    }

    private void RestoreThinkingSteps(
        AgentMessageRow assistantMessage,
        IReadOnlyList<QuoteAgentThinkingStepDto> thinkingSteps)
    {
        if (thinkingSteps.Count == 0)
        {
            return;
        }

        assistantMessage.ThinkingSteps = thinkingSteps
            .OrderBy(step => step.StepNumber <= 0 ? int.MaxValue : step.StepNumber)
            .ToList();

        foreach (var step in assistantMessage.ThinkingSteps)
        {
            if (step.Type.Equals("reasoning", StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(step.Detail))
            {
                assistantMessage.AppendReasoningThought(step.Detail);
                continue;
            }

            assistantMessage.AddReasoningTool(ThinkingStepSummary(step));
        }

        var totalDurationMs = assistantMessage.ThinkingSteps
            .Where(step => step.DurationMs is > 0)
            .Sum(step => step.DurationMs!.Value);
        assistantMessage.ThinkingDurationSeconds = totalDurationMs > 0
            ? Math.Max(1, (int)Math.Ceiling(totalDurationMs / 1000d))
            : 1;
    }

    private void ApplyStreamingThinkingStep(QuoteAgentThinkingStepDto step)
    {
        if (_disposed)
        {
            return;
        }

        var assistantMessage = _messages.LastOrDefault(message =>
            message.Role.Equals("assistant", StringComparison.OrdinalIgnoreCase) &&
            message.IsProcessing);
        if (assistantMessage is null)
        {
            return;
        }

        var added = UpsertThinkingStep(assistantMessage, step);
        // Interleave a concise tool-call marker into the live reasoning stream (Claude Code style),
        // so the collapsed "Thinking…" disclosure shows both the model's reasoning and the actions it takes.
        if (added && step.Type.Equals("function_call", StringComparison.OrdinalIgnoreCase))
        {
            assistantMessage.ThinkingStartedAt ??= DateTimeOffset.UtcNow;
            assistantMessage.IsThinking = true;
            StartReasoningTimer();
            assistantMessage.AddReasoningTool(ThinkingStepSummary(step));
        }

        RequestScrollToLatestMessage();
        StateHasChanged();
    }

    private static bool UpsertThinkingStep(AgentMessageRow assistantMessage, QuoteAgentThinkingStepDto step)
    {
        if (step.StepNumber <= 0)
        {
            step.StepNumber = assistantMessage.ThinkingSteps.Count + 1;
        }

        var index = assistantMessage.ThinkingSteps.FindIndex(existing =>
            existing.StepNumber == step.StepNumber ||
            (!string.IsNullOrWhiteSpace(step.Type) &&
             existing.Type.Equals(step.Type, StringComparison.OrdinalIgnoreCase) &&
             existing.Title.Equals(step.Title, StringComparison.OrdinalIgnoreCase)));
        if (index >= 0)
        {
            assistantMessage.ThinkingSteps[index] = step;
            return false;
        }

        assistantMessage.ThinkingSteps.Add(step);
        return true;
    }

    private string ReasoningSummaryLabel(AgentMessageRow message)
    {
        var seconds = LiveThinkingDurationSeconds(message);
        var activity = ReasoningActivityLabel(message);
        if (message.IsThinking)
        {
            return string.IsNullOrWhiteSpace(activity)
                ? Text($"Thinking · {seconds}s", $"กำลังคิด · {seconds} วินาที")
                : Text($"{activity} · {seconds}s", $"{activity} · {seconds} วินาที");
        }

        if (!string.IsNullOrWhiteSpace(activity) && seconds > 0)
        {
            return Text($"{activity} · {seconds}s", $"{activity} · {seconds} วินาที");
        }

        return seconds > 0
            ? Text($"Thought for {seconds}s", $"คิดอยู่ {seconds} วินาที")
            : Text("Thought process", "กระบวนการคิด");
    }

    private static string? ReasoningActivityLabel(AgentMessageRow message)
    {
        var reasoning = string.Join(
            "\n",
            message.ReasoningEntries
                .Where(entry => !entry.IsTool)
                .Select(entry => entry.Text));

        return QuoteAgentUiHelpers.ExtractReasoningLabel(reasoning);
    }

    private static int LiveThinkingDurationSeconds(AgentMessageRow message)
    {
        if (message.IsThinking && message.ThinkingStartedAt is { } startedAt)
        {
            return Math.Max(1, (int)Math.Round((DateTimeOffset.UtcNow - startedAt).TotalSeconds));
        }

        return message.ThinkingDurationSeconds;
    }

    private void StartReasoningTimer()
    {
        if (_reasoningTimerCts is not null)
        {
            return;
        }

        _reasoningTimerCts = new CancellationTokenSource();
        var token = _reasoningTimerCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && !_disposed)
            {
                try
                {
                    await Task.Delay(1000, token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                if (!token.IsCancellationRequested && !_disposed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        });
    }

    private void StopReasoningTimer()
    {
        _reasoningTimerCts?.Cancel();
        _reasoningTimerCts?.Dispose();
        _reasoningTimerCts = null;
    }

    private static string ReasoningDetailsClass(AgentMessageRow message)
    {
        return message.IsThinking
            ? "qe-agent-reasoning qe-agent-reasoning--live"
            : "qe-agent-reasoning";
    }

    private async Task ApplyUiDirectivesAsync(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives, bool suppressPanelAutoOpen = false)
    {
        if (directives.Count == 0)
        {
            return;
        }

        _uiFocusDirectives = directives.ToList();
        // Mid-conversation agent directives may still focus a panel (agent-directed
        // workbench focus); upload/attach refreshes pass suppressPanelAutoOpen so the
        // panel never pops open just because files were added.
        if (!suppressPanelAutoOpen || _uiFocusDirectives.Any(directive => directive.OpenPanel))
        {
            OpenDirectivePanel(_uiFocusDirectives);
        }

        SelectDirectiveUploadTarget(_uiFocusDirectives);
        ActivateUiHighlights(_uiFocusDirectives);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenDirectivePanel(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        var panel = directives
            .Select(directive => directive.Panel)
            .FirstOrDefault(item =>
                item.Equals("summary", StringComparison.OrdinalIgnoreCase) ||
                item.Equals("artifacts", StringComparison.OrdinalIgnoreCase) ||
                item.Equals("workbench", StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(panel))
        {
            return;
        }

        if (panel.Equals("summary", StringComparison.OrdinalIgnoreCase))
        {
            _summaryPanelOpen = true;
            _artifactPanelOpen = false;
            return;
        }

        _artifactPanelOpen = true;
        _summaryPanelOpen = false;
    }

    private void SelectDirectiveUploadTarget(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        if (UploadedParts.Count == 0)
        {
            return;
        }

        var partTarget = directives
            .Select(directive => directive.TargetId)
            .FirstOrDefault(target => Guid.TryParse(target, out _));
        if (string.IsNullOrWhiteSpace(partTarget))
        {
            return;
        }

        var index = UploadedParts
            .Select((part, partIndex) => new { part, partIndex })
            .FirstOrDefault(item => item.part.PartId.ToString("D").Equals(partTarget, StringComparison.OrdinalIgnoreCase))
            ?.partIndex ?? -1;
        if (index >= 0 && OnUploadedPartSelected.HasDelegate)
        {
            _ = SelectUploadedPartAsync(index);
        }
    }

    private void ActivateUiHighlights(IReadOnlyCollection<QuoteAgentUiDirectiveDto> directives)
    {
        _activeUiHighlightKeys.Clear();
        foreach (var directive in directives)
        {
            if (!string.IsNullOrWhiteSpace(directive.HighlightKey))
            {
                _activeUiHighlightKeys.Add(directive.HighlightKey);
            }
        }

        var focusVersion = ++_uiFocusVersion;
