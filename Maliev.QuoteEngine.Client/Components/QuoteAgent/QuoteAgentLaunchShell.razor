    private static bool IsGeneratedViewerArtifact(QuoteAgentArtifactDto artifact)
    {
        return artifact.ArtifactType.Equals("viewer", StringComparison.OrdinalIgnoreCase) &&
            artifact.Metadata.TryGetValue("generated", out var generated) &&
            generated.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private static InlineViewerInfo? FindInlinePreview(
        IReadOnlyList<QuoteAgentArtifactDto> artifacts,
        IReadOnlySet<Guid>? generatedViewerArtifactIdsBeforeTurn = null)
    {
        var generated = artifacts.LastOrDefault(a =>
            IsGeneratedViewerArtifact(a) &&
            generatedViewerArtifactIdsBeforeTurn?.Contains(a.ArtifactId) != true);
        if (generated is null)
        {
            return null;
        }

        if (!generated.Metadata.TryGetValue("cad_commands", out var commandsJson) ||
            string.IsNullOrWhiteSpace(commandsJson))
        {
            return null;
        }

        return new InlineViewerInfo
        {
            ArtifactId = generated.ArtifactId,
            CommandsJson = commandsJson,
            FeedbackRating = int.TryParse(ArtifactMetadata(generated, "customerRating"), CultureInfo.InvariantCulture, out var rating)
                ? Math.Clamp(rating, 1, 5)
                : 0,
            FeedbackComment = ArtifactMetadata(generated, "customerComment") ?? string.Empty,
            FeedbackStatus = generated.Status.Equals("feedback_recorded", StringComparison.OrdinalIgnoreCase)
                ? "Feedback recorded"
                : string.Empty
        };
    }

