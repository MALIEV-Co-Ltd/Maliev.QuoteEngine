        QueueComposerAttachment(part);
        await InvokeAsync(StateHasChanged);
        await RefreshPendingAttachmentPreviewAsync();
    }

    private void QueueComposerAttachment(QuotePartViewModel part)
    {
        var attachment = ComposerAttachmentPreview.FromPart(part);
        var existingIndex = _pendingComposerAttachments.FindIndex(item => item.Matches(attachment));
        if (existingIndex >= 0)
        {
            _pendingComposerAttachments[existingIndex] = attachment;
            return;
        }

        _pendingComposerAttachments.Add(attachment);
    }

    private async Task SelectPendingComposerAttachmentAsync(int index)
    {
        if (index < 0 || index >= _pendingComposerAttachments.Count)
        {
            return;
        }

        var attachment = _pendingComposerAttachments[index];
        var uploadedPartIndex = UploadedParts.ToList().FindIndex(part =>
            string.Equals(part.ClientFileId, attachment.ClientFileId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(part.UploadId, attachment.UploadId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(part.FileName, attachment.FileName, StringComparison.OrdinalIgnoreCase));

        if (uploadedPartIndex >= 0)
        {
            SelectedPartIndex = uploadedPartIndex;
            await SelectUploadedPartAsync(uploadedPartIndex);
        }

        _artifactPanelOpen = true;
        _summaryPanelOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemovePendingComposerAttachmentAsync(int index)
    {
        if (index < 0 || index >= _pendingComposerAttachments.Count)
        {
            return;
        }

        _pendingComposerAttachments.RemoveAt(index);
        await InvokeAsync(StateHasChanged);
        await FocusComposerAsync();
    }

