    private async Task InsertSketchImageAsync(InputFileChangeEventArgs args)
    {
        var image = args.File;
        if (!image.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _error = Text("Only image files can be inserted into the sketch.", "เพิ่มได้เฉพาะไฟล์รูปภาพในสเก็ตช์");
            return;
        }

        await using var stream = image.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var dataUrl = $"data:{image.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        _sketchModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/quote-agent-sketch.js");
        await _sketchModule.InvokeVoidAsync("insertSketchImage", SketchCanvasId, dataUrl);
        ApplySketchImageTitle(Path.GetFileNameWithoutExtension(image.Name));
    }

