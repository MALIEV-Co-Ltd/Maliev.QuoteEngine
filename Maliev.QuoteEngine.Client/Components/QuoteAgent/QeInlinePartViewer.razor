@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_containerId" class="qe-inline-viewer">
    @if (_loadFailed)
    {
        <div class="qe-inline-viewer-error">
            <span>@_loadErrorMessage</span>
            <button type="button" class="qe-inline-viewer-retry" @onclick="RetryPreview">Retry preview</button>
        </div>
    }
    else
    {
        <div class="qe-inline-viewer-loading">Loading 3D preview…</div>
    }
</div>

@code {
    private const string DefaultLoadErrorMessage = "3D preview could not be loaded.";
    private const int PreviewErrorMessageMaxLength = 180;
    private static int _counter;

    private readonly string _containerId = $"qipv-{++_counter}";
    private string? _renderedCommandsJson;
    private string? _failedCommandsJson;
    private string _loadErrorMessage = DefaultLoadErrorMessage;
    private bool _loadFailed;

    [Parameter]
    public string CommandsJson { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(CommandsJson))
        {
            if (_renderedCommandsJson is not null)
            {
                await JS.InvokeVoidAsync("quoteInlineViewer.disposePreview", _containerId);
                _renderedCommandsJson = null;
                _failedCommandsJson = null;
                _loadErrorMessage = DefaultLoadErrorMessage;
                _loadFailed = false;
            }

            return;
        }

        if (_loadFailed && CommandsJson == _failedCommandsJson)
        {
            return;
        }

        if (CommandsJson == _renderedCommandsJson)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("quoteInlineViewer.disposePreview", _containerId);
            _failedCommandsJson = null;
            await JS.InvokeVoidAsync("quoteInlineViewer.createPreview", _containerId, CommandsJson);
            _renderedCommandsJson = CommandsJson;
            _loadErrorMessage = DefaultLoadErrorMessage;
            _loadFailed = false;
        }
        catch (JSException ex)
        {
            _renderedCommandsJson = null;
            _failedCommandsJson = CommandsJson;
            _loadErrorMessage = FormatLoadErrorMessage(ex.Message);
            _loadFailed = true;
            StateHasChanged();
        }
    }

    private static string FormatLoadErrorMessage(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return DefaultLoadErrorMessage;
        }

        var trimmed = message.Trim();
        return trimmed.Length > PreviewErrorMessageMaxLength
            ? $"{trimmed[..PreviewErrorMessageMaxLength]}..."
            : trimmed;
    }

    private void RetryPreview()
    {
        _failedCommandsJson = null;
        _loadErrorMessage = DefaultLoadErrorMessage;
        _loadFailed = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("quoteInlineViewer.disposePreview", _containerId);
        }
        catch
        {
        }
    }
}
