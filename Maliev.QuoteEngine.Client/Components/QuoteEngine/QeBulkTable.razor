@* Customer-safe ProjectNew dense all-parts table. *@

<div class="qe-pbt-root">
    <div class="qe-pbt-header">
        <div class="qe-pbt-heading">
            <div class="qe-pbt-title-row">
                <div class="qe-pbt-kicker">Table edit</div>
                <button type="button"
                        class="qe-pbt-configurator-button"
                        title="Configurator"
                        aria-label="Switch to configurator"
                        @onclick="OnConfiguratorRequested">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                </button>
            </div>
            <div class="qe-pbt-title">@Parts.Count part@(Parts.Count == 1 ? "" : "s")</div>
        </div>
        <div class="qe-pbt-actions">
            <button type="button" class="qe-dropzone qe-dropzone--compact qe-pbt-upload-zone" @onclick="OnAddFilesRequested">
                <span class="qe-dropzone-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" />
                </span>
                <span>Add CAD files</span>
                <small>STEP, STL, 3MF, IGES</small>
            </button>
            <button type="button" class="qe-pbt-action-button" @onclick="ToggleAll">
                <MudIcon Icon="@(AreAllSelected ? Icons.Material.Outlined.Deselect : Icons.Material.Outlined.SelectAll)" Size="Size.Small" />
                <span>@(AreAllSelected ? "Clear" : "Select all")</span>
            </button>
        </div>
    </div>

    @if (SelectedCount > 0)
    {
        <div class="qe-pbt-bulk-panel">
            <div class="qe-pbt-bulk-summary">
                <strong>@SelectedCount selected</strong>
                <span>Auto-applies compatible fields.</span>
            </div>

            <div class="qe-pbt-bulk-grid">
                <span class="qe-pbt-bulk-field">Process</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkProcess">
                    <option value="">Select process</option>
                    @foreach (var process in Processes)
                    {
                        <option value="@process.Id">@process.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Material</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkMaterial">
                    <option value="">Select material</option>
                    @foreach (var material in Materials)
                    {
                        <option value="@material.Id">@material.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Finish</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkFinish">
                    <option value="">Select finish</option>
                    @foreach (var finish in Finishes)
                    {
                        <option value="@finish.Id">@finish.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Tolerance</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkTolerance">
                    <option value="">Select tolerance</option>
                    @foreach (var tolerance in Tolerances)
                    {
                        <option value="@tolerance.Id">@tolerance.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Quantity</span>
                <input class="qe-pbt-input" type="number" min="1" value="@_bulkQuantity" @oninput="ApplyBulkQuantity" />

                <span class="qe-pbt-bulk-field">Inspection</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkInspection">
                    <option value="">Select inspection</option>
                    @foreach (var inspection in InspectionLevels)
                    {
                        <option value="@inspection.Code">@inspection.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Roughness</span>
                <select class="qe-pbt-input" @onchange="ApplyBulkRoughness">
                    <option value="">Select roughness</option>
                    @foreach (var roughness in RoughnessOptions)
                    {
                        <option value="@roughness.Code">@roughness.Name</option>
                    }
                </select>

                <span class="qe-pbt-bulk-field">Threaded holes</span>
                <label class="qe-pbt-inline-check">
                    <input type="checkbox" @onchange="ApplyBulkThreadedHoles" />
                    <span>Required</span>
                </label>

                <span class="qe-pbt-bulk-field">Inserts</span>
                <label class="qe-pbt-inline-check">
                    <input type="checkbox" @onchange="ApplyBulkInserts" />
                    <span>Required</span>
                </label>

                <span class="qe-pbt-bulk-field">Notes</span>
                <textarea class="qe-pbt-input qe-pbt-input--notes"
                          rows="3"
                          placeholder="Part note"
                          @oninput="ApplyBulkNotes"></textarea>
            </div>
        </div>
    }

    <div class="qe-pbt-table-surface">
        <table class="qe-pbt-table">
            <thead>
                <tr>
                    <th class="qe-pbt-col-check">
                        <input type="checkbox"
                               checked="@AreAllSelected"
                               @onchange="@((ChangeEventArgs _) => ToggleAll())"
                               aria-label="Select all parts" />
                    </th>
                    <th>Part</th>
                    <th>Process</th>
                    <th>Material</th>
                    <th>Finish</th>
                    <th>Tolerance</th>
                    <th>Qty</th>
                    <th>Inspection</th>
                    <th>Price</th>
                    <th>DFM</th>
                    <th class="qe-pbt-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Parts)
                {
                    var selected = IsPartSelected(part);
                    <tr class="qe-pbt-table-row @(selected ? "qe-pbt-table-row--selected" : "")">
                        <td class="qe-pbt-col-check">
                            <input type="checkbox"
                                   checked="@selected"
                                   @onchange="@((ChangeEventArgs args) => TogglePart(part, IsChecked(args)))"
                                   aria-label="@($"Select {part.FileName}")" />
                        </td>
                        <td>
                            <div class="qe-pbt-part-cell">
                                <div class="qe-pbt-part-thumb">
                                    @if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
                                    {
                                        <img src="@part.ThumbnailUrl" alt="" class="qe-pbt-part-thumb-img" onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                    }
                                </div>
                                <div class="qe-pbt-part-copy">
                                    <div class="qe-pbt-part-name" title="@part.FileName">@part.FileName</div>
                                    <div class="qe-pbt-part-meta">@ResolvePartMeta(part)</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <select class="qe-pbt-input"
                                    value="@part.ProcessId"
                                    @onchange="@((ChangeEventArgs args) => ChangeProcessAsync(part, args.Value?.ToString()))">
                                @foreach (var process in Processes)
                                {
                                    <option value="@process.Id">@process.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="qe-pbt-input"
                                    value="@part.MaterialId"
                                    @onchange="@((ChangeEventArgs args) => ChangeMaterialAsync(part, args.Value?.ToString()))">
                                @foreach (var material in Materials.Where(material => material.ProcessId == part.ProcessId))
                                {
                                    <option value="@material.Id">@material.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="qe-pbt-input"
                                    value="@(part.FinishId ?? string.Empty)"
                                    @onchange="@((ChangeEventArgs args) => ChangeFinishAsync(part, args.Value?.ToString()))">
                                <option value="">Finish</option>
                                @foreach (var finish in Finishes.Where(finish => finish.ProcessId == part.ProcessId))
                                {
                                    <option value="@finish.Id">@finish.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="qe-pbt-input"
                                    value="@(part.ToleranceId ?? string.Empty)"
                                    @onchange="@((ChangeEventArgs args) => ChangeToleranceAsync(part, args.Value?.ToString()))">
                                <option value="">Tolerance</option>
                                @foreach (var tolerance in Tolerances.Where(tolerance => tolerance.ProcessId == part.ProcessId))
                                {
                                    <option value="@tolerance.Id">@tolerance.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input class="qe-pbt-input qe-pbt-input--qty"
                                   type="number"
                                   min="1"
                                   value="@part.Quantity"
                                   @oninput="@((ChangeEventArgs args) => ChangeQuantityAsync(part, args.Value?.ToString()))" />
                        </td>
                        <td>
                            <select class="qe-pbt-input"
                                    value="@(part.InspectionLevel ?? "STANDARD")"
                                    @onchange="@((ChangeEventArgs args) => ChangeInspectionAsync(part, args.Value?.ToString()))">
                                @foreach (var inspection in InspectionLevels)
                                {
                                    <option value="@inspection.Code">@inspection.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="qe-pbt-price">
                                <span>@ResolveLineTotal(part)</span>
                                @if (part.UnitPriceTHB.HasValue)
                                {
                                    <span>@part.UnitPriceTHB.Value.ToString("N0") ea</span>
                                }
                            </div>
                        </td>
                        <td>
                            <button type="button"
                                    class="@ResolveDfmClass(part)"
                                    disabled="@(!CanUseDfmBadge(part))">
                                @ResolveDfmText(part)
                            </button>
                        </td>
                        <td class="qe-pbt-col-actions">
                            <div class="qe-pbt-row-actions">
                                <button type="button"
                                        class="qe-pbt-icon-button"
                                        title="Open viewer"
                                        @onclick="@(() => OnSelectPart.InvokeAsync(part))">
                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="qe-pbt-card-stack">
        @foreach (var part in Parts)
        {
            var selected = IsPartSelected(part);
            <article class="qe-pbt-part-card @(selected ? "qe-pbt-part-card--selected" : "")">
                <div class="qe-pbt-card-head">
                    <input type="checkbox"
                           checked="@selected"
                           @onchange="@((ChangeEventArgs args) => TogglePart(part, IsChecked(args)))"
                           aria-label="@($"Select {part.FileName}")" />
                    <strong>@part.FileName</strong>
                    <button type="button" class="qe-pbt-icon-button" @onclick="@(() => OnSelectPart.InvokeAsync(part))">
                        <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                    </button>
                </div>
                <div class="qe-pbt-card-grid">
                    <span>@ProcessName(part.ProcessId)</span>
                    <span>@MaterialName(part.MaterialId)</span>
                    <span>@DisplayOrDefault(part.FinishCode)</span>
                    <span>@part.Quantity pcs</span>
                </div>
            </article>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<QuotePartViewModel> Parts { get; set; } = [];
    [Parameter] public IReadOnlyList<ProcessOptionDto> Processes { get; set; } = [];
    [Parameter] public IReadOnlyList<MaterialOptionDto> Materials { get; set; } = [];
    [Parameter] public IReadOnlyList<FinishOptionDto> Finishes { get; set; } = [];
    [Parameter] public IReadOnlyList<ToleranceOptionDto> Tolerances { get; set; } = [];
    [Parameter] public IReadOnlyList<InspectionOptionDto> InspectionLevels { get; set; } = [];
    [Parameter] public IReadOnlyList<RoughnessOptionDto> RoughnessOptions { get; set; } = [];
    [Parameter] public EventCallback<QuotePartViewModel> OnPartChanged { get; set; }
    [Parameter] public EventCallback<QuotePartViewModel> OnSelectPart { get; set; }
    [Parameter] public EventCallback OnAddFilesRequested { get; set; }
    [Parameter] public EventCallback OnConfiguratorRequested { get; set; }

    private readonly HashSet<string> _selected = [];
    private int _bulkQuantity = 1;

    private int SelectedCount => Parts.Count(IsPartSelected);
    private bool AreAllSelected => Parts.Count > 0 && Parts.All(IsPartSelected);

    private bool IsPartSelected(QuotePartViewModel part) => _selected.Contains(part.UploadId);

    private void ToggleAll()
    {
        var allSelected = AreAllSelected;
        _selected.Clear();
        if (!allSelected)
        {
            foreach (var part in Parts)
            {
                _selected.Add(part.UploadId);
            }
        }
    }

    private void TogglePart(QuotePartViewModel part, bool selected)
    {
        if (selected)
        {
            _selected.Add(part.UploadId);
        }
        else
        {
            _selected.Remove(part.UploadId);
        }
    }

    private async Task ApplyBulkProcess(ChangeEventArgs args)
    {
        var processId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(processId)) return;

        foreach (var part in SelectedParts())
        {
            part.ProcessId = processId;
            var material = Materials.FirstOrDefault(item => item.ProcessId == processId);
            if (material is not null)
            {
                part.MaterialId = material.Id;
            }

            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkMaterial(ChangeEventArgs args)
    {
        var materialId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(materialId)) return;

        foreach (var part in SelectedParts())
        {
            part.MaterialId = materialId;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkFinish(ChangeEventArgs args)
    {
        var finish = Finishes.FirstOrDefault(item => item.Id == args.Value?.ToString());
        if (finish is null) return;

        foreach (var part in SelectedParts())
        {
            part.FinishId = finish.Id;
            part.FinishCode = finish.Code;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkTolerance(ChangeEventArgs args)
    {
        var tolerance = Tolerances.FirstOrDefault(item => item.Id == args.Value?.ToString());
        if (tolerance is null) return;

        foreach (var part in SelectedParts())
        {
            part.ToleranceId = tolerance.Id;
            part.ToleranceCode = tolerance.Code;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkQuantity(ChangeEventArgs args)
    {
        _bulkQuantity = ParsePositiveInt(args.Value, _bulkQuantity);
        foreach (var part in SelectedParts())
        {
            part.Quantity = _bulkQuantity;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkInspection(ChangeEventArgs args)
    {
        var inspection = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(inspection)) return;

        foreach (var part in SelectedParts())
        {
            part.InspectionLevel = inspection;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkRoughness(ChangeEventArgs args)
    {
        var roughness = args.Value?.ToString();
        foreach (var part in SelectedParts())
        {
            part.RoughnessCode = string.IsNullOrWhiteSpace(roughness) ? null : roughness;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkThreadedHoles(ChangeEventArgs args)
    {
        var enabled = IsChecked(args);
        foreach (var part in SelectedParts())
        {
            part.HasThreadedHoles = enabled;
            part.ThreadedHoleCount = enabled ? Math.Max(part.ThreadedHoleCount, 1) : 0;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkInserts(ChangeEventArgs args)
    {
        var enabled = IsChecked(args);
        foreach (var part in SelectedParts())
        {
            part.InsertType = enabled ? "HeatSet" : "None";
            part.InsertCount = enabled ? Math.Max(part.InsertCount, 1) : 0;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkNotes(ChangeEventArgs args)
    {
        var notes = args.Value?.ToString();
        foreach (var part in SelectedParts())
        {
            part.PartNotes = notes;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ChangeProcessAsync(QuotePartViewModel part, string? processId)
    {
        if (string.IsNullOrWhiteSpace(processId)) return;
        part.ProcessId = processId;
        var material = Materials.FirstOrDefault(item => item.ProcessId == processId);
        if (material is not null)
        {
            part.MaterialId = material.Id;
        }

        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeMaterialAsync(QuotePartViewModel part, string? materialId)
    {
        if (string.IsNullOrWhiteSpace(materialId)) return;
        part.MaterialId = materialId;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeFinishAsync(QuotePartViewModel part, string? finishId)
    {
        var finish = Finishes.FirstOrDefault(item => item.Id == finishId);
        part.FinishId = finish?.Id;
        part.FinishCode = finish?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeToleranceAsync(QuotePartViewModel part, string? toleranceId)
    {
        var tolerance = Tolerances.FirstOrDefault(item => item.Id == toleranceId);
        part.ToleranceId = tolerance?.Id;
        part.ToleranceCode = tolerance?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeQuantityAsync(QuotePartViewModel part, string? value)
    {
        part.Quantity = ParsePositiveInt(value, part.Quantity);
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeInspectionAsync(QuotePartViewModel part, string? inspection)
    {
        part.InspectionLevel = string.IsNullOrWhiteSpace(inspection) ? "STANDARD" : inspection;
        await OnPartChanged.InvokeAsync(part);
    }

    private IEnumerable<QuotePartViewModel> SelectedParts() => Parts.Where(IsPartSelected).ToArray();

    private string ProcessName(string id) => Processes.FirstOrDefault(item => item.Id == id)?.Name ?? id;

    private string MaterialName(string id) => Materials.FirstOrDefault(item => item.Id == id)?.Name ?? id;

    private static bool IsChecked(ChangeEventArgs args) => args.Value is bool checkedValue && checkedValue;

    private static int ParsePositiveInt(object? value, int fallback)
        => int.TryParse(value?.ToString(), out var parsed) ? Math.Max(1, parsed) : Math.Max(1, fallback);

    private static string DisplayOrDefault(string? value) => string.IsNullOrWhiteSpace(value) ? "Default" : value;

    private static string ResolvePartMeta(QuotePartViewModel part)
        => part.VolumeCc > 0 ? $"{part.VolumeCc:N1} cc / {part.SurfaceAreaCm2:N1} cm2" : part.Status;

    private static string ResolveLineTotal(QuotePartViewModel part)
        => part.UnitPriceTHB.HasValue ? $"{(part.UnitPriceTHB.Value * part.Quantity):N0} THB" : "Not priced";

    private static bool CanUseDfmBadge(QuotePartViewModel part)
        => part.FdmDfmReport is not null || part.SlaDfmReport is not null || part.CncDfmReport is not null || part.Findings.Count > 0;

    private static string ResolveDfmText(QuotePartViewModel part)
    {
        if (part.DfmAcknowledged) return "Ack";
        if (CanUseDfmBadge(part)) return "Review";
        return "Pending";
    }

    private static string ResolveDfmClass(QuotePartViewModel part)
    {
        if (part.DfmAcknowledged) return "qe-pbt-dfm qe-pbt-dfm--ok";
        if (CanUseDfmBadge(part)) return "qe-pbt-dfm qe-pbt-dfm--warn";
        return "qe-pbt-dfm qe-pbt-dfm--pending";
    }
}
