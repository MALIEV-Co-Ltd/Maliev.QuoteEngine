@* Maliev.QuoteEngine.Client/Components/QuoteEngine/QeBulkTable.razor *@
@using Maliev.QuoteEngine.Shared.Quotes

<div class="qe-bulk-table-wrap">

    @* ── Header bar ── *@
    <div class="qe-bulk-header">
        <span class="qe-bulk-count">@Parts.Count part(s)</span>
        <button class="qe-btn qe-btn--ghost" @onclick="OnAddFilesRequested">+ Add files</button>
    </div>

    @* ── Table ── *@
    <div class="qe-bulk-table-scroll">
        <table class="qe-bulk-table">
            <thead>
                <tr>
                    <th><input type="checkbox" @onchange="ToggleSelectAll"
                               checked="@(_selected.Count == Parts.Count && Parts.Count > 0)" /></th>
                    <th>Part</th>
                    <th>Status</th>
                    <th>Process / Material</th>
                    <th>Finish / Tolerance</th>
                    <th>Inspection</th>
                    <th class="qe-col-num">Qty</th>
                    <th class="qe-col-num">DFM</th>
                    <th class="qe-col-num">Unit (THB)</th>
                    <th class="qe-col-num qe-col-LineTotal">Line total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Parts)
                {
                    var isSelected = _selected.Contains(part.UploadId);
                    <tr class="@(isSelected ? "qe-bulk-row--selected" : "")">
                        <td>
                            <input type="checkbox" checked="@isSelected"
                                   @onchange="() => ToggleRow(part.UploadId)" />
                        </td>
                        <td class="qe-bulk-filename" title="@part.FileName">@TruncateName(part.FileName)</td>
                        <td>@RenderStatus(part.Status)</td>
                        <td>
                            @if (_editing == part.UploadId)
                            {
                                @* BulkProcess inline edit *@
                                <select @bind="part.ProcessId" @bind:after="() => OnPartChanged.InvokeAsync(part)">
                                    @foreach (var proc in Processes)
                                    {
                                        <option value="@proc.Id">@proc.Name</option>
                                    }
                                </select>
                                @* BulkMaterial inline edit *@
                                <select @bind="part.MaterialId" @bind:after="() => OnPartChanged.InvokeAsync(part)">
                                    @foreach (var mat in Materials.Where(m => m.ProcessId == part.ProcessId))
                                    {
                                        <option value="@mat.Id">@mat.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="qe-bulk-proc" @onclick="() => _editing = part.UploadId">
                                    @ProcessName(part.ProcessId) · @MaterialName(part.MaterialId)
                                </span>
                            }
                        </td>
                        <td>
                            @if (_editing == part.UploadId)
                            {
                                <select value="@(part.FinishId ?? string.Empty)" @onchange="args => SetRowFinish(part, args)">
                                    <option value="">Default finish</option>
                                    @foreach (var finish in Finishes.Where(f => f.ProcessId == part.ProcessId))
                                    {
                                        <option value="@finish.Id">@finish.Name</option>
                                    }
                                </select>
                                <select value="@(part.ToleranceId ?? string.Empty)" @onchange="args => SetRowTolerance(part, args)">
                                    <option value="">Default tolerance</option>
                                    @foreach (var tolerance in Tolerances.Where(t => t.ProcessId == part.ProcessId))
                                    {
                                        <option value="@tolerance.Id">@tolerance.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="qe-bulk-proc" @onclick="() => _editing = part.UploadId">
                                    @DisplayOrDefault(part.FinishCode) · @DisplayOrDefault(part.ToleranceCode)
                                </span>
                            }
                        </td>
                        <td>
                            @if (_editing == part.UploadId)
                            {
                                <select value="@(part.InspectionLevel ?? "STANDARD")" @onchange="args => SetRowInspection(part, args)">
                                    @foreach (var inspection in InspectionLevels)
                                    {
                                        <option value="@inspection.Code">@inspection.Name</option>
                                    }
                                </select>
                                <select value="@(part.RoughnessCode ?? string.Empty)" @onchange="args => SetRowRoughness(part, args)">
                                    <option value="">Default roughness</option>
                                    @foreach (var roughness in RoughnessOptions.Where(r => r.ProcessId == part.ProcessId))
                                    {
                                        <option value="@roughness.Code">@roughness.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="qe-bulk-proc" @onclick="() => _editing = part.UploadId">
                                    @DisplayOrDefault(part.InspectionLevel) / @DisplayOrDefault(part.RoughnessCode)
                                </span>
                            }
                        </td>
                        <td class="qe-col-num">
                            <input class="qe-bulk-qty" type="number" min="1" max="100000"
                                   @bind="part.Quantity" @bind:after="() => OnPartChanged.InvokeAsync(part)" />
                        </td>
                        <td class="qe-col-num">@RenderDfmReport(part)</td>
                        <td class="qe-col-num">@(part.UnitPriceTHB.HasValue ? part.UnitPriceTHB.Value.ToString("N0") : "—")</td>
                        <td class="qe-col-num qe-bulk-total">
                            @(part.UnitPriceTHB.HasValue ? (part.UnitPriceTHB.Value * part.Quantity).ToString("N0") : "—")
                        </td>
                        <td>
                            <button class="qe-btn-icon" title="View in 3D" @onclick="() => OnSelectPart.InvokeAsync(part)">&#x2299;</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Bulk action bar (appears when rows selected) ── *@
    @if (_selected.Count > 0)
    {
        <div class="qe-bulk-bar">
            <span class="qe-bulk-bar-count">@_selected.Count selected</span>
            @* BulkProcess selector *@
            <select @onchange="ApplyBulkProcess">
                <option value="">Bulk process&hellip;</option>
                @foreach (var proc in Processes)
                {
                    <option value="@proc.Id">@proc.Name</option>
                }
            </select>
            @* BulkMaterial selector *@
            <select @onchange="ApplyBulkMaterial">
                <option value="">Bulk material&hellip;</option>
                @foreach (var mat in Materials)
                {
                    <option value="@mat.Id">@mat.Name</option>
                }
            </select>
            <select @onchange="ApplyBulkFinish">
                <option value="">Bulk finish&hellip;</option>
                @foreach (var finish in Finishes)
                {
                    <option value="@finish.Id">@finish.Name</option>
                }
            </select>
            <select @onchange="ApplyBulkTolerance">
                <option value="">Bulk tolerance&hellip;</option>
                @foreach (var tolerance in Tolerances)
                {
                    <option value="@tolerance.Id">@tolerance.Name</option>
                }
            </select>
            <select @onchange="ApplyBulkInspection">
                <option value="">Bulk inspection&hellip;</option>
                @foreach (var inspection in InspectionLevels)
                {
                    <option value="@inspection.Code">@inspection.Name</option>
                }
            </select>
            <span class="qe-bulk-bar-total">
                Total @(GrandTotal.ToString("N0")) THB
            </span>
        </div>
    }
    else
    {
        <div class="qe-bulk-footer">
            <span class="qe-bulk-bar-total">Total @(GrandTotal.ToString("N0")) THB</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<QuotePartViewModel> Parts { get; set; } = [];
    [Parameter] public IReadOnlyList<ProcessOptionDto> Processes { get; set; } = [];
    [Parameter] public IReadOnlyList<MaterialOptionDto> Materials { get; set; } = [];
    [Parameter] public IReadOnlyList<FinishOptionDto> Finishes { get; set; } = [];
    [Parameter] public IReadOnlyList<ToleranceOptionDto> Tolerances { get; set; } = [];
    [Parameter] public IReadOnlyList<InspectionOptionDto> InspectionLevels { get; set; } = [];
    [Parameter] public IReadOnlyList<RoughnessOptionDto> RoughnessOptions { get; set; } = [];
    [Parameter] public EventCallback<QuotePartViewModel> OnPartChanged { get; set; }
    [Parameter] public EventCallback<QuotePartViewModel> OnSelectPart { get; set; }
    [Parameter] public EventCallback OnAddFilesRequested { get; set; }

    private readonly HashSet<string> _selected = [];
    private string? _editing;

    private decimal GrandTotal => Parts
        .Where(p => p.UnitPriceTHB.HasValue)
        .Sum(p => p.UnitPriceTHB!.Value * p.Quantity);

    private void ToggleRow(string uploadId)
    {
        if (!_selected.Remove(uploadId)) _selected.Add(uploadId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true)
            foreach (var p in Parts) _selected.Add(p.UploadId);
    }

    private async Task ApplyBulkProcess(ChangeEventArgs e)
    {
        var processId = e.Value?.ToString();
        if (string.IsNullOrEmpty(processId)) return;
        foreach (var part in Parts.Where(p => _selected.Contains(p.UploadId)))
        {
            part.ProcessId = processId;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkMaterial(ChangeEventArgs e)
    {
        var materialId = e.Value?.ToString();
        if (string.IsNullOrEmpty(materialId)) return;
        foreach (var part in Parts.Where(p => _selected.Contains(p.UploadId)))
        {
            part.MaterialId = materialId;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkFinish(ChangeEventArgs e)
    {
        var finishId = e.Value?.ToString();
        if (string.IsNullOrEmpty(finishId)) return;
        var finish = Finishes.FirstOrDefault(f => f.Id == finishId);
        if (finish is null) return;
        foreach (var part in Parts.Where(p => _selected.Contains(p.UploadId)))
        {
            part.FinishId = finish.Id;
            part.FinishCode = finish.Code;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkTolerance(ChangeEventArgs e)
    {
        var toleranceId = e.Value?.ToString();
        if (string.IsNullOrEmpty(toleranceId)) return;
        var tolerance = Tolerances.FirstOrDefault(t => t.Id == toleranceId);
        if (tolerance is null) return;
        foreach (var part in Parts.Where(p => _selected.Contains(p.UploadId)))
        {
            part.ToleranceId = tolerance.Id;
            part.ToleranceCode = tolerance.Code;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task ApplyBulkInspection(ChangeEventArgs e)
    {
        var inspection = e.Value?.ToString();
        if (string.IsNullOrEmpty(inspection)) return;
        foreach (var part in Parts.Where(p => _selected.Contains(p.UploadId)))
        {
            part.InspectionLevel = inspection;
            await OnPartChanged.InvokeAsync(part);
        }
    }

    private async Task SetRowFinish(QuotePartViewModel part, ChangeEventArgs e)
    {
        var finish = Finishes.FirstOrDefault(f => f.Id == e.Value?.ToString());
        part.FinishId = finish?.Id;
        part.FinishCode = finish?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task SetRowTolerance(QuotePartViewModel part, ChangeEventArgs e)
    {
        var tolerance = Tolerances.FirstOrDefault(t => t.Id == e.Value?.ToString());
        part.ToleranceId = tolerance?.Id;
        part.ToleranceCode = tolerance?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task SetRowInspection(QuotePartViewModel part, ChangeEventArgs e)
    {
        part.InspectionLevel = e.Value?.ToString() ?? "STANDARD";
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task SetRowRoughness(QuotePartViewModel part, ChangeEventArgs e)
    {
        part.RoughnessCode = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString();
        await OnPartChanged.InvokeAsync(part);
    }

    private string ProcessName(string id)
        => Processes.FirstOrDefault(p => p.Id == id)?.Name ?? id;

    private string MaterialName(string id)
        => Materials.FirstOrDefault(m => m.Id == id)?.Name ?? id;

    private static string TruncateName(string name)
        => name.Length > 28 ? name[..25] + "…" : name;

    private static string DisplayOrDefault(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Default" : value;

    private RenderFragment RenderStatus(string status) =>
        @<span class="qe-status qe-status--@status.ToLowerInvariant()">@status</span>;

    // RenderDfmReport — DFM indicator combining all three report types (FDM/SLA/CNC)
    private RenderFragment RenderDfmReport(QuotePartViewModel part)
    {
        if (part.FdmDfmReport is null && part.SlaDfmReport is null && part.CncDfmReport is null)
            return @<span class="qe-dfm-ind qe-dfm-ind--pending">—</span>;

        var issueCount = (part.FdmDfmReport?.Issues.Count ?? 0)
                       + (part.SlaDfmReport?.Issues.Count ?? 0)
                       + (part.CncDfmReport?.Issues.Count ?? 0);

        return issueCount > 0
            ? @<span class="qe-dfm-ind qe-dfm-ind--warn">&#x26A0; @issueCount</span>
            : @<span class="qe-dfm-ind qe-dfm-ind--ok">&#x2713;</span>;
    }
}
