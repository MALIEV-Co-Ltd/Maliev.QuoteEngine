@* Customer-facing drawing and attachment surface. Files remain quote-session scoped until a signed-in customer creates a formal project. *@

<div class="qe-dat-root">
    <div class="qe-dat-list-col">
        <div class="qe-dat-dropzone-wrap">
            <label class="qe-dropzone qe-dropzone--compact qe-dat-dropzone @(CanAttachDocuments ? "" : "qe-dat-dropzone--disabled")">
                <span class="qe-dropzone-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" />
                </span>
                <span>@(CanAttachDocuments ? "Drop drawings here or click to upload" : "Drawing upload disabled in demo")</span>
                <small>PDF, DWG, DXF, PNG, JPG / max 25 MB</small>
                @if (CanAttachDocuments)
                {
                    <InputFile OnChange="HandleFilesSelected" multiple accept=".pdf,.dwg,.dxf,.png,.jpg,.jpeg,.webp" class="qe-dat-file-input" />
                }
            </label>
        </div>

        @if (Part.DrawingFiles.Count > 0)
        {
            <div class="qe-dat-list">
                @foreach (var file in Part.DrawingFiles)
                {
                    var selected = ReferenceEquals(file, _selectedFile);
                    <article class="qe-dat-row @(selected ? "qe-dat-row--active" : "")"
                             @onclick="@(() => SelectDrawing(file))"
                             @onmouseenter="@(() => _hoveredFile = file)"
                             @onmouseleave="@(() => _hoveredFile = null)">
                        <MudIcon Icon="@GetFileIcon(file.FileName)" Size="Size.Small" Class="qe-dat-row-icon" />
                        <div class="qe-dat-row-info">
                            <strong class="qe-dat-row-name" title="@file.FileName">@file.FileName</strong>
                            <span class="qe-dat-row-meta">
                                <span>@System.IO.Path.GetExtension(file.FileName).TrimStart('.').ToUpperInvariant()</span>
                                <span>·</span>
                                <span>@FormatBytes(file.FileSizeBytes)</span>
                                <span>·</span>
                                <span>@file.Kind</span>
                            </span>
                        </div>
                        @if (ReferenceEquals(_hoveredFile, file))
                        {
                            <button type="button"
                                    class="qe-dat-row-delete"
                                    title="Remove"
                                    @onclick:stopPropagation="true"
                                    @onclick="@(() => RemoveDrawing(file))">
                                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                            </button>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="qe-dat-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Large" />
                <span>No drawings uploaded yet</span>
            </div>
        }
    </div>

    <div class="qe-dat-preview-col">
        @if (PreviewUrl is { Length: > 0 } previewUrl)
        {
            <iframe src="@previewUrl" class="qe-dat-preview-iframe" title="Drawing preview"></iframe>
        }
        else if (_selectedFile is not null)
        {
            <div class="qe-dat-preview-placeholder">
                <MudIcon Icon="@GetFileIcon(_selectedFile.FileName)" Size="Size.Large" />
                <strong>@_selectedFile.FileName</strong>
                <span>Preview will be available after the file is uploaded to the customer project.</span>
            </div>
        }
        else
        {
            <div class="qe-dat-preview-placeholder">
                <MudIcon Icon="@Icons.Material.Outlined.Preview" Size="Size.Large" />
                <span>Select a file to preview</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public QuotePartViewModel Part { get; set; } = new();
    [Parameter] public bool CanAttachDocuments { get; set; } = true;
    [Parameter] public EventCallback<QuotePartViewModel> OnPartChanged { get; set; }

    private QuotePartAttachmentDto? _selectedFile;
    private QuotePartAttachmentDto? _hoveredFile;

    private string? PreviewUrl =>
        _selectedFile?.StoragePath is { Length: > 0 } path
        && (path.StartsWith("/", StringComparison.Ordinal) || path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            ? path
            : null;

    protected override void OnParametersSet()
    {
        if (_selectedFile is not null && !Part.DrawingFiles.Contains(_selectedFile))
        {
            _selectedFile = null;
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        if (!CanAttachDocuments)
        {
            return;
        }

        foreach (var file in args.GetMultipleFiles(10))
        {
            Part.DrawingFiles.Add(new QuotePartAttachmentDto(
                file.Name,
                $"session://quote-engine/{Part.PartId:N}/{Uri.EscapeDataString(file.Name)}",
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                file.Size,
                "Drawing"));
        }

        _selectedFile = Part.DrawingFiles.LastOrDefault();
        await OnPartChanged.InvokeAsync(Part);
    }

    private void SelectDrawing(QuotePartAttachmentDto file)
    {
        _selectedFile = ReferenceEquals(_selectedFile, file) ? null : file;
    }

    private async Task RemoveDrawing(QuotePartAttachmentDto file)
    {
        Part.DrawingFiles.Remove(file);
        if (ReferenceEquals(_selectedFile, file))
        {
            _selectedFile = null;
        }

        await OnPartChanged.InvokeAsync(Part);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
        {
            return "pending upload";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{Math.Max(1, bytes / 1024)} KB";
        }

        return $"{bytes / 1024m / 1024m:0.0} MB";
    }

    private static string GetFileIcon(string name) =>
        System.IO.Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".pdf" => Icons.Material.Outlined.PictureAsPdf,
            ".dwg" or ".dxf" => Icons.Material.Outlined.Architecture,
            ".png" or ".jpg" or ".jpeg" or ".webp" => Icons.Material.Outlined.Image,
            _ => Icons.Material.Outlined.InsertDriveFile
        };
}
