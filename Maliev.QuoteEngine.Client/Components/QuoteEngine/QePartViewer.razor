@* Maliev.QuoteEngine.Client/Components/QuoteEngine/QePartViewer.razor *@
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="qe-viewer-wrap" style="position:relative;width:100%;height:100%;min-height:280px;">
    <canvas id="@_canvasId"
            style="width:100%;height:100%;touch-action:none;outline:none;display:block;"></canvas>

    @if (!string.IsNullOrEmpty(GlbUrl))
    {
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="qe-viewer-fallback" role="status">
                <img src="/images/generated/sample-part.svg" alt="" />
                <strong>3D preview unavailable</strong>
                <span>The quote configuration is still available while the model preview is refreshed.</span>
            </div>
        }

        <div class="qe-viewer-toolbar" aria-label="CAD viewer toolbar">
            <div class="qe-vt-group" aria-label="Camera presets">
                @foreach (var preset in ViewPresets)
                {
                    <button class="@ToolbarButtonClass(_cameraPreset == preset.Key)"
                            @onclick="@(() => SetPresetAsync(preset.Key))"
                            title="@preset.Label"
                            aria-label="@preset.Label">
                        @GetCubeIconSvg(preset.Key, _cameraPreset == preset.Key)
                    </button>
                }
            </div>
            <span class="qe-vt-sep"></span>
            <div class="qe-vt-group" aria-label="Display controls">
                <button class="@ToolbarButtonClass(_renderMode == "solid")"
                        @onclick='() => SetRenderModeAsync("solid")'
                        title="Solid shaded view"
                        aria-label="Solid shaded view">
                    @GetModeIconSvg("solid", _renderMode == "solid")
                </button>
                <button class="@ToolbarButtonClass(_renderMode == "wireframe")"
                        @onclick='() => SetRenderModeAsync("wireframe")'
                        title="Wireframe view"
                        aria-label="Wireframe view">
                    @GetModeIconSvg("wireframe", _renderMode == "wireframe")
                </button>
                <button class="@ToolbarButtonClass(_renderMode == "transparent")"
                        @onclick='() => SetRenderModeAsync("transparent")'
                        title="Transparent view"
                        aria-label="Transparent view">
                    @GetModeIconSvg("transparent", _renderMode == "transparent")
                </button>
            </div>
            <span class="qe-vt-sep"></span>
            <div class="qe-vt-group" aria-label="Projection controls">
                <button class="@ToolbarButtonClass(!_ortho)"
                        @onclick='() => SetProjectionAsync("perspective")'
                        title="Perspective"
                        aria-label="Perspective camera">
                    @GetModeIconSvg("perspective", !_ortho)
                </button>
                <button class="@ToolbarButtonClass(_ortho)"
                        @onclick='() => SetProjectionAsync("orthographic")'
                        title="Orthographic"
                        aria-label="Orthographic camera">
                    @GetModeIconSvg("ortho", _ortho)
                </button>
            </div>
            <span class="qe-vt-sep"></span>
            <div class="qe-vt-group" aria-label="Display toggles">
                <button class="@ToolbarButtonClass(_gridOn)"
                        @onclick="ToggleGridAsync"
                        title="Grid floor"
                        aria-label="Toggle grid floor">
                    @GetModeIconSvg("grid", _gridOn)
                </button>
                <button class="@ToolbarButtonClass(_edgesOn)"
                        @onclick="ToggleEdgesAsync"
                        title="Edges"
                        aria-label="Toggle edges">
                    @GetModeIconSvg("edges", _edgesOn)
                </button>
                <button class="@ToolbarButtonClass(_boundingBoxOn)"
                        @onclick="ToggleBoundingBoxAsync"
                        title="Bounding box"
                        aria-label="Toggle bounding box">
                    @GetModeIconSvg("bounds", _boundingBoxOn)
                </button>
            </div>
            <span class="qe-vt-sep"></span>
            <div class="qe-vt-group" aria-label="Analysis controls">
                <button class="@ToolbarButtonClass(_sectionOn)"
                        @onclick="ToggleSectionAsync"
                        title="Section cut"
                        aria-label="Toggle section cut">
                    <MudIcon Icon="@Icons.Material.Outlined.ContentCut" Size="Size.Small" />
                </button>
                <button class="@ToolbarButtonClass(_measureOn)"
                        @onclick="ToggleMeasureAsync"
                        title="Measure"
                        aria-label="Toggle measure tool">
                    <MudIcon Icon="@Icons.Material.Outlined.Straighten" Size="Size.Small" />
                </button>
                <button class="@ToolbarButtonClass(_thicknessOn)"
                        @onclick="ToggleThicknessAsync"
                        title="Thickness probe"
                        aria-label="Toggle thickness analysis">
                    <MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" />
                </button>
                <button class="qe-vt-btn" @onclick="RotateModelAsync" title="Rotate 90 degrees" aria-label="Rotate model 90 degrees">
                    <MudIcon Icon="@Icons.Material.Filled.RotateRight" Size="Size.Small" />
                </button>
                <button class="qe-vt-btn" @onclick="ResetCameraAsync" title="Reset camera" aria-label="Reset camera">
                    <MudIcon Icon="@Icons.Material.Filled.FlipCameraIos" Size="Size.Small" />
                </button>
            </div>

            @if (_sectionOn)
            {
                <div class="qe-vt-subtools" aria-label="Section plane">
                    <button class="@AxisButtonClass("x")" @onclick='() => SetSectionAxisAsync("x")'>X</button>
                    <button class="@AxisButtonClass("y")" @onclick='() => SetSectionAxisAsync("y")'>Y</button>
                    <button class="@AxisButtonClass("z")" @onclick='() => SetSectionAxisAsync("z")'>Z</button>
                    <input type="range"
                           min="-100"
                           max="100"
                           step="1"
                           value="@_sectionOffsetMm"
                           @onchange="SetSectionOffsetAsync"
                           aria-label="Section offset" />
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_lastMeasurement))
        {
            <div class="qe-viewer-measure-readout" role="status">@_lastMeasurement</div>
        }
    }
    else
    {
        <div class="qe-viewer-placeholder">
            <span class="qe-viewer-loading-orbit" aria-hidden="true"></span>
            <span>Loading 3D model&hellip;</span>
        </div>
    }
</div>

@code {
    [Parameter] public string? GlbUrl { get; set; }
    [Parameter] public string FileExtension { get; set; } = ".glb";
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public string? PartColor { get; set; }
    [Parameter] public string? ProcessId { get; set; }
    [Parameter] public string? BrowserFileClientId { get; set; }
    [Parameter] public string? BrowserFileName { get; set; }
    [Parameter] public string? FinishCode { get; set; }
    [Parameter] public string? RoughnessCode { get; set; }
    [Parameter] public EventCallback<string> OnViewerError { get; set; }
    [Parameter] public Func<LocalGeometryRuntimeResult, Task<bool>>? OnLocalGeometryRuntimeCompleted { get; set; }
    [Parameter] public Func<LocalGeometryRuntimeStarted, Task>? OnLocalGeometryRuntimeStarted { get; set; }
    [Parameter] public Func<LocalGeometryRuntimeUnavailable, Task>? OnLocalGeometryRuntimeUnavailable { get; set; }

    private readonly string _canvasId = $"qe-canvas-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<QePartViewer>? _dotNetRef;
    private string? _lastGlbUrl;
    private string? _lastFileExtension;
    private string? _lastPartColor;
    private string? _lastProcessId;
    private string? _lastFinishCode;
    private string? _lastRoughnessCode;
    private string? _loadError;
    private string? _lastMeasurement;
    private string _cameraPreset = "iso";
    private string _renderMode = "solid";
    private string _sectionAxis = "z";
    private double _sectionOffsetMm;
    private bool _sectionOn;
    private bool _sectionInverted = false;
    private bool _ortho;
    private bool _edgesOn = true;
    private bool _gridOn = true;
    private bool _boundingBoxOn;
    private bool _measureOn;
    private bool _thicknessOn;

    private static readonly ViewPreset[] ViewPresets =
    [
        new("front", "Front view"),
        new("left", "Left view"),
        new("back", "Back view"),
        new("right", "Right view"),
        new("top", "Top view"),
        new("bottom", "Bottom view"),
        new("iso", "Isometric view")
    ];

    private sealed record ViewPreset(string Key, string Label);

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(GlbUrl)
            && (GlbUrl != _lastGlbUrl || FileExtension != _lastFileExtension))
        {
            _lastGlbUrl = GlbUrl;
            _lastFileExtension = FileExtension;
            _lastPartColor = PartColor;
            _lastProcessId = ProcessId;
            _lastFinishCode = FinishCode;
            _lastRoughnessCode = RoughnessCode;
            _loadError = null;
            await InitializeViewerAsync();
        }
        else if (_module is not null && MaterialChanged())
        {
            var processChanged = ProcessId != _lastProcessId;
            _lastPartColor = PartColor;
            _lastProcessId = ProcessId;
            _lastFinishCode = FinishCode;
            _lastRoughnessCode = RoughnessCode;
            await _module.InvokeVoidAsync("setPartMaterial", _canvasId, ProcessId, FinishCode, RoughnessCode, PartColor);
            if (processChanged)
            {
                await RunLocalGeometryRuntimeAsync(ProcessId);
            }
        }
    }

    private bool MaterialChanged() =>
        PartColor != _lastPartColor ||
        ProcessId != _lastProcessId ||
        FinishCode != _lastFinishCode ||
        RoughnessCode != _lastRoughnessCode;

    private async Task InitializeViewerAsync()
    {
        try
        {
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/quote-part-viewer.js");
            _dotNetRef ??= DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("initialize",
                _canvasId, GlbUrl, FileExtension, IsDarkMode,
                null,
                _dotNetRef,
                new
                {
                    cameraPreset = _cameraPreset,
                    renderMode = _renderMode,
                    edgesEnabled = _edgesOn,
                    gridEnabled = _gridOn,
                    boundingBoxEnabled = _boundingBoxOn,
                    cameraProjection = _ortho ? "orthographic" : "perspective",
                    sectionEnabled = _sectionOn,
                    sectionAxis = _sectionAxis,
                    sectionOffsetMm = _sectionOffsetMm,
                    sectionInverted = _sectionInverted,
                    partColor = PartColor,
                    processId = ProcessId,
                    processCode = ProcessId,
                    finishCode = FinishCode,
                    roughnessCode = RoughnessCode
                });
        }
        catch (Exception ex)
        {
            await OnLoadError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task OnLoadError(string message)
    {
        _loadError = string.IsNullOrWhiteSpace(message) ? "Failed to load 3D model." : message;
        await OnViewerError.InvokeAsync(_loadError);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task NotifyMeasureResult(string distanceMm, string angleDeg)
    {
        _lastMeasurement = $"{distanceMm} mm / {angleDeg} deg";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetPresetAsync(string preset)
    {
        if (_module is null) return;
        _cameraPreset = preset;
        await _module.InvokeVoidAsync("setCameraPreset", _canvasId, preset);
    }

    private async Task SetRenderModeAsync(string mode)
    {
        if (_module is null) return;
        _renderMode = mode;
        await _module.InvokeVoidAsync("setRenderMode", _canvasId, mode);
    }

    public async Task NotifyVisibleAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("notifyViewerVisible", _canvasId);
    }

    public async Task SelectBodyAsync(int? bodyIndex)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("selectBody", _canvasId, bodyIndex);
    }

    public async Task ToggleDfmOverlayAsync(string partKey, string overlayKey, string glbUrl, bool visible)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("toggleDfmOverlay", _canvasId, partKey, overlayKey, glbUrl, visible);
    }

    public async Task ClearDfmOverlaysAsync(string partKey)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("clearDfmOverlays", _canvasId, partKey);
    }

    public async Task RunLocalGeometryRuntimeAsync(string? processCode = null)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("runLocalAdvisoryGeometry", _canvasId, new
        {
            processCode = string.IsNullOrWhiteSpace(processCode) ? ProcessId : processCode,
            clientUploadId = BrowserFileClientId,
            fileName = BrowserFileName,
            fileBytesProvider = "quoteEngineUploads",
            dotNetRef = _dotNetRef
        });
    }

    [JSInvokable]
    public async Task<bool> NotifyLocalGeometryRuntimeComplete(LocalGeometryRuntimeResult result)
    {
        if (OnLocalGeometryRuntimeCompleted is null)
            return false;

        return await OnLocalGeometryRuntimeCompleted(result);
    }

    [JSInvokable]
    public async Task NotifyLocalGeometryRuntimeStarted(LocalGeometryRuntimeStarted result)
    {
        if (OnLocalGeometryRuntimeStarted is not null)
            await OnLocalGeometryRuntimeStarted(result);
    }

    [JSInvokable]
    public async Task NotifyLocalGeometryRuntimeUnavailable(LocalGeometryRuntimeUnavailable result)
    {
        if (OnLocalGeometryRuntimeUnavailable is not null)
            await OnLocalGeometryRuntimeUnavailable(result);
    }

    private async Task SetProjectionAsync(string projection)
    {
        if (_module is null) return;
        _ortho = projection.Equals("orthographic", StringComparison.OrdinalIgnoreCase);
        await _module.InvokeVoidAsync("setCameraProjection", _canvasId, _ortho ? "orthographic" : "perspective");
    }

    private async Task RotateModelAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("rotateModel", _canvasId, 90);
    }

    private async Task ToggleEdgesAsync()
    {
        if (_module is null) return;
        _edgesOn = !_edgesOn;
        await _module.InvokeVoidAsync("toggleEdges", _canvasId, _edgesOn);
    }

    private async Task ToggleGridAsync()
    {
        if (_module is null) return;
        _gridOn = !_gridOn;
        await _module.InvokeVoidAsync(_gridOn ? "showGrid" : "hideGrid", _canvasId);
    }

    private async Task ToggleBoundingBoxAsync()
    {
        if (_module is null) return;
        _boundingBoxOn = !_boundingBoxOn;
        await _module.InvokeVoidAsync("toggleBoundingBox", _canvasId, _boundingBoxOn);
    }

    private async Task ToggleMeasureAsync()
    {
        if (_module is null || _dotNetRef is null) return;
        _measureOn = !_measureOn;
        if (_measureOn)
        {
            _thicknessOn = false;
            await _module.InvokeVoidAsync("disableThicknessAnalysis", _canvasId);
            await _module.InvokeVoidAsync("enableMeasureTool", _canvasId, _dotNetRef);
        }
        else
        {
            await _module.InvokeVoidAsync("disableMeasureTool", _canvasId);
        }
    }

    private async Task ToggleThicknessAsync()
    {
        if (_module is null) return;
        _thicknessOn = !_thicknessOn;
        if (_thicknessOn)
        {
            _measureOn = false;
            await _module.InvokeVoidAsync("disableMeasureTool", _canvasId);
            await _module.InvokeVoidAsync("enableThicknessAnalysis", _canvasId);
        }
        else
        {
            await _module.InvokeVoidAsync("disableThicknessAnalysis", _canvasId);
        }
    }

    private async Task ToggleSectionAsync()
    {
        _sectionOn = !_sectionOn;
        await ApplySectionPlaneAsync();
    }

    private async Task SetSectionAxisAsync(string axis)
    {
        _sectionAxis = axis;
        await ApplySectionPlaneAsync();
    }

    private async Task SetSectionOffsetAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            _sectionOffsetMm = value;
            await ApplySectionPlaneAsync();
        }
    }

    private async Task ApplySectionPlaneAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setSectionPlane", _canvasId, _sectionOn, _sectionAxis, _sectionOffsetMm, _sectionInverted);
    }

    private async Task ResetCameraAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("resetCamera", _canvasId);
    }

    private static readonly Dictionary<string, string> CubeFacePoints = new(StringComparer.OrdinalIgnoreCase)
    {
        ["front"] = "50,86 14,70 14,28 50,44",
        ["back"] = "86,70 50,54 50,12 86,28",
        ["left"] = "14,70 50,54 50,12 14,28",
        ["right"] = "50,86 86,70 86,28 50,44",
        ["top"] = "50,44 14,28 50,12 86,28",
        ["bottom"] = "50,86 14,70 50,54 86,70"
    };

    private static MarkupString GetCubeIconSvg(string viewKey, bool isActive)
    {
        var fill = isActive ? "rgba(10, 114, 239, .34)" : "rgba(77, 77, 77, .12)";
        var stroke = isActive ? "var(--accent)" : "var(--maliev-muted)";
        var mutedStroke = isActive ? "rgba(10, 114, 239, .52)" : "rgba(102, 102, 102, .30)";
        var face = viewKey.Equals("iso", StringComparison.OrdinalIgnoreCase)
            ? $"""
                <polygon points="50,86 14,70 14,28 50,44" fill="{fill}" stroke="{stroke}" stroke-width="2.4" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="{fill}" stroke="{stroke}" stroke-width="2.4" stroke-linejoin="round"/>
                <polygon points="50,44 14,28 50,12 86,28" fill="{fill}" stroke="{stroke}" stroke-width="2.4" stroke-linejoin="round"/>
                """
            : CubeFacePoints.TryGetValue(viewKey, out var points)
                ? $"""<polygon points="{points}" fill="{fill}" stroke="{stroke}" stroke-width="2.4" stroke-linejoin="round"/>"""
                : string.Empty;

        return new MarkupString($"""
            <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" focusable="false">
              <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{mutedStroke}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="var(--maliev-ink-2)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="var(--maliev-ink-2)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              {face}
            </svg>
            """);
    }

    private static MarkupString GetModeIconSvg(string modeKey, bool isActive)
    {
        var edge = isActive ? "var(--accent)" : "var(--maliev-ink-2)";
        var back = isActive ? "rgba(10, 114, 239, .42)" : "rgba(102, 102, 102, .32)";
        var activeFill = isActive ? "rgba(10, 114, 239, .18)" : "none";
        var panel = "var(--maliev-panel)";
        var shade = "var(--maliev-panel-3)";

        var body = modeKey switch
        {
            "solid" => $"""
                <polygon points="50,44 14,28 50,12 86,28" fill="{panel}" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="{shade}" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="var(--maliev-muted-3)" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                """,
            "wireframe" => $"""
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                """,
            "transparent" => $"""
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{back}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="rgba(10, 114, 239, .18)" stroke="none"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="rgba(10, 114, 239, .18)" stroke="none"/>
                """,
            "edges" => $"""
                <polygon points="50,44 14,28 50,12 86,28" fill="{panel}" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="{shade}" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="var(--maliev-muted-3)" stroke="{back}" stroke-width="1.2" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edge}" stroke-width="2.6" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edge}" stroke-width="2.6" stroke-linejoin="round"/>
                """,
            "bounds" => $"""
                <circle cx="50" cy="49" r="20" fill="rgba(10, 114, 239, .38)"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edge}" stroke-width="2.3" stroke-dasharray="5 4" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edge}" stroke-width="2.3" stroke-dasharray="5 4" stroke-linejoin="round"/>
                """,
            "grid" => $"""
                <path d="M16 72H84M24 60H76M32 48H68M40 36H60M26 24 12 76M42 24 34 76M58 24 66 76M74 24 88 76" stroke="{edge}" stroke-width="3" stroke-linecap="round"/>
                <path d="M16 72H84M24 60H76M32 48H68M40 36H60" stroke="{back}" stroke-width="1.5" stroke-linecap="round"/>
                """,
            "ortho" => $"""
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="{activeFill}" stroke="{edge}" stroke-width="2.5" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linejoin="round"/>
                """,
            "perspective" => $"""
                <path d="M50,58 L20,69 M50,58 L80,69 M50,58 L50,31" fill="none" stroke="{back}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,90 80,69 80,34 50,31 20,34 20,69" fill="{activeFill}" stroke="{edge}" stroke-width="2.5" stroke-linejoin="round"/>
                <path d="M50,40 L50,90 M50,40 L20,34 M50,40 L80,34" fill="none" stroke="{edge}" stroke-width="2.5" stroke-linejoin="round"/>
                """,
            _ => string.Empty
        };

        return new MarkupString($"""
            <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" focusable="false">
              {body}
            </svg>
            """);
    }

    private static string ToolbarButtonClass(bool active)
    {
        return active ? "qe-vt-btn qe-vt-active" : "qe-vt-btn";
    }

    private string AxisButtonClass(string axis)
    {
        return _sectionAxis == axis ? "qe-vt-axis qe-vt-active" : "qe-vt-axis";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _canvasId); } catch { /* ignore */ }
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}
