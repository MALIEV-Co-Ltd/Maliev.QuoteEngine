@* Customer-safe ProjectNew-style part configuration sidebar. *@

<aside class="qe-pcs-sidebar">
    <header class="qe-pcs-header">
        <span>Configure</span>
        <strong title="@Part.FileName">@Part.FileName</strong>
    </header>
    <div class="qe-pcs-scroll">
        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Manufacturing Process</span>
            </div>
            <div class="qe-pcs-process-grid">
                @foreach (var process in ReferenceData?.Processes ?? [])
                {
                    var active = Part.ProcessId == process.Id;
                    <button type="button" class="qe-pcs-process-card @(active ? "qe-pcs-process-card--active" : "")"
                            @onclick="@(() => SetProcess(process))">
                        <MudIcon Icon="@ProcessIcon(process.Id)" Size="Size.Small" />
                        <strong>@process.Name</strong>
                        @if (active)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                        }
                    </button>
                }
            </div>
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Material</span>
                <small>@MaterialsFor(Part.ProcessId).Count() options</small>
            </div>
            <div class="qe-pcs-cards">
                @foreach (var material in MaterialsFor(Part.ProcessId))
                {
                    var active = Part.MaterialId == material.Id;
                    <button type="button" class="qe-pcs-mat-card @(active ? "qe-pcs-mat-card--active" : "")"
                            @onclick="@(() => SetMaterial(material))">
                        <span class="qe-mat-swatch" style="background:@MaterialSwatch(material.Id)"></span>
                        <span>
                            <strong>@material.Name</strong>
                            <small>@material.Grade / @material.Finish</small>
                        </span>
                        @if (active)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="qe-card-check" />
                        }
                    </button>
                }
            </div>
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Finish and color</span>
            </div>
            <label class="qe-field">
                Finish
                <select value="@(Part.FinishId ?? string.Empty)" @onchange="SetFinish">
                    <option value="">Default finish</option>
                    @foreach (var finish in FinishesFor(Part.ProcessId))
                    {
                        <option value="@finish.Id">@finish.Name</option>
                    }
                </select>
            </label>
            <div class="qe-color-swatches">
                @foreach (var color in ColorsFor(Part.MaterialId))
                {
                    <button type="button"
                            title="@color.Name"
                            class="qe-color-swatch @(Part.Color == color.Code ? "qe-color-swatch--active" : "")"
                            style="background:@color.CssValue"
                            @onclick="@(() => SetColor(color.Code))">
                        <span>@color.Name</span>
                    </button>
                }
            </div>
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Tolerance and inspection</span>
            </div>
            <label class="qe-field">
                Tolerance
                <select value="@(Part.ToleranceId ?? string.Empty)" @onchange="SetTolerance">
                    <option value="">Default tolerance</option>
                    @foreach (var tolerance in TolerancesFor(Part.ProcessId))
                    {
                        <option value="@tolerance.Id">@tolerance.Name</option>
                    }
                </select>
            </label>
            <label class="qe-field">
                Inspection
                <select value="@(Part.InspectionLevel ?? "STANDARD")" @onchange="SetInspection">
                    @foreach (var inspection in ReferenceData?.InspectionLevels ?? [])
                    {
                        <option value="@inspection.Code">@inspection.Name</option>
                    }
                </select>
            </label>
            @if (IsCnc)
            {
                <label class="qe-field">
                    Surface roughness
                    <select value="@(Part.RoughnessCode ?? string.Empty)" @onchange="SetRoughness">
                        <option value="">Default roughness</option>
                        @foreach (var roughness in RoughnessFor(Part.ProcessId))
                        {
                            <option value="@roughness.Code">@roughness.Name</option>
                        }
                    </select>
                </label>
            }
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Threads and inserts</span>
            </div>
            <label class="qe-check-btn @(Part.HasThreadedHoles ? "checked" : "")">
                <input type="checkbox" checked="@Part.HasThreadedHoles" @onchange="SetHasThreadedHoles" />
                Threaded holes
            </label>
            @if (Part.HasThreadedHoles)
            {
                <div class="qe-inline-fields">
                    <label class="qe-field">
                        Spec
                        <input value="@Part.ThreadSpecification" @onchange="SetThreadSpecification" placeholder="M3x0.5" />
                    </label>
                    <label class="qe-field">
                        Count
                        <input type="number" min="0" value="@Part.ThreadedHoleCount" @onchange="SetThreadedHoleCount" />
                    </label>
                </div>
            }
            <label class="qe-field">
                Insert type
                <select value="@(Part.InsertType ?? "None")" @onchange="SetInsertType">
                    <option value="None">No inserts</option>
                    <option value="HeatSet">Heat-set</option>
                    <option value="PressFit">Press-fit</option>
                    <option value="Ultrasonic">Ultrasonic</option>
                </select>
            </label>
            @if (!string.Equals(Part.InsertType, "None", StringComparison.OrdinalIgnoreCase))
            {
                <label class="qe-field">
                    Insert count
                    <input type="number" min="0" value="@Part.InsertCount" @onchange="SetInsertCount" />
                </label>
            }
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span>Quantity and review</span>
            </div>
            <div class="qe-pcs-qty-stack">
                <div>
                    <div class="qe-field-label">Quantity</div>
                    <div class="qe-qty-stepper">
                        <button type="button" class="qe-qty-stepper-btn"
                                disabled="@(Part.Quantity <= 1)"
                                @onclick="DecrementQuantity">-</button>
                        <input type="number"
                               class="qe-qty-stepper-input"
                               aria-label="Quantity"
                               min="1"
                               value="@Part.Quantity"
                               @oninput="SetQuantityInput" />
                        <button type="button" class="qe-qty-stepper-btn"
                                @onclick="IncrementQuantity">+</button>
                    </div>
                    <div class="qe-qty-presets">
                        @foreach (var preset in QuantityPresets)
                        {
                            var p = preset;
                            <button type="button"
                                    class="qe-qty-preset-btn @(Part.Quantity == p ? "qe-qty-preset-btn--active" : "")"
                                    @onclick="@(() => SetQuantityPreset(p))">@p</button>
                        }
                    </div>
                </div>
                <label class="qe-check-btn @(Part.DfmAcknowledged ? "checked" : "")">
                    <input type="checkbox" checked="@Part.DfmAcknowledged" @onchange="SetDfmAcknowledged" />
                    DFM reviewed
                </label>
            </div>
        </section>
    </div>
</aside>

@code {
    private static readonly int[] QuantityPresets = [1, 5, 10, 25, 50];

    [Parameter, EditorRequired] public QuotePartViewModel Part { get; set; } = new();
    [Parameter] public QuoteReferenceDataResponse? ReferenceData { get; set; }
    [Parameter] public EventCallback<QuotePartViewModel> OnPartChanged { get; set; }

    private bool IsCnc => Part.ProcessId.Equals("cnc", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<MaterialOptionDto> MaterialsFor(string processId) =>
        (ReferenceData?.Materials ?? []).Where(x => x.ProcessId == processId);

    private IEnumerable<FinishOptionDto> FinishesFor(string processId) =>
        (ReferenceData?.Finishes ?? []).Where(x => x.ProcessId == processId);

    private IEnumerable<ToleranceOptionDto> TolerancesFor(string processId) =>
        (ReferenceData?.Tolerances ?? []).Where(x => x.ProcessId == processId);

    private IEnumerable<RoughnessOptionDto> RoughnessFor(string processId) =>
        (ReferenceData?.RoughnessOptions ?? []).Where(x => x.ProcessId == processId);

    private IEnumerable<ColorOptionDto> ColorsFor(string materialId)
    {
        var colors = (ReferenceData?.Colors ?? [])
            .Where(x => x.MaterialIds.Count == 0 || x.MaterialIds.Contains(materialId, StringComparer.OrdinalIgnoreCase))
            .ToArray();
        return colors.Length == 0
            ? [new ColorOptionDto("Default", "Default", MaterialSwatch(materialId), [materialId])]
            : colors;
    }

    private async Task SetProcess(ProcessOptionDto process)
    {
        Part.ProcessId = process.Id;
        var material = MaterialsFor(process.Id).FirstOrDefault();
        if (material is not null)
        {
            Part.MaterialId = material.Id;
        }

        ApplyCatalogDefaults();
        await NotifyChanged();
    }

    private async Task SetMaterial(MaterialOptionDto material)
    {
        Part.MaterialId = material.Id;
        await NotifyChanged();
    }

    private async Task SetFinish(ChangeEventArgs args)
    {
        var id = args.Value?.ToString();
        var finish = FinishesFor(Part.ProcessId).FirstOrDefault(item => item.Id == id);
        Part.FinishId = finish?.Id;
        Part.FinishCode = finish?.Code;
        await NotifyChanged();
    }

    private async Task SetTolerance(ChangeEventArgs args)
    {
        var id = args.Value?.ToString();
        var tolerance = TolerancesFor(Part.ProcessId).FirstOrDefault(item => item.Id == id);
        Part.ToleranceId = tolerance?.Id;
        Part.ToleranceCode = tolerance?.Code;
        await NotifyChanged();
    }

    private async Task SetInspection(ChangeEventArgs args)
    {
        Part.InspectionLevel = args.Value?.ToString() ?? "STANDARD";
        await NotifyChanged();
    }

    private async Task SetRoughness(ChangeEventArgs args)
    {
        Part.RoughnessCode = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value?.ToString();
        await NotifyChanged();
    }

    private async Task SetColor(string color)
    {
        Part.Color = color;
        await NotifyChanged();
    }

    private async Task SetHasThreadedHoles(ChangeEventArgs args)
    {
        Part.HasThreadedHoles = args.Value is true;
        if (!Part.HasThreadedHoles)
        {
            Part.ThreadSpecification = null;
            Part.ThreadedHoleCount = 0;
        }
        else if (Part.ThreadedHoleCount == 0)
        {
            Part.ThreadedHoleCount = 1;
        }

        await NotifyChanged();
    }

    private async Task SetThreadSpecification(ChangeEventArgs args)
    {
        Part.ThreadSpecification = args.Value?.ToString();
        await NotifyChanged();
    }

    private async Task SetThreadedHoleCount(ChangeEventArgs args)
    {
        Part.ThreadedHoleCount = ParseNonNegativeInt(args.Value, Part.ThreadedHoleCount);
        await NotifyChanged();
    }

    private async Task SetInsertType(ChangeEventArgs args)
    {
        Part.InsertType = args.Value?.ToString() ?? "None";
        if (string.Equals(Part.InsertType, "None", StringComparison.OrdinalIgnoreCase))
        {
            Part.InsertCount = 0;
        }
        else if (Part.InsertCount == 0)
        {
            Part.InsertCount = 1;
        }

        await NotifyChanged();
    }

    private async Task SetInsertCount(ChangeEventArgs args)
    {
        Part.InsertCount = ParseNonNegativeInt(args.Value, Part.InsertCount);
        await NotifyChanged();
    }

    private async Task IncrementQuantity()
    {
        Part.Quantity++;
        await NotifyChanged();
    }

    private async Task DecrementQuantity()
    {
        if (Part.Quantity > 1)
        {
            Part.Quantity--;
            await NotifyChanged();
        }
    }

    private async Task SetQuantityPreset(int quantity)
    {
        Part.Quantity = Math.Max(1, quantity);
        await NotifyChanged();
    }

    private async Task SetQuantityInput(ChangeEventArgs args)
    {
        Part.Quantity = int.TryParse(args.Value?.ToString(), out var quantity)
            ? Math.Max(1, quantity)
            : 1;
        await NotifyChanged();
    }

    private async Task SetDfmAcknowledged(ChangeEventArgs args)
    {
        Part.DfmAcknowledged = args.Value is true;
        await NotifyChanged();
    }

    private void ApplyCatalogDefaults()
    {
        var finish = FinishesFor(Part.ProcessId).FirstOrDefault();
        Part.FinishId = finish?.Id;
        Part.FinishCode = finish?.Code;

        var tolerance = TolerancesFor(Part.ProcessId).FirstOrDefault();
        Part.ToleranceId = tolerance?.Id;
        Part.ToleranceCode = tolerance?.Code;

        Part.RoughnessCode = RoughnessFor(Part.ProcessId).FirstOrDefault()?.Code;
        Part.Color = ColorsFor(Part.MaterialId).FirstOrDefault()?.Code;
    }

    private async Task NotifyChanged()
    {
        await OnPartChanged.InvokeAsync(Part);
    }

    private static int ParseNonNegativeInt(object? value, int fallback)
    {
        return int.TryParse(value?.ToString(), out var parsed) ? Math.Max(0, parsed) : fallback;
    }

    private static string ProcessIcon(string processId) => processId switch
    {
        "cnc" => Icons.Material.Outlined.PrecisionManufacturing,
        "sla" => Icons.Material.Outlined.Science,
        _ => Icons.Material.Outlined.ViewInAr
    };

    private static string MaterialSwatch(string materialId) => materialId switch
    {
        "pla-black" => "linear-gradient(135deg, #222 0%, #555 100%)",
        "petg-clear" => "linear-gradient(135deg, #d9eef2 0%, #ffffff 100%)",
        "al6061" or "aluminum-6061" => "linear-gradient(135deg, #b9c2c5 0%, #f4f6f7 48%, #8d989d 100%)",
        "resin-gray" => "linear-gradient(135deg, #8f949b 0%, #c4c8ce 100%)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };
}
