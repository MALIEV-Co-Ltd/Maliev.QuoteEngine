@* Customer-safe ProjectNew-style part configuration sidebar. *@

<aside class="qe-pcs-sidebar">
    <header class="qe-pcs-header">
        <span>@Text("Configure", "ตั้งค่า")</span>
        <strong title="@Part.FileName">@Part.FileName</strong>
    </header>

    <div class="qe-pcs-scroll">
        <section class="qe-pcs-section"
                 data-config-section="manufacturing-process"
                 data-horizontal-wheel="true"
                 onwheel="const row = this.querySelector('.qe-pcs-process-row'); if (row && Math.abs(event.deltaY) >= Math.abs(event.deltaX)) { row.scrollLeft += event.deltaY; event.preventDefault(); }">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Manufacturing Process", "กระบวนการผลิต")</span>
            </div>
            <div class="qe-pcs-process-row">
                @foreach (var process in ReferenceData?.Processes ?? [])
                {
                    var active = Part.ProcessId == process.Id;
                    var cardClass = active
                        ? "qe-pcs-process-card qe-pcs-process-card--active"
                        : HasSelectedProcess ? "qe-pcs-process-card qe-pcs-process-card--dimmed" : "qe-pcs-process-card";
                    <button type="button"
                            class="@cardClass"
                            data-process-code="@process.Id"
                            aria-pressed="@active"
                            title="@process.Name"
                            @onclick="@(() => SetProcess(process))">
                        @if (active)
                        {
                            <span class="qe-pcs-process-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </span>
                        }
                        <span class="qe-pcs-process-photo"
                              style="background-image:url('/images/processes/@ProcessImageFile(process.Id)')"
                              role="img"
                              aria-label="@process.Name">
                        </span>
                        <span class="qe-pcs-process-name">@process.Name</span>
                        <span class="qe-pcs-process-description">@ProcessDescription(process.Id)</span>
                    </button>
                }
            </div>
        </section>

        <section class="qe-pcs-section" data-config-section="material">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Material", "วัสดุ")</span>
                <span class="qe-pcs-section-count">@FormatOptionCount(MaterialsFor(Part.ProcessId).Count())</span>
            </div>
            <div class="qe-pcs-cards">
                @foreach (var material in MaterialsFor(Part.ProcessId))
                {
                    var active = Part.MaterialId == material.Id;
                    <button type="button"
                            class="qe-pcs-mat-card @(active ? "qe-pcs-mat-card--active" : "")"
                            @onclick="@(() => SetMaterial(material))">
                        <span class="qe-pcs-mat-swatch" style="background:@MaterialSwatch(material.Id)"></span>
                        <span class="qe-pcs-mat-info">
                            <span class="qe-pcs-mat-name">@material.Name</span>
                            <span class="qe-pcs-mat-sub">@material.Grade / @material.Finish</span>
                        </span>
                        @if (active)
                        {
                            <span class="qe-pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </span>
                        }
                    </button>
                }
            </div>
        </section>

        @{
            var materialColorOptions = MaterialColorOptions.ToArray();
        }
        @if (materialColorOptions.Length > 0)
        {
            <section class="qe-pcs-section" data-config-section="material-color">
                <div class="qe-pcs-section-header">
                    <span class="qe-pcs-section-title">@Text("Material Color", "สีวัสดุ")</span>
                    <span class="qe-pcs-section-count">@FormatOptionCount(materialColorOptions.Length)</span>
                </div>
                <div class="qe-pcs-color-choice-grid">
                    @foreach (var color in materialColorOptions)
                    {
                        var active = Part.Color == color.Code;
                        <button type="button"
                                title="@color.Name"
                                class="qe-pcs-color-choice @(active ? "qe-pcs-color-choice--active" : "")"
                                @onclick="@(() => SetMaterialColor(color.Code))">
                            <span class="qe-pcs-color-chip" style="background:@color.CssValue"></span>
                            <span>@color.Name</span>
                            @if (active)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                        </button>
                    }
                </div>
            </section>
        }

        <section class="qe-pcs-section" data-config-section="surface-finish">
            @{
                var finishes = FinishesFor(Part.ProcessId).ToArray();
            }
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Surface Finish", "ผิวสำเร็จ")</span>
                <span class="qe-pcs-section-count">@FormatOptionCount(finishes.Length + 1)</span>
            </div>
            <div class="qe-pcs-cards">
                <button type="button"
                        class="qe-pcs-fin-card @(Part.FinishId is null ? "qe-pcs-fin-card--active" : "")"
                        @onclick="@(() => SetFinish((FinishOptionDto?)null))">
                    <span class="qe-pcs-fin-swatch" style="background:@FinishSwatch(null)"></span>
                    <span class="qe-pcs-fin-info">
                        <span class="qe-pcs-fin-name">@Text("Default finish", "ผิวมาตรฐาน")</span>
                        <span class="qe-pcs-fin-sub">@Text("Use the standard finish for the selected process.", "ใช้ผิวมาตรฐานสำหรับกระบวนการที่เลือก")</span>
                    </span>
                    <span class="qe-pcs-fin-price">@Text("Base", "พื้นฐาน")</span>
                </button>
                @foreach (var finish in finishes)
                {
                    var active = Part.FinishId == finish.Id || Part.FinishCode == finish.Code;
                    <button type="button"
                            class="qe-pcs-fin-card @(active ? "qe-pcs-fin-card--active" : "")"
                            @onclick="@(() => SetFinish(finish))">
                        <span class="qe-pcs-fin-swatch" style="background:@FinishSwatch(finish.Code)"></span>
                        <span class="qe-pcs-fin-info">
                            <span class="qe-pcs-fin-name">@finish.Name</span>
                            <span class="qe-pcs-fin-sub">@finish.Description</span>
                        </span>
                        <span class="qe-pcs-fin-price" title="@Text("Price multiplier over base cost", "ตัวคูณราคาจากราคาพื้นฐาน")">@FormatMultiplier(finish.PriceMultiplier)</span>
                        @if (active)
                        {
                            <span class="qe-pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </span>
                        }
                    </button>
                }
            </div>

        </section>

        @{
            var finishColorOptions = FinishColorOptions.ToArray();
        }
        @if (finishColorOptions.Length > 0)
        {
            <section class="qe-pcs-section" data-config-section="finish-options">
                <div class="qe-pcs-section-header">
                    <span class="qe-pcs-section-title">@Text("Finish Options", "ตัวเลือกผิวสำเร็จ")</span>
                    <span class="qe-pcs-section-count">@FormatOptionCount(finishColorOptions.Length)</span>
                </div>
                <div class="qe-pcs-options-stack">
                    @foreach (var option in finishColorOptions)
                    {
                        <div class="qe-pcs-option-row">
                            <span class="qe-pcs-option-label">@option.Label</span>
                            @if (option.IsPaint)
                            {
                                var paintHex = GetProcessOptionValue(PaintColorHexKey, string.Empty);
                                var paintReference = GetProcessOptionValue(PaintColorReferenceKey, string.Empty);
                                var customPaintSelected = IsCustomPaintColorSelected(paintHex, paintReference);
                                <div class="qe-pcs-color-choice-grid">
                                    @foreach (var paint in StandardPaintColors)
                                    {
                                        var active = IsPaintColorSelected(paint, paintHex, paintReference);
                                        <button type="button"
                                                class="qe-pcs-color-choice @(active ? "qe-pcs-color-choice--active" : "")"
                                                @onclick="@(() => SetStandardPaintColor(paint))">
                                            <span class="qe-pcs-color-chip" style="background:@paint.Hex"></span>
                                            <span>@paint.Name</span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    }
                                    <button type="button"
                                            class="qe-pcs-color-choice @(customPaintSelected ? "qe-pcs-color-choice--active" : "")"
                                            @onclick="SelectCustomPaintColor">
                                        <span class="qe-pcs-color-chip qe-pcs-color-chip--custom" style="background:@GetProcessOptionValue(PaintColorHexKey, "#111111")"></span>
                                        <span>@Text("Custom", "กำหนดเอง")</span>
                                        @if (customPaintSelected)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        }
                                    </button>
                                </div>
                                @if (customPaintSelected)
                                {
                                    <div class="qe-pcs-color-picker-row">
                                        <label class="qe-pcs-native-color">
                                            <span>@Text("Custom color", "สีที่กำหนดเอง")</span>
                                            <input type="color"
                                                   value="@GetProcessOptionValue(PaintColorHexKey, "#111111")"
                                                   @onchange="SetCustomPaintColorHex" />
                                        </label>
                                        <label class="qe-field qe-pcs-color-reference">
                                            @Text("Color name/code", "ชื่อหรือรหัสสี")
                                            <input value="@paintReference"
                                                   placeholder="RAL 9005, Pantone Black C"
                                                   @oninput="SetCustomPaintColorReference" />
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="qe-pcs-color-choice-grid">
                                    @foreach (var color in option.Choices)
                                    {
                                        var active = string.Equals(GetProcessOptionValue(option.ConfigKey, option.DefaultValue), color, StringComparison.OrdinalIgnoreCase);
                                        <button type="button"
                                                class="qe-pcs-color-choice @(active ? "qe-pcs-color-choice--active" : "")"
                                                @onclick="@(() => SetProcessOptionValue(option.ConfigKey, color))">
                                            <span class="qe-pcs-color-chip" style="background:@FinishOptionColorSwatch(color)"></span>
                                            <span>@FormatOptionLabel(color)</span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <section class="qe-pcs-section" data-config-section="tolerance">
            @{
                var tolerances = TolerancesFor(Part.ProcessId).ToArray();
            }
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Tolerance", "ค่าความคลาดเคลื่อน")</span>
                <span class="qe-pcs-section-count">@FormatOptionCount(tolerances.Length + 1)</span>
            </div>
            <div class="qe-pcs-tolerance-groups">
                <div class="qe-pcs-tolerance-group">
                    <div class="qe-pcs-tolerance-group-header">
                        <div>
                            <span class="qe-pcs-tolerance-group-title">@ToleranceGroupTitle()</span>
                            <span class="qe-pcs-tolerance-group-standard">@ToleranceGroupStandard()</span>
                        </div>
                        <span class="qe-pcs-tolerance-group-count">@FormatOptionCount(tolerances.Length + 1)</span>
                    </div>
                    <div class="qe-pcs-tol-grid">
                        <button type="button"
                                class="qe-pcs-tol-card @(Part.ToleranceId is null ? "qe-pcs-tol-card--active" : "")"
                                @onclick="@(() => SetTolerance((ToleranceOptionDto?)null))">
                            <span class="qe-pcs-tol-name">@Text("Default", "มาตรฐาน")</span>
                            <span class="qe-pcs-tol-grade">@Text("Process", "กระบวนการ")</span>
                            <span class="qe-pcs-tol-range">@Text("Base", "พื้นฐาน")</span>
                        </button>
                        @foreach (var tolerance in tolerances)
                        {
                            var active = Part.ToleranceId == tolerance.Id || Part.ToleranceCode == tolerance.Code;
                            <button type="button"
                                    class="qe-pcs-tol-card @(active ? "qe-pcs-tol-card--active" : "")"
                                    title="@tolerance.Description"
                                    @onclick="@(() => SetTolerance(tolerance))">
                                <span class="qe-pcs-tol-name">@tolerance.Name</span>
                                <span class="qe-pcs-tol-grade">@tolerance.Code</span>
                                <span class="qe-pcs-tol-range" title="@Text("Price multiplier over base cost", "ตัวคูณราคาจากราคาพื้นฐาน")">@FormatMultiplier(tolerance.PriceMultiplier)</span>
                                @if (active)
                                {
                                    <span class="qe-pcs-tol-check">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>

        @if (IsCnc)
        {
            <section class="qe-pcs-section" data-config-section="surface-roughness">
                @{
                    var roughnessOptions = RoughnessFor(Part.ProcessId).ToArray();
                }
                <div class="qe-pcs-section-header">
                    <span class="qe-pcs-section-title">@Text("Surface Roughness", "ความหยาบผิว")</span>
                    <span class="qe-pcs-section-count">@FormatOptionCount(roughnessOptions.Length)</span>
                </div>
                <div class="qe-pcs-cards">
                    @foreach (var roughness in roughnessOptions)
                    {
                        var active = Part.RoughnessCode == roughness.Code;
                        <button type="button"
                                class="qe-pcs-choice-card qe-pcs-roughness-card @(active ? "qe-pcs-choice-card--active" : "")"
                                @onclick="@(() => SetRoughness(roughness.Code))">
                            <span class="qe-pcs-choice-swatch qe-pcs-roughness-swatch"
                                  style="background-image:url('@GetRoughnessImageUrl(roughness.Code)')">
                                <MudIcon Icon="@Icons.Material.Outlined.Grain" Size="Size.Small" />
                            </span>
                            <span class="qe-pcs-choice-info">
                                <span class="qe-pcs-choice-name">@roughness.Name</span>
                                <span class="qe-pcs-choice-sub">@roughness.Description</span>
                            </span>
                            @if (active)
                            {
                                <span class="qe-pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </span>
                            }
                        </button>
                    }
                </div>
            </section>
        }

        <section class="qe-pcs-section" data-config-section="part-features">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Part Features", "ฟีเจอร์ชิ้นงาน")</span>
                <span class="qe-pcs-section-count">@Text("2 options", "2 ตัวเลือก")</span>
            </div>
            <div class="qe-pcs-feature-toggle-grid">
                <button type="button"
                        class="qe-pcs-feature-card qe-pcs-choice-card @(Part.HasThreadedHoles ? "qe-pcs-choice-card--active" : "")"
                        @onclick="ToggleThreadedHoles">
                    <span class="qe-pcs-choice-swatch">
                        <MudIcon Icon="@Icons.Material.Outlined.Construction" Size="Size.Small" />
                    </span>
                    <span class="qe-pcs-choice-info">
                        <span class="qe-pcs-choice-name">@Text("Tapped holes", "รูเกลียว")</span>
                        <span class="qe-pcs-choice-sub">@Text("Internal threads cut into the part.", "เกลียวภายในที่ตัดลงบนชิ้นงาน")</span>
                    </span>
                    @if (Part.HasThreadedHoles)
                    {
                        <span class="qe-pcs-card-check">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        </span>
                    }
                </button>
                <button type="button"
                        class="qe-pcs-feature-card qe-pcs-choice-card @(HasInserts ? "qe-pcs-choice-card--active" : "")"
                        @onclick="ToggleInserts">
                    <span class="qe-pcs-choice-swatch">
                        <MudIcon Icon="@Icons.Material.Outlined.Hardware" Size="Size.Small" />
                    </span>
                    <span class="qe-pcs-choice-info">
                        <span class="qe-pcs-choice-name">@Text("Thread inserts", "อินเสิร์ตเกลียว")</span>
                        <span class="qe-pcs-choice-sub">@Text("Installed threaded hardware such as heat-set inserts.", "ฮาร์ดแวร์เกลียวที่ติดตั้ง เช่น heat-set inserts")</span>
                    </span>
                    @if (HasInserts)
                    {
                        <span class="qe-pcs-card-check">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        </span>
                    }
                </button>
            </div>

            @if (Part.HasThreadedHoles)
            {
                <div class="qe-inline-fields qe-pcs-feature-fields">
                    <label class="qe-field">
                        @Text("Spec", "สเปก")
                        <input value="@Part.ThreadSpecification" @oninput="SetThreadSpecification" placeholder="M3x0.5" />
                    </label>
                    <label class="qe-field">
                        @Text("Count", "จำนวน")
                        <input type="number" min="0" value="@Part.ThreadedHoleCount" @oninput="SetThreadedHoleCount" />
                    </label>
                </div>
                @if (IsThreadSpecInvalid)
                {
                    <p class="qe-pcs-field-warning">@Text("Enter a standard metric or UNC thread spec, e.g. M3x0.5, M6x1, #6-32, 1/4-20", "ป้อนสเปกเกลียวมาตรฐาน เช่น M3x0.5, M6x1, #6-32, 1/4-20")</p>
                }
            }

            @if (HasInserts)
            {
                <div class="qe-pcs-insert-type-grid">
                    @foreach (var option in InsertOptions)
                    {
                        var active = string.Equals(Part.InsertType, option, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="qe-pcs-insert-type @(active ? "qe-pcs-insert-type--active" : "")"
                                @onclick="@(() => SetInsertType(option))">@option</button>
                    }
                </div>
                <label class="qe-field qe-pcs-feature-count">
                    @Text("Insert count", "จำนวนอินเสิร์ต")
                    <input type="number" min="0" value="@Part.InsertCount" @oninput="SetInsertCount" />
                </label>
            }
        </section>

        @{
            var visibleProcessOptions = VisibleProcessOptions.ToArray();
        }
        @if (visibleProcessOptions.Length > 0)
        {
            <section class="qe-pcs-section" data-config-section="process-options">
                <div class="qe-pcs-section-header">
                    <span class="qe-pcs-section-title">@Text("Options", "ตัวเลือก")</span>
                    <span class="qe-pcs-section-count">@FormatOptionCount(visibleProcessOptions.Length)</span>
                </div>
                <div class="qe-pcs-options-stack">
                    @foreach (var option in visibleProcessOptions)
                    {
                        <div class="qe-pcs-option-row">
                            @if (IsBooleanOption(option))
                            {
                                var enabled = GetProcessOptionBool(option.ConfigKey);
                                <button type="button"
                                        class="qe-pcs-choice-card qe-pcs-process-option-card @(enabled ? "qe-pcs-choice-card--active" : "")"
                                        @onclick="@(() => SetProcessOptionBool(option.ConfigKey, !enabled))">
                                    <span class="qe-pcs-choice-swatch">
                                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                                    </span>
                                    <span class="qe-pcs-choice-info">
                                        <span class="qe-pcs-choice-name">@option.Label</span>
                                        <span class="qe-pcs-choice-sub">@option.HelpText</span>
                                    </span>
                                    @if (enabled)
                                    {
                                        <span class="qe-pcs-card-check">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        </span>
                                    }
                                </button>
                            }
                            else if (IsCardChoiceOption(option))
                            {
                                var currentValue = GetProcessOptionValue(option.ConfigKey, option.DefaultValue);
                                <span class="qe-pcs-option-label">@option.Label</span>
                                <div class="qe-pcs-cards">
                                    @foreach (var choice in GetProcessOptionChoices(option))
                                    {
                                        var active = string.Equals(currentValue, choice, StringComparison.OrdinalIgnoreCase);
                                        <button type="button"
                                                class="qe-pcs-choice-card qe-pcs-process-option-card @(active ? "qe-pcs-choice-card--active" : "")"
                                                @onclick="@(() => SetProcessOptionValue(option.ConfigKey, choice))">
                                            <span class="qe-pcs-choice-swatch">
                                                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                                            </span>
                                            <span class="qe-pcs-choice-info">
                                                <span class="qe-pcs-choice-name">@FormatOptionLabel(choice)</span>
                                                <span class="qe-pcs-choice-sub">@option.HelpText</span>
                                            </span>
                                            @if (active)
                                            {
                                                <span class="qe-pcs-card-check">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                </span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <label class="qe-field">
                                    @option.Label
                                    <input value="@GetProcessOptionValue(option.ConfigKey, option.DefaultValue)"
                                           placeholder="@option.HelpText"
                                           @oninput="@(args => SetProcessOptionText(option.ConfigKey, args))" />
                                </label>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <section class="qe-pcs-section" data-config-section="inspection">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Inspection", "การตรวจสอบ")</span>
                <span class="qe-pcs-section-count">@FormatOptionCount((ReferenceData?.InspectionLevels.Count ?? 0))</span>
            </div>
            <div class="qe-pcs-cards">
                @foreach (var inspection in ReferenceData?.InspectionLevels ?? [])
                {
                    var active = string.Equals(Part.InspectionLevel, inspection.Code, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="qe-pcs-choice-card @(active ? "qe-pcs-choice-card--active" : "")"
                            @onclick="@(() => SetInspection(inspection.Code))">
                        <span class="qe-pcs-choice-swatch">
                            <MudIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Small" />
                        </span>
                        <span class="qe-pcs-choice-info">
                            <span class="qe-pcs-choice-name">@inspection.Name</span>
                            <span class="qe-pcs-choice-sub">@inspection.Description</span>
                        </span>
                        @if (active)
                        {
                            <span class="qe-pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </span>
                        }
                    </button>
                }
            </div>
        </section>

        <section class="qe-pcs-section" data-config-section="quantity">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Quantity", "จำนวน")</span>
            </div>
            <div class="qe-pcs-qty-stack">
                <div class="qe-qty-stepper">
                    <button type="button"
                            class="qe-qty-stepper-btn"
                            disabled="@(Part.Quantity <= 1)"
                            @onclick="DecrementQuantity">-</button>
                    <input type="number"
                           class="qe-qty-stepper-input"
                           aria-label="@Text("Quantity", "จำนวน")"
                           min="1"
                           value="@Part.Quantity"
                           @oninput="SetQuantityInput" />
                    <button type="button" class="qe-qty-stepper-btn" @onclick="IncrementQuantity">+</button>
                </div>
                <div class="qe-qty-presets">
                    @foreach (var preset in QuantityPresets)
                    {
                        var value = preset;
                        <button type="button"
                                class="qe-qty-preset-btn @(Part.Quantity == value ? "qe-qty-preset-btn--active" : "")"
                                @onclick="@(() => SetQuantityPreset(value))">@value</button>
                    }
                </div>
            </div>
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("DFM Review", "การตรวจ DFM")</span>
                <MudTooltip Text="@Text("Design for Manufacturability (DFM) flags features that could be difficult or costly to produce — such as thin walls, sharp internal corners, or unsupported overhangs.", "การวิเคราะห์ DFM ตรวจหาฟีเจอร์ที่อาจยากหรือมีต้นทุนสูงในการผลิต เช่น ผนังบาง มุมฉากภายใน หรือส่วนที่ยื่นออกมา")" Placement="Placement.Left" Arrow="true">
                    <span class="qe-pcs-help-link" tabindex="0">@Text("What is DFM?", "DFM คืออะไร?")</span>
                </MudTooltip>
            </div>
            <label class="qe-pcs-choice-card qe-pcs-dfm-review-card @(Part.DfmAcknowledged ? "qe-pcs-choice-card--active" : "")">
                <input type="checkbox"
                       class="qe-pcs-choice-input"
                       aria-label="@Text("DFM reviewed", "ตรวจ DFM แล้ว")"
                       checked="@Part.DfmAcknowledged"
                       @onchange="SetDfmAcknowledged" />
                <span class="qe-pcs-choice-swatch">
                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                </span>
                <span class="qe-pcs-choice-info">
                    <span class="qe-pcs-choice-name">@Text("DFM reviewed", "ตรวจ DFM แล้ว")</span>
                    <span class="qe-pcs-choice-sub">@Text("I understand the highlighted manufacturing notes.", "ฉันเข้าใจหมายเหตุการผลิตที่เน้นไว้")</span>
                </span>
            </label>
        </section>

        <section class="qe-pcs-section">
            <div class="qe-pcs-section-header">
                <span class="qe-pcs-section-title">@Text("Production notes", "หมายเหตุการผลิต")</span>
            </div>
            <textarea class="qe-pcs-notes-input"
                      rows="4"
                      value="@Part.PartNotes"
                      placeholder="@Text("Customer-visible notes for tolerances, fit, cosmetic faces, packaging, or inspection.", "หมายเหตุที่ลูกค้าเห็นได้ เช่น tolerance, fit, ผิวที่ต้องการความสวยงาม, บรรจุภัณฑ์ หรือการตรวจสอบ")"
                      @oninput="SetPartNotes"></textarea>
        </section>
    </div>
</aside>

@code {
    private const string PaintColorKey = "paint_color";
    private const string PaintColorHexKey = "paint_color_hex";
    private const string PaintColorReferenceKey = "paint_color_reference";
    private const string AnodizeColorKey = "anodize_color";

    private static readonly int[] QuantityPresets = [1, 5, 10, 25, 50];
    private static readonly string[] InsertOptions = ["HeatSet", "PressFit", "Ultrasonic"];
    private static readonly PaintColorOption[] StandardPaintColors =
    [
        new("Black", "#111111", "RAL 9005"),
        new("White", "#f5f5f5", "RAL 9016"),
        new("Light Gray", "#b8bfcc", "RAL 7035"),
        new("Red", "#c62828", "RAL 3020"),
        new("Blue", "#1565c0", "RAL 5015"),
        new("Green", "#2e7d32", "RAL 6002")
    ];

    private static readonly System.Text.RegularExpressions.Regex _threadSpecRegex =
        new(@"^(M\d+(\.\d+)?([xX]\d+(\.\d+)?)?|#\d+-\d+|\d+/\d+-\d+)$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    [Parameter, EditorRequired] public QuotePartViewModel Part { get; set; } = new();
    [Parameter] public QuoteReferenceDataResponse? ReferenceData { get; set; }
    [Parameter] public EventCallback<QuotePartViewModel> OnPartChanged { get; set; }

    [CascadingParameter(Name = "Culture")]
    private string Culture { get; set; } = SupportedCultures.DefaultCulture;

    private bool IsCnc => Part.ProcessId.Equals("cnc", StringComparison.OrdinalIgnoreCase);
    private bool HasSelectedProcess => !string.IsNullOrWhiteSpace(Part.ProcessId);
    private bool HasInserts => !string.IsNullOrWhiteSpace(Part.InsertType)
        && !Part.InsertType.Equals("None", StringComparison.OrdinalIgnoreCase);

    private bool IsThreadSpecInvalid =>
        Part.HasThreadedHoles &&
        !string.IsNullOrWhiteSpace(Part.ThreadSpecification) &&
        !_threadSpecRegex.IsMatch(Part.ThreadSpecification.Trim());

    private IEnumerable<MaterialOptionDto> MaterialsFor(string processId) =>
        (ReferenceData?.Materials ?? []).Where(item => item.ProcessId == processId);

    private IEnumerable<FinishOptionDto> FinishesFor(string processId) =>
        (ReferenceData?.Finishes ?? []).Where(item => item.ProcessId == processId);

    private IEnumerable<ToleranceOptionDto> TolerancesFor(string processId) =>
        (ReferenceData?.Tolerances ?? []).Where(item => item.ProcessId == processId);

    private IEnumerable<RoughnessOptionDto> RoughnessFor(string processId) =>
        (ReferenceData?.RoughnessOptions ?? []).Where(item => item.ProcessId == processId);

    private IEnumerable<ColorOptionDto> ColorsFor(string materialId)
    {
        var colors = (ReferenceData?.Colors ?? [])
            .Where(item => item.MaterialIds.Count == 0 || item.MaterialIds.Contains(materialId, StringComparer.OrdinalIgnoreCase))
            .ToArray();
        return colors.Length == 0
            ? [new ColorOptionDto("Default", "Default", MaterialSwatch(materialId), [materialId])]
            : colors;
    }

    private IEnumerable<ColorOptionDto> MaterialColorOptions => ColorsFor(Part.MaterialId);

    private IEnumerable<ProcessConfigOptionDto> VisibleProcessOptions =>
        (ReferenceData?.ProcessOptions ?? [])
            .Where(option => string.Equals(option.ProcessId, Part.ProcessId, StringComparison.OrdinalIgnoreCase))
            .Where(option => !IsDedicatedFinishOption(option))
            .Where(option => !IsHiddenCustomerOption(option));

    private IEnumerable<FinishColorOption> FinishColorOptions
    {
        get
        {
            var normalized = NormalizeOptionText($"{Part.FinishId} {Part.FinishCode}");
            if (normalized.Contains("paint", StringComparison.Ordinal)
                || normalized.Contains("powder", StringComparison.Ordinal)
                || normalized.Contains("coat", StringComparison.Ordinal))
            {
                yield return new FinishColorOption(PaintColorKey, Text("Paint color", "สีพ่น"), true, [], string.Empty);
            }

            if (normalized.Contains("anod", StringComparison.Ordinal))
            {
                yield return new FinishColorOption(
                    AnodizeColorKey,
                    Text("Anodize color", "สีอโนไดซ์"),
                    false,
                    ["Clear", "Black", "Blue", "Red", "Green"],
                    "Clear");
            }
        }
    }

    private async Task SetProcess(ProcessOptionDto process)
    {
        Part.ProcessId = process.Id;
        Part.LocalDfmRuntimeUnavailable = false;
        Part.LocalDfmRuntimeUnavailableReason = null;
        Part.LocalDfmRuntimeRunningProcessId = null;
        Part.LocalDfmRuntimeStartedAtUtc = null;
        var material = MaterialsFor(process.Id).FirstOrDefault();
        if (material is not null)
        {
            Part.MaterialId = material.Id;
        }

        ApplyCatalogDefaults();
        await NotifyChanged();
    }

    private async Task SetMaterial(MaterialOptionDto material)
    {
        Part.MaterialId = material.Id;
        Part.Color = ColorsFor(Part.MaterialId).FirstOrDefault()?.Code;
        await NotifyChanged();
    }

    private async Task SetFinish(FinishOptionDto? finish)
    {
        Part.FinishId = finish?.Id;
        Part.FinishCode = finish?.Code;
        ApplyFinishOptionDefaults();
        await NotifyChanged();
    }

    private async Task SetTolerance(ToleranceOptionDto? tolerance)
    {
        Part.ToleranceId = tolerance?.Id;
        Part.ToleranceCode = tolerance?.Code;
        await NotifyChanged();
    }

    private async Task SetInspection(string code)
    {
        Part.InspectionLevel = code;
        await NotifyChanged();
    }

    private async Task SetRoughness(string? code)
    {
        Part.RoughnessCode = string.IsNullOrWhiteSpace(code) ? null : code;
        await NotifyChanged();
    }

    private async Task SetMaterialColor(string color)
    {
        Part.Color = color;
        await NotifyChanged();
    }

    private async Task SetStandardPaintColor(PaintColorOption paint)
    {
        await SetProcessOptionValue(PaintColorHexKey, paint.Hex, notify: false);
        await SetProcessOptionValue(PaintColorReferenceKey, paint.Reference, notify: false);
        await SetProcessOptionValue(PaintColorKey, paint.Reference);
    }

    private async Task SelectCustomPaintColor()
    {
        var currentHex = GetProcessOptionValue(PaintColorHexKey, "#111111");
        var currentReference = GetProcessOptionValue(PaintColorReferenceKey, string.Empty);
        if (StandardPaintColors.Any(paint => IsPaintColorSelected(paint, currentHex, currentReference)))
        {
            currentReference = string.Empty;
        }

        await SetProcessOptionValue(PaintColorHexKey, currentHex, notify: false);
        await SetProcessOptionValue(PaintColorReferenceKey, currentReference, notify: false);
        await SetProcessOptionValue(PaintColorKey, string.IsNullOrWhiteSpace(currentReference) ? currentHex : currentReference);
    }

    private async Task SetCustomPaintColorHex(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        await SetProcessOptionValue(PaintColorHexKey, value, notify: false);
        await SetProcessOptionValue(PaintColorKey, string.IsNullOrWhiteSpace(GetProcessOptionValue(PaintColorReferenceKey, string.Empty))
            ? value
            : GetProcessOptionValue(PaintColorReferenceKey, string.Empty));
    }

    private async Task SetCustomPaintColorReference(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        await SetProcessOptionValue(PaintColorReferenceKey, value, notify: false);
        await SetProcessOptionValue(PaintColorKey, string.IsNullOrWhiteSpace(value)
            ? GetProcessOptionValue(PaintColorHexKey, "#111111")
            : value);
    }

    private async Task SetProcessOptionValue(string key, string? value, bool notify = true)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Part.ProcessOptionValues.Remove(key);
        }
        else
        {
            Part.ProcessOptionValues[key] = value.Trim();
        }

        if (notify)
        {
            await NotifyChanged();
        }
    }

    private async Task SetProcessOptionBool(string key, bool value)
    {
        await SetProcessOptionValue(key, value ? "true" : null);
    }

    private async Task SetProcessOptionText(string key, ChangeEventArgs args)
    {
        await SetProcessOptionValue(key, args.Value?.ToString());
    }

    private async Task ToggleThreadedHoles()
    {
        Part.HasThreadedHoles = !Part.HasThreadedHoles;
        if (!Part.HasThreadedHoles)
        {
            Part.ThreadSpecification = null;
            Part.ThreadedHoleCount = 0;
        }
        else if (Part.ThreadedHoleCount == 0)
        {
            Part.ThreadedHoleCount = 1;
        }

        await NotifyChanged();
    }

    private async Task ToggleInserts()
    {
        if (HasInserts)
        {
            Part.InsertType = "None";
            Part.InsertCount = 0;
        }
        else
        {
            Part.InsertType = InsertOptions[0];
            Part.InsertCount = Math.Max(Part.InsertCount, 1);
        }

        await NotifyChanged();
    }

    private async Task SetThreadSpecification(ChangeEventArgs args)
    {
        Part.ThreadSpecification = args.Value?.ToString();
        await NotifyChanged();
    }

    private async Task SetThreadedHoleCount(ChangeEventArgs args)
    {
        Part.ThreadedHoleCount = ParseNonNegativeInt(args.Value, Part.ThreadedHoleCount);
        await NotifyChanged();
    }

    private async Task SetInsertType(string type)
    {
        Part.InsertType = type;
        Part.InsertCount = Math.Max(Part.InsertCount, 1);
        await NotifyChanged();
    }

    private async Task SetInsertCount(ChangeEventArgs args)
    {
        Part.InsertCount = ParseNonNegativeInt(args.Value, Part.InsertCount);
        await NotifyChanged();
    }

    private async Task IncrementQuantity()
    {
        Part.Quantity++;
        await NotifyChanged();
    }

    private async Task DecrementQuantity()
    {
        if (Part.Quantity > 1)
        {
            Part.Quantity--;
            await NotifyChanged();
        }
    }

    private async Task SetQuantityPreset(int quantity)
    {
        Part.Quantity = Math.Max(1, quantity);
        await NotifyChanged();
    }

    private async Task SetQuantityInput(ChangeEventArgs args)
    {
        Part.Quantity = int.TryParse(args.Value?.ToString(), out var quantity)
            ? Math.Max(1, quantity)
            : 1;
        await NotifyChanged();
    }

    private async Task SetDfmAcknowledged(ChangeEventArgs args)
    {
        Part.DfmAcknowledged = args.Value is bool value && value;
        await NotifyChanged();
    }

    private async Task SetPartNotes(ChangeEventArgs args)
    {
        Part.PartNotes = args.Value?.ToString();
        await NotifyChanged();
    }

    private void ApplyCatalogDefaults()
    {
        var finish = FinishesFor(Part.ProcessId).FirstOrDefault();
        Part.FinishId = finish?.Id;
        Part.FinishCode = finish?.Code;

        var tolerance = TolerancesFor(Part.ProcessId).FirstOrDefault();
        Part.ToleranceId = tolerance?.Id;
        Part.ToleranceCode = tolerance?.Code;

        Part.InspectionLevel = ReferenceData?.InspectionLevels.FirstOrDefault()?.Code ?? "STANDARD";
        Part.RoughnessCode = RoughnessFor(Part.ProcessId).FirstOrDefault()?.Code;
        Part.Color = ColorsFor(Part.MaterialId).FirstOrDefault()?.Code;
        ApplyFinishOptionDefaults();
    }

    private async Task NotifyChanged()
    {
        await OnPartChanged.InvokeAsync(Part);
    }

    private static int ParseNonNegativeInt(object? value, int fallback)
    {
        return int.TryParse(value?.ToString(), out var parsed) ? Math.Max(0, parsed) : fallback;
    }

    private string FormatOptionCount(int count)
    {
        return count == 1
            ? Text("1 option", "1 ตัวเลือก")
            : $"{count} {Text("options", "ตัวเลือก")}";
    }

    private string FormatMultiplier(decimal multiplier) => multiplier switch
    {
        1m => Text("Base", "พื้นฐาน"),
        > 1m => $"+{Math.Round((multiplier - 1m) * 100m)}%",
        < 1m => $"-{Math.Round((1m - multiplier) * 100m)}%"
    };

    private string ToleranceGroupTitle() => IsCnc
        ? Text("Machining tolerance", "ค่าความคลาดเคลื่อนงานกลึงกัด")
        : Text("Process tolerance", "ค่าความคลาดเคลื่อนตามกระบวนการ");

    private string ToleranceGroupStandard() => Part.ProcessId.ToLowerInvariant() switch
    {
        "cnc" => "ISO 2768",
        "sla" => Text("Resin print standard", "มาตรฐานงานพิมพ์เรซิน"),
        _ => Text("Manufacturing standard", "มาตรฐานการผลิต")
    };

    private void ApplyFinishOptionDefaults()
    {
        var options = FinishColorOptions.ToArray();
        if (!options.Any(option => option.IsPaint))
        {
            Part.ProcessOptionValues.Remove(PaintColorKey);
            Part.ProcessOptionValues.Remove(PaintColorHexKey);
            Part.ProcessOptionValues.Remove(PaintColorReferenceKey);
        }
        else if (!Part.ProcessOptionValues.ContainsKey(PaintColorKey))
        {
            var paint = StandardPaintColors[0];
            Part.ProcessOptionValues[PaintColorHexKey] = paint.Hex;
            Part.ProcessOptionValues[PaintColorReferenceKey] = paint.Reference;
            Part.ProcessOptionValues[PaintColorKey] = paint.Reference;
        }

        var anodizeOption = options.FirstOrDefault(option =>
            string.Equals(option.ConfigKey, AnodizeColorKey, StringComparison.OrdinalIgnoreCase));
        if (anodizeOption is null)
        {
            Part.ProcessOptionValues.Remove(AnodizeColorKey);
        }
        else if (!Part.ProcessOptionValues.ContainsKey(AnodizeColorKey))
        {
            Part.ProcessOptionValues[AnodizeColorKey] = anodizeOption.DefaultValue;
        }
    }

    private string GetProcessOptionValue(string key, string defaultValue) =>
        Part.ProcessOptionValues.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : defaultValue;

    private bool GetProcessOptionBool(string key) =>
        Part.ProcessOptionValues.TryGetValue(key, out var value)
        && bool.TryParse(value, out var parsed)
        && parsed;

    private static bool IsBooleanOption(ProcessConfigOptionDto option) =>
        option.ConfigType.Equals("boolean", StringComparison.OrdinalIgnoreCase)
        || option.ConfigType.Equals("checkbox", StringComparison.OrdinalIgnoreCase)
        || option.ConfigKey.Contains("deburr", StringComparison.OrdinalIgnoreCase);

    private static bool IsCardChoiceOption(ProcessConfigOptionDto option) =>
        option.ConfigType.Equals("dropdown", StringComparison.OrdinalIgnoreCase)
        || option.ConfigType.Equals("select", StringComparison.OrdinalIgnoreCase)
        || option.Choices.Count > 0;

    private static IEnumerable<string> GetProcessOptionChoices(ProcessConfigOptionDto option) =>
        option.Choices.Count > 0 ? option.Choices : [option.DefaultValue];

    private static bool IsDedicatedFinishOption(ProcessConfigOptionDto option)
    {
        var normalized = NormalizeOptionText($"{option.ConfigKey} {option.Label}");
        return normalized.Contains("paintcolor", StringComparison.Ordinal)
            || normalized.Contains("powdercoatcolor", StringComparison.Ordinal)
            || normalized.Contains("anodizecolor", StringComparison.Ordinal)
            || normalized.Contains("anodisecolor", StringComparison.Ordinal);
    }

    private static bool IsHiddenCustomerOption(ProcessConfigOptionDto option)
    {
        var normalized = NormalizeOptionText($"{option.ConfigKey} {option.Label}");
        return normalized.Contains("layerheight", StringComparison.Ordinal)
            || normalized.Contains("infill", StringComparison.Ordinal)
            || normalized.Contains("supporttype", StringComparison.Ordinal)
            || normalized.Contains("threadspec", StringComparison.Ordinal)
            || normalized.Contains("threadedhole", StringComparison.Ordinal)
            || normalized.Contains("threadinsert", StringComparison.Ordinal)
            || normalized.Contains("uvcure", StringComparison.Ordinal)
            || normalized.Contains("postcure", StringComparison.Ordinal)
            || normalized.Contains("undercut", StringComparison.Ordinal);
    }

    private static bool IsPaintColorSelected(PaintColorOption paint, string? paintHex, string? paintReference) =>
        string.Equals(paint.Hex, paintHex, StringComparison.OrdinalIgnoreCase)
        || string.Equals(paint.Reference, paintReference, StringComparison.OrdinalIgnoreCase);

    private static bool IsCustomPaintColorSelected(string? paintHex, string? paintReference) =>
        !string.IsNullOrWhiteSpace(paintHex)
        && !StandardPaintColors.Any(paint => IsPaintColorSelected(paint, paintHex, paintReference));

    private string FormatOptionLabel(string value) => value.Replace('_', ' ');

    private static string FinishOptionColorSwatch(string value) => NormalizeOptionText(value) switch
    {
        "black" => "#111111",
        "blue" => "#1565c0",
        "red" => "#c62828",
        "green" => "#2e7d32",
        "clear" => "linear-gradient(135deg, #f8fafc, #cfd8dc)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };

    private static string GetRoughnessImageUrl(string code) =>
        "/images/materials/" + (NormalizeOptionText(code) switch
        {
            var normalized when normalized.Contains("ra04", StringComparison.Ordinal) => "roughness-ra-0-4-part-surface.webp",
            var normalized when normalized.Contains("ra08", StringComparison.Ordinal) => "roughness-ra-0-8-part-surface.webp",
            var normalized when normalized.Contains("ra16", StringComparison.Ordinal) => "roughness-ra-1-6-part-surface.webp",
            _ => "roughness-ra-3-2-part-surface.webp",
        });

    private string Text(string en, string th)
    {
        return SupportedCultures.Normalize(Culture) == SupportedCultures.ThaiCulture ? th : en;
    }

    private static string ProcessImageFile(string processId) => NormalizeProcessAssetCode(processId) + ".jpg";

    private string ProcessDescription(string processId)
    {
        var description = ReferenceData?.Processes.FirstOrDefault(process =>
            string.Equals(process.Id, processId, StringComparison.OrdinalIgnoreCase))?.Description;

        return !string.IsNullOrWhiteSpace(description)
            ? description
            : NormalizeProcessAssetCode(processId) switch
            {
                "cnc" or "cnc_mill" => Text("Precision machined parts", "ชิ้นงานกลึงกัดความแม่นยำ"),
                "cnc_turn" => Text("Lathe-turned cylindrical parts", "ชิ้นงานทรงกระบอกกลึง"),
                "sla" or "sla_dlp" => Text("High-detail resin printing", "พิมพ์เรซินรายละเอียดสูง"),
                "fdm" => Text("Fast functional prototypes", "ต้นแบบใช้งานจริงที่รวดเร็ว"),
                "sls" => Text("Strong nylon production parts", "ชิ้นงานไนลอนแข็งแรง"),
                "mjf" => Text("Production-grade nylon batches", "ผลิตเป็นชุดด้วยไนลอน"),
                "sheet_metal" => Text("Cut and bent sheet metal", "ตัดและพับโลหะแผ่น"),
                _ => Text("Custom manufacturing route", "กระบวนการผลิตแบบกำหนดเอง")
            };
    }

    private static string NormalizeProcessAssetCode(string processId)
    {
        var normalized = processId.Trim().ToLowerInvariant().Replace('-', '_');
        return normalized switch
        {
            "sla" => "sla_dlp",
            "cnc_milling" => "cnc_mill",
            "cnc_turning" => "cnc_turn",
            "sheetmetal" => "sheet_metal",
            _ => normalized
        };
    }

    private static string NormalizeOptionText(string value)
    {
        var builder = new System.Text.StringBuilder(value.Length);
        foreach (var ch in value.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(ch))
            {
                builder.Append(ch);
            }
        }

        return builder.ToString();
    }

    private static string MaterialSwatch(string materialId) => materialId switch
    {
        "pla-black" => "linear-gradient(135deg, #222 0%, #555 100%)",
        "petg-clear" => "linear-gradient(135deg, #d9eef2 0%, #ffffff 100%)",
        "al6061" or "aluminum-6061" => "linear-gradient(135deg, #b9c2c5 0%, #f4f6f7 48%, #8d989d 100%)",
        "resin-gray" => "linear-gradient(135deg, #8f949b 0%, #c4c8ce 100%)",
        _ => "linear-gradient(135deg, #fafafa 0%, #ebebeb 100%)"
    };

    private static string FinishSwatch(string? finishCode) => finishCode?.ToLowerInvariant() switch
    {
        "vapor_smooth" => "linear-gradient(135deg, #e8f0f8, #b8cad8)",
        "sanded_primer" => "linear-gradient(135deg, #d8dbe0, #aeb4bd)",
        "bead_blast_clear" => "linear-gradient(135deg, #d4d8e0, #aeb5bf)",
        "as_machined" => "repeating-linear-gradient(90deg, #d4d8e0, #d4d8e0 1px, #b8bcc4 1px, #b8bcc4 2px)",
        "matte" => "repeating-linear-gradient(0deg, #d4d8e0, #d4d8e0 2px, #c4c8d0 2px, #c4c8d0 3px)",
        _ => "linear-gradient(135deg, #e8ecf2, #c0c6d0)"
    };

    private sealed record PaintColorOption(string Name, string Hex, string Reference);

    private sealed record FinishColorOption(
        string ConfigKey,
        string Label,
        bool IsPaint,
        IReadOnlyList<string> Choices,
        string DefaultValue);
}
