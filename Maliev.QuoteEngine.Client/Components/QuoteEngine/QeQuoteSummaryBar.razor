@* Customer-facing quote summary bar matching the ProjectNew bottom action surface. *@

<footer class="qe-qsb-root">
    <div class="qe-qsb-zone qe-qsb-customer">
        <span class="qe-zone-label">Bill To</span>
        <strong>@BillingName</strong>
        <small>@BillingHint</small>
    </div>

    <div class="qe-qsb-divider"></div>

    <div class="qe-qsb-zone qe-qsb-lead">
        <span class="qe-zone-label">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
            Lead Time
        </span>
        <div class="qe-qsb-lead-options">
            @foreach (var leadTime in ReferenceData?.LeadTimes ?? [])
            {
                var active = LeadTimeCode == leadTime.Code;
                <button type="button"
                        class="qe-qsb-lead-btn @(active ? "qe-qsb-lead-btn--active" : "")"
                        @onclick="@(() => OnLeadTimeSelected.InvokeAsync(leadTime.Code))">
                    <span>
                        <strong>@leadTime.Name</strong>
                        <small>@leadTime.BusinessDays business days</small>
                    </span>
                    <em>@LeadTimeBadge(leadTime)</em>
                </button>
            }
        </div>
    </div>

    <div class="qe-qsb-divider"></div>

    <div class="qe-qsb-zone qe-qsb-total">
        <span class="qe-zone-label">Quote Total</span>
        <strong>@(Estimate is null ? "--" : $"{Estimate.Total:N2} {Estimate.Currency}")</strong>
        @if (Estimate is not null)
        {
            <span class="qe-qsb-ships-date">
                Ships by <strong>@ComputeShipDate()</strong>
            </span>
        }

        <div class="qe-qsb-actions">
            <button type="button" class="qe-secondary-btn" disabled="@(!Parts.Any())" @onclick="OnCalculateRequested">
                <MudIcon Icon="@Icons.Material.Outlined.Calculate" Size="Size.Small" />
                Estimate
            </button>
            <button type="button" class="qe-secondary-btn" disabled="@(Estimate is null)" @onclick="@(() => _detailsOpen = !_detailsOpen)">
                <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" />
                Details
            </button>
            <button type="button" class="qe-secondary-btn" disabled="@(!CanRequestFormalQuote)" @onclick="OnQuoteRequested">
                <MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" />
                PDF
            </button>
            @if (FormalQuote is null)
            {
                <button type="button" class="qe-primary-btn" disabled="@(!CanRequestFormalQuote)" @onclick="OnQuoteRequested">
                    @QuoteButtonLabel
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </button>
            }
            else if (!IsQuoteApproved)
            {
                <button type="button" class="qe-secondary-btn" disabled="@(!CanCreateOrder)" @onclick="OnOrderRequested">
                    Create order
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </button>
                <button type="button" class="qe-primary-btn" disabled="@(!CanApproveQuote)" @onclick="OnApproveQuoteRequested">
                    Approve quote
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                </button>
            }
            else if (Order is null)
            {
                <button type="button" class="qe-primary-btn" disabled="@(!CanCreateOrder)" @onclick="OnOrderRequested">
                    Create order
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </button>
            }
            else
            {
                <button type="button" class="qe-primary-btn" disabled="@(!CanPay)" @onclick="OnPaymentRequested">
                    Pay now
                    <MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" />
                </button>
            }
        </div>

        @if (_detailsOpen && Estimate is not null)
        {
            <div class="qe-qsb-details-popover">
                <div class="qe-qsb-details-head">
                    <strong>Quote details</strong>
                    <button type="button" class="qe-btn-icon" title="Close details" @onclick="@(() => _detailsOpen = false)">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </div>
                <div class="qe-qsb-detail-lines">
                    @foreach (var line in Estimate.Lines)
                    {
                        <div class="qe-qsb-detail-line">
                            <span title="@line.FileName">@line.FileName</span>
                            <strong>@line.LineTotal.ToString("N2") @line.Currency</strong>
                            <small>@line.Notes</small>
                        </div>
                    }
                </div>
                <div class="qe-qsb-detail-links">
                    <a href="/documents">Customer documents</a>
                    <a href="/ndas">NDA</a>
                    <a href="/profile">Account</a>
                </div>
            </div>
        }

        @if (FormalQuote is not null)
        {
            <div class="qe-qsb-result">
                <span>@FormalQuote.QuoteNumber</span>
                <strong>@FormalQuote.Status</strong>
            </div>
        }
        @if (Order is not null)
        {
            <div class="qe-qsb-result">
                <span>@Order.OrderNumber</span>
                <strong>@Order.Status</strong>
            </div>
        }
        @if (Payment is not null)
        {
            <div class="qe-qsb-result">
                <span>Payment ready</span>
                <a href="@Payment.PaymentUrl">Open payment</a>
            </div>
        }
    </div>
</footer>

@code {
    [Parameter, EditorRequired] public List<QuotePartViewModel> Parts { get; set; } = [];
    [Parameter] public QuoteReferenceDataResponse? ReferenceData { get; set; }
    [Parameter] public QuoteEstimateResponse? Estimate { get; set; }
    [Parameter] public GenerateFormalQuoteResponse? FormalQuote { get; set; }
    [Parameter] public CreateManufacturingOrderResponse? Order { get; set; }
    [Parameter] public InitiatePaymentResponse? Payment { get; set; }
    [Parameter] public string LeadTimeCode { get; set; } = "STANDARD";
    [Parameter] public bool CanRequestFormalQuote { get; set; }
    [Parameter] public bool CanApproveQuote { get; set; }
    [Parameter] public bool CanCreateOrder { get; set; }
    [Parameter] public bool CanPay { get; set; }
    [Parameter] public string QuoteButtonLabel { get; set; } = "Quote";
    [Parameter] public string BillingName { get; set; } = "Customer account";
    [Parameter] public string BillingHint { get; set; } = "Private order";
    [Parameter] public EventCallback<string> OnLeadTimeSelected { get; set; }
    [Parameter] public EventCallback OnCalculateRequested { get; set; }
    [Parameter] public EventCallback OnQuoteRequested { get; set; }
    [Parameter] public EventCallback OnApproveQuoteRequested { get; set; }
    [Parameter] public EventCallback OnOrderRequested { get; set; }
    [Parameter] public EventCallback OnPaymentRequested { get; set; }

    private bool _detailsOpen;
    private bool IsQuoteApproved => FormalQuote?.Status.Contains("Approved", StringComparison.OrdinalIgnoreCase) == true;

    private string ComputeShipDate()
    {
        var leadTimeDays = ReferenceData?.LeadTimes
            .FirstOrDefault(lt => lt.Code == LeadTimeCode)?.BusinessDays ?? 5;
        var shipDate = AddBusinessDays(DateTime.Today, leadTimeDays);
        return shipDate.ToString("d MMM yyyy");
    }

    private static DateTime AddBusinessDays(DateTime start, int businessDays)
    {
        var date = start;
        var remaining = businessDays;
        while (remaining > 0)
        {
            date = date.AddDays(1);
            if (date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday)
            {
                remaining--;
            }
        }

        return date;
    }

    private static string LeadTimeBadge(LeadTimeOptionDto leadTime) => leadTime.PriceMultiplier switch
    {
        < 1m => $"-{Math.Round((1m - leadTime.PriceMultiplier) * 100m)}%",
        > 1m => $"+{Math.Round((leadTime.PriceMultiplier - 1m) * 100m)}%",
        _ => "base"
    };
}
