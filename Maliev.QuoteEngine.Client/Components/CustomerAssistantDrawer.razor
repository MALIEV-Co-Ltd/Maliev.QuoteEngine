@using System.Globalization
@implements IDisposable
@inject QuoteEngineApiClient Api
@inject IJSRuntime JS

<section class="customer-chatbot-panel" aria-label="MALIEV customer assistant">
    <header class="customer-chatbot-header">
        <div class="customer-chatbot-profile">
            <span class="customer-chatbot-avatar" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.SupportAgent" Size="Size.Medium" />
            </span>
            <div class="customer-chatbot-title">
                <strong>Mali</strong>
                <small>Quotes, orders, profile, and documents</small>
            </div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Class="customer-chatbot-close"
                       Size="Size.Small"
                       aria-label="Close assistant"
                       OnClick="CloseAsync" />
    </header>

    <div class="customer-chatbot-status">
        @if (_session.IsAuthenticated)
        {
            <span>Signed in</span>
            <strong>@(_session.DisplayName ?? _session.Email ?? "Customer")</strong>
        }
        else
        {
            <span>Guest session</span>
            <strong>Sign in inside chat for account help</strong>
        }
    </div>

    <div class="customer-chatbot-messages" @ref="_messagesContainer" aria-live="polite">
        @foreach (var message in _messages)
        {
            <article class="@MessageClass(message)">
                <div class="customer-chatbot-message-body">
                    @foreach (var line in MessageLines(message.Content))
                    {
                        <p>@line</p>
                    }
                </div>
                @if (message.Actions.Count > 0)
                {
                    <div class="customer-chatbot-actions">
                        @foreach (var action in message.Actions)
                        {
                            if (IsSignInAction(action))
                            {
                                <button type="button"
                                        class="customer-chatbot-action customer-chatbot-auth-email"
                                        @onclick="() => BeginSignInAsync(action)"
                                        disabled="@_isAwaitingSignIn">
                                    <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Small" />
                                    <span>@action.Label</span>
                                </button>
                            }
                            else
                            {
                                <a class="customer-chatbot-action"
                                   href="@action.Href"
                                   target="@TargetFor(action.Href)"
                                   rel="@RelFor(action.Href)">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                    <span>@action.Label</span>
                                </a>
                            }
                        }
                    </div>
                }
            </article>
        }

        @if (_hydrating)
        {
            <article class="customer-chatbot-message assistant pending">
                <div class="customer-chatbot-message-body">
                    <p>Loading shared conversation...</p>
                </div>
            </article>
        }

        @if (_isSending)
        {
            <article class="customer-chatbot-message assistant pending">
                <span></span>
                <span></span>
                <span></span>
            </article>
        }
    </div>

    <div class="customer-chatbot-prompts" aria-label="Suggested assistant topics">
        @foreach (var prompt in SuggestedPrompts)
        {
            <button type="button" @onclick="() => SendSuggestionAsync(prompt)" disabled="@_isSending">@prompt</button>
        }
    </div>

    <div class="customer-chatbot-composer">
        <textarea @ref="_draftInput"
                  rows="1"
                  maxlength="1000"
                  placeholder="Ask about a quote, order, receipt, profile, or address"
                  value="@_draft"
                  @oninput="OnDraftInputAsync"
                  disabled="@_isSending"></textarea>
        <button type="button" aria-label="Send message" @onclick="SendDraftAsync" disabled="@(!CanSend)">
            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
        </button>
    </div>
</section>

@code {
    private const string SharedSessionStorageKey = "maliev.customerAssistant.session.v1";
    private const int SignInPollAttempts = 60;
    private static readonly TimeSpan SignInPollInterval = TimeSpan.FromSeconds(2);
    private static readonly string[] SuggestedPrompts =
    [
        "Help me choose a process",
        "Where is my order?",
        "Show my receipts",
        "Update my address"
    ];

    private readonly List<CustomerChatMessage> _messages = [];
    private ElementReference _messagesContainer;
    private ElementReference _draftInput;
    private CustomerChatbotSessionResponse _session = new();
    private Guid? _sessionId;
    private string _draft = string.Empty;
    private bool _hydrating;
    private bool _isSending;
    private bool _isAwaitingSignIn;
    private bool _scrollPending;
    private CancellationTokenSource? _signInPollCts;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool CanSend => !_isSending && !string.IsNullOrWhiteSpace(_draft);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await HydrateAsync();
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await ScrollToBottomAsync(smooth: true);
        }
    }

    private async Task HydrateAsync()
    {
        _hydrating = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _session = await Api.GetChatbotSessionAsync();
            var browserSessionId = await ReadSharedSessionIdAsync();
            var requestedSessionId = Guid.TryParse(browserSessionId, out var parsedSessionId)
                ? parsedSessionId
                : _session.SessionId;

            var hydration = await Api.HydrateChatbotAsync(new CustomerChatbotHydrateRequest
            {
                SessionId = requestedSessionId
            });
            _sessionId = hydration.SessionId ?? _session.SessionId;

            if (hydration.Messages.Count > 0)
            {
                _messages.Clear();
                foreach (var message in hydration.Messages)
                {
                    _messages.Add(new CustomerChatMessage(
                        NormalizeRole(message.Role),
                        message.Content,
                        [],
                        IsHydrated: true));
                }
            }
            else if (_messages.Count == 0)
            {
                AddAssistant(hydration.ContinuationMessage ?? "Mali is ready in Quote Engine. Ask about CAD files, pricing, quotes, orders, receipts, profile, or documents.");
            }
        }
        catch (InvalidOperationException)
        {
            AddAssistant("Mali is ready in Quote Engine. Ask about CAD files, pricing, quotes, orders, receipts, profile, or documents.");
        }
        finally
        {
            _hydrating = false;
            _scrollPending = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendDraftAsync()
    {
        var message = _draft.Trim();
        if (message.Length == 0)
        {
            return;
        }

        _draft = string.Empty;
        await SendMessageAsync(message);
    }

    private async Task SendSuggestionAsync(string prompt)
    {
        await SendMessageAsync(prompt);
    }

    private async Task SendMessageAsync(string message)
    {
        _messages.Add(new CustomerChatMessage("user", message, []));
        _isSending = true;
        _scrollPending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Api.SendChatbotMessageAsync(new CustomerChatbotRequest
            {
                SessionId = _sessionId,
                Message = message,
                Language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("th", StringComparison.OrdinalIgnoreCase)
                    ? "th"
                    : "en"
            });
            _sessionId = response.SessionId ?? _sessionId;
            _messages.Add(new CustomerChatMessage(
                NormalizeRole(response.Role),
                response.Content,
                MapActions(response.SuggestedActions)));

            await WriteSharedSessionAsync(response.Language);
        }
        catch (InvalidOperationException)
        {
            AddAssistant("I could not reach the MALIEV assistant service. Your Quote Engine page is still active, so please try again in a moment.");
        }
        finally
        {
            _isSending = false;
            _scrollPending = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BeginSignInAsync(CustomerChatAction action)
    {
        if (_isAwaitingSignIn)
        {
            return;
        }

        _isAwaitingSignIn = true;
        AddAssistant("Opening sign-in in a separate window. This Quote Engine page will stay open and I will continue here after your identity is verified.");
        await InvokeAsync(StateHasChanged);

        var signInUrl = string.IsNullOrWhiteSpace(action.Href)
            ? "/auth/sign-in?returnUrl=%2Fauth%2Fchatbot-complete"
            : action.Href;
        var opened = await OpenSignInPopupAsync(signInUrl);
        if (!opened)
        {
            AddAssistant("The sign-in window was blocked. Use the sign-in link in this message, then return here to continue.", [action]);
            _isAwaitingSignIn = false;
            return;
        }

        _signInPollCts?.Cancel();
        _signInPollCts?.Dispose();
        _signInPollCts = new CancellationTokenSource();
        var token = _signInPollCts.Token;

        try
        {
            for (var attempt = 0; attempt < SignInPollAttempts; attempt++)
            {
                await Task.Delay(SignInPollInterval, token);
                var session = await Api.GetChatbotSessionAsync(token);
                if (!session.IsAuthenticated)
                {
                    continue;
                }

                _session = session;
                AddAssistant($"You are signed in as {session.DisplayName ?? session.Email ?? "your MALIEV account"}. I can now help with your quotes, orders, receipts, profile, and address information.");
                await WriteSharedSessionAsync("en");
                return;
            }

            AddAssistant("I am still waiting for sign-in to complete. When you finish signing in, send your account question again and I will continue from this chat.");
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _isAwaitingSignIn = false;
            _scrollPending = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddAssistant(string content, IReadOnlyList<CustomerChatAction>? actions = null)
    {
        _messages.Add(new CustomerChatMessage("assistant", content, actions?.ToList() ?? []));
    }

    private async Task OnDraftInputAsync(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;
        await FitComposerAsync();
    }

    private Task CloseAsync()
    {
        return OnClose.InvokeAsync();
    }

    private async Task<string?> ReadSharedSessionIdAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("malievChatbot.readSharedSessionId", SharedSessionStorageKey);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task WriteSharedSessionAsync(string language)
    {
        if (!_sessionId.HasValue)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "malievChatbot.writeSharedSession",
                SharedSessionStorageKey,
                _sessionId.Value.ToString("D"),
                _session.CustomerId?.ToString("D") ?? _session.Email,
                string.Equals(language, "th", StringComparison.OrdinalIgnoreCase) ? "th" : "en",
                _session.IsAuthenticated);
        }
        catch (JSException)
        {
        }
    }

    private async Task<bool> OpenSignInPopupAsync(string signInUrl)
    {
        try
        {
            return await JS.InvokeAsync<bool>("malievChatbot.openSignInPopup", signInUrl);
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task FitComposerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("malievChatbot.fitComposer", _draftInput);
        }
        catch (JSException)
        {
        }
    }

    private async Task ScrollToBottomAsync(bool smooth)
    {
        try
        {
            await JS.InvokeVoidAsync("malievChatbot.scrollToBottom", _messagesContainer, smooth);
        }
        catch (JSException)
        {
        }
    }

    private static IReadOnlyList<CustomerChatAction> MapActions(IReadOnlyList<CustomerChatbotActionDto> actions)
    {
        return actions
            .Where(action => !string.IsNullOrWhiteSpace(action.Label))
            .Select(action => new CustomerChatAction(
                action.Label,
                action.Action,
                string.IsNullOrWhiteSpace(action.Data) ? null : action.Data))
            .ToList();
    }

    private static bool IsSignInAction(CustomerChatAction action)
    {
        return string.Equals(action.Kind, "sign-in", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Kind, "signin", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action.Kind, "signin-email", StringComparison.OrdinalIgnoreCase);
    }

    private static string MessageClass(CustomerChatMessage message)
    {
        var hydrated = message.IsHydrated ? " customer-chatbot-hydrated" : string.Empty;
        return $"customer-chatbot-message {NormalizeRole(message.Role)}{hydrated}";
    }

    private static string NormalizeRole(string? role)
    {
        return string.Equals(role, "user", StringComparison.OrdinalIgnoreCase) ? "user" : "assistant";
    }

    private static IEnumerable<string> MessageLines(string content)
    {
        return content.ReplaceLineEndings("\n").Split('\n');
    }

    private static string? TargetFor(string? href)
    {
        return href?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true ? "_blank" : null;
    }

    private static string? RelFor(string? href)
    {
        return href?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true ? "noopener" : null;
    }

    public void Dispose()
    {
        _signInPollCts?.Cancel();
        _signInPollCts?.Dispose();
    }

    private sealed record CustomerChatMessage(
        string Role,
        string Content,
        IReadOnlyList<CustomerChatAction> Actions,
        bool IsHydrated = false);

    private sealed record CustomerChatAction(string Label, string Kind, string? Href);
}
