@inherits LayoutComponentBase
@using Maliev.QuoteEngine.Shared.ReferenceData
@inject QuoteEngineApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject PreferenceService Preferences
@implements IDisposable

<MudThemeProvider Theme="@_malievTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="@AppShellClass">
    <!-- The legacy customer topbar is retired: navigation, account, theme,
         language, and currency all live inside the Make Studio workspace. -->
    <main class="@WorkspaceClass">
        <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
            <CascadingValue Value="_selectedCulture" Name="Culture">
                <CascadingValue Value="_authStatus.IsSignedIn" Name="IsSignedIn">
                <CascadingValue Value="new Func<Task>(() => Task.CompletedTask)" Name="OpenAssistant">
                    @if (IsQuoteWorkspace)
                    {
                        <div class="quote-workspace-host">
                            @Body
                        </div>
                    }
                    else if (IsHomePage)
                    {
                        <div class="home-host">
                            @Body
                        </div>
                    }
                    else
                    {
                        <section class="page-surface">
                            @Body
                        </section>
                    }
                </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </main>
</div>

@code {
    private readonly MudTheme _malievTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#171717",
            PrimaryContrastText = "#ffffff",
            Secondary = "#ffffff",
            SecondaryContrastText = "#171717",
            Tertiary = "#de1d8d",
            Info = "#0a72ef",
            InfoContrastText = "#ffffff",
            Error = "#ff5b4f",
            ErrorContrastText = "#ffffff",
            Dark = "#171717",
            DarkContrastText = "#ffffff",
            Surface = "#ffffff",
            Background = "#ffffff",
            BackgroundGray = "#fafafa",
            TextPrimary = "#171717",
            TextSecondary = "#4d4d4d",
            LinesDefault = "#ebebeb",
            AppbarBackground = "#ffffff",
            AppbarText = "#171717"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#f5f5f5",
            PrimaryContrastText = "#111111",
            Secondary = "#171717",
            SecondaryContrastText = "#f5f5f5",
            Tertiary = "#ff4fb3",
            Info = "#4f9cff",
            InfoContrastText = "#0d1117",
            Error = "#ff7a70",
            ErrorContrastText = "#0d1117",
            Dark = "#f5f5f5",
            DarkContrastText = "#111111",
            Surface = "#161616",
            Background = "#0f0f10",
            BackgroundGray = "#1f1f22",
            TextPrimary = "#f5f5f5",
            TextSecondary = "#c7c7c7",
            LinesDefault = "#2d2d30",
            AppbarBackground = "#111111",
            AppbarText = "#f5f5f5"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI Variable Text", "Segoe UI", "Noto Sans", "Noto Sans Thai", "sans-serif"],
                FontSize = ".875rem",
                FontWeight = "400",
                LineHeight = "1.5",
                LetterSpacing = "0"
            },
            Button = new ButtonTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI Variable Text", "Segoe UI", "Noto Sans", "Noto Sans Thai", "sans-serif"],
                FontSize = ".8125rem",
                FontWeight = "500",
                LineHeight = "1.43",
                LetterSpacing = "0",
                TextTransform = "none"
            },
            Caption = new CaptionTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI Variable Text", "Segoe UI", "Noto Sans", "Noto Sans Thai", "sans-serif"],
                FontSize = ".75rem",
                FontWeight = "500",
                LineHeight = "1.33",
                LetterSpacing = "0"
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    private static readonly CurrencyOptionDto FallbackCurrency = new("THB", "฿", "Thai Baht", true, true);
    private static readonly string[] PriorityCodes = ["THB", "USD", "EUR", "GBP", "JPY", "CNY", "SGD", "AUD", "CAD", "CHF"];
    private bool IsQuoteWorkspace => IsQuoteWorkspacePath(new Uri(Navigation.Uri).AbsolutePath);
    private bool IsHomePage => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Length == 0 && !IsQuoteWorkspace;
    private string WorkspaceClass => IsQuoteWorkspace ? "workspace workspace--quote" : "workspace";
    private bool _isDarkMode;
    private List<CurrencyOptionDto> _currencyOptions = [FallbackCurrency];
    private string _selectedCurrency = "THB";
    private bool _preferencesLoaded;
    private string _selectedCulture = SupportedCultures.DefaultCulture;
    private QuoteAuthStatusResponse _authStatus = new(false, null, null);
    private CustomerProfileResponse? _profile;
    private string _selectedBillingAccountId = "personal";
    private string AppShellClass =>
        $"app-shell{(IsHomePage ? " is-home" : "")}{(IsQuoteWorkspace ? " is-quote-workspace" : "")}";
    private bool HasCompanyBillingAccount => !string.IsNullOrWhiteSpace(_profile?.CompanyName);
    private string PersonalBillingName => _profile?.DisplayName ?? _authStatus.DisplayName ?? Text("Customer account", "บัญชีลูกค้า");
    private string BillingAccountTitle => _selectedBillingAccountId == "company" && HasCompanyBillingAccount
        ? _profile!.CompanyName
        : PersonalBillingName;
    private string BillingAccountHint => _selectedBillingAccountId == "company" && HasCompanyBillingAccount
        ? Text("Company billing", "เรียกเก็บเงินบริษัท")
        : Text("Private order", "คำสั่งซื้อส่วนตัว");
    private string ThemeToggleIcon => _isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ThemeToggleTitle => _isDarkMode ? Text("Use light mode", "ใช้โหมดสว่าง") : Text("Use dark mode", "ใช้โหมดมืด");
    private string AvatarInitials => GetInitials(_profile?.DisplayName ?? _authStatus.DisplayName ?? "Customer");
    private MarkupString CustomerAvatarMarkup => !string.IsNullOrWhiteSpace(_profile?.ProfileImageUrl)
        ? new MarkupString($"<img class=\"customer-avatar customer-avatar--image\" src=\"{System.Net.WebUtility.HtmlEncode(_profile.ProfileImageUrl)}\" alt=\"\" />")
        : new MarkupString($"<span class=\"customer-avatar\" aria-hidden=\"true\">{System.Net.WebUtility.HtmlEncode(AvatarInitials)}</span>");

    private static bool IsQuoteWorkspacePath(string path)
    {
        var normalized = path.TrimEnd('/');
        return normalized.Length == 0
            || normalized.Equals("/projects/new", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("/quotes", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("/quote/new", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("/quotes/new", StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        Preferences.Changed += OnPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;
        // Pre-hydrate auth state from the server-injected window.getMalievAuth() so the
        // correct header (account info or sign-in button) shows on first paint — before any
        // API round-trip or WASM cold-start delay.
        if (Js is IJSInProcessRuntime jsSync)
        {
            try
            {
                var preloaded = jsSync.Invoke<QuoteAuthStatusResponse?>("getMalievAuth");
                if (preloaded is not null) _authStatus = preloaded;
            }
            catch { /* getMalievAuth not defined — no server pre-hydration available */ }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencyOptionsAsync();
        await RefreshAuthStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPreferencesAsync();
            await Js.InvokeVoidAsync("quoteEngineLoader.markReady");
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshAuthStatusAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAuthStatusAsync()
    {
        try
        {
            _authStatus = await Api.GetAuthStatusAsync();
            if (_authStatus.IsSignedIn)
            {
                _profile = await Api.GetProfileAsync();
                if (!_preferencesLoaded)
                {
                    _selectedCurrency = NormalizeCurrency(_profile?.PreferredCurrency ?? _selectedCurrency);
                }
                if (!HasCompanyBillingAccount && string.Equals(_selectedBillingAccountId, "company", StringComparison.Ordinal))
                {
                    _selectedBillingAccountId = "personal";
                }
            }
            else
            {
                _profile = null;
                _selectedBillingAccountId = "personal";
            }
        }
        catch (HttpRequestException)
        {
            _authStatus = new QuoteAuthStatusResponse(false, null, null);
            _profile = null;
            _selectedBillingAccountId = "personal";
        }
    }

    private async Task LoadPreferencesAsync()
    {
        await Preferences.InitializeAsync();
        _isDarkMode = Preferences.IsDarkMode;
        _selectedCulture = Preferences.Culture;

        var currency = await Js.InvokeAsync<string?>("quoteEnginePreferences.getPreference", "maliev.quote.currency");
        _selectedCurrency = NormalizeCurrency(currency ?? _profile?.PreferredCurrency ?? _selectedCurrency);
        _preferencesLoaded = true;
    }

    private async Task LoadCurrencyOptionsAsync()
    {
        try
        {
            var currencies = await Api.GetCurrenciesAsync();
            _currencyOptions = currencies
                .Where(currency => currency.IsActive && !string.IsNullOrWhiteSpace(currency.Code))
                .OrderByDescending(currency => currency.IsPrimary)
                .ThenBy(currency => currency.Code, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (_currencyOptions.Count == 0)
            {
                _currencyOptions = [FallbackCurrency];
            }
        }
        catch (HttpRequestException)
        {
            _currencyOptions = [FallbackCurrency];
        }

        _selectedCurrency = NormalizeCurrency(_selectedCurrency);
    }

    private async Task ToggleThemeAsync()
    {
        await Preferences.SetThemeAsync(_isDarkMode ? PreferenceService.LightTheme : PreferenceService.DarkTheme);
    }

    private Task ChangeCultureAsync(string culture)
    {
        return Preferences.SetCultureAsync(culture);
    }

    private Task ChangeCultureToAutoAsync()
    {
        return Preferences.SetCultureAutoAsync();
    }

    private string AutoLanguageButtonClass()
    {
        return Preferences.IsCultureAuto ? "quote-language-button is-active" : "quote-language-button";
    }

    private async Task PersistCurrencyAsync()
    {
        await Preferences.SetCurrencyAsync(_selectedCurrency);
        await Js.InvokeVoidAsync("quoteEnginePreferences.setPreference", "maliev.quote.currency", _selectedCurrency);
    }

    private CurrencyOptionDto? SelectedCurrencyDto =>
        _currencyOptions.FirstOrDefault(c => c.Code.Equals(_selectedCurrency, StringComparison.OrdinalIgnoreCase));

    private async Task SetCurrencyDtoAsync(CurrencyOptionDto? c)
    {
        if (c is null) return;
        _selectedCurrency = c.Code;
        await PersistCurrencyAsync();
    }

    private async Task<IEnumerable<CurrencyOptionDto>> SearchCurrenciesAsync(string? query, CancellationToken ct)
    {
        // Retry loading the full currency list if only the fallback THB entry is present.
        if (_currencyOptions.Count <= 1)
        {
            await LoadCurrencyOptionsAsync();
        }

        var active = _currencyOptions.Where(c => c.IsActive).ToList();
        var currentDisplay = SelectedCurrencyDto is { } dto ? $"{dto.Code} {dto.Symbol}" : null;
        var isShowAll = string.IsNullOrWhiteSpace(query) ||
            (currentDisplay != null && string.Equals(query!.Trim(), currentDisplay.Trim(), StringComparison.OrdinalIgnoreCase));

        if (isShowAll)
        {
            var priority = PriorityCodes
                .Select(code => active.FirstOrDefault(c => c.Code == code))
                .Where(c => c != null)
                .Cast<CurrencyOptionDto>();
            var rest = active.Where(c => !PriorityCodes.Contains(c.Code));
            return priority.Concat(rest);
        }

        var q = query!.Trim();
        return active.Where(c =>
            c.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Symbol.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private string NormalizeCurrency(string? currency)
    {
        return _currencyOptions.FirstOrDefault(candidate => candidate.Code.Equals(currency, StringComparison.OrdinalIgnoreCase))?.Code
            ?? _currencyOptions.FirstOrDefault(candidate => candidate.IsPrimary)?.Code
            ?? _currencyOptions.FirstOrDefault(candidate => candidate.Code.Equals("THB", StringComparison.OrdinalIgnoreCase))?.Code
            ?? _currencyOptions.FirstOrDefault()?.Code
            ?? "THB";
    }

    private static string GetInitials(string value)
    {
        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "C";
        }

        var initials = string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
        return string.IsNullOrWhiteSpace(initials) ? "C" : initials;
    }

    private void SelectBillingAccount(string accountId)
    {
        _selectedBillingAccountId = HasCompanyBillingAccount && string.Equals(accountId, "company", StringComparison.Ordinal)
            ? "company"
            : "personal";
    }

    private bool IsBillingAccountSelected(string accountId)
    {
        return string.Equals(_selectedBillingAccountId, accountId, StringComparison.Ordinal);
    }

    private string BillingAccountOptionClass(string accountId)
    {
        return IsBillingAccountSelected(accountId) ? "billing-account-option is-selected" : "billing-account-option";
    }

    private string LanguageButtonClass(string culture)
    {
        return string.Equals(SupportedCultures.Normalize(_selectedCulture), SupportedCultures.Normalize(culture), StringComparison.Ordinal)
            ? "quote-language-button is-active"
            : "quote-language-button";
    }

    // Force a full HTTP request so the BFF SSR landing page is served (not the WASM Home.razor).
    private void GoToLanding() => Navigation.NavigateTo("/", forceLoad: true);

    private string Text(string en, string th)
    {
        return Preferences.Text(en, th);
    }

    private void OnPreferencesChanged()
    {
        _isDarkMode = Preferences.IsDarkMode;
        _selectedCulture = Preferences.Culture;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
