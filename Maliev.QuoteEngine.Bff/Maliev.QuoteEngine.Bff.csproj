<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>maliev-quoteengine-bff</UserSecretsId>
    <StaticWebAssetEndpointExclusionPattern>$(StaticWebAssetEndpointExclusionPattern);index.html</StaticWebAssetEndpointExclusionPattern>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maliev.QuoteEngine.Client\Maliev.QuoteEngine.Client.csproj" />
    <ProjectReference Include="..\Maliev.QuoteEngine.Shared\Maliev.QuoteEngine.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Maliev.MessagingContracts\generated\csharp\Maliev.MessagingContracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
    <PackageReference Include="Maliev.MessagingContracts" Version="$(SharedLibraryVersion)" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" Version="8.5.8" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.8" />
    <!-- SignalR Redis 10.0.7 permits MessagePack 2.5.187, which is vulnerable; stay on the patched 2.x line. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="GeometryRuntimeFallback\client-geometry-runtime.worker.js" />
    <EmbeddedResource Include="GeometryRuntimeFallback\client-geometry-runtime.worker.js" />
  </ItemGroup>
</Project>
